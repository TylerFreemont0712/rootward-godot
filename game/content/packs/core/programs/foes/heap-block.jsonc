  "id": "heap-block",
  "name": "Heap Block",
  "sprite": "heap-block",
  "size": "small",
  "hp": 10,
  "trait": { "kind": "heap-block", "free_block": 3 },
  "intents": [{ "kind": "idle", "tempo": 999 }],
  "flavor": "Sixteen bytes, and nobody holds the pointer any more."
