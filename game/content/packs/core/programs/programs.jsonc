// The Shardrun (ADR-0012): a run is a program built card by card every turn, and its cards are real algorithms. A
// program starts from one seed bolt; each card is a stage that takes the volley and the battle and returns a new
// volley; the last stage usually aims it. Every stage's work is its complexity applied to the input size the sandbox
// really measured, and a foe whose tempo is below the program's total work acts before the program lands.
{
  // What every program starts from, before its first card: three plain bolts. With one, nearly every card only reshaped
  // what Salvo made, and a hand without Salvo did almost nothing (docs/ROADMAP.md, section 2).
  "seed": [
    { "power": 3, "element": "none" },
    { "power": 3, "element": "none" },
    { "power": 3, "element": "none" }
  ],
  // The Program is a file: its name, and the extension the run's language gives it (main.py, main.js).
  "program": { "name": "main", "capacity": 5 },
  // Work, in operations, above which a program times out: it lands nothing, and every foe acts. One per layer: the
  // Kernel gives you a short time slice, so a late program has to be efficient (ADR-0017). Relics may raise it.
  "budget": [4096, 2048, 1024],
  // A program run's map for each layer (Paradigm Update B6): two more rows than the Shardrun's (a second guaranteed
  // fight, and a fixed Registry two rows before the guardian's rest) and Issue rooms by weight. Merged over the layer
  // (ProgramRules.catalog_for); Spellforge keeps its own maps.
  "map": {
    "salvage": {
      "rows": 10,
      "fixed_rows": { "0": "fight", "1": "fight", "4": "treasure", "7": "shop", "-1": "rest" },
      "weights": { "fight": 44, "elite": 14, "issue": 18, "rest": 10, "forge": 10, "shop": 4, "treasure": 0 }
    },
    "heap": {
      "rows": 11,
      "fixed_rows": { "0": "fight", "1": "fight", "4": "treasure", "8": "shop", "-1": "rest" },
      "weights": { "fight": 42, "elite": 16, "issue": 18, "rest": 10, "forge": 10, "shop": 4, "treasure": 0 }
    },
    "kernel": {
      "rows": 11,
      "fixed_rows": { "0": "fight", "1": "fight", "4": "treasure", "8": "shop", "-1": "rest" },
      "weights": { "fight": 40, "elite": 18, "issue": 18, "rest": 10, "forge": 10, "shop": 4, "treasure": 0 }
    }
  },
  // The Registry, a program run's shop (ProgramShop, Paradigm Update B7): five cards (two of your paradigm, a neutral, one
  // of another paradigm, any), three relics (legendary one time in a hundred), the scripts and three services. Prices
  // wander by `jitter` from the seed; `uninstall` costs `step` more each time you use it in a run.
  "registry": {
    "cards": 5,
    "relics": 3,
    "scripts": 3,
    "card_rarity": { "common": 55, "uncommon": 35, "rare": 10 },
    "card_price": { "common": 100, "uncommon": 150, "rare": 300 },
    "sale": 0.5,
    "relic_tiers": { "common": 40, "uncommon": 34, "rare": 20, "epic": 5, "legendary": 1 },
    "relic_price": { "common": 220, "uncommon": 320, "rare": 460, "epic": 640, "legendary": 450 },
    "uninstall": { "price": 150, "step": 50 },
    "refactor": 180,
    "pip_install": { "price": 120, "choices": 3 },
    "jitter": 0.1
  },
  // Scripts, the one-use commands on the belt (ProgramScripts, Paradigm Update B12): the belt's size, the chance a won
  // fight leaves one (fights add `step` for each fight without one), and the rarity odds of any script.
  "scripts": {
    "belt": 3,
    "drop": { "fight": 0.3, "elite": 0.6, "boss": 1.0 },
    "step": 0.1,
    "rarity": { "common": 60, "uncommon": 30, "rare": 10 }
  },
  // What a fight offers as cards (ProgramRewards, Paradigm Update B4). Each of the three cards comes from your own
  // paradigm (50%), neutral (30%) or another paradigm (20%), and at least one is always your own; a guardian never
  // offers another paradigm's. The focus's cards weigh double inside the own share. An elite adds a fourth card from
  // another paradigm, one rarity up. Each reward without a rare card adds `pity` to the next rare chance. Skipping the
  // cards pays `skip_cycles` per layer.
  "rewards": {
    "shares": { "own": 0.5, "neutral": 0.3, "other": 0.2 },
    "focus_weight": 2.0,
    "elite_extra": 1,
    "pity": 0.03,
    "skip_cycles": 10
  },
  // Cycles, the money (ProgramCycles, Paradigm Update B5): floor(base[kind] x layer x difficulty) a kill (a guardian's pay is
  // shared by its bodies; a summoned foe pays `summoned`, never scaled), +exact, +initiative, +clean (no damage taken),
  // +one_liner (won with one program); a treasure pays `treasure` x the layer's number.
  "cycles": {
    "base": { "fight": 12, "elite": 32, "boss": 90, "summoned": 2 },
    "layer": [1.0, 1.25, 1.5, 1.75],
    "difficulty": { "beginner": 1.0, "programmer": 1.25 },
    "exact": 2,
    "initiative": 2,
    "clean": 10,
    "one_liner": 6,
    "treasure": 40
  },
  // Initiative: a foe your program lands before (its tempo is not below the program's work) takes 25% more from it.
  "initiative": 0.25,
  // The strongest a bolt can be, and how many a volley can hold (more are dropped as fizzled).
  "max_power": 9999,
  "max_bolts": 128,
  // The first thing a run asks: pick one paradigm of three, then draft cards from packs.
  "draft": {
    "paradigms_offered": 3,
    "rounds": 5,
    "pack_size": 3,
    "paradigm_weight": 2.0,
    "focus_weight": 3.0
  },
  // Every deck starts with these, whatever the paradigm.
  "basics": ["salvo", "salvo", "fork", "amplify", "ward", "ward", "round-robin", "kindle"],
  "paradigms": [
    {
      "id": "divide-conquer",
      "name": "Divide & Conquer",
      "tier": "O(n log n)",
      "colour": "#b48cff",
      "summary": "Split the volley in half, again and again. Every level of recursion makes every bolt stronger, so the bigger the volley, the harder it hits.",
      "signature": [
        "divide",
        "merge-strike"
      ],
      "pool": ["divide", "merge-strike", "quick-sort", "quickselect", "recursion-tree", "split", "import-math",
        "import-copy", "recursive-mirror", "base-case", "k-way-merge", "dutch-flag", "closest-pair",
        "counting-inversions", "fast-power", "halve", "introsort", "karatsuba", "max-subarray", "median-of-medians",
        "skyline", "tower-of-hanoi", "tail-call"],
      "law": "recurse",
      "swap": {
        "out": "fork",
        "in": "split"
      },
      "focuses": [
        {
          "id": "deep",
          "name": "Deep Recursion",
          "tag": "deep",
          "rule": "Recurse goes one level deeper: the card after a split runs on each quarter.",
          "signature": "base-case",
          "relic": "focus-deep",
          "plays_like": "Towers of small cards on small pieces.",
          "teaches": "Recursion depth and base cases."
        },
        {
          "id": "merge",
          "name": "Merger",
          "tag": "merge",
          "rule": "When halves rejoin, every bolt gains 1.",
          "signature": "k-way-merge",
          "relic": "focus-merge",
          "plays_like": "Splits and merges in a loop.",
          "teaches": "The combine step of merge sort."
        },
        {
          "id": "pivot",
          "name": "Partitioner",
          "tag": "pivot",
          "rule": "A pivot card marks its pivot bolt, which lands doubled on the toughest foe.",
          "signature": "dutch-flag",
          "relic": "focus-pivot",
          "plays_like": "Partitions, selection, quick sort.",
          "teaches": "Partitioning, pivots, linear-time selection."
        }
      ]
    },
    {
      "id": "search-index",
      "name": "Search & Index",
      "tier": "O(log n)",
      "colour": "#5cc8b8",
      "summary": "Pay once to put the volley in order, then find exactly the bolt each foe needs. Nothing wasted, but only on sorted data.",
      "signature": [
        "prefix-sum",
        "binary-execute"
      ],
      "pool": ["prefix-sum", "binary-execute", "hash-merge", "bisect-insert", "dedupe", "two-pointers", "hash-aim",
        "import-bisect", "import-collections", "run-length", "lookup", "two-sum", "interpolation-search",
        "bloom-filter", "consistent-hashing", "counting-sort", "cursor", "exponential-search", "lower-bound-ward",
        "range-query", "ternary-search", "write-ahead-log", "b-tree"],
      "law": "the-index",
      "swap": {
        "out": "kindle",
        "in": "merge-sort"
      },
      "focuses": [
        {
          "id": "index",
          "name": "Indexer",
          "tag": "index",
          "rule": "The index holds 16, and the seed takes its two strongest bolts.",
          "signature": "lookup",
          "relic": "focus-index",
          "plays_like": "Bank overkill, then spend it precisely.",
          "teaches": "Indexes and sorted containers."
        },
        {
          "id": "hash",
          "name": "Hasher",
          "tag": "hash",
          "rule": "A bolt that lands on a foe's weakness gains 2 power.",
          "signature": "two-sum",
          "relic": "focus-hash",
          "plays_like": "Element maps and O(1) lookups.",
          "teaches": "Hash maps, sets, Bloom filters."
        },
        {
          "id": "bisect",
          "name": "Bisector",
          "tag": "bisect",
          "rule": "A volley sorted when a strike reads it gives each of that strike's bolts +1.",
          "signature": "interpolation-search",
          "relic": "focus-bisect",
          "plays_like": "Sort once, search many times.",
          "teaches": "Binary search and its relatives."
        }
      ]
    },
    {
      "id": "greedy",
      "name": "Greedy",
      "tier": "O(n)",
      "colour": "#f2a541",
      "summary": "Take the best choice in front of you, every time. Fast and cheap, great against crowds, not always optimal.",
      "signature": [
        "greedy-assign",
        "take-max"
      ],
      "pool": ["greedy-assign", "take-max", "sweep", "make-change", "huffman", "load-balance", "greedy-ward",
        "import-heapq", "stable-partition", "chain-lightning", "activity-selection", "top-k", "first-fit-decreasing",
        "boyer-moore", "brace", "break-loop", "fractional-knapsack", "heap-sort", "heapify", "increase-key",
        "job-sequencing", "minimum-arrows", "nearest-neighbour", "stock-trader", "task-scheduler"],
      "law": "local-optimum",
      "swap": {
        "out": "round-robin",
        "in": "sweep"
      },
      "focuses": [
        {
          "id": "sprint",
          "name": "Sprint",
          "tag": "sprint",
          "rule": "A program of three cards or fewer counts 25% less work.",
          "signature": "activity-selection",
          "relic": "focus-sprint",
          "plays_like": "Tiny cheap programs every turn; kill chains for mana.",
          "teaches": "Short-circuiting, break, streaming."
        },
        {
          "id": "heap",
          "name": "Priority Queue",
          "tag": "heap",
          "rule": "import heapq is in force from the first turn of every fight, free.",
          "signature": "top-k",
          "relic": "focus-heap",
          "plays_like": "A few huge bolts, strongest first.",
          "teaches": "Heaps, priority queues, heapify in O(n)."
        },
        {
          "id": "schedule",
          "name": "Scheduler",
          "tag": "schedule",
          "rule": "A program that hits every living foe gives each bolt +1.",
          "signature": "first-fit-decreasing",
          "relic": "focus-schedule",
          "plays_like": "Spread bolts over crowds exactly.",
          "teaches": "Scheduling, bin packing, interval problems."
        }
      ]
    },
    {
      "id": "brute-force",
      "name": "Brute Force",
      "tier": "O(n\u00b2)",
      "colour": "#e2584f",
      "summary": "Try every pair, every subset. Enormous damage and perfect answers, but slow: foes act first, and a big volley times out.",
      "signature": [
        "pairwise",
        "exhaustive-kill"
      ],
      "pool": ["pairwise", "exhaustive-kill", "bubble-sort", "power-set", "linear-search", "exhaustive-ward",
        "import-itertools", "cartesian-product", "backtracking", "nested-strike", "all-pairs-rank", "bogosort",
        "branch-and-bound", "combinations", "grid-search", "meet-in-the-middle", "n-queens", "permutations",
        "selection-sort"],
      "law": "throw-hardware-at-it",
      "swap": {
        "out": "amplify",
        "in": "bubble-sort"
      },
      "focuses": [
        {
          "id": "enumerate",
          "name": "Enumerator",
          "tag": "enumerate",
          "rule": "Brute-force sources make bolts with +1 power; a volley may hold 192 bolts.",
          "signature": "cartesian-product",
          "relic": "focus-enumerate",
          "plays_like": "Floods of hundreds of bolts.",
          "teaches": "Combinatorics and growing search spaces."
        },
        {
          "id": "prune",
          "name": "Pruner",
          "tag": "prune",
          "rule": "A program never times out: the card that would cross the budget is skipped instead, and later cards still run.",
          "signature": "backtracking",
          "relic": "focus-prune",
          "plays_like": "Exhaustive cards safely near the budget.",
          "teaches": "Pruning, branch and bound, graceful degradation."
        },
        {
          "id": "heavy",
          "name": "Overclocker",
          "tag": "heavy",
          "rule": "The budget is 50% larger; a timeout costs 5 Integrity.",
          "signature": "nested-strike",
          "relic": "focus-heavy",
          "plays_like": "The slowest, heaviest programs, all risk.",
          "teaches": "Quadratic code and the limits of more hardware."
        }
      ]
    },
    {
      "id": "dynamic",
      "name": "Dynamic Programming",
      "tier": "O(n\u00b7H)",
      "colour": "#82d8ff",
      "summary": "Build answers from smaller answers. Tables that grow as they go, exact kills with no overkill, and naive recursion worth optimising.",
      "signature": [
        "tabulate",
        "knapsack-strike"
      ],
      "pool": ["tabulate", "knapsack-strike", "fib-surge", "kadane", "lis-strike", "pascal-row", "knapsack-ward",
        "import-cache", "sliding-window", "memo-strike", "recurrence", "coin-change", "global-total", "release",
        "catalan", "edit-distance", "equal-partition", "grid-paths", "lcs", "memo-ward", "rod-cutting", "table-ward",
        "unbounded-knapsack", "bottom-up", "global-total", "release"],
      "law": "the-table",
      "swap": {
        "out": "ward",
        "in": "knapsack-ward"
      },
      "focuses": [
        {
          "id": "memo",
          "name": "Memoiser",
          "tag": "memo",
          "rule": "functools.cache is in force from the first turn: a card that already ran this fight does no work.",
          "signature": "memo-strike",
          "relic": "focus-memo",
          "plays_like": "Repeating programs that grow cheaper.",
          "teaches": "Top-down DP and memoisation."
        },
        {
          "id": "table",
          "name": "Tabulator",
          "tag": "table",
          "rule": "The Table's bolt starts on turn 2 and is (dp[t-1] + dp[t-2]) // 3.",
          "signature": "recurrence",
          "relic": "focus-table",
          "plays_like": "Slow first turns, overwhelming late turns.",
          "teaches": "Bottom-up DP and recurrences."
        },
        {
          "id": "exact",
          "name": "Optimiser",
          "tag": "exact",
          "rule": "A kill with no overkill writes double into the Table and gives 2 block.",
          "signature": "coin-change",
          "relic": "focus-exact",
          "plays_like": "Exact kills, never a point wasted.",
          "teaches": "Optimal substructure, knapsack and coin problems."
        }
      ]
    }
  ],
  // Cards any pack can offer beside the paradigm's own.
  "neutral": ["fork", "amplify", "kindle", "chill", "charge", "merge-sort", "round-robin", "ward", "salvo", "literal",
    "repeat", "reverse", "filter-weak", "reduce", "import-numpy", "generator", "higher-order", "import-operator",
    "fire-constant", "frost-constant", "spark-constant", "zip-ward", "bit-shift", "enumerate-bolts",
    "list-comprehension", "monte-carlo", "pop-bolt", "range-source", "read-input", "reservoir-sampling",
    "rotate-bolts", "slice-bolts", "sort-by-key", "swap-ends", "prefetch"],
  // Programming words for what a card does in the deck (ADR-0018), shown on the card with these meanings.
  "keywords": {
    "once": "Runs once a fight: after its program it leaves the deck until the next fight.",
    "volatile": "If it is still in your hand at the end of the turn, it is gone until the next fight.",
    "const": "Stays in your hand from turn to turn, without taking a hold slot.",
    "__init__": "Always in your opening hand.",
    "lambda": "Made by another card, for this fight only."
  },
  // Operations a foe waits before it acts: a program doing more work than this lands after the foe's move. Each intent
  // has its own speed (ADR-0017), listed here in the order of the foe's intents: a jab is quick, a slam slow. (A foe
  // of the program run's own, in programs/foes/, gives each intent its `tempo` there.)
  "tempo_default": 48,
  "tempo": {
    "race-condition-imp": [12, 20],
    "tally-wisp": [28, 20, 16],
    "dangling-pointer": [32, 16],
    "null-wraith": [36, 20, 28],
    "off-by-one-goblin": [24, 56],
    "memory-leak-ooze": [96, 64, 48],
    "type-mimic": [32, 56, 48],
    "segfault-specter": [64, 24],
    "stack-overflow-serpent": [48, 96, 40],
    "regex-sphinx": [112, 48, 64, 96],
    "garbage-collector": [64, 160, 80],
    "fork-bomb": [48, 160, 64],
    "kiln-warden": [200, 96, 128, 160, 80],
    "deadlock-golem": [128, 320, 192, 256, 128],
    "root-daemon": [192, 448, 256, 160, 512, 512]
  },
  // Foe HP for each layer of a program run, in place of the Shardrun's (1, 2.6, 6.8, which Spellforge keeps). Tuned
  // with the balance probe (ADR-0016): the smart bot wins about half its runs, and every paradigm a third or more.
  "foe_hp": [2.4, 3.6, 4.6, 5.4],
  // A program run's own encounters for a layer, in place of the Shardrun's. Each layer's guardian is drawn from a pool
  // of five by the run's seed (docs/NewEnemies.md, ADR-0026), and shown on the map from the start. The Heap's Deadlock
  // Golem comes as two locks (ADR-0017): a boss that tests a quality of the program (hitting two targets at once).
  "encounters": {
    "salvage": {
      "boss": [["kiln-warden"], ["ouroboros"], ["unhandled-exception"], ["short-circuit"], ["unreachable"]]
    },
    "heap": {
      "boss": [
        ["deadlock-lock-a", "deadlock-lock-b"],
        ["cache-lich"],
        ["malloc-matron"],
        ["page-fault-a", "page-fault-b", "page-fault-c"],
        ["thunk"]
      ]
    },
    "kernel": {
      "boss": [["root-daemon"], ["call-stack-colossus"], ["int-max"], ["profiler"], ["livelock-a", "livelock-b"]]
    }
  },
  // Preserve all four existing layer ids and encounters. Their presentation now descends through privilege rings.
  "layer_looks": {
    "kernel": {
      "name": "The Interrupt Foundry",
      "flavor": "Copper buses carry requests into the deep. Please hold: your interrupt is important to us.",
      "ring": 1,
      "backdrop": "arena-ring-1-interrupt-foundry",
      "boss_backdrop": "arena-ring-1-interrupt-foundry",
      "map_backdrop": "map-machine-shaft"
    }
  },
  // The existing fourth layer (id root) is Ring 0; its maps, foes, budget and difficulty stay as before.
  "layers": [
    {
      "id": "root",
      "name": "The Kernel / Root Sanctum",
      "flavor": "All roots lead here. Every process answers to one owner; permission denied is no longer a suggestion.",
      "backdrop": "arena-ring-0-kernel",
      "boss_backdrop": "arena-ring-0-kernel",
      "ring": 0,
      "map_backdrop": "map-machine-shaft",
      "ambience": "embers",
      "music": "music-kernel",
      "battle_music": "music-battle-kernel",
      "boss_music": "music-guardian-final",
      "rest_music": "music-rest",
      "rows": 11,
      "columns": 5,
      "paths": 6,
      "fixed_rows": { "0": "fight", "1": "fight", "4": "treasure", "8": "shop", "-1": "rest" },
      "weights": { "fight": 38, "elite": 20, "issue": 18, "rest": 10, "forge": 10, "shop": 4, "treasure": 0 },
      "elite_from_row": 2,
      "encounters": {
        "fight": [
          ["stack-overflow-serpent", "segfault-specter"],
          ["type-mimic", "race-condition-imp", "race-condition-imp"],
          ["garbage-collector"],
          ["regex-sphinx", "null-wraith"]
        ],
        "elite": [
          ["fork-bomb", "fork-bomb"],
          ["garbage-collector", "stack-overflow-serpent"]
        ],
        "boss": [["the-quine"], ["root-compiler"], ["mutator"], ["karp"], ["halting-oracle"]]
      }
    }
  ],
  // A pattern ward (the Regex Sphinx) lets a bolt of the wrong element through at half, not the quarter Spellforge
  // uses. At a quarter the Golem, before it became two locks, was a test of luck that ended a third of the probe's runs.
  "pattern_off": 0.5,
  // Relics are the program's own (programs/relics/), each of a tier from common (a nudge) to legendary (a new way to
  // play). Where a relic is found decides the tiers it can be: an elite offers only rare or better, a guardian only
  // epic or legendary. The numbers are relative weights; a tier left out never drops there.
  "relic_tiers": {
    "treasure": { "common": 45, "uncommon": 35, "rare": 15, "epic": 5 },
    "elite": { "rare": 70, "epic": 25, "legendary": 5 },
    "boss": { "epic": 65, "legendary": 35 }
  }
}
