{
  "id": "round-robin-plus",
  "name": "Round Robin+",
  "rarity": "common",
  "art": "round-robin",
  "cost": 0,
  "paradigm": "neutral",
  "role": "strike",
  "complexity": "linear",
  "summary": "Deals the bolts to the foes in turn, like cards, but skips a foe whose dealt bolts already cover its HP: nothing is wasted on the fallen.",
  "function": "round_robin_plus",
  "draftable": false,
  "examples": [
    {
      "name": "dealt out",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 5}, "foes": [{"name": "Tally Wisp", "hp": 16, "max": 16, "shield": 0, "weak": [], "resist": []}, {"name": "Imp", "hp": 5, "max": 14, "shield": 0, "weak": [], "resist": []}, {"name": "Golem", "hp": 40, "max": 40, "shield": 4, "weak": [], "resist": []}]},
      "expect": [
        { "power": 1, "element": "none", "foe": 0 },
        { "power": 2, "element": "none", "foe": 1 },
        { "power": 3, "element": "none", "foe": 2 },
        { "power": 4, "element": "none", "foe": 0 },
        { "power": 5, "element": "none", "foe": 1 }
      ]
    },
    {
      "name": "a foe covered is skipped",
      "bolts": [
        { "power": 12, "element": "none" },
        { "power": 9, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 5}, "foes": [{"name": "Tally Wisp", "hp": 16, "max": 16, "shield": 0, "weak": ["frost"], "resist": ["fire"]}, {"name": "Off-by-One Goblin", "hp": 9, "max": 22, "shield": 2, "weak": ["spark"], "resist": []}, {"name": "Golem", "hp": 30, "max": 40, "shield": 0, "weak": [], "resist": []}]},
      "expect": [
        { "power": 12, "element": "none", "foe": 0 },
        { "power": 9, "element": "none", "foe": 1 },
        { "power": 3, "element": "none", "foe": 2 },
        { "power": 4, "element": "none", "foe": 0 },
        { "power": 5, "element": "none", "foe": 1 },
        { "power": 6, "element": "none", "foe": 2 }
      ]
    }
  ]
}
