{
  "id": "exhaustive-kill-plus",
  "name": "Exhaustive Kill+",
  "rarity": "rare",
  "art": "exhaustive-kill",
  "cost": 2,
  "paradigm": "brute-force",
  "role": "strike",
  "complexity": "exponential",
  "cap_n": 12,
  "summary": "Tries every subset of the first 12 bolts to find the one that kills the front foe with the least overkill; those bolts hit it, the rest hit the weakest of the other foes.",
  "function": "exhaustive_kill_plus",
  "draftable": false,
  "examples": [
    {
      "name": "no overkill on the front foe",
      "bolts": [
        { "power": 7, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 9, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 5}, "foes": [{"name": "Tally Wisp", "hp": 16, "max": 16, "shield": 0, "weak": ["frost"], "resist": ["fire"]}, {"name": "Off-by-One Goblin", "hp": 9, "max": 22, "shield": 2, "weak": ["spark"], "resist": []}]},
      "expect": [
        { "power": 7, "element": "none", "foe": 0 },
        { "power": 5, "element": "none", "foe": 1 },
        { "power": 9, "element": "none", "foe": 0 },
        { "power": 3, "element": "none", "foe": 1 },
        { "power": 4, "element": "none", "foe": 1 }
      ]
    },
    {
      "name": "three foes",
      "bolts": [
        { "power": 9, "element": "none" },
        { "power": 8, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 2, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 5}, "foes": [{"name": "Tally Wisp", "hp": 16, "max": 16, "shield": 0, "weak": ["frost"], "resist": ["fire"]}, {"name": "Off-by-One Goblin", "hp": 9, "max": 22, "shield": 2, "weak": ["spark"], "resist": []}, {"name": "Golem", "hp": 30, "max": 40, "shield": 0, "weak": [], "resist": []}]},
      "expect": [
        { "power": 9, "element": "none", "foe": 0 },
        { "power": 8, "element": "none", "foe": 1 },
        { "power": 5, "element": "none", "foe": 0 },
        { "power": 4, "element": "none", "foe": 1 },
        { "power": 2, "element": "none", "foe": 0 }
      ]
    }
  ]
}
