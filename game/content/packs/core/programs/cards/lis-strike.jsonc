{
  "id": "lis-strike",
  "name": "LIS Strike",
  "rarity": "rare",
  "cost": 2,
  "paradigm": "dynamic",
  "role": "strike",
  "complexity": "quadratic",
  "big_o": "O(n²)",
  "summary": "Dynamic programming finds the longest sequence of bolts that keeps rising (not necessarily neighbours): it flies at the front foe, every bolt in it stronger by the sequence's length. Every other bolt becomes block.",
  "function": "lis_strike",
  "examples": [
    {
      "name": "a seed and a salvo",
      "bolts": [
        { "power": 3, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "expect": [
        { "power": 3, "element": "none", "block": true },
        { "power": 3, "element": "none", "block": true },
        { "power": 3, "element": "none", "block": true },
        { "power": 7, "element": "none", "foe": 0 },
        { "power": 8, "element": "none", "foe": 0 },
        { "power": 9, "element": "none", "foe": 0 },
        { "power": 10, "element": "none", "foe": 0 },
        { "power": 11, "element": "none", "foe": 0 },
        { "power": 12, "element": "none", "foe": 0 }
      ]
    }
  ]
}
