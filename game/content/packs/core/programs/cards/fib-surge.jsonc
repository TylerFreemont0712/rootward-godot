{
  "id": "fib-surge",
  "name": "Fibonacci Surge",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "dynamic",
  "role": "shape",
  "complexity": "exponential",
  "cap_n": 16,
  "summary": "Each bolt gains fib(i) power for its place i in the volley (up to fib(16)), computed by naive recursion: about 2ⁿ calls. A forge can optimise it.",
  "function": "fib_surge",
  "forge": {
    "into": "fib-memo",
    "verb": "optimize"
  },
