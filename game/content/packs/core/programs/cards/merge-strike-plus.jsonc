{
  "id": "merge-strike-plus",
  "name": "Merge Strike+",
  "rarity": "rare",
  "art": "merge-strike",
  "cost": 2,
  "paradigm": "divide-conquer",
  "role": "strike",
  "complexity": "linear",
  "summary": "Merges the bolts in pairs, then the pairs in pairs, until one is left. Every merge adds 30% (50% with import math). It flies at the toughest foe.",
  "function": "merge_strike_plus",
  "draftable": false,
  "examples": [
    {
      "name": "four bolts into one",
      "bolts": [
        { "power": 5, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 5, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 5}, "foes": [{"name": "Tally Wisp", "hp": 16, "max": 16, "shield": 0, "weak": [], "resist": []}, {"name": "Imp", "hp": 5, "max": 14, "shield": 0, "weak": [], "resist": []}, {"name": "Golem", "hp": 40, "max": 40, "shield": 4, "weak": [], "resist": []}]},
      "expect": [
        { "power": 33, "element": "none", "foe": 2 }
      ]
    },
    {
      "name": "with import math",
      "bolts": [
        { "power": 5, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 5, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 6}, "foes": [{"name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": []}], "imports": ["math"]},
      "expect": [
        { "power": 45, "element": "none", "foe": 0 }
      ]
    }
  ]
}
