{
  "id": "spark-constant",
  "name": "Spark Constant",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "neutral",
  "role": "source",
  "complexity": "constant",
  "art": "spark-constant",
  "summary": "Appends one 6-power spark bolt. const: stays in your hand until played, without using a hold slot.",
  "function": "spark_constant",
  "keywords": [
    "const"
  ],
  "forge": {
    "into": "spark-constant-plus",
    "verb": "upgrade"
  },
  "examples": [
    {
      "name": "an elemental seed",
      "bolts": [
        {
          "power": 3,
          "element": "none"
        }
      ],
      "expect": [
        {
          "power": 3,
          "element": "none"
        },
        {
          "power": 6,
          "element": "spark"
        }
      ]
    },
    {
      "name": "from an empty volley",
      "bolts": [],
      "expect": [
        {
          "power": 6,
          "element": "spark"
        }
      ]
    }
  ]
}
