{
  "id": "fire-constant-plus",
  "name": "Ember Constant+",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "neutral",
  "role": "source",
  "complexity": "constant",
  "art": "fire-constant",
  "summary": "Appends one 9-power fire bolt. const: stays in your hand until played, without using a hold slot.",
  "function": "fire_constant_plus",
  "keywords": [
    "const"
  ],
  "draftable": false,
  "examples": [
    {
      "name": "an elemental seed",
      "bolts": [
        {
          "power": 3,
          "element": "none"
        }
      ],
      "expect": [
        {
          "power": 3,
          "element": "none"
        },
        {
          "power": 9,
          "element": "fire"
        }
      ]
    },
    {
      "name": "from an empty volley",
      "bolts": [],
      "expect": [
        {
          "power": 9,
          "element": "fire"
        }
      ]
    }
  ]
}
