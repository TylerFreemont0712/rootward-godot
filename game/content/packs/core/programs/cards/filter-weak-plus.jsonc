{
  "id": "filter-weak-plus",
  "name": "Filter+",
  "rarity": "common",
  "art": "filter-weak",
  "cost": 0,
  "paradigm": "neutral",
  "role": "shape",
  "complexity": "linear",
  "summary": "Drops every bolt under 3 power; the strongest bolt that stays absorbs each dropped one, 1 stronger for every bolt it swallows.",
  "function": "filter_weak_plus",
  "draftable": false,
  "examples": [
    {
      "name": "a salvo, filtered",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "expect": [
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 11, "element": "none" }
      ]
    },
    {
      "name": "nothing would stay",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" }
      ],
      "expect": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" }
      ]
    }
  ]
}
