        },
        {
          "power": 2,
          "element": "none"
        },
        {
          "power": 6,
          "element": "fire"
        }
      ],
      "expect": [
        {
          "power": 9,
          "element": "fire"
        },
        {
          "power": 10,
          "element": "fire"
        },
        {
          "power": 12,
          "element": "fire"
        }
      ]
    }
  ]
