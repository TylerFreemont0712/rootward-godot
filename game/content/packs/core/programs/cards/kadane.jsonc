{
  "id": "kadane",
  "name": "Kadane",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "dynamic",
  "role": "shape",
  "complexity": "linear",
  "summary": "Kadane's algorithm scores each bolt as its power minus 3 and keeps a running best: the stretch of neighbouring bolts with the highest score fuses into one bolt of its whole power, 1 stronger for every bolt in it.",
  "function": "kadane",
  "forge": {"into": "kadane-plus", "verb": "upgrade"},
  "examples": [
    {
      "name": "the strong end of a salvo",
      "bolts": [
        { "power": 3, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "expect": [
        { "power": 3, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 18, "element": "none" }
      ]
    },
    {
      "name": "a gap breaks the run",
      "bolts": [
        { "power": 9, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 8, "element": "none" },
        { "power": 7, "element": "fire" }
      ],
      "expect": [
        { "power": 9, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 1, "element": "none" },
        { "power": 17, "element": "none" }
      ]
    }
  ]
}
