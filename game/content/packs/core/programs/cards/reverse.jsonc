{
  "id": "reverse",
  "name": "Reverse",
  "rarity": "common",
  "cost": 0,
  "paradigm": "neutral",
  "role": "order",
  "complexity": "linear",
  "makes": "unsorted",
  "summary": "Turns the volley around, the last bolt first. A sorted volley comes out strongest first.",
  "function": "reverse",
  "examples": [
    {
      "name": "strongest first",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "spark" }
      ],
      "expect": [
        { "power": 4, "element": "spark" },
        { "power": 3, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 1, "element": "none" }
      ]
    }
  ]
}
