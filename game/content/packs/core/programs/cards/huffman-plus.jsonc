{
  "id": "huffman-plus",
  "name": "Huffman+",
  "rarity": "uncommon",
  "art": "huffman",
  "cost": 1,
  "paradigm": "greedy",
  "role": "shape",
  "complexity": "linearithmic",
  "big_o": "O(n log n)",
  "makes": "sorted",
  "summary": "A min-heap: take the two weakest bolts, fuse them into one 2 stronger than both together, and repeat until three are left.",
  "function": "huffman_plus",
  "draftable": false,
  "examples": [
    {
      "name": "a salvo into three",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "expect": [
        { "power": 6, "element": "none" },
        { "power": 9, "element": "none" },
        { "power": 12, "element": "none" }
      ]
    },
    {
      "name": "three stay three",
      "bolts": [
        { "power": 5, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 8, "element": "none" }
      ],
      "expect": [
        { "power": 2, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 8, "element": "none" }
      ]
    }
  ]
}
