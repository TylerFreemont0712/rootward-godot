  "examples": [
    {
      "name": "three bolts, three pairs",
      "bolts": [
        { "power": 4, "element": "fire" },
        { "power": 2, "element": "none" },
        { "power": 6, "element": "fire" }
      ],
      "expect": [
        { "power": 12, "element": "fire" },
        { "power": 10, "element": "fire" },
        { "power": 16, "element": "fire" }
      ]
    }
  ]
}
