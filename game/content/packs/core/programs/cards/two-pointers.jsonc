{
  "id": "two-pointers",
  "name": "Two Pointers",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "search-index",
  "role": "shape",
  "complexity": "linear",
  "needs": "sorted",
  "makes": "unsorted",
  "summary": "On a sorted volley, one pointer at each end: the weakest and the strongest bolt fuse, then the next pair inward. Half as many bolts, all of about the same power.",
  "function": "two_pointers",
  "examples": [
    {
      "name": "a sorted salvo",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "expect": [
        { "power": 7, "element": "none" },
        { "power": 7, "element": "none" },
        { "power": 7, "element": "none" }
      ]
    },
    {
      "name": "an odd one in the middle",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 10, "element": "none" }
      ],
      "expect": [
        { "power": 11, "element": "none" },
        { "power": 2, "element": "none" }
      ]
    }
  ]
}
