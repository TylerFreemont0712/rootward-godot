  "role": "source",
  "complexity": "constant",
  "summary": "Appends one 12-power bolt: a constant written into the code, added in O(1).",
  "function": "literal_plus",
  "keywords": ["const"],
  "draftable": false,
  "examples": [
    {
      "name": "after the seed",
