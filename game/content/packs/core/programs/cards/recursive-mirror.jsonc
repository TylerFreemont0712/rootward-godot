{
  "id": "recursive-mirror",
  "icon": "shardrun/shard-echo",
  "name": "Recursive Mirror",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "divide-conquer",
  "role": "source",
  "complexity": "linear",
  "summary": "Append a reversed copy of the volley at half power, rounded up. Recursion visits each bolt once; elements, targets and guards are copied.",
  "function": "recursive_mirror",
  "makes": "unsorted",
  "forge": {
    "into": "recursive-mirror-plus",
    "verb": "upgrade"
  },
  "examples": [
    {
      "name": "the reflection reverses",
      "bolts": [
        {
          "power": 3,
          "element": "fire"
        },
        {
          "power": 6,
          "element": "frost",
          "block": true
        }
      ],
      "expect": [
        {
          "power": 3,
          "element": "fire"
        },
        {
          "power": 6,
          "element": "frost",
          "block": true
        },
        {
          "power": 3,
          "element": "frost",
          "block": true
        },
        {
          "power": 2,
          "element": "fire"
        }
      ]
    },
    {
      "name": "empty input",
      "bolts": [],
      "expect": []
    }
  ]
}
