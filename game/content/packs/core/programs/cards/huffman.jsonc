{
  "id": "huffman",
  "name": "Huffman",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "greedy",
  "role": "shape",
  "complexity": "linearithmic",
  "big_o": "O(n log n)",
  "makes": "sorted",
  "summary": "A min-heap: take the two weakest bolts, fuse them into one 1 stronger than both together, push it back, until three bolts remain. Huffman's greedy step; they come out weakest first.",
  "function": "huffman",
  "forge": {"into": "huffman-plus", "verb": "upgrade"},
  "examples": [
    {
      "name": "a salvo into three",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "expect": [
        { "power": 6, "element": "none" },
        { "power": 8, "element": "none" },
        { "power": 10, "element": "none" }
      ]
    },
    {
      "name": "three stay three",
      "bolts": [
        { "power": 5, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 8, "element": "none" }
      ],
      "expect": [
        { "power": 2, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 8, "element": "none" }
      ]
    }
  ]
}
