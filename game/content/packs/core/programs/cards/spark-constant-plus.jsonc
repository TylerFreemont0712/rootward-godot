{
  "id": "spark-constant-plus",
  "icon": "shardrun/shard-arc",
  "name": "Spark Constant+",
  "rarity": "uncommon",
  "cost": 1,
  "paradigm": "neutral",
  "role": "source",
  "complexity": "constant",
  "summary": "Appends one 9-power spark bolt. const: stays in your hand until played, without using a hold slot.",
  "function": "spark_constant_plus",
  "keywords": [
    "const"
  ],
  "draftable": false,
  "examples": [
    {
      "name": "an elemental seed",
      "bolts": [
        {
          "power": 3,
          "element": "none"
        }
      ],
      "expect": [
        {
          "power": 3,
          "element": "none"
        },
        {
          "power": 9,
          "element": "spark"
        }
      ]
    },
    {
      "name": "from an empty volley",
      "bolts": [],
      "expect": [
        {
          "power": 9,
          "element": "spark"
        }
      ]
    }
  ]
}
