  "role": "shape",
  "complexity": "linear",
  "needs": "sorted",
  "makes": "unsorted",
  "summary": "On a sorted volley, one pointer at each end: the weakest and the strongest bolt fuse, 1 stronger, then the next pair in, until the pointers meet. Balanced bolts.",
  "function": "two_pointers_plus",
  "draftable": false,
  "examples": [
    {
      "name": "a sorted salvo",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 3, "element": "none" },
        { "power": 4, "element": "none" },
        { "power": 5, "element": "none" },
        { "power": 6, "element": "none" }
      ],
      "expect": [
        { "power": 8, "element": "none" },
        { "power": 8, "element": "none" },
        { "power": 8, "element": "none" }
      ]
    },
    {
      "name": "an odd one in the middle",
      "bolts": [
        { "power": 1, "element": "none" },
        { "power": 2, "element": "none" },
        { "power": 10, "element": "none" }
      ],
      "expect": [
        { "power": 12, "element": "none" },
        { "power": 2, "element": "none" }
      ]
    }
  ]
}
