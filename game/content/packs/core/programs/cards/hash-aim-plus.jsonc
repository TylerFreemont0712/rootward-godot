{
  "id": "hash-aim-plus",
  "name": "Hash Aim+",
  "rarity": "uncommon",
  "art": "hash-aim",
  "cost": 1,
  "paradigm": "search-index",
  "role": "strike",
  "complexity": "linear",
  "big_o": "O(n + m)",
  "summary": "One pass over the foes builds a map from each element to the first foe weak to it; every bolt flies at the foe weak to its element, or else at the weakest foe.",
  "function": "hash_aim_plus",
  "draftable": false,
  "examples": [
    {
      "name": "each to its weakness",
      "bolts": [
        { "power": 4, "element": "frost" },
        { "power": 5, "element": "spark" },
        { "power": 6, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 5}, "foes": [{"name": "Tally Wisp", "hp": 16, "max": 16, "shield": 0, "weak": ["frost"], "resist": ["fire"]}, {"name": "Off-by-One Goblin", "hp": 9, "max": 22, "shield": 2, "weak": ["spark"], "resist": []}]},
      "expect": [
        { "power": 4, "element": "frost", "foe": 0 },
        { "power": 5, "element": "spark", "foe": 1 },
        { "power": 6, "element": "none", "foe": 1 }
      ]
    },
    {
      "name": "no weakness to aim at",
      "bolts": [
        { "power": 4, "element": "fire" },
        { "power": 6, "element": "none" }
      ],
      "battle": {"turn": 1, "me": {"hp": 30, "max": 30, "block": 0, "mana": 5}, "foes": [{"name": "Tally Wisp", "hp": 16, "max": 16, "shield": 0, "weak": ["frost"], "resist": ["fire"]}, {"name": "Off-by-One Goblin", "hp": 9, "max": 22, "shield": 2, "weak": ["spark"], "resist": []}, {"name": "Golem", "hp": 30, "max": 40, "shield": 0, "weak": [], "resist": []}]},
      "expect": [
        { "power": 4, "element": "fire", "foe": 1 },
        { "power": 6, "element": "none", "foe": 1 }
      ]
    }
  ]
}
