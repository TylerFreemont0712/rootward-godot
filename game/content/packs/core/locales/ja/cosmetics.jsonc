// The cosmetic looks (content/cosmetics.jsonc, ADR-0037), keyed by the English name or note.
[
  {"en": "Script Loom", "to": "コードの織り陣"},
  {"en": "A bright writing tip stitches one section of the seal during each function. Wear for both light and heavy casts to weave every spell.", "to": "関数ごとに、光の筆先が魔法陣の一部を縫うように描く。すべての呪文に使うには、軽い詠唱と重い詠唱の両方に着せてね。"},
  {"en": "Shard Weave", "to": "シャードの織り陣"},
  {"en": "Every function weaves a new layer into the circle while its code runs: pen-stroke rings, a ruled star, and the spell's own function names as runes.", "to": "コードを実行しながら、関数ごとに新しい層が魔法陣に織りこまれる。筆で描いたような輪、定規で引いた星、呪文の関数名のルーン。"},
  {"en": "A bright writing tip stitches one section of the seal during each function, round a single clasp.", "to": "関数ごとに、光の筆先が魔法陣の一部を縫うように描き、中心の留め具をかこむ。"},
  {"en": "Ring Bloom", "to": "リングブルーム"},
  {"en": "The first shard sets a core, and every shard after it sets another whole ring round the others, up to six. Each turns a little as it settles.", "to": "最初のシャードが核をすえ、次のシャードごとに輪がひとつ外側にそっくりあらわれる。六つまで。輪はおさまる時に少しだけ回る。"},
  {"en": "Guarded Breath", "to": "かまえの呼吸"},
  {"en": "Weight on the back foot, hands loose, eyes on the foes.", "to": "うしろ足に体重をのせ、手はゆったり。目は敵からはなさない。"},
  {"en": "Lantern Bearer", "to": "あかりを持つ者"},
  {"en": "One hand held up and open, cupping a light for the dark of the roots.", "to": "片手をひらいて高くかかげ、根っこの暗やみを照らすあかりを包む。"},
  {"en": "Finger Snap", "to": "フィンガースナップ"},
  {"en": "A snap beside the face, and the circle is simply there.", "to": "顔の横でパチン。それだけで魔法陣があらわれる。"},
  {"en": "Rune Trace", "to": "ルーンなぞり"},
  {"en": "One finger writes a quick stroke in the air; the circle closes on its last line.", "to": "指一本で空中にすばやく一筆。さいごの線で魔法陣がとじる。"},
  {"en": "Grand Push", "to": "グランドプッシュ"},
  {"en": "Both hands gather the power at the chest, then drive it through the circle.", "to": "両手で胸に力をあつめ、魔法陣ごしに押しだす。"},
  {"en": "Skyward Call", "to": "天への呼び声"},
  {"en": "An arm raised to the ceiling calls the spell down from above.", "to": "天井へ腕をかかげ、呪文を上からよびおろす。"},
  {"en": "Root Seal", "to": "根の封印"},
  {"en": "Down on one knee, a palm pressed to the floor wakes what grows under it.", "to": "片ひざをつき、床に手のひらを当てて、その下で育つものをめざめさせる。"},
  {"en": "Codex Circle", "to": "コーデックスの魔法陣"},
  {"en": "Pen-stroke rings, a ruled star and the spell's own function names as runes.", "to": "ペンで書いたような輪、定規で引いた星、そして呪文の関数名がルーンになる。"},
  {"en": "Rootglass Wreath", "to": "根硝子のリース"},
  {"en": "A ring that grows like a vine, budding leaves, with branches for a star.", "to": "つるのようにのびる輪に葉が芽ぶき、星のかわりに枝がひろがる。"},
  {"en": "Clockwork Gear", "to": "からくり歯車"},
  {"en": "Toothed rings that turn against each other, ticking like a timer.", "to": "歯のある輪がたがいに逆に回り、タイマーのようにカチカチ進む。"},
  {"en": "Constellation", "to": "星座"},
  {"en": "Stars pricked in the air and joined one line at a time, as Vesper writes.", "to": "空中に星をうち、ヴェスパーが書くように一本ずつ線でつなぐ。"},
  {"en": "Arcane Lance", "to": "アルカナランス"},
  {"en": "Lances of light that curve to their mark; a strong one flies as an orb.", "to": "光の槍が弧をえがいて的へ。強い一撃は光の球になって飛ぶ。"},
  {"en": "Power Orb", "to": "パワーオーブ"},
  {"en": "Every bolt a pulsing orb with runes in orbit.", "to": "どの一撃も、ルーンがまわりをまわる脈うつ光の球。"},
  {"en": "Glyph Swarm", "to": "グリフの群れ"},
  {"en": "Runes that corkscrew to their target, shedding letters as they go.", "to": "ルーンがらせんをえがいて的へ。とちゅうで文字をこぼしていく。"},
  {"en": "Rootglass Thorn", "to": "根硝子のトゲ"},
  {"en": "A glass thorn shot straight and fast, sap-light streaming behind it.", "to": "ガラスのトゲがまっすぐ速く飛び、うしろに樹液の光がながれる。"},
  {"en": "Falling Code", "to": "落ちてくるコード"},
  {"en": "Blocks of code drawn in the air above the foe, then dropped on it.", "to": "敵の上の空中にコードのブロックをえがき、そのまま落とす。"},
  {"en": "Starfall", "to": "スターフォール"},
  {"en": "A star streaks down at a slant and bursts on the foe.", "to": "星がななめにかけおりて、敵の上ではじける。"},
  {"en": "Root Eruption", "to": "根の噴出"},
  {"en": "The floor splits in a ring and roots spear up through the foe.", "to": "床が輪のようにさけ、根がやりのように敵をつきあげる。"},
  {"en": "Judgment Pillar", "to": "審判の光柱"},
  {"en": "A column of light slams down on the foe, runes racing round its foot.", "to": "光の柱が敵にたたきつけられ、その足もとをルーンがかけまわる。"}
]
