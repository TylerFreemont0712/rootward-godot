  {"en": "A lockbox with a four-digit lock.", "to": "4けたの あんごうが ついた、かぎの はこ。", "kanji": "4桁の暗証番号で開く箱。"},
  {"en": "Brisk's drill board.", "to": "ブリスクの ドリルの かんばん。", "kanji": "ブリスクのドリルの看板。"},
  {"en": "Pip's tally board. It counts lanterns.", "to": "ピップの かぞえ かんばん。ランタンを かぞえるよ。", "kanji": "ピップの集計板。ランタンを数えるよ。"},
  {"en": "Your options", "to": "オプション", "kanji": "オプション"},
  {"en": "A gift: %s! But we have no bag to put it in yet.", "to": "おくりもの：%s！ でも、まだ いれる かばんが ないよ。", "kanji": "贈り物：%s！でも、まだ入れる鞄がないよ。"},
  {"en": "A lockbox with a four-digit lock. Nix knows its secret.", "to": "4けたの あんごうが ついた、かぎの はこ。ニックスが あんごうを しって いるよ。", "kanji": "4桁の暗証番号で開く箱。ニックスがその秘密を知っている。"},
  {"en": "Bought %s for %d coins.", "to": "%s を %d コインで かったよ。", "kanji": "%sを%dコインで購入しました。"},
  {"en": "Drill 1, double:", "to": "ドリル 1、にばい：", "kanji": "ドリル 1、二倍："},
  {"en": "Drill 2, total:", "to": "ドリル 2、ぜんぶで：", "kanji": "ドリル 2、全部で："},
  {"en": "Drill 3, first:", "to": "ドリル 3、さいしょ：", "kanji": "ドリル 3、最初："},
  {"en": "Pip's board is blank. Its count needs fixing.", "to": "ピップの かんばんは まっしろだよ。かぞえ方を なおして あげてね。", "kanji": "ピップの看板は真っ白だよ。かぞえ方を直してあげてね。"},
  {"en": "Pip's board says: %d lanterns lit.", "to": "ピップの かんばんには、ともって いる ランタンが %d こ と かいて あるよ。", "kanji": "ピップの看板には、灯っているランタンが %d 個と書いてあるよ。"},
  {"en": "Sold %d × %s for %d coins.", "to": "%d こ の %s を うって、%d コイン もらったよ。", "kanji": "%d 個の %s を売って、%d コインもらったよ。"},
  {"en": "The lockbox is open. Its key is yours now.", "to": "かぎの はこは あいたよ。その キーは、もう きみの ものだよ。", "kanji": "鍵の箱は開いたよ。そのキーは、もう君のものだよ。"},
  {"en": "Your can_buy() isn't ready yet. Nym can help.", "to": "きみの can_buy() は まだ じゅんびが できて いないよ。ニムが てつだって くれるよ。", "kanji": "君の can_buy() はまだ準備ができていないよ。ニムが手伝ってくれるよ。"},
  {"en": "Your can_buy() said yes, but Nym counts %d coins, and it costs %d.", "to": "きみの can_buy() は「はい」と いったけど、ニムが かぞえると コインは %d、ねだんは %d だよ。", "kanji": "can_buy() は購入可能と判定しましたが、所持金は%dコイン、価格は%dコインです。"},
  {"en": "Your can_buy() says no: %d coins, and it costs %d.", "to": "きみの can_buy() は「いいえ」と いって いるよ。コインは %d、ねだんは %d だよ。", "kanji": "can_buy() は購入不可と判定しました。所持金は%dコイン、価格は%dコインです。"},
  {"en": "Your lock holds. Nix has the code to open it.", "to": "きみの かぎは もちこたえて いるよ。ニックスが あける あんごうを もって いるよ。", "kanji": "鍵は正常に機能しています。開けるための暗証番号はニックスが持っています。"},
  {"en": "Your price() can't price that yet.", "to": "きみの price() は、まだ その ねだんを きめられないよ。", "kanji": "君の price() は、まだその値段をきめられないよ。"},
  {"en": "Your weather() never says rain, so the grove waits.", "to": "きみの weather() は いちども あめと いわないから、もりは まって いるよ。", "kanji": "君の weather() は一度も雨と言わないから、森は待っているよ。"},
  {"en": "Zzz... Day %d. Listen: rain!", "to": "zzz… %d にちめ。きいて、あめだよ！", "kanji": "zzz… %d 日目。聞いて、雨だよ！"},
  {"en": "afternoon", "to": "ひる", "kanji": "昼"},
  {"en": "caught!", "to": "つかまえた！", "kanji": "捕まえた！"},
  {"en": "evening", "to": "ゆうがた", "kanji": "夕方"},
  {"en": "morning", "to": "あさ", "kanji": "朝"},
  {"en": "night", "to": "よる", "kanji": "夜"},
  {"en": "not yet", "to": "まだ", "kanji": "まだ"},
  {"en": "Your bag can't tidy itself yet. Mira can help.", "to": "きみの かばんは、まだ じぶんで かたづけられないよ。ミラが てつだって くれるよ。", "kanji": "君の鞄は、まだ自分でかたづけられないよ。ミラが手伝ってくれるよ。"},
  {"en": "Your can_buy() didn't answer true or false, so Nym can't sell yet.", "to": "きみの can_buy() は true か false で こたえなかったから、ニムは まだ うれないよ。", "kanji": "君の can_buy() は true か false で答えなかったから、ニムはまだうれないよ。"},
  {"en": "Your count() gave %s, but there are only %d lanterns.", "to": "きみの count() は %s を かえしたけど、ランタンは %d こ しか ないよ。", "kanji": "君の count() は %s を返したけど、ランタンは %d 個しかないよ。"},
  {"en": "Your count() tripped: %s", "to": "きみの count() が つまずいたよ：%s", "kanji": "君の count() がつまずいたよ：%s"},
  {"en": "Your price() didn't give a whole number of coins, so Nym can't pay that.", "to": "きみの price() は、コインの せいすうを かえして くれなかったから、ニムは はらえないよ。", "kanji": "君の price() は、コインの整数を返してくれなかったから、ニムは払えないよ。"},
  {"en": "Your tidy() lost or changed something, so the bag stays as it was.", "to": "きみの tidy() が なにかを なくしたり かえたり したから、かばんは まえの まま だよ。", "kanji": "君の tidy() が何かを失くしたりかえたりしたから、鞄は前のままだよ。"},
  {"en": "Your tidy() tripped: %s", "to": "きみの tidy() が つまずいたよ：%s", "kanji": "君の tidy() がつまずいたよ：%s"},
  {"en": "Your total() didn't give a whole number.", "to": "きみの total() は、せいすうを かえして くれなかったよ。", "kanji": "君の total() は、整数を返してくれなかったよ。"},
