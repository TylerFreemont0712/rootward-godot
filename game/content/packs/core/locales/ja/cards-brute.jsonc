[
  {"en": "Combinations", "to": "組み合わせ（くみあわせ）"},
  {"en": "Combinations+", "to": "組み合わせ（くみあわせ）+"},
  {"en": "Every 3-bolt combination of the first seven bolts becomes one bolt of half their sum (35 from seven). Fewer than three bolts pass through.", "to": "最初の7本から3本を選ぶすべての組み合わせが、合計の半分の威力のボルト1本になる（7本なら35本）。3本に満たないときはそのまま通す。"},
  {"en": "Every 3-bolt combination of the first seven bolts becomes one bolt of half their sum plus 1 (35 from seven). Fewer than three bolts pass through.", "to": "最初の7本から3本を選ぶすべての組み合わせが、合計の半分に1を足した威力のボルト1本になる（7本なら35本）。3本に満たないときはそのまま通す。"},
  {"en": "Permutations", "to": "順列（じゅんれつ）"},
  {"en": "Permutations+", "to": "順列（じゅんれつ）+"},
  {"en": "Tries every order of up to six bolts, dealt round robin over the foes, and keeps the order that kills the most foes (6! = 720 orders).", "to": "最大6本のボルトのすべての並び順を、敵に順番に配って試し、倒せる敵がいちばん多い並びを選ぶ（6! = 720通り）。"},
  {"en": "Tries every order of up to six bolts, dealt round robin over the foes, and keeps the order that kills the most foes. Ties go to the least overkill.", "to": "最大6本のボルトのすべての並び順を、敵に順番に配って試し、倒せる敵がいちばん多い並びを選ぶ。同じ数なら、与えすぎがいちばん少ない並びを選ぶ。"},
  {"en": "Grid Search", "to": "グリッドサーチ"},
  {"en": "Grid Search+", "to": "グリッドサーチ+"},
  {"en": "Every cell (i, j) of a 4×4 grid becomes a bolt of power i·j // 2 + 1: sixteen bolts after your volley. A lot of work, as when tuning a model.", "to": "4×4のマスの各 (i, j) が、威力 i·j // 2 + 1 のボルトになり、16本がボルトの後ろに加わる。モデルの調整のように、仕事量が多い。"},
  {"en": "Every cell (i, j) of a 5×5 grid becomes a bolt of power i·j // 2 + 1: twenty-five bolts after your volley. A lot of work, as when tuning a model.", "to": "5×5のマスの各 (i, j) が、威力 i·j // 2 + 1 のボルトになり、25本がボルトの後ろに加わる。モデルの調整のように、仕事量が多い。"},
  {"en": "N-Queens", "to": "Nクイーン"},
  {"en": "N-Queens+", "to": "Nクイーン+"},
  {"en": "Places six queens on a 6×6 board by backtracking, a row at a time. Each of the 4 solutions adds a 7-power bolt after your volley.", "to": "6×6の盤にクイーンを6つ、1行ずつバックトラッキングで置く。4つの解それぞれが、威力7のボルトとして後ろに加わる。"},
  {"en": "Places eight queens on an 8×8 board by backtracking, a row at a time. Each of the 92 solutions adds a 2-power bolt after your volley: a flood, and slow.", "to": "8×8の盤にクイーンを8つ、1行ずつバックトラッキングで置く。92個の解それぞれが、威力2のボルトとして後ろに加わる。洪水のように多く、遅い。"},
  {"en": "Branch and Bound", "to": "分枝限定法（ぶんしげんていほう）"},
  {"en": "Branch and Bound+", "to": "分枝限定法（ぶんしげんていほう）+"},
  {"en": "Finds the subset of the first ten bolts that blocks the damage the foes intend with the least to spare, cutting any branch that cannot reach it or beat the best; if the ten cannot reach it, all ten guard. Exhaustive Ward's search, pruned to the damage coming rather than a fixed 12.", "to": "最初の10本の矢の部分集合の中から、敵が与えようとするダメージを、余りが最も少なく防げるものを探します。届かない枝や、いまの最良を超えられない枝は切り捨てます。10本でも届かなければ、10本すべてが守ります。Exhaustive Wardの探索を、来るダメージに合わせて切り詰めたものです。"},
  {"en": "Finds the subset of the first twelve bolts that blocks the damage the foes intend with the least to spare, cutting any branch that cannot reach it or beat the best; if the twelve cannot reach it, all twelve guard. Exhaustive Ward's search, pruned to the damage coming rather than a fixed 16.", "to": "最初の12本の矢の部分集合の中から、敵が与えようとするダメージを、余りが最も少なく防げるものを探します。届かない枝や、いまの最良を超えられない枝は切り捨てます。12本でも届かなければ、12本すべてが守ります。Exhaustive Wardの探索を、来るダメージに合わせて切り詰めたものです。"},
  {"en": "Meet in the Middle", "to": "中間一致（ちゅうかんいっち）"},
  {"en": "Meet in the Middle+", "to": "中間一致（ちゅうかんいっち）+"},
  {"en": "Exhaustive Kill's question for the first 12 bolts, answered from both ends: list the sums of each half, sort one, binary-search it for the other. The same kill, with the square root of the work.", "to": "「総当たりの一撃」の問いを、最初の12本について両端から解く。半分ずつの合計を並べ、片方を整列して二分探索する。同じ答えを、平方根の仕事量で出す。"},
  {"en": "Exhaustive Kill's question for the first 16 bolts, answered from both ends: list the sums of each half, sort one, binary-search it for the other. The same kill, with the square root of the work.", "to": "「総当たりの一撃」の問いを、最初の16本について両端から解く。半分ずつの合計を並べ、片方を整列して二分探索する。同じ答えを、平方根の仕事量で出す。"},
  {"en": "Bogosort", "to": "ボゴソート"},
  {"en": "Bogosort+", "to": "ボゴソート+"},
  {"en": "Shuffles the first six bolts, seeded by the turn and the bolts, until they are in order or 120 shuffles have passed, then keeps the best try. Absurd work. volatile: gone if not played.", "to": "最初の6本を、ターンとボルトから決まる乱数でシャッフルし、順番どおりになるか120回に届くまで続けて、いちばん良かった並びを残す。とてつもない仕事量。volatile：使わないと消える。"},
  {"en": "Shuffles the first seven bolts, seeded by the turn and the bolts, until they are in order or 120 shuffles have passed, then keeps the best try. Absurd work. volatile: gone if not played.", "to": "最初の7本を、ターンとボルトから決まる乱数でシャッフルし、順番どおりになるか120回に届くまで続けて、いちばん良かった並びを残す。とてつもない仕事量。volatile：使わないと消える。"},
  {"en": "Selection Sort", "to": "選択ソート（せんたくソート）"},
  {"en": "Selection Sort+", "to": "選択ソート（せんたくソート）+"},
  {"en": "Finds the weakest bolt of the rest and swaps it to the front, again and again: always n² comparisons, even on a sorted volley. Weakest first.", "to": "残りのなかでいちばん弱いボルトを見つけて先頭と入れかえる、をくり返す。整列ずみでも、いつも n² 回の比較をする。弱い順。"},
  {"en": "Finds the strongest bolt of the rest and swaps it to the front, again and again: always n² comparisons, even on a sorted volley. Strongest first.", "to": "残りのなかでいちばん強いボルトを見つけて先頭と入れかえる、をくり返す。整列ずみでも、いつも n² 回の比較をする。強い順。"},
  {"en": "All-Pairs Rank", "to": "総当たりランク（そうあたりランク）"},
  {"en": "All-Pairs Rank+", "to": "総当たりランク（そうあたりランク）+"},
  {"en": "Compares every bolt with every other: each gains 1 power for every bolt weaker than it. The same ranking can be had in O(n log n).", "to": "すべてのボルトを、ほかのすべてのボルトと比べる。自分より弱いボルト1本につき、威力が1上がる。同じ順位づけは O(n log n) でもできる。"},
  {"en": "Compares every bolt with every other: each gains 1 power for every bolt weaker than it, and the strongest gains 2 more. The same ranking can be had in O(n log n).", "to": "すべてのボルトを、ほかのすべてのボルトと比べる。自分より弱いボルト1本につき威力が1上がり、いちばん強いボルトはさらに2上がる。同じ順位づけは O(n log n) でもできる。"}
]
