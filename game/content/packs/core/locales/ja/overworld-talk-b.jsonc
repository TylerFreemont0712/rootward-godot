// Japanese for Lanternroot's quests and for the talk of the noticeboard, Lumen, Pell, Pip, Nym, Seren and the
// Warden (Concept/v0.4/06), keyed by the English exactly (ADR-0047). Code (add, shortcut, light_all, x, y, B, Esc,
// night, morning, afternoon, evening, true) stays as it is.
[
  // quests.jsonc: the titles, summaries, steps and hints of Lanternroot's quests.
  {"en": "A bag of your own", "to": "じぶんの かばん", "kanji": "自分の鞄"},
  {"en": "A key for every door", "to": "どの とびらにも キーを", "kanji": "どの扉にもキーを"},
  {"en": "A key goes in. The name of a door comes out.", "to": "キーを いれると、とびらの なまえが でて くるよ。", "kanji": "キーを入れると、扉の名前が出てくるよ。"},
  {"en": "A pad can push a slider past 0 and past 10.", "to": "パッドは、スライダーを 0 の むこうや 10 の むこうまで おせるよ。", "kanji": "パッドは、スライダーを 0 のむこうや 10 の向こうまで押せるよ。"},
  {"en": "A pile with nothing left should go away.", "to": "なにも のこって いない 山は、きえる ように しよう。", "kanji": "何も残っていない山は、消えるようにしよう。"},
  {"en": "A place is a box. Is the cell inside it?", "to": "ばしょは はこだよ。マスは、その なかに あるかな？", "kanji": "場所は箱だよ。マスは、その中にあるかな？"},
  {"en": "A whole day takes only a few minutes.", "to": "いちにちは、ほんの すうふんで おわるよ。", "kanji": "一日は、ほんの数分で終わるよ。"},
  {"en": "After the last song, go back to the first.", "to": "さいごの きょくの あとは、さいしょの きょくに もどるよ。", "kanji": "最後の曲の後は、最初の曲に戻るよ。"},
  {"en": "Ask Lumen about the dark lane.", "to": "ルーメンに、くらい ランタンの みちの ことを きこう。", "kanji": "ルーメンに、暗いランタンの道のことを聞こう。"},
  {"en": "Ask Lumen about the evening.", "to": "ルーメンに、ゆうがたの ことを きこう。", "kanji": "ルーメンに、夕方のことを聞こう。"},
  {"en": "Choose a song in the music box.", "to": "オルゴールで きょくを えらぼう。", "kanji": "オルゴールで曲を選ぼう。"},
  {"en": "Continue goes first and Quit goes last.", "to": "「つづける」が いちばん さきで、「ゲームを やめる」が いちばん あとだよ。", "kanji": "「続ける」が一番さきで、「ゲームをやめる」が一番後だよ。"},
  {"en": "Each row is one thing to turn, with a name you choose.", "to": "ぎょう ひとつが、まわす もの ひとつ。なまえは じぶんで きめてね。", "kanji": "行一つが、回すもの一つ。名前は自分で決めてね。"},
  {"en": "Esc only opens Hotaru's pocket menu. Mira thinks a town this clever deserves a real one.", "to": "Esc で ひらくのは、ほたるの ポケットメニューだけ。ミラは、こんなに かしこい まちには、ちゃんとした メニューが ひつようだと おもって いるよ。", "kanji": "Esc で開くのは、ほたるのポケットメニューだけ。ミラは、こんなにかしこい町には、ちゃんとしたメニューが必要だと思っているよ。"},
  {"en": "Everything in Lanternroot runs on code, even your boots. Teach them to walk.", "to": "ともしび村では、なにもかも コードで うごくよ。くつも そう。くつに あるく やりかたを おしえて あげよう。", "kanji": "ともしび村では、何もかもコードで動くよ。靴もそう。靴に歩くやり方を教えてあげよう。"},
  {"en": "Give Marta 3 cabbages.", "to": "マルタに キャベツを 3こ わたそう。", "kanji": "マルタにキャベツを 3個渡そう。"},
  {"en": "Hello, Lanternroot", "to": "こんにちは、ともしび村！", "kanji": "こんにちは、ともしび村！"},
  {"en": "Hours, a colon, and minutes with two digits.", "to": "じかん、コロン、それから 2けたの ふん。", "kanji": "時間、コロン、それから 2桁の分。"},
  {"en": "If the bag holds some already, they share a pile.", "to": "かばんに もう はいって いたら、おなじ 山に なるよ。", "kanji": "鞄にもう入っていたら、同じ山になるよ。"},
  {"en": "Lanternroot has no clock, so it is always now. Lumen wants her lamps to know when it is evening.", "to": "ともしび村には とけいが ないから、いつも いまなの。ルーメンは、ランタンが ゆうがたを しれる ように したいんだって。", "kanji": "ともしび村には時計がないから、いつも今なの。ルーメンは、ランタンが夕方を知れるようにしたいんだって。"},
  {"en": "Marta is making cabbage soup for the whole town. A bag that only takes is a bit greedy.", "to": "マルタが まち じゅうの ために、キャベツの スープを つくって いるよ。いれる ことしか できない かばんは、ちょっと よくばりだね。", "kanji": "マルタが町中のために、キャベツのスープを作っているよ。入れることしかできない鞄は、ちょっとよくばりだね。"},
  {"en": "Meet Elder Orin by the Lantern Root.", "to": "ランタンの木の そばで、ちょうろうの オリンに あおう。", "kanji": "ランタンの木のそばで、長老のオリンに会おう。"},
  {"en": "Meet Vell at the Archive.", "to": "きろくこで、ヴェルに あおう。", "kanji": "記録庫で、ヴェルに会おう。"},
  {"en": "Meet more of the town.", "to": "まちの ほかの ひとにも あおう。", "kanji": "町の他の人にも会おう。"},
  {"en": "Nothing in Lanternroot is kept unless someone writes code to keep it. Not even you.", "to": "ともしび村では、だれかが のこす コードを かかないかぎり、なにも のこらないよ。きみも おなじだよ。", "kanji": "ともしび村では、誰かが残すコードをかかないかぎり、何も残らないよ。君も同じだよ。"},
  {"en": "Nym has goods on every shelf and nowhere to put them. A bag would help.", "to": "ニムの たなには しなものが ならんで いるのに、おく ところが ないの。かばんが あれば たすかるよ。", "kanji": "ニムの棚には品物が並んでいるのに、置くところがないの。鞄があれば助かるよ。"},
  {"en": "One line for you, then one line for each part.", "to": "さいしょは きみの 1ぎょう、それから パーツごとに 1ぎょうずつ。", "kanji": "最初は君の 1行、それからパーツごとに 1行ずつ。"},
  {"en": "One name for each song, in the same order.", "to": "きょくごとに なまえを ひとつ、おなじ じゅんばんで。", "kanji": "曲ごとに名前を一つ、同じ順番で。"},
  {"en": "Open your Options page and move a slider.", "to": "オプションの ページを ひらいて、スライダーを うごかそう。", "kanji": "オプションのページを開いて、スライダーを動かそう。"},
  {"en": "Open your map.", "to": "ちずを ひらこう。", "kanji": "ちずを開こう。"},
  {"en": "Pell has drawn every street, all in grey. A map needs colour, names and a key to open it.", "to": "ペルは まちの みちを ぜんぶ、はいいろで かいて いるよ。ちずには いろと なまえと、ひらく ための キーが ひつようなんだ。", "kanji": "ペルは町の道を全部、灰色で書いているよ。ちずには色と名前と、開くためのキーが必要なんだ。"},
  {"en": "Pell's little map", "to": "ペルの ちいさな ちず", "kanji": "ペルの小さな地図"},
  {"en": "Pick cabbages in the plot. Marta needs 3.", "to": "はたけで キャベツを とろう。マルタには 3こ ひつようだよ。", "kanji": "畑でキャベツを取ろう。マルタには 3個必要だよ。"},
  {"en": "Pick up 3 different things.", "to": "ちがう ものを 3つ ひろおう。", "kanji": "違うものを 3つ拾おう。"},
  {"en": "Pip likes numbers out of a hundred. The tracker needs a bar that fills as you go.", "to": "ピップは、100 の なかの かずが すきなの。トラッカーには、すすむ ほど いっぱいに なる バーが ひつようだよ。", "kanji": "ピップは、100 の中の数がすきなの。トラッカーには、進むほどいっぱいになるバーが必要だよ。"},
  {"en": "Pip's progress", "to": "ピップの しんちょく", "kanji": "ピップの進捗"},
  {"en": "Press Esc and open your own menu.", "to": "Esc を おして、じぶんの メニューを ひらこう。", "kanji": "Esc を押して、自分のメニューを開こう。"},
  {"en": "Read the noticeboard in the square.", "to": "ひろばの おしらせばんを よもう。", "kanji": "広場のおしらせばんを読もう。"},
  {"en": "Save from the menu (Esc).", "to": "メニュー（Esc）から セーブしよう。", "kanji": "メニュー（Esc）からセーブしよう。"},
  {"en": "Say hello to Marta at the Warm Hearth.", "to": "あったかだんろで、マルタに あいさつしよう。", "kanji": "温かな暖炉で、マルタに挨拶しよう。"},
  {"en": "Seren hears every sound in Lanternroot, all at full volume. She wants a page with a knob.", "to": "セレンには、ともしび村の おとが ぜんぶ、いちばん おおきい おとで きこえて いるの。つまみの ついた ページが ほしいんだって。", "kanji": "セレンには、ともしび村の音が全部、一番大きい音できこえているの。つまみの付いたページが欲しいんだって。"},
  {"en": "Sign your work", "to": "さくひんに サインを", "kanji": "さくひんにサインを"},
  {"en": "Soup for the Hearth", "to": "あったかだんろの スープ", "kanji": "温かな暖炉のスープ"},
  {"en": "Steps done and steps in all. Out of a hundred.", "to": "おわった ステップと、ぜんぶの ステップの かず。100 の なかで。", "kanji": "終わったステップと、全部のステップの数。100 の中で。"},
  {"en": "Talk to Marta about the music box.", "to": "マルタに、オルゴールの ことを きこう。", "kanji": "マルタに、オルゴールのことを聞こう。"},
  {"en": "Talk to Marta about the soup.", "to": "マルタに、スープの ことを きこう。", "kanji": "マルタに、スープのことを聞こう。"},
  {"en": "Talk to Nym about the shelves.", "to": "ニムに、たなの ことを きこう。", "kanji": "ニムに、棚のことを聞こう。"},
  {"en": "Talk to Orin about the Book of Makers.", "to": "オリンに、つくりびとの ほんの ことを きこう。", "kanji": "オリンに、作り手のほんのことを聞こう。"},
  {"en": "Talk to Pell about the grey map.", "to": "ペルに、はいいろの ちずの ことを きこう。", "kanji": "ペルに、灰色のちずのことを聞こう。"},
  {"en": "Talk to Pip about the counting.", "to": "ピップに、かぞえる ことを きこう。", "kanji": "ピップに、数えることを聞こう。"},
  {"en": "Talk to Seren about the noise.", "to": "セレンに、うるさい おとの ことを きこう。", "kanji": "セレンに、うるさい音のことを聞こう。"},
  {"en": "Teach the cabbage gate when to open.", "to": "キャベツの もんに、いつ ひらくかを おしえよう。", "kanji": "キャベツの門に、いつ開くかを教えよう。"},
  {"en": "Teach your boots all four ways.", "to": "くつに よっつの むきを ぜんぶ おしえよう。", "kanji": "靴に四つの向きを全部教えよう。"},
  {"en": "The Lantern Root keeps a Book of Makers. Every Maker signs it with the parts they built.", "to": "ランタンの木には、つくりびとの ほんが あるよ。つくりびとは、じぶんが つくった パーツで、その ほんに サインするんだ。", "kanji": "ランタンの木には、作り手の本があるよ。作り手は、自分が作ったパーツで、その本にサインするんだ。"},
  {"en": "The Warm Hearth has a music box with no tunes in it. Marta wants music for the evenings.", "to": "あったかだんろには、きょくの はいって いない オルゴールが あるよ。マルタは ゆうがたの おんがくが ほしいんだって。", "kanji": "温かな暖炉には、曲の入っていないオルゴールがあるよ。マルタは夕方の音楽が欲しいんだって。"},
  {"en": "The lamps along the north lane went dark. Lumen needs a tinker who can light them all at once.", "to": "きたの みちの ランタンが、ぜんぶ きえて しまったの。ルーメンは、ぜんぶを いっぺんに ともせる しゅうりやさんが ひつようなのよ。", "kanji": "北の小道のランタンが、全部消えてしまったの。ルーメンは、まとめて灯せる修理屋さんを探しているわ。"},
  {"en": "The music box", "to": "オルゴール", "kanji": "オルゴール"},
  {"en": "The plot is in Home Hollow. Your gate opens it.", "to": "はたけは いえの くぼちに あるよ。きみの もんで ひらくんだ。", "kanji": "畑は家のある窪地にあるよ。君の門で開くんだ。"},
  {"en": "The town's hours are in the margin.", "to": "まちの じかんは、ページの よこに かいて あるよ。", "kanji": "町の時間は、ページの横に書いてあるよ。"},
  {"en": "The whole town wants to meet the new tinker.", "to": "まち じゅうが、あたらしい しゅうりやさんに あいたがって いるよ。", "kanji": "町中が、新しい修理屋さんに開いたがっているよ。"},
  {"en": "Trees, plots and flowers give things. Press Space.", "to": "木、はたけ、はなは、ものを くれるよ。スペースキーを おしてね。", "kanji": "木、畑、花は、ものをくれるよ。スペースキーを押してね。"},
  {"en": "Turn it up", "to": "おとを あげよう", "kanji": "音をあげよう"},
  {"en": "Visit Mira at the workshop.", "to": "こうぼうで、ミラに あいに いこう。", "kanji": "工房で、ミラにあいに行こう。"},
  {"en": "Wait for evening in town.", "to": "まちで ゆうがたまで まって みよう。", "kanji": "町で夕方まで待ってみよう。"},
  {"en": "Walk out of your house.", "to": "きみの いえから そとへ でよう。", "kanji": "君の家から外へ出よう。"},
  {"en": "Watch the credits roll.", "to": "クレジットが ながれる のを みよう。", "kanji": "クレジットがながれるのを見よう。"},
  {"en": "Watch the lane light up.", "to": "ランタンの みちが ひかる のを みよう。", "kanji": "ランタンの道が光るのを見よう。"},
  {"en": "Water should not look like grass.", "to": "みずは、くさの いろに みえちゃ だめだよ。", "kanji": "水は、草の色にみえちゃだめだよ。"},
  {"en": "What time is it?", "to": "いま なんじ？", "kanji": "今何時？"},
  {"en": "Write add: put something in the bag.", "to": "add を かこう：かばんに ものを いれよう。", "kanji": "add を書こう：鞄にものを入れよう。"},
  {"en": "Write clock_text: say the time aloud.", "to": "clock_text を かこう：じかんを こえに だして いおう。", "kanji": "clock_text を書こう：時間を声に出して言おう。"},
  {"en": "Write credits: your name and your parts.", "to": "credits を かこう：きみの なまえと パーツを いれよう。", "kanji": "credits を書こう：君の名前とパーツを入れよう。"},
  {"en": "Write light_all: light every lamp on the lane.", "to": "light_all を かこう：みちの ランタンを ぜんぶ ともそう。", "kanji": "light_all を書こう：道のランタンを全部灯そう。"},
  {"en": "Write map_colour: paint each kind of ground.", "to": "map_colour を かこう：じめんの しゅるいごとに いろを ぬろう。", "kanji": "map_colour を書こう：地面の種類ごとに色を決める。"},
  {"en": "Write menu_items: what your menu shows.", "to": "menu_items を かこう：メニューに だす ものを きめよう。", "kanji": "menu_items を書こう：メニューに出すものを決めよう。"},
  {"en": "Write next_track: go on to the next song.", "to": "next_track を かこう：つぎの きょくへ すすもう。", "kanji": "next_track を書こう：次の曲へ進もう。"},
  {"en": "Write options: which rows does the page show?", "to": "options を かこう：ページに どの ぎょうを だす？", "kanji": "options を書こう：ページにどの行を出す？"},
  {"en": "Write place_of: name the place under a cell.", "to": "place_of を かこう：マスの したに ある ばしょの なまえを いおう。", "kanji": "place_of を書こう：マスのしたにある場所の名前を言おう。"},
  {"en": "Write progress: how full is the bar?", "to": "progress を かこう：バーは どれくらい いっぱい？", "kanji": "progress を書こう：バーはどれくらいいっぱい？"},
  {"en": "Write remove: take something out of the bag.", "to": "remove を かこう：かばんから ものを とりだそう。", "kanji": "remove を書こう：鞄からものを取り出そう。"},
  {"en": "Write shortcut again: a key for the bag.", "to": "shortcut を もういちど かこう：かばんの キーを つくろう。", "kanji": "shortcut をもう一度書こう：鞄のキーを作ろう。"},
  {"en": "Write shortcut again: a key for the map.", "to": "shortcut を もういちど かこう：ちずの キーを つくろう。", "kanji": "shortcut をもう一度書こう：ちずのキーを作ろう。"},
  {"en": "Write shortcut: which door does Esc open?", "to": "shortcut を かこう：Esc は どの とびらを ひらく？", "kanji": "shortcut を書こう：Esc はどの扉を開く？"},
  {"en": "Write time_of_day: night, morning, afternoon or evening.", "to": "time_of_day を かこう：night、morning、afternoon、evening の どれかを かえそう。", "kanji": "time_of_day を書こう：night、morning、afternoon、evening のどれかを返そう。"},
  {"en": "Write titles: list the songs by name.", "to": "titles を かこう：きょくの なまえを ぜんぶ リストに しよう。", "kanji": "titles を書こう：曲の名前を全部リストにしよう。"},
  {"en": "Write volume again: stay inside the ends.", "to": "volume を もういちど かこう：はじの なかに おさめよう。", "kanji": "volume をもう一度書こう：はじの中に収めよう。"},
  {"en": "Write volume: how loud is each notch?", "to": "volume を かこう：めもり ひとつごとの おとの おおきさは？", "kanji": "volume を書こう：目盛り一つごとの音の大きさは？"},
  {"en": "Write your save: what should the town remember about you?", "to": "セーブを かこう：まちは きみの なにを おぼえて おけば いい？", "kanji": "セーブを書こう：町は君の何を覚えておけばいい？"},
  {"en": "Your own two feet", "to": "じぶんの あしで", "kanji": "自分の足で"},
  {"en": "Zero is silent. Ten is full.", "to": "0 は しずか。10 は いっぱい。", "kanji": "0 は静か。10 はいっぱい。"},
  // talk/noticeboard.jsonc
  {"en": "Lost: one firefly. Found: the same firefly. (Lumen)", "to": "まいご：ほたるが いっぴき。みつかった：おなじ ほたる。（ルーメン）", "kanji": "迷子：ほたるが一匹。見つかった：同じほたる。（ルーメン）"},
  {"en": "The Lantern Festival is coming. Bring something that glows.", "to": "ランタンまつりが もうすぐだよ。ひかる ものを もって きてね。", "kanji": "ランタン祭りがもうすぐだよ。光るものを持ってきてね。"},
  // talk/oracle.jsonc
  {"en": "A clock that says seven colon five makes me sad.", "to": "「7:5」って かく とけいは、かなしく なっちゃう。", "kanji": "「7:5」って書く時計は、悲しくなっちゃう。"},
  {"en": "A minute goes in. Words come out, like the time on a wall.", "to": "ふんを いれると、かべの とけいみたいに、ことばが でて くるの。", "kanji": "分を入れると、壁の時計みたいに、言葉が出てくるの。"},
  {"en": "A whole day takes only a few minutes in Lanternroot.", "to": "ともしび村では、いちにちが ほんの すうふんで おわっちゃうんだよ。", "kanji": "ともしび村では、一日がほんの数分でおわっちゃうんだよ。"},
  {"en": "Always now? That sounds tiring.", "to": "いつも いま？ それって、つかれそう。", "kanji": "いつも今？それって、疲れそう。"},
  {"en": "Change my clock words.", "to": "とけいの ことばを かえたい。", "kanji": "時計の言葉を変えたい。"},
  {"en": "Change my day and night.", "to": "ひると よるを かえたい。", "kanji": "昼と夜を変えたい。"},
  {"en": "Day and night! Look, the light is changing already.", "to": "ひると よる！ みて、もう ひかりが かわって きたわ。", "kanji": "昼と夜！見て、もう光が変わってきたわ。"},
  {"en": "Even the ones at the very end!", "to": "いちばん おくの ランタンも！", "kanji": "一番奥のランタンも！"},
  {"en": "Evening. The lamps are glowing, and I did not say a word.", "to": "ゆうがたに なったわ。ランタンが ひかって いるの。わたしは、ひとことも いって いないのに。", "kanji": "夕方になったわ。ランタンが光っているの。私は、一言も言っていないのに。"},
  {"en": "Everything is a little peach-coloured!", "to": "なにもかも、すこし もも いろに なってるよ！", "kanji": "何もかも、少しもも色になってるよ！"},
  {"en": "First, teach the town day from night. A minute goes in. Night, morning, afternoon or evening comes out.", "to": "まずは、まちに ひると よるを おしえてね。ふんを いれると、night、morning、afternoon、evening の どれかが でて くるの。", "kanji": "まずは、町に昼と夜を教えてね。分を入れると、night、morning、afternoon、evening のどれかが出てくるの。"},
  {"en": "Here they are, all in one list. Light every one, however many there are.", "to": "ほら、ぜんぶ ひとつの リストに なって いるわ。いくつ あっても、ぜんぶ ともして。", "kanji": "ほら、全部一つのリストになっているわ。いくつあっても、全部灯して。"},
  {"en": "I have kept these lamps for as long as I can remember. They never listened to me.", "to": "わたしは、おぼえて いる かぎり ずっと、このランタンを まもって きたの。でも、わたしの いう ことは、いちども きいて くれなかったわ。", "kanji": "私は、覚えているかぎりずっと、このランタンを守ってきたの。でも、私の言うことは、一度も聞いてくれなかったわ。"},
  {"en": "I'll build a clock.", "to": "とけいを つくるよ。", "kanji": "時計を作るよ。"},
  {"en": "I'll light them.", "to": "ランタンを ともすよ。", "kanji": "ランタンを灯すよ。"},
  {"en": "I'll wait.", "to": "まって いるね。", "kanji": "待っているね。"},
  {"en": "Is that... unusual?", "to": "それって…めずらしい こと？", "kanji": "それって…めずらしいこと？"},
  {"en": "It has not happened in a very long time. Ask Elder Orin about the Makers.", "to": "そんな ことは、ずいぶん ひさしぶりなのよ。つくりびとの ことは、ちょうろうの オリンに きいて みて。", "kanji": "そんなことは、ずいぶん久しぶりなのよ。作り手のことは、長老のオリンに聞いてみて。"},
  {"en": "It is. A town needs mornings. And my lamps should know when the evening comes.", "to": "ええ、そうなの。まちには あさが ひつようでしょう。それに、わたしの ランタンは、ゆうがたが くるのを しって いて ほしいの。", "kanji": "ええ、そうなの。町には朝が必要でしょう。それに、私のランタンは、夕方がくるのを知っていて欲しいの。"},
  {"en": "Let's finish it.", "to": "さあ、おわらせよう。", "kanji": "さあ、おわらせよう。"},
  {"en": "Let's light it.", "to": "ともそう。", "kanji": "灯そう。"},
  {"en": "Look at the lane!", "to": "ランタンの みちを みて！", "kanji": "ランタンの道を見て！"},
  {"en": "Look at the lane, tinker. Every lamp, awake at once.", "to": "みて、しゅうりやさん。ランタンの みちを。ぜんぶの ランタンが、いっせいに めを さましたのよ。", "kanji": "見て、修理屋さん。ランタンの道を。全部のランタンが、一斉に目を覚ましたのよ。"},
  {"en": "Look at the lane. Every lamp, awake at once.", "to": "ランタンの みちを みて。ぜんぶの ランタンが、いっせいに めを さまして いるわ。", "kanji": "ランタンの道を見て。全部のランタンが、一斉に目を覚ましているわ。"},
  {"en": "Now words for the clock. Turn the minute into the time we say aloud: hours, a colon, minutes.", "to": "つぎは、とけいの ことばよ。ふんを、わたしたちが こえに だす じかんに かえて。じかん、コロン、ふん、ね。", "kanji": "次は、時計の言葉よ。分を、私たちが声に出す時間に変えて。時間、コロン、分、ね。"},
  {"en": "One loop, and the whole lane listened. That is a kind of magic, you know.", "to": "くりかえし いちどで、みちの ランタンが ぜんぶ きいたの。それって、ちょっとした まほうなのよ。しって いた？", "kanji": "繰り返し一度で、道のランタンが全部聞いたの。それって、ちょっとした魔法なのよ。知っていた？"},
  {"en": "Thank you, Lumen.", "to": "ありがとう、ルーメン。", "kanji": "ありがとう、ルーメン。"},
  {"en": "That is why I need a tinker. Say it once, in a loop, and every lamp hears it.", "to": "だから、しゅうりやさんが ひつようなの。くりかえしの なかで いちど いえば、ランタンみんなに とどくのよ。", "kanji": "だから、修理屋さんが必要なの。繰り返しの中で一度言えば、ランタンみんなに届くのよ。"},
  {"en": "The Makers would have liked you, tinker.", "to": "つくりびとたちも、あなたの ことを すきに なったでしょうね、しゅうりやさん。", "kanji": "作り手たちも、あなたのことをすきになったでしょうね、修理屋さん。"},
  {"en": "The clock speaks! Now wait for the evening, tinker. The lamps will be so pleased.", "to": "とけいが はなしたわ！ さあ、しゅうりやさん、ゆうがたを まって。ランタンたちも、きっと よろこぶわ。", "kanji": "時計が話したわ！さあ、修理屋さん、夕方を待って。ランタンたちも、きっと喜ぶわ。"},
  {"en": "The day is not finished. The town is still waiting for its hours.", "to": "まだ いちにちは おわって いないの。まちは、じかんを まって いるのよ。", "kanji": "まだ一日は終わっていないの。町は、時間を待っているのよ。"},
  {"en": "The fireflies inside are only sleeping. A lamp wakes when someone tells it so: lit is true.", "to": "なかの ほたるたちは、ねむって いるだけなの。ランタンは、「lit は true」と いって もらうと、めを さますのよ。", "kanji": "中のほたるたちは、ただ眠っているだけなの。「lit は true」と伝えれば、ランタンは目を覚ますのよ。"},
  {"en": "The fireflies will dream a little longer. Come back when you're ready.", "to": "ほたるたちは、もう すこし ゆめを みて いたいみたい。じゅんびが できたら、また きてね。", "kanji": "ほたるたちは、もう少し夢を見ているわ。準備ができたら、また来てね。"},
  {"en": "The lane is still waiting for your loop.", "to": "ランタンの みちは、まだ あなたの くりかえしを まって いるわ。", "kanji": "ランタンの道は、まだあなたの繰り返しを待っているわ。"},
  {"en": "The town's hours are written in the margin of the page. Follow them.", "to": "まちの じかんは、ページの よこに かいて あるわ。その とおりに して ね。", "kanji": "町の時間は、ページの横に書いてあるわ。その通りにしてね。"},
  {"en": "There are so many! Telling them one by one would take all night.", "to": "こんなに たくさん！ ひとつずつ いって いたら、よる じゅう かかっちゃうよ！", "kanji": "こんなにたくさん！一つずつ伝えていたら、一晩かかっちゃうよ！"},
  {"en": "There is no answer. The town has no clock, so it is always now.", "to": "こたえは ないの。まちには とけいが ないから、いつも「いま」なのよ。", "kanji": "答えはないの。町には時計がないから、いつも「今」なのよ。"},
  {"en": "They listened to you. Your words, in your loop. The lamps listened.", "to": "きいて くれたわ。あなたの ことばを、あなたの くりかえしの なかで。ランタンが きいたのよ。", "kanji": "聞いてくれたわ。あなたの言葉を、あなたの繰り返しの中で。ランタンが聞いたのよ。"},
  {"en": "Time can wait. It is very good at it.", "to": "じかんは まてるの。まつのが とても じょうずなのよ。", "kanji": "時間は待てるの。まつのがとても上手なのよ。"},
  {"en": "Tinker, a quiet question. What time is it in Lanternroot?", "to": "しゅうりやさん、しずかな しつもんよ。ともしび村では、いま なんじ？", "kanji": "修理屋さん、静かな質問よ。ともしび村では、今何時？"},
  {"en": "Tinker. Do you see the lamp lane? Every lamp along it has gone dark.", "to": "しゅうりやさん。ランタンの みちが みえる？ そって いる ランタンが、ぜんぶ きえて しまったの。", "kanji": "修理屋さん。ランタンの道が見える？沿っているランタンが、全部きえてしまったの。"},
  // talk/pell.jsonc
  {"en": "A grey Pell would be funny.", "to": "はいいろの ペルって、おもしろそう！", "kanji": "灰色のペルって、面白そう！"},
  {"en": "And a path must never look like grass. People get lost.", "to": "それに、みちは くさに みえちゃ だめなんだ。みんな まいごに なっちゃうよ。", "kanji": "それに、道は草にみえちゃだめなんだ。みんな迷子になっちゃうよ。"},
  {"en": "Back to Mira's key machine. Add a door for the map.", "to": "ミラの キーの きかいに もどろう！ ちずの とびらを ひとつ ふやしてね。", "kanji": "ミラのキーの機械に戻ろう！ちずの扉を一つ増やしてね。"},
  {"en": "Bye! Do not get lost. (You cannot. You have a map.)", "to": "バイバイ！ まいごに ならないでね。（きみは ならないよ。ちずが あるもん。）", "kanji": "バイバイ！迷子にならないでね。（君はならないよ。ちずがあるもん。）"},
  {"en": "Bye, Pell!", "to": "バイバイ、ペル！", "kanji": "バイバイ、ペル！"},
  {"en": "Change my colours.", "to": "いろを かえたい。", "kanji": "色を変えたい。"},
  {"en": "Change my places.", "to": "ばしょを かえたい。", "kanji": "場所を変えたい。"},
  {"en": "Colours! The map is BEAUTIFUL!", "to": "いろだ！ ちずが すっごく きれいに なった！", "kanji": "色だ！ちずがすっごく綺麗になった！"},
  {"en": "Each place is a box on the map. Is the spot inside the box? That is the whole question.", "to": "ばしょは、ちずの うえの はこなんだ。そこは はこの なかに あるかな？ それが ぜんぶの しつもんなんだよ。", "kanji": "場所は、ちずの上の箱なんだ。そこは箱の中にあるかな？それが全部の質問なんだよ。"},
  {"en": "Everything starts at the big tree. Now it can find the big tree by itself.", "to": "ぜんぶ、おおきな木から はじまるんだ。いまは、ちずが おおきな木を ひとりで さがせるように なったよ。", "kanji": "全部、おおきな木から始まるんだ。今は、ちずがおおきな木を一人で探せるようになったよ。"},
  {"en": "Grey grass. Grey water. A grey me! A map should show where the water is without a word.", "to": "はいいろの くさ。はいいろの みず。はいいろの わたし！ ちずは、ことばを つかわなくても、みずが どこに あるか わからないと いけないんだ。", "kanji": "灰色の草、灰色の水、それに灰色の私！地図は、説明がなくても水の場所が分かるようにしたいんだ。"},
  {"en": "Home Hollow. Waterside. Lantern Square. And so on.", "to": "いえの くぼち。みずべ。ランタンの ひろば。など、など。", "kanji": "家のある窪地、水辺、ランタン広場。ほかにも、いろんな場所があるよ。"},
  {"en": "I hung your map on my wall, next to my first one. Yours is better.", "to": "きみの ちずを、わたしの さいしょの ちずの となりに かけたよ。きみの ほうが すてきだね。", "kanji": "君のちずを、私の最初のちずの隣にかけたよ。君のほうが素敵だね。"},
  {"en": "I vote for M. M is for map!", "to": "わたしは M に いっぴょう！ M は ちずの M だもん！", "kanji": "私は M にいっぴょう！ M はちずの M だもん！"},
  {"en": "I'll paint it.", "to": "ぬって みるよ。", "kanji": "塗ってみるよ。"},
  {"en": "It is still grey, but it is a very tidy grey.", "to": "まだ はいいろだけど、とても きちんとした はいいろだよ。", "kanji": "まだ灰色だけど、とてもきちんとした灰色だよ。"},
  {"en": "It knows where it is! Now, how do I open it?", "to": "じぶんが どこに いるか わかるように なったよ！ さて、どうやって ひらけば いいの？", "kanji": "自分がどこにいるか分かるようになったよ！さて、どうやって開けばいいの？"},
  {"en": "Let's add it.", "to": "つけよう。", "kanji": "付けよう。"},
  {"en": "Mira has a key for the menu. Nym has one for the bag. The map needs a key too.", "to": "ミラは メニューの キーを もって いるし、ニムは かばんの キーを もって いるよ。ちずにも キーが ひつようなんだ。", "kanji": "ミラはメニューのキーを持っているし、ニムは鞄のキーを持っているよ。ちずにもキーが必要なんだ。"},
  {"en": "Not to Pell. I have the pencils. I need the colours.", "to": "はいいろの わたしは ごめんだよ。えんぴつは あるんだ。ひつようなのは いろなんだ。", "kanji": "灰色の私はごめんだよ。えんぴつはあるんだ。必要なのは色なんだ。"},
  {"en": "Now it needs names. Point at any spot, and the map should say which place that is.", "to": "つぎは なまえが ひつようなんだ！ どこか ひとつを さしたら、ちずが「ここは どの ばしょ」か いって くれるように してね。", "kanji": "次は名前が必要なんだ！どこか一つをさしたら、ちずが「ここはどの場所」か言ってくれるようにしてね。"},
  {"en": "Press the key! Open your map! Is that... that is our town!", "to": "キーを おして！ ちずを ひらいて！ あれって…わたしたちの まちだ！", "kanji": "キーを押して！ちずを開いて！あれって…私たちの町だ！"},
  {"en": "Still grey! Can you finish my colours?", "to": "まだ はいいろだよ！ わたしの いろを ぬりおわって くれる？", "kanji": "まだ灰色だよ！私の色をぬりおわってくれる？"},
  {"en": "Tell me what colour each kind of ground is. Water should look like water.", "to": "じめんの しゅるいごとに、いろを おしえて。みずは、みずらしい いろに しなくちゃ。", "kanji": "地面の種類ごとに色を決めてほしいんだ。水は水だと分かる色にしてね。"},
  {"en": "Thanks, Pell.", "to": "ありがとう、ペル。", "kanji": "ありがとう、ペル。"},
  {"en": "Then it should say nothing at all.", "to": "そしたら、なにも いわない ように すれば いいんだ。", "kanji": "そしたら、何も言わないようにすればいいんだ。"},
  {"en": "Tinker! Tinker! I need help! I drew the whole town and it is all grey!", "to": "しゅうりやさん！ しゅうりやさん！ たすけて！ まち ぜんぶ かいたのに、ぜんぶ はいいろなんだ！", "kanji": "修理屋さん！修理屋さん！たすけて！町全部書いたのに、全部灰色なんだ！"},
  {"en": "What if you point at nowhere?", "to": "もし どこでもない ところを さしたら？", "kanji": "もしどこでもないところをさしたら？"},
  // talk/pip.jsonc
  {"en": "...Do not ask me that.", "to": "…それは きかないで。", "kanji": "…それは聞かないで。"},
  {"en": "And if a quest has no steps at all?", "to": "もし クエストに ステップが ひとつも ないときは？", "kanji": "もしクエストにステップが一つもないときは？"},
  {"en": "Bye! One, two, three... oh no. Starting again.", "to": "バイバイ！ いち、に、さん…あ、まちがえた。もういちど はじめから！", "kanji": "バイバイ！一、に、三…あ、間違えた。もう一度初めから！"},
  {"en": "Bye, Pip.", "to": "バイバイ、ピップ。", "kanji": "バイバイ、ピップ。"},
  {"en": "Change my bar.", "to": "バーを かえたい。", "kanji": "バーを変えたい。"},
  {"en": "Done goes in. Total goes in. Out comes a whole number, from nothing to a hundred.", "to": "おわった かずを いれて、ぜんぶの かずも いれるよ。すると、0 から 100 までの せいすうが でて くるんだ。", "kanji": "終わった数を入れて、全部の数も入れるよ。すると、0 から 100 までの整数が出てくるんだ。"},
  {"en": "Eleven lanterns, by the way.", "to": "ちなみに、ランタンは じゅういっこだよ。", "kanji": "ちなみに、ランタンは十一個だよ。"},
  {"en": "Fine. I will count something else. Nine, ten... eleven? Ten!", "to": "いいよ、ほかの ものを かぞえるから。きゅう、じゅう…じゅういち？ じゅう！", "kanji": "いいよ、他のものを数えるから。九、十…十一？十！"},
  {"en": "Give me the steps done and the steps in all. I will give you how full the bar is.", "to": "おわった ステップの かずと、ぜんぶの ステップの かずを ちょうだい。バーが どれくらい いっぱいか、おしえて あげるよ。", "kanji": "終わったステップの数と、全部のステップの数をちょうだい。バーがどれくらいいっぱいか、教えてあげるよ。"},
  {"en": "Half is not a number. I want a number out of one hundred, for the tracker bar.", "to": "はんぶんは かずじゃ ないよ！ ぼくが ほしいのは、トラッカーの バーに つかう、100 の なかの かずなんだ。", "kanji": "半分は数じゃないよ！ぼくが欲しいのは、トラッカーのバーに使う、100 の中の数なんだ。"},
  {"en": "I'll build it.", "to": "つくって みるね。", "kanji": "作ってみるね。"},
  {"en": "It fills! I watched it twice. Fifty percent! ...Is that a tinker thing? Good.", "to": "いっぱいに なった！ ふたかい みたんだ。50 パーセント！ …それって しゅうりやさんの ふしぎな わざ？ いいね！", "kanji": "いっぱいになった！二回みたんだ。50 パーセント！ …それって修理屋さんの不思議な技？いいね！"},
  {"en": "Let's fill it.", "to": "いっぱいに しよう。", "kanji": "いっぱいにしよう。"},
  {"en": "My bar is still empty. Empty is zero. Zero is where I do not like to be.", "to": "ぼくの バーは、まだ からっぽ。からっぽは 0 だよね。0 の ところに いるのは、ぼく すきじゃ ないんだ。", "kanji": "ぼくのバーは、まだ空っぽ。空っぽは 0 だよね。0 のところにいるのは、僕すきじゃないんだ。"},
  {"en": "Shh! I am counting your quest steps. Two done, two to go.", "to": "しーっ！ きみの クエストの ステップを かぞえて いるんだ。ふたつ おわって、あと ふたつ。", "kanji": "しーっ！君のクエストのステップを数えているんだ。二つ終わって、後二つ。"},
  {"en": "TEN.", "to": "じゅう！", "kanji": "十！"},
  {"en": "Two out of four. That's half!", "to": "4つの うち 2つ。はんぶんだね！", "kanji": "4つのうち 2つ。半分だね！"},
  // talk/quartermaster.jsonc
  {"en": "A bag of your own, and a key to open it. I am nearly ready to open the shop.", "to": "じぶんの かばんと、それを あける キー。もうすぐ おみせを ひらけそうだよ。", "kanji": "自分の鞄と、それを開けるキー。もうすぐお店を開けそうだよ。"},
  {"en": "A key! Press one, and the bag opens. Like the menu!", "to": "キー！ ひとつ おすと、かばんが あくんだね。メニューと おなじだ！", "kanji": "キー！一つおすと、鞄があくんだね。メニューと同じだ！"},
  {"en": "Back to Mira's key machine. Add a door for the bag on the I key. I is for inventory.", "to": "ミラの キーの きかいに もどって。I キーに、かばんの とびらを ふやしてね。I は かばんの I だよ。", "kanji": "ミラのキーの機械に戻って。I キーに、鞄の扉を増やしてね。I は鞄の I だよ。"},
  {"en": "But a bag you cannot open is only a very small cupboard.", "to": "でも、あけられない かばんは、ちいさな とだなと おなじだよ。", "kanji": "でも、あけられない鞄は、小さなとだなと同じだよ。"},
  {"en": "Bye, Nym.", "to": "バイバイ、ニム。", "kanji": "バイバイ、ニム。"},
  {"en": "Change my key.", "to": "キーを かえたい。", "kanji": "キーを変えたい。"},
  {"en": "Do not start.", "to": "はじめないで。", "kanji": "始めないで。"},
  {"en": "I'll make one.", "to": "ひとつ つくるよ。", "kanji": "一つ作るよ。"},
  {"en": "It holds! I put a pebble in and it stayed. Wonderful.", "to": "もった！ こいしを いれたら、そのまま のこって いたよ。すばらしいね。", "kanji": "持った！小石を入れたら、そのまま残っていたよ。素晴らしいね。"},
  {"en": "Let's do it.", "to": "やって みよう。", "kanji": "やってみよう。"},
  {"en": "Let's fix it.", "to": "なおそう。", "kanji": "直そう。"},
  {"en": "Mind the pebbles.", "to": "こいしに きを つけてね。", "kanji": "小石には気を付けてね。"},
  {"en": "Mira has the right idea. Teach her key machine one more door: the bag.", "to": "ミラは いい かんがえを もって いるね。ミラの キーの きかいに、もうひとつ とびら、かばんを おしえて あげて。", "kanji": "ミラはいい考えを持っているね。ミラのキーの機械に、もう一つ扉、鞄を教えてあげて。"},
  {"en": "My shelves are full, and nobody has anywhere to put anything. A cabbage rolled all the way to Marta's.", "to": "たなは いっぱいなのに、だれも なにを おく ところが ない。キャベツが ころがって、マルタの ところまで いったよ。", "kanji": "棚はいっぱいなのに、みんな持ち物を入れる場所がないんだ。キャベツがマルタの家まで転がっていったよ。"},
  {"en": "Pockets are a mess. I want a bag. Neat piles, each with a name and a number.", "to": "ポケットは ぐちゃぐちゃだ。かばんが ほしいんだ。きちんと した 山に、それぞれ なまえと かずを つけて ね。", "kanji": "ポケットはぐちゃぐちゃだ。鞄が欲しいんだ。きちんとした山に、それぞれ名前と数を付けてね。"},
  {"en": "Pockets! Pockets are the answer!", "to": "ポケット！ ポケットが こたえだね！", "kanji": "ポケット！ポケットが答えだね！"},
  {"en": "Something picked up should go into the bag. If you hold some already, they share a pile.", "to": "ひろった ものは、かばんに はいるんだよ。もう もって いる ものと おなじなら、おなじ 山に なるよ。", "kanji": "拾ったものは、鞄に入るんだよ。もう持っているものと同じなら、同じ山になるよ。"},
  {"en": "Take your time. The shelves are not going anywhere.", "to": "ゆっくりで いいよ。たなは どこにも いかないから。", "kanji": "ゆっくりでいいよ。棚はどこにも行かないから。"},
  {"en": "The bag has no bottom yet. Things fall out.", "to": "かばんには、まだ そこが ないんだ。ものが おちて しまう。", "kanji": "鞄には、まだ底がないんだ。中身が落ちてしまうよ。"},
  {"en": "Tinker. A word about shelves.", "to": "しゅうりやさん。たなの ことで、ひとこと。", "kanji": "修理屋さん。棚のことで、一言。"},
  {"en": "Very, very nearly?", "to": "ほんとに、もうすぐ？", "kanji": "本当に、もうすぐ？"},
  // talk/summoner.jsonc
  {"en": "A notch goes in. A loudness comes out.", "to": "めもりを いれると、おとの おおきさが でて くるの。", "kanji": "目盛りを入れると、音の大きさが出てくるの。"},
  {"en": "A page is a list of rows. Each row is one thing to turn, with a name you choose.", "to": "ページは、ぎょうの リストよ。ぎょう ひとつが、まわす もの ひとつ。なまえは あなたが きめてね。", "kanji": "ページは、行のリストよ。行一つが、回すもの一つ。名前はあなたが決めてね。"},
  {"en": "Below none. Above all. Your knob must still make sense out there.", "to": "ゼロより した、ぜんぶより うえ。そんな そとでも、あなたの つまみは ちゃんと いみを もって いないと いけないわ。", "kanji": "ゼロより下、全部より上。そんな外でも、あなたのつまみはちゃんといみを持っていないといけないわ。"},
  {"en": "Both ends hold. Now go and use it: open your menu, choose Options, and move a slider.", "to": "りょうはしも、ちゃんと たもって いるわ。さあ、つかって みて。メニューを ひらいて、オプションを えらんで、スライダーを うごかして ね。", "kanji": "両端も、ちゃんと保っているわ。さあ、使ってみて。メニューを開いて、オプションを選んで、スライダーを動かしてね。"},
  {"en": "Bye, Seren.", "to": "バイバイ、セレン。", "kanji": "バイバイ、セレン。"},
  {"en": "Change my knob.", "to": "つまみを かえたい。", "kanji": "つまみを変えたい。"},
  {"en": "Change my page.", "to": "ページを かえたい。", "kanji": "ページを変えたい。"},
  {"en": "I can hear a cabbage thinking.", "to": "キャベツが かんがえて いる 声が きこえるよ！", "kanji": "キャベツが考えている声が聞こえるよ！"},
  {"en": "I can hear you thinking. It is mostly 'hmm'.", "to": "きみが かんがえて いる 声も きこえるよ。ほとんど「うーん」だけどね。", "kanji": "君が考えている声も聞こえるよ。ほとんど「うーん」だけどね。"},
  {"en": "I need a knob. A page where sounds turn up and down. You would build the page.", "to": "つまみが ひつようなの。おとを あげたり さげたり できる ページが。あなたが ページを つくって くれないかしら。", "kanji": "つまみが必要なの。音をあげたりさげたりできるページが。あなたがページを作ってくれないかしら。"},
  {"en": "In Lanternroot every sound is as loud as it wants to be. That is very loud.", "to": "ともしび村では、どの おとも、したい だけ おおきく なって しまうの。とても うるさいのよ。", "kanji": "ともしび村では、どの音も、したいだけ大きくなってしまうの。とてもうるさいのよ。"},
  {"en": "It is. So we must catch it.", "to": "そうなの。だから、つかまえなくては。", "kanji": "そうなの。だから、つかまえなくては。"},
  {"en": "Let's catch it.", "to": "つかまえよう。", "kanji": "捕まえよう。"},
  {"en": "Louder than loud? That sounds like trouble.", "to": "うるさいより もっと うるさい？ それは たいへんそう！", "kanji": "うるさいよりもっとうるさい？それはたいへんそう！"},
  {"en": "Name them kindly. My spirits answer to anything kind.", "to": "なまえは やさしく つけて ね。わたしの せいれいは、やさしい ことばに こたえるのよ。", "kanji": "名前は優しく付けてね。私の精霊は、優しい言葉に答えるのよ。"},
  {"en": "No sound should be quieter than silence, or louder than full.", "to": "どの おとも、しずかさより しずかに ならず、いっぱいより おおきく ならないの。", "kanji": "どの音も、静かさより静かにならず、いっぱいより大きくならないの。"},
  {"en": "Now Lanternroot has a volume of its own. I can finally hear myself think.", "to": "これで ともしび村にも、じぶんの おとの おおきさが できたわ。やっと、じぶんの かんがえが きこえるように なったの。", "kanji": "これでともしび村にも、自分の音の大きさができたわ。やっと、自分の考えが聞こえるようになったの。"},
  {"en": "Small for the low notches, big for the high ones.", "to": "ひくい めもりは ちいさく、たかい めもりは おおきく。", "kanji": "低い目盛りは小さく、高い目盛りは大きく。"},
  {"en": "Thanks, Seren.", "to": "ありがとう、セレン。", "kanji": "ありがとう、セレン。"},
  {"en": "The spirits can wait. Even the loud ones.", "to": "せいれいたちは まてるわ。うるさい せいれいだって。", "kanji": "精霊たちは待てるわ。うるさい精霊だって。"},
  {"en": "The spirits say thank you. In their way, which is quietly.", "to": "せいれいたちも ありがとうって。かれらの やりかたで、そっと ね。", "kanji": "精霊たちもありがとうって。かれらのやり方で、そっとね。"},
  {"en": "There are eleven notches, from none to all. Say how loud each one makes the sound.", "to": "めもりは じゅういっこ。なしから ぜんぶまで。めもり ひとつごとに、おとが どれくらい おおきく なるかを いって ね。", "kanji": "目盛りは十一個。なしから全部まで。目盛り一つごとに、音がどれくらい大きくなるかを言ってね。"},
  {"en": "Tinker. Can you hear it? The bells, the water, the gate, the wind.", "to": "しゅうりやさん。きこえる？ かねの おと、みずの おと、もんの おと、かぜの おと。", "kanji": "修理屋さん。聞こえる？かねの音、水の音、門の音、風の音。"},
  {"en": "Your knob sings! Now a secret: some pads can push a slider past its ends.", "to": "つまみが うたって いるわ！ それと ひみつ。パッドの なかには、スライダーを はじの むこうまで おせる ものが あるの。", "kanji": "つまみが歌っているわ！それと秘密。パッドの中には、スライダーをはじの向こうまで押せるものがあるの。"},
  {"en": "Your page has no rows yet. A page with no rows is a very quiet wall.", "to": "ページには、まだ ぎょうが ないわ。ぎょうの ない ページは、とても しずかな かべよ。", "kanji": "ページには、まだ行がないわ。行のないページは、とても静かな壁よ。"},
  {"en": "Your page stands, and it is lovely. But a slider has to know how loud each notch is.", "to": "ページは たって いて、すてきね。でも、スライダーは めもり ひとつごとの おとの おおきさを しって いないと いけないの。", "kanji": "ページは立っていて、素敵ね。でも、スライダーは目盛り一つごとの音の大きさを知っていないといけないの。"},
  {"en": "Zero should be silent. Ten should be as loud as it gets.", "to": "ゼロは しずかに。じゅうは、いちばん おおきい おとに なるように。", "kanji": "ゼロは静かに。十は、一番大きい音になるように。"},
  // talk/warden.jsonc
  {"en": "...Apologies. I read it twice. The gate is still sealed.", "to": "…しつれい。ふたたび よんだが、もんは まだ とじたままだ。", "kanji": "…失礼。ふたたび読んだが、門はまだとじたままだ。"},
  {"en": "...TINKER. YOUR NAME IS IN THE BOOK OF MAKERS.", "to": "…しゅうりやさん！ きみの なまえが、つくりびとの ほんに のって いるぞ！", "kanji": "……修理屋さん！君の名が、作り手の本に記されているぞ！"},
  {"en": "But it listens now. Below it, the roots hold spells nobody has written yet.", "to": "だが、いまは もんが きいて いるぞ。その したでは、まだ だれも かいて いない じゅもんを、ねっこが もって いるんだ。", "kanji": "だが、今はもんが聞いているぞ。そのしたでは、まだ誰も書いていない呪文を、根が持っているんだ。"},
  {"en": "Come back when you are ready to write them.", "to": "じゅもんを かく じゅんびが できたら、また きて くれ。", "kanji": "呪文を書く準備ができたら、また来てくれ。"}
]
