[
  {"en": "The Coffee Machine", "to": "コーヒーメーカー", "kanji": "コーヒーメーカー"},
  {"en": "Coffee machine is out of beans", "to": "コーヒーメーカーの豆がきれた", "kanji": "コーヒーメーカーの豆がきれた"},
  {"en": "The break-room machine hums sadly. A sticky note says: out of beans, back in five. Somebody has left a thermos behind.", "to": "休憩室のコーヒーメーカーが、さびしくうなっている。「豆がきれました。5分でもどります」とメモがある。だれかの水筒も置きっぱなしだ。", "kanji": "休憩室のコーヒーメーカーが、さびしくうなっている。「豆がきれました。5分でもどります」とメモがある。だれかの水筒も置きっぱなしだ。"},
  {"en": "good first issue", "to": "はじめてでもOK", "kanji": "初めてでもOK"},
  {"en": "Make a pot of what is left (heal 25%)", "to": "のこりで一杯いれる（Integrityを25%回復）", "kanji": "のこりで一杯いれる（Integrityを25%回復）"},
  {"en": "Stay up all night (+5 max Integrity)", "to": "ひと晩ねないで作業する（最大Integrity+5）", "kanji": "ひと晩ねないで作業する（最大Integrity+5）"},
  {"en": "Sell the spare mugs (+30 cycles)", "to": "あまったマグカップを売る（+30サイクル）", "kanji": "あまったマグカップを売る（+30サイクル）"},
  {"en": "Take the thermos (a script)", "to": "水筒をもらう（スクリプト1つ）", "kanji": "水筒をもらう（スクリプト1つ）"},
  {"en": "Code Review", "to": "コードレビュー", "kanji": "コードレビュー"},
  {"en": "Your pull request has comments", "to": "プルリクエストにコメントがついた", "kanji": "プルリクエストにコメントが付いた"},
  {"en": "A reviewer left a long comment thread on your deck. They are polite about it, which is somehow worse.", "to": "レビューする人が、あなたのデッキに長いコメントをのこしていった。ていねいな言い方なのが、かえってつらい。", "kanji": "レビューする人が、あなたのデッキに長いコメントをのこしていった。ていねいな言い方なのが、かえってつらい。"},
  {"en": "review", "to": "レビュー", "kanji": "レビュー"},
  {"en": "Take the advice: remove a card", "to": "アドバイスにしたがう：カードを1枚へらす", "kanji": "アドバイスに従う：カードを1枚へらす"},
  {"en": "Take the advice: refactor a card", "to": "アドバイスにしたがう：カードを1枚リファクタする", "kanji": "アドバイスに従う：カードを1枚リファクタする"},
  {"en": "Argue, lose, and collect the consolation (+50 cycles)", "to": "言いあらそって負け、なぐさめをもらう（+50サイクル）", "kanji": "言いあらそって負け、なぐさめをもらう（+50サイクル）"},
  {"en": "Legacy Codebase", "to": "古いコード", "kanji": "古いコード"},
  {"en": "Nobody knows what this does", "to": "これが何をするのか、だれも知らない", "kanji": "これが何をするのか、だれも知らない"},
  {"en": "A forgotten module, thousands of lines, no tests. Two of your cards could be rewritten here, if you can stand reading it.", "to": "忘れられたモジュール。何千行もあって、テストはない。読むのにたえられるなら、ここで2枚のカードを書きなおせる。", "kanji": "忘れられたモジュール。何千行もあって、テストはない。読むのにたえられるなら、ここで2枚のカードを書きなおせる。"},
  {"en": "legacy", "to": "レガシー", "kanji": "レガシー"},
  {"en": "Refactor two cards, lose 8 Integrity", "to": "2枚リファクタする。Integrityを8へらす", "kanji": "2枚リファクタする。Integrityを8減らす"},
  {"en": "Walk away", "to": "立ち去る", "kanji": "立ち去る"},
  {"en": "Dependency Hell", "to": "依存関係の地獄", "kanji": "依存関係の地獄"},
  {"en": "Cannot resolve dependencies", "to": "依存関係を解決できない", "kanji": "依存関係を解決できない"},
  {"en": "The installer wants version 3 and version 4 of the same package. A glowing relic sits at the bottom of the conflict. So does something else.", "to": "インストーラーが、同じパッケージのバージョン3と4を両方ほしがっている。争いの底に、光る遺物がある。ほかにも何かいるようだ。", "kanji": "インストーラーが、同じパッケージのバージョン3と4を両方ほしがっている。争いの底に、光る遺物がある。ほかにも何かいるようだ。"},
  {"en": "bug", "to": "バグ", "kanji": "バグ"},
  {"en": "Install it all (an epic relic, and a curse)", "to": "ぜんぶインストールする（エピックの遺物と、呪い）", "kanji": "全部インストールする（エピックの遺物と、呪い）"},
  {"en": "Deprecated API", "to": "非推奨のAPI", "kanji": "非推奨のAPI"},
  {"en": "This card is deprecated", "to": "このカードは非推奨です", "kanji": "このカードは非推奨です"},
  {"en": "A warning scrolls past: one of your cards uses an old call and will stop working next release. There is a migration guide, mostly in a comment.", "to": "警告が流れていく。あなたのカードの1枚が古い呼び出しを使っていて、次のリリースで動かなくなる。移行ガイドは、ほとんどコメントの中にある。", "kanji": "警告が流れていく。あなたのカードの1枚が古い呼び出しを使っていて、次のリリースで動かなくなる。移行ガイドは、ほとんどコメントの中にある。"},
  {"en": "deprecation", "to": "非推奨", "kanji": "非推奨"},
  {"en": "Migrate a card to something like it", "to": "似たカードに移行する", "kanji": "似たカードに移行する"},
  {"en": "Merge Conflict", "to": "マージのコンフリクト", "kanji": "マージのコンフリクト"},
  {"en": "CONFLICT in deck.json", "to": "deck.json でコンフリクト", "kanji": "deck.json でコンフリクト"},
  {"en": "Two of your cards both changed the same line. Git has left its arrows all over the file.", "to": "2枚のカードが、同じ行を書きかえてしまった。Gitが、ファイルじゅうに矢印を置いていった。", "kanji": "2枚のカードが、同じ行を書きかえてしまった。Gitが、ファイルじゅうに矢印を置いていった。"},
  {"en": "conflict", "to": "コンフリクト", "kanji": "コンフリクト"},
  {"en": "Resolve it: keep one of the two", "to": "解決する：2枚のうち1枚をのこす", "kanji": "解決する：2枚のうち1枚をのこす"},
  {"en": "Pay 40 cycles to keep both", "to": "40サイクル払って、両方のこす", "kanji": "40サイクル払って、両方のこす"},
  {"en": "Rewrite It in Rust", "to": "Rustで書きなおそう", "kanji": "Rustで書きなおそう"},
  {"en": "Have you considered rewriting it in Rust?", "to": "Rustで書きなおすのはどう？", "kanji": "Rustで書きなおすのはどう？"},
  {"en": "A small brass crab in a hard hat insists that everything common in your deck would be better, and safer, and faster, if only you rewrote it. It is not entirely wrong.", "to": "ヘルメットをかぶった小さな真鍮のカニが、デッキの「ふつう」のカードをぜんぶ書きなおせば、もっと安全で速くなると言い張る。まちがってはいない。", "kanji": "ヘルメットをかぶった小さな真鍮のカニが、デッキの「通常」のカードをぜんぶ書きなおせば、もっと安全で速くなると言い張る。間違ってはいない。"},
  {"en": "enhancement", "to": "改善", "kanji": "改善"},
  {"en": "Rewrite every common card (each costs 2 max Integrity)", "to": "ふつうのカードをぜんぶ書きなおす（1枚ごとに最大Integrity-2）", "kanji": "ふつうのカードをぜんぶ書きなおす（1枚ごとに最大Integrity-2）"},
  {"en": "Mark and Sweep", "to": "マーク＆スイープ", "kanji": "マーク＆スイープ"},
  {"en": "Garbage collection is overdue", "to": "ガベージコレクションの時間です", "kanji": "ガベージコレクションの時間です"},
  {"en": "A collector with a very long broom offers to sweep the basics out of your deck. It does not take payment. It takes a promise to travel lighter.", "to": "とても長いほうきを持った回収屋が、デッキの基本カードをはき出してくれるという。お金はいらない。身軽に旅をする約束だけだ。", "kanji": "とても長いほうきを持った回収屋が、デッキの基本カードをはき出してくれるという。お金はいらない。身軽に旅をする約束だけだ。"},
  {"en": "maintenance", "to": "メンテナンス", "kanji": "メンテナンス"},
  {"en": "Sweep away up to two basic cards", "to": "基本カードを2枚まではき出す", "kanji": "基本カードを2枚まではき出す"},
  {"en": "Abandoned Repository", "to": "放置されたリポジトリ", "kanji": "放置されたリポジトリ"},
  {"en": "Last commit: a very long time ago", "to": "最後のコミット：ずっとむかし", "kanji": "最後のコミット：ずっとむかし"},
  {"en": "A repository wrapped in vines. The README promises great things. The bin folder is padlocked, but loosely.", "to": "つるにおおわれたリポジトリ。READMEは、すごいことを約束している。binフォルダには南京錠がかかっているが、ゆるい。", "kanji": "つるにおおわれたリポジトリ。READMEは、すごいことを約束している。binフォルダには南京錠がかかっているが、ゆるい。"},
  {"en": "Open the chest (a relic, 30% cursed)", "to": "宝箱をあける（遺物。30%で呪い）", "kanji": "宝箱をあける（遺物。30%で呪い）"},
  {"en": "Read the README (a random card)", "to": "READMEを読む（ランダムなカード）", "kanji": "READMEを読む（ランダムなカード）"},
  {"en": "Check the bin folder (two scripts)", "to": "binフォルダを見る（スクリプト2つ）", "kanji": "binフォルダを見る（スクリプト2つ）"},
  {"en": "Fork the Repo", "to": "リポジトリのフォーク", "kanji": "リポジトリのフォーク"},
  {"en": "Fork requested", "to": "フォークのリクエスト", "kanji": "フォークのリクエスト"},
  {"en": "Copying is faster than writing. It also leaves two copies to keep in sync, and the sync always costs something.", "to": "コピーは、書くより速い。でも、コピーが2つできると、同期を保つのにいつも何かがかかる。", "kanji": "コピーは、書くより速い。でも、コピーが2つできると、同期を保つのにいつも何かがかかる。"},
  {"en": "Fork a card (copy it, lose 8 Integrity)", "to": "カードをフォークする（コピーして、Integrity-8）", "kanji": "カードをフォークする（コピーして、Integrity-8）"},
  {"en": "Code Golf", "to": "コードゴルフ", "kanji": "コードゴルフ"},
  {"en": "Can you do it in fewer strokes?", "to": "もっと少ない打数でできる？", "kanji": "もっと少ない打数でできる？"},
  {"en": "A challenger scribbles two cards of yours off the page and says you will not miss them. You will, a little.", "to": "挑戦者が、あなたのカード2枚をページから消して、なくても困らないと言う。ちょっとだけ、困る。", "kanji": "挑戦者が、あなたのカード2枚をページから消して、なくても困らないという。ちょっとだけ、困る。"},
  {"en": "challenge", "to": "チャレンジ", "kanji": "チャレンジ"},
  {"en": "Cut two cards (-6 max Integrity in all)", "to": "2枚へらす（最大Integrityがあわせて-6）", "kanji": "2枚へらす（最大Integrityがあわせて-6）"},
  {"en": "Version Bump", "to": "バージョンアップ", "kanji": "バージョンアップ"},
  {"en": "Release 2.0.0?", "to": "リリース 2.0.0 にする？", "kanji": "リリース 2.0.0 にする？"},
  {"en": "Semver would like a word with you. Major, minor or patch: the owl has opinions about all three.", "to": "センバーが、お話があるそうだ。メジャー、マイナー、パッチ。フクロウは、3つともに意見がある。", "kanji": "センバーが、お話があるそうだ。メジャー、マイナー、パッチ。フクロウは、3つともに意見がある。"},
  {"en": "release", "to": "リリース", "kanji": "リリース"},
  {"en": "Major: three of your paradigm's cards are rewritten", "to": "メジャー：自分のパラダイムのカード3枚を書きなおす", "kanji": "メジャー：自分のパラダイムのカード3枚を書きなおす"},
  {"en": "Minor: refactor one card", "to": "マイナー：カードを1枚リファクタする", "kanji": "マイナー：カードを1枚リファクタする"},
  {"en": "Patch: heal 12", "to": "パッチ：12回復する", "kanji": "パッチ：12回復する"},
  {"en": "Pair Programming", "to": "ペアプログラミング", "kanji": "ペアプログラミング"},
  {"en": "Looking for a pairing partner", "to": "ペアになってくれる人をさがしています", "kanji": "ペアになってくれる人をさがしています"},
  {"en": "A stranger at the next desk offers to pair for an hour. They will show you how another school of thought does it.", "to": "となりの机の見知らぬ人が、1時間ペアを組もうと言ってくれた。ほかの考え方のやり方を、見せてくれる。", "kanji": "となりの机の見知らぬ人が、1時間ペアを組もうと言ってくれた。ほかの考え方のやり方を、見せてくれる。"},
  {"en": "collaboration", "to": "協力", "kanji": "協力"},
  {"en": "Pair up: choose a paradigm, then one of three of its cards", "to": "ペアになる：パラダイムを選び、そのカード3枚から1枚もらう", "kanji": "ペアになる：パラダイムを選び、そのカード3枚から1枚もらう"},
  {"en": "Decline politely (+10 cycles for the coffee)", "to": "ていねいにことわる（コーヒー代で+10サイクル）", "kanji": "丁寧にことわる（コーヒー代で+10サイクル）"},
  {"en": "Conference Talk", "to": "カンファレンスの講演", "kanji": "カンファレンスの講演"},
  {"en": "A talk on another paradigm", "to": "ほかのパラダイムについての講演", "kanji": "ほかのパラダイムについての講演"},
  {"en": "An owl-shaped lectern on a small stage. Today's talk is about how other people solve your problems, differently.", "to": "小さな舞台に、フクロウの形の演台。今日の話は、あなたの問題をほかの人がどうちがうやり方で解くか、だ。", "kanji": "小さな舞台に、フクロウの形の演台。今日の話は、あなたの問題をほかの人がどうちがうやり方で解くか、だ。"},
  {"en": "learning", "to": "学び", "kanji": "学び"},
  {"en": "Buy the workshop ticket (75 cycles): one of three cards from another paradigm, already refactored", "to": "ワークショップのチケットを買う（75サイクル）：ほかのパラダイムのカード3枚から1枚。リファクタずみ", "kanji": "ワークショップのチケットを買う（75サイクル）：ほかのパラダイムのカード3枚から1枚。リファクタずみ"},
  {"en": "Stay for the free swag (a neutral card)", "to": "無料のおみやげまで残る（ふつうのカード）", "kanji": "無料のおみやげまで残る（ふつうのカード）"},
  {"en": "Cross-Compilation", "to": "クロスコンパイル", "kanji": "クロスコンパイル"},
  {"en": "Target: another paradigm", "to": "ターゲット：ほかのパラダイム", "kanji": "ターゲット：ほかのパラダイム"},
  {"en": "A compiler will take one of your cards and give you two of another school in return. It is a fair rate, as long as you do not ask what it does with the original.", "to": "コンパイラが、あなたのカード1枚と引きかえに、ほかの流派のカードを2枚くれる。元のカードをどうするかは、聞かないかぎり、悪くない取引だ。", "kanji": "コンパイラが、あなたのカード1枚と引きかえに、ほかの流派のカードを2枚くれる。元のカードをどうするかは、聞かないかぎり、悪くない取引だ。"},
  {"en": "Trade a card for two from another paradigm", "to": "カード1枚を、ほかのパラダイムの2枚と交換する", "kanji": "カード1枚を、ほかのパラダイムの2枚と交換する"},
  {"en": "Paradigm Shift", "to": "パラダイムシフト", "kanji": "パラダイムシフト"},
  {"en": "Switch to a different approach?", "to": "ちがうやり方に切りかえる？", "kanji": "ちがうやり方に切りかえる？"},
  {"en": "A thin book on the floor describes the same problems from a second angle. You could take up another focus within your paradigm.", "to": "床に落ちた薄い本が、同じ問題を別の角度から書いている。自分のパラダイムのなかで、別のフォーカスにかえてもいい。", "kanji": "床に落ちた薄い本が、同じ問題を別の角度から書いている。自分のパラダイムのなかで、別のフォーカスにかえてもいい。"},
  {"en": "Take up another focus (the signature card you hold stays)", "to": "別のフォーカスにかえる（持っているシグネチャーカードはのこる）", "kanji": "別のフォーカスにかえる（持っているシグネチャーカードはのこる）"},
  {"en": "Keep to your path (+40 cycles)", "to": "今の道をすすむ（+40サイクル）", "kanji": "今の道をすすむ（+40サイクル）"},
  {"en": "The Open-Source Maintainer", "to": "オープンソースのメンテナー", "kanji": "オープンソースのメンテナー"},
  {"en": "Funding request", "to": "支援のおねがい", "kanji": "支援のおねがい"},
  {"en": "A tired maintainer asks for a little support. They promise to remember you, and you believe them.", "to": "つかれたメンテナーが、少しの支援をおねがいしてくる。あなたのことをおぼえておくと約束する。信じていいと思う。", "kanji": "疲れたメンテナーが、少しの支援をおねがいしてくる。あなたのことをおぼえておくと約束する。信じていいと思う。"},
  {"en": "sponsorship", "to": "スポンサー", "kanji": "スポンサー"},
  {"en": "Donate 50 cycles (a rare relic waits two rooms on)", "to": "50サイクル寄付する（2部屋さきで、レアの遺物が待っている）", "kanji": "50サイクル寄付する（2部屋さきで、レアの遺物が待っている）"},
  {"en": "Say thanks and go", "to": "お礼を言って立ち去る", "kanji": "お礼を言って立ち去る"},
  {"en": "Technical Debt", "to": "技術的負債", "kanji": "技術的負債"},
  {"en": "Borrow against the future", "to": "未来からお金をかりる", "kanji": "未来からお金をかりる"},
  {"en": "A ledger with a red ribbon. Borrow cycles now; the interest is paid in attention, every third fight, until you settle at a Registry.", "to": "赤いリボンのついた台帳。今、サイクルをかりる。利子は注意力ではらう。3回の戦いごとに、レジストリで150サイクルを返すまで。", "kanji": "赤いリボンのついた台帳。今、サイクルをかりる。利子は注意力ではらう。3回の戦いごとに、レジストリで150サイクルを返すまで。"},
  {"en": "debt", "to": "負債", "kanji": "負債"},
  {"en": "Borrow 120 cycles (a curse until repaid for 150 at a Registry)", "to": "120サイクルかりる（レジストリで150サイクル返すまで、呪い）", "kanji": "120サイクルかりる（レジストリで150サイクル返すまで、呪い）"},
  {"en": "Decline", "to": "ことわる", "kanji": "断る"},
  {"en": "The Intern", "to": "インターン", "kanji": "インターン"},
  {"en": "A new hire", "to": "新人が来た", "kanji": "新人が来た"},
  {"en": "An intern with an enormous mug asks if there is anything they can help with. There is always something.", "to": "大きなマグカップを持ったインターンが、何か手つだえることはないかと聞いてくる。いつも何かある。", "kanji": "大きなマグカップを持ったインターンが、何か手つだえることはないかと聞いてくる。いつも何かある。"},
  {"en": "staffing", "to": "人事", "kanji": "人事"},
  {"en": "Take them on (a fourth card in the next three card rewards)", "to": "引きうける（つぎの3回のカード報酬に4枚目が出る）", "kanji": "引きうける（次の3回のカード報酬に4枚目が出る）"},
  {"en": "Say you are fine", "to": "だいじょうぶと言う", "kanji": "だいじょうぶという"},
  {"en": "Daily Standup", "to": "朝会", "kanji": "朝会"},
  {"en": "Standup in five minutes", "to": "5分後に朝会です", "kanji": "5分後に朝会です"},
  {"en": "Everyone stands in a circle and says what they did yesterday. You are allowed to say something useful today.", "to": "みんなが輪になって立ち、きのうやったことを話す。今日は、役に立つことを言っていい。", "kanji": "みんなが輪になって立ち、きのうやったことを話す。今日は、役に立つことを言っていい。"},
  {"en": "process", "to": "プロセス", "kanji": "プロセス"},
  {"en": "Plan the day: +1 mana on the first turn, for three fights", "to": "一日の計画：3回の戦いのあいだ、最初のターンのマナ+1", "kanji": "一日の計画：3回の戦いのあいだ、最初のターンのマナ+1"},
  {"en": "Review the board: draw 1 more on the first turn, for three fights", "to": "ボードを見なおす：3回の戦いのあいだ、最初のターンに1枚多く引く", "kanji": "ボードを見なおす：3回の戦いのあいだ、最初のターンに1枚多く引く"},
  {"en": "Block your calendar: start with 5 block, for three fights", "to": "予定をブロックする：3回の戦いのあいだ、ブロック5で始まる", "kanji": "予定をブロックする：3回の戦いのあいだ、ブロック5で始まる"},
  {"en": "Skip it and take the donuts (an uncommon script)", "to": "朝会をぬけてドーナツをもらう（アンコモンのスクリプト）", "kanji": "朝会をぬけてドーナツをもらう（アンコモンのスクリプト）"},
  {"en": "Hackathon", "to": "ハッカソン", "kanji": "ハッカソン"},
  {"en": "48 hours, one prize", "to": "48時間、賞品は1つ", "kanji": "48時間、賞品は1つ"},
  {"en": "A banner, a leaderboard, and a very serious elite team that has not slept. The prize is a rare relic. So is the risk.", "to": "バナーに、順位表に、ねていない精鋭チーム。賞品は、レアな遺物。危険も、レアだ。", "kanji": "バナーに、順位表に、ねていない精鋭チーム。賞品は、レアな遺物。危険も、レアだ。"},
  {"en": "event", "to": "イベント", "kanji": "イベント"},
  {"en": "Enter: fight an elite now", "to": "参加する：今すぐエリートと戦う", "kanji": "参加する：今すぐエリートと戦う"},
  {"en": "Watch from the sofa", "to": "ソファーから見ている", "kanji": "ソファーから見ている"},
  {"en": "Bug Bounty", "to": "バグバウンティ", "kanji": "バグバウンティ"},
  {"en": "A bounty on the next bug", "to": "つぎのバグに懸賞金", "kanji": "つぎのバグに懸賞金"},
  {"en": "A coin with a beetle on it. Whoever fixes the next bug in a single program collects. Fix it in one go and the reward is yours.", "to": "カブトムシのついたコイン。つぎのバグを1つのプログラムで直した人が受けとる。一発で直せば、賞金はあなたのものだ。", "kanji": "カブトムシの付いたコイン。つぎのバグを1つのプログラムで直した人が受けとる。一発で直せば、賞金はあなたのものだ。"},
  {"en": "bounty", "to": "懸賞", "kanji": "懸賞"},
  {"en": "Take the bounty: kill the next fight's foes in one program for 100 cycles", "to": "懸賞を受ける：つぎの戦いを1つのプログラムで倒すと100サイクル", "kanji": "懸賞を受ける：つぎの戦いを1つのプログラムで倒すと100サイクル"},
  {"en": "Pass", "to": "見送る", "kanji": "見送る"},
  {"en": "Benchmark", "to": "ベンチマーク", "kanji": "ベンチマーク"},
  {"en": "Keep it under half a thousand", "to": "500より下におさえよう", "kanji": "500より下におさえよう"},
  {"en": "A stopwatch on a podium. The next fight is a benchmark: every program of it must stay light.", "to": "表彰台の上のストップウォッチ。つぎの戦いはベンチマークで、どのプログラムも軽くしておかなければならない。", "kanji": "表彰台の上のストップウォッチ。つぎの戦いはベンチマークで、どのプログラムも軽くしておかなければならない。"},
  {"en": "performance", "to": "性能", "kanji": "性能"},
  {"en": "Take the benchmark: keep every program under 512 operations in the next fight for 80 cycles", "to": "ベンチマークを受ける：つぎの戦いで、どのプログラムも512オペレーションより下なら80サイクル", "kanji": "ベンチマークを受ける：つぎの戦いで、どのプログラムも512オペレーションより下なら80サイクル"},
  {"en": "Hotfix in Production", "to": "本番でホットフィックス", "kanji": "本番でホットフィックス"},
  {"en": "It is on fire (again)", "to": "また燃えてます", "kanji": "また燃えてます"},
  {"en": "The alert says 500s everywhere. A quick patch would help, and the quick patch is the sort that leaves a mark.", "to": "アラートは、あちこちで500番台のエラーだと言っている。急ぎのパッチは役に立つけれど、跡がのこるたぐいのものだ。", "kanji": "アラートは、あちこちで500番台のエラーだと言っている。急ぎのパッチは役に立つけれど、跡がのこるたぐいのものだ。"},
  {"en": "urgent", "to": "緊急", "kanji": "緊急"},
  {"en": "Hotfix: refactor a card now, lose 6 Integrity", "to": "ホットフィックス：今すぐカードを1枚リファクタ。Integrity-6", "kanji": "ホットフィックス：今すぐカードを1枚リファクタ。Integrity-6"},
  {"en": "Let it burn", "to": "燃えるにまかせる", "kanji": "燃えるにまかせる"},
  {"en": "The Rubber Duck", "to": "ラバーダック", "kanji": "ラバーダック"},
  {"en": "Explain it to the duck", "to": "アヒルに説明してみよう", "kanji": "アヒルに説明してみよう"},
  {"en": "A rubber duck in tiny bronze armour. Explain what one of your cards returns, out loud, and the duck will nod. If you are wrong, it will not say so, but it will know.", "to": "小さな青銅のよろいを着たゴムのアヒル。カードの1枚が何を返すか、声に出して説明してみよう。アヒルはうなずく。まちがっていても言わないけれど、わかっている。", "kanji": "小さな青銅のよろいを着たゴムのアヒル。カードの1枚が何を返すか、声に出して説明してみよう。アヒルはうなずく。まちがっていても言わないけれど、分かっている。"},
  {"en": "quiz", "to": "クイズ", "kanji": "クイズ"},
  {"en": "Explain a card of yours (right: a rare card of your paradigm; wrong: 15 cycles)", "to": "カードを説明する（正解：自分のパラダイムのレアなカード。不正解：15サイクル）", "kanji": "カードを説明する（正解：自分のパラダイムのレアなカード。不正解：15サイクル）"},
  {"en": "The Oracle's Test Suite", "to": "オラクルのテストスイート", "kanji": "オラクルのテストスイート"},
  {"en": "Which version passes?", "to": "どのバージョンが通る？", "kanji": "どのバージョンが通る？"},
  {"en": "The Oracle sets three versions of one of your cards before you, and a test. Only one passes. The Oracle is patient.", "to": "オラクルが、あなたのカードの3つのバージョンとテストをならべた。通るのは1つだけ。オラクルは、がまん強い。", "kanji": "オラクルが、あなたのカードの3つのバージョンとテストをならべた。通るのは1つだけ。オラクルは、がまん強い。"},
  {"en": "Find the passing version (right: 60 cycles and a refactor; wrong: 20 cycles)", "to": "通るバージョンを見つける（正解：60サイクルとリファクタ。不正解：20サイクル）", "kanji": "通るバージョンを見つける（正解：60サイクルとリファクタ。不正解：20サイクル）"},
  {"en": "Stack Overflow Answer", "to": "Stack Overflowの回答", "kanji": "Stack Overflowの回答"},
  {"en": "Accepted answer (3 upvotes)", "to": "ベストアンサー（3票）", "kanji": "ベストアンサー（3票）"},
  {"en": "Someone on the forum has posted an answer for one of your cards. It has three upvotes. Half the time, the answer is subtly wrong.", "to": "フォーラムのだれかが、カードの1枚についての回答を投稿している。3票ついている。半分は、少しだけまちがっている。", "kanji": "フォーラムの誰かが、カードの1枚についての回答を投稿している。3票ついている。半分は、少しだけまちがっている。"},
  {"en": "copy-paste", "to": "コピペ", "kanji": "コピペ"},
  {"en": "Copy it without reading (a copy of the card; if the answer was buggy, lose 6 Integrity)", "to": "読まずにコピーする（カードのコピー。回答にバグがあれば、Integrity-6）", "kanji": "読まずにコピーする（カードのコピー。回答にバグがあれば、Integrity-6）"},
  {"en": "Read the comments first (15 cycles): see the answer's code, then decide", "to": "先にコメントを読む（15サイクル）：回答のコードを見てから決める", "kanji": "先にコメントを読む（15サイクル）：回答のコードを見てから決める"},
  {"en": "Big-O Quiz", "to": "ビッグオー・クイズ", "kanji": "ビッグオー・クイズ"},
  {"en": "Which is faster?", "to": "どっちが速い？", "kanji": "どっちが速い？"},
  {"en": "A chalkboard with two of your cards and a number. Which does less work? The chalk is already in your hand.", "to": "黒板に、あなたのカード2枚と1つの数字。どちらの仕事が少ない？ チョークは、もう手の中にある。", "kanji": "黒板に、あなたのカード2枚と1つの数字。どちらの仕事が少ない？チョークは、もう手の中にある。"},
  {"en": "Take the quiz (right: 40 cycles and a refactor; wrong: 15 cycles)", "to": "クイズに答える（正解：40サイクルとリファクタ。不正解：15サイクル）", "kanji": "クイズに答える（正解：40サイクルとリファクタ。不正解：15サイクル）"},
  {"en": "Will It Halt?", "to": "止まるかな？", "kanji": "止まるかな？"},
  {"en": "Does this ever finish?", "to": "これは終わるの？", "kanji": "これは終わるの？"},
  {"en": "A looping bronze track with a finish flag. The Root loves this question, and has never answered it kindly.", "to": "ゴールの旗がついた、ぐるぐるのレール。ルートはこの質問が大好きで、やさしく答えてくれたことはない。", "kanji": "ゴールの旗がついた、ぐるぐるのレール。ルートはこの質問が大好きで、やさしく答えてくれたことはない。"},
  {"en": "Say whether it finishes in time (right: an epic relic; wrong: lose 6 Integrity)", "to": "時間内に終わるか答える（正解：エピックの遺物。不正解：Integrity-6）", "kanji": "時間内に終わるか答える（正解：エピックの遺物。不正解：Integrity-6）"},
  {"en": "Off-by-One", "to": "1ずれ", "kanji": "1ずれ"},
  {"en": "How many times does it run?", "to": "何回まわる？", "kanji": "何回まわる？"},
  {"en": "A short loop over a short volley. The classic mistake is one more or one fewer than you think.", "to": "短い一斉射に、短いループ。よくあるまちがいは、思ったより1つ多いか、1つ少ないことだ。", "kanji": "短い一斉射に、短いループ。よくあるまちがいは、思ったより1つ多いか、1つ少ないことだ。"},
  {"en": "Count the bolts it returns (right: +4 max Integrity; wrong: lose 3 Integrity)", "to": "返ってくるボルトの数をかぞえる（正解：最大Integrity+4。不正解：Integrity-3）", "kanji": "返ってくるボルトの数をかぞえる（正解：最大Integrity+4。不正解：Integrity-3）"}
]
