// The run screen and the rooms between fights (ADR-0047): the header, the run menu, the map and its route drawer, the
// spellbook, the draft, the rewards, the rest, the forge and the end of a run, keyed by the English exactly as the
// screen shows it (%s a name or word, %d a whole number). When the Japanese needs the values in another order, number
// them: {1} is the first %s or %d of the English, {2} the second. Names from content have their own entries elsewhere.
[
  // --- The header and the run menu ---------------------------------------------------------------------------------
  {"en": "Shardrun", "to": "シャードラン"},
  {"en": "Card Shardrun", "to": "カードのシャードラン"},
  {"en": "Spellforge", "to": "スペルフォージ"},
  {"en": "PIP'S TRIAL", "to": "ピップのトライアル"},
  {"en": "ARTIFICER", "to": "アーティフィサー"},
  {"en": "TURN %d  ·  %s", "to": "ターン %d  ·  %s"},
  {"en": "FIGHT", "to": "戦い"},
  {"en": "ELITE", "to": "強敵"},
  {"en": "BOSS", "to": "番人（ばんにん）"},
  {"en": "INTEGRITY", "to": "HP"},
  {"en": "RING %d · %s (%d/%d) · %s · %s", "to": "リング %d · %s（%d/%d） · %s · %s"},
  {"en": "4 STOPS · %s · %s", "to": "4つの部屋 · %s · %s"},
  {"en": "Deck", "to": "デッキ"},
  {"en": "Stats", "to": "記録"},
  {"en": "Menu", "to": "メニュー"},
  {"en": "Return to title", "to": "タイトルへもどる"},
  {"en": "A new run", "to": "新しい冒険へ"},
  {"en": "RUN MENU", "to": "冒険のメニュー"},
  {"en": "%s · Artificer · %s", "to": "%s · アーティフィサー · %s"},
  {"en": "The run is saved after every move.", "to": "冒険は、ひとつ動くたびにセーブされるよ。"},
  {"en": "Return to title whenever you want to continue later.", "to": "続きはあとで、と思ったら、いつでもタイトルへもどってね。"},
  {"en": "Battle look", "to": "戦いのすがた"},
  {"en": "Options", "to": "設定"},
  {"en": "Archives", "to": "記録庫（きろくこ）"},
  {"en": "Skip Trial", "to": "トライアルをとばす"},
  {"en": "Abandon run", "to": "冒険をやめる"},
  {"en": "Abandon the run?", "to": "冒険をやめる？"},
  {"en": "Climb back out? The run ends here and is scored as it stands; the shards stay behind.", "to": "地上へもどる？ 冒険はここで終わって、いまのままでスコアがつくよ。シャードはここに置いていくことになるよ。"},
  {"en": "Abandon this run", "to": "この冒険をやめる"},
  {"en": "Keep going", "to": "まだ続ける"},
  {"en": "This is the whole spell as one function. Cast it in a fight to watch it run, line by line.", "to": "これが呪文（じゅもん）ぜんぶを一つの関数にしたものだよ。戦いで唱えると、一行ずつ動くようすが見られるよ。"},

  // --- The map and its route drawer ---------------------------------------------------------------------------------
  {"en": "Fight", "to": "戦い"},
  {"en": "Elite", "to": "強敵"},
  {"en": "Guardian", "to": "番人（ばんにん）"},
  {"en": "Rest", "to": "休けい"},
  {"en": "Forge", "to": "炉（ろ）"},
  {"en": "Cache", "to": "キャッシュ"},
  {"en": "Foes bar the way.", "to": "敵が道をふさいでいるよ。"},
  {"en": "A stronger foe, and a richer reward.", "to": "もっと強い敵。そのぶん、ごほうびも大きいよ。"},
  {"en": "The layer's guardian. Beat it to go deeper.", "to": "この階層の番人。たおせば、もっと深くへ進めるよ。"},
  {"en": "Recover Integrity, or cleanse a curse.", "to": "HPを回復するか、呪いをはらおう。"},
  {"en": "Rework a shard, widen a spell, or bind a new one.", "to": "シャードを作り直すか、呪文を広げるか、新しい呪文を作ろう。"},
  {"en": "A sealed cache: a relic, or a curse.", "to": "封じられたキャッシュ。中身は遺物（いぶつ）か、呪いか。"},
  {"en": "Hover a room to see what waits there.", "to": "部屋にマウスをのせると、なにが待っているかわかるよ。"},
  {"en": "NEXT ROOMS", "to": "次の部屋"},
  {"en": "ROOMS", "to": "部屋の種類"},
  {"en": "Wheel or drag to look ahead.", "to": "ホイールかドラッグで、先を見てみよう。"},
  {"en": "Show or hide the route: the layer, the rooms you can enter next, the legend.", "to": "道すじの表示を出したり、しまったりするよ。階層、次に入れる部屋、部屋の種類がのっているよ。"},
  {"en": "RING %d · LAYER %d OF %d", "to": "リング %d · 階層 %d / %d"},
  {"en": "Pip's Trial", "to": "ピップのトライアル"},
  {"en": "%d STOPS · ONE ROUTE", "to": "%dつの部屋 · 一本道"},
  {"en": "A short descent to the Kiln Warden.", "to": "窯の番人までの、短い道のりだよ。"},
  {"en": "DECK · %d", "to": "デッキ · %d"},
  {"en": "Open your deck: every card, what it does and its code.", "to": "デッキを開こう。カードぜんぶと、その働き、そのコードが見られるよ。"},
  {"en": "AVAILABLE", "to": "行ける"},
  {"en": "OUT OF REACH", "to": "とどかない"},
  {"en": "CURRENT", "to": "いまここ"},
  {"en": "VISITED", "to": "通った"},
  {"en": "AHEAD", "to": "この先"},
  {"en": "Click to go there.", "to": "クリックすると、そこへ行くよ。"},
  {"en": "You are here.", "to": "きみはいまここ。"},
  {"en": "GUARDIAN OF %s", "to": "%sの番人"},
  {"en": "Route  »", "to": "道すじ  »"},
  {"en": "«  Route", "to": "«  道すじ"},

  // --- The spellbook and the deck ------------------------------------------------------------------------------------
  {"en": "Drag shards between spells and spares.", "to": "シャードをドラッグして、呪文と予備のあいだで動かそう。"},
  {"en": "A spell runs its shards left to right, starting from one plain bolt.", "to": "呪文は、ふつうのボルト一つから始まって、シャードを左から右へ順に動かすよ。"},
  {"en": "Spellbook", "to": "呪文の本"},
  {"en": "%d/%d slots", "to": "スロット %d/%d"},
  {"en": "Code", "to": "コード"},
  {"en": "put back here", "to": "ここへもどす"},
  {"en": "Spare shards (%d)", "to": "予備のシャード（%d）"},
  {"en": "Now click where %s should go.", "to": "次は、%sを置きたい場所をクリックしてね。"},
  {"en": "Point at a shard to read it.", "to": "シャードにマウスをのせると、くわしく読めるよ。"},
  {"en": "%s (%d slots)", "to": "%s（スロット %d）"},
  {"en": "YOUR DECK · %d CARDS", "to": "きみのデッキ · %d枚"},
  {"en": "Every fight shuffles the deck and deals %d cards a turn.", "to": "戦いのたびにデッキをシャッフルして、1ターンに%d枚くばるよ。"},
  {"en": "Play them into %s; the order you play them in is the order they run.", "to": "カードを%sに出そう。出した順番が、そのまま動く順番だよ。"},
  {"en": "Hover a card to read its code.", "to": "カードにマウスをのせると、コードが読めるよ。"},
  {"en": "DRAW PILE (sorted)", "to": "山札（やまふだ）（並べかえ済み）"},
  {"en": "DISCARD PILE", "to": "捨て札"},
  {"en": "HELD", "to": "キープ中"},

  // --- The draft -----------------------------------------------------------------------------------------------------
  {"en": "Choose how your program thinks", "to": "きみのプログラムの考え方をえらぼう"},
  {"en": "Hover a paradigm name for its description.", "to": "パラダイム名にマウスをのせると、説明が読めるよ。"},
  {"en": "Click a relic to choose it.", "to": "レリックをクリックしてえらぼう。"},
  {"en": "Hover to read a card's code; click it to choose.", "to": "カードにマウスをのせるとコードが読めるよ。クリックしてえらぼう。"},
  {"en": "A paradigm is a way of solving problems. Its cards are real algorithms; its speed decides who acts first.", "to": "パラダイムは、問題のとき方のこと。カードは本物のアルゴリズムで、その速さでどちらが先に動くかが決まるよ。"},
  {"en": "Pack %d of %d", "to": "パック %d / %d"},
  {"en": "Take one card. Its code is what it does; the order you play cards in is the program.", "to": "カードを1枚えらぼう。コードがそのままカードの働き。カードを出す順番が、プログラムになるよ。"},
  {"en": "Choose %s", "to": "%sにする"},
  {"en": "SIGNATURE CARDS", "to": "代表のカード"},
  {"en": "Take %s", "to": "%sをもらう"},

  // --- A card's details ------------------------------------------------------------------------------------------------
  {"en": "Play it into the Program: it becomes a line at the top and holds for the rest of the fight.", "to": "プログラムに出すと、いちばん上の一行になって、戦いが終わるまでずっと残るよ。"},
  {"en": "%s … %d more lines in the Program panel", "to": "%s … 続きの%d行は、プログラムのパネルで読めるよ"},
  {"en": "A forge upgrades it into %s.", "to": "炉（ろ）で強化すると、%sになるよ。"},
  {"en": "A forge repairs it into %s.", "to": "炉（ろ）で直すと、%sになるよ。"},
  {"en": "A forge optimises it into %s.", "to": "炉（ろ）で最適化すると、%sになるよ。"},

  // --- Rewards and caches --------------------------------------------------------------------------------------------
  {"en": "An opened cache", "to": "開いたキャッシュ"},
  {"en": "Shards in the rubble", "to": "がれきの中のシャード"},
  {"en": "A sealed cache", "to": "封じられたキャッシュ"},
  {"en": "A curse has bound itself", "to": "呪いがとりついた"},
  {"en": "Curse chance: %d%%. Opening may bind a cursed relic instead of offering helpful relics.", "to": "呪いの確率：%d%%。開けると、役に立つ遺物（いぶつ）のかわりに、呪われた遺物がとりつくかもしれないよ。"},
  {"en": "Leaving it unopened is safe.", "to": "開けずに行けば安全だよ。"},
  {"en": "At a rest, you can cleanse one cursed relic instead of healing.", "to": "休けいの部屋では、回復するかわりに、呪われた遺物を一つはらえるよ。"},
  {"en": "Open the cache", "to": "キャッシュを開ける"},
  {"en": "The curse is already bound to you. Leaving does not remove it.", "to": "呪いはもう、きみにとりついているよ。立ち去っても消えないんだ。"},
  {"en": "The guardian's core holds a spell of its own: %s, with %d empty slots.", "to": "番人のコアには、呪文が一つ入っていたよ。%s、空きスロットは%dつ。"},
  {"en": "Claim %s", "to": "%sをもらう"},
  {"en": "A relic", "to": "遺物（いぶつ）"},
  {"en": "Choose a relic", "to": "遺物（いぶつ）をえらぼう"},
  {"en": "Claim", "to": "もらう"},
  {"en": "Add one card to your deck", "to": "デッキにカードを1枚くわえよう"},
  {"en": "Take one shard", "to": "シャードを一つもらおう"},
  {"en": "It is shuffled into your deck for every fight from now on.", "to": "これからは、どの戦いでもデッキにまぜられるよ。"},
  {"en": "It joins your spare shards; slot it into a spell before the next fight.", "to": "予備のシャードに入るよ。次の戦いの前に、呪文にはめこもう。"},
  {"en": "Add %s to the deck", "to": "%sをデッキにくわえる"},
  {"en": "Skip the cards", "to": "カードはもらわない"},
  {"en": "Skip the shards", "to": "シャードはもらわない"},
  {"en": "Leave it unopened", "to": "開けずに行く"},
  {"en": "Leave the rest and move on", "to": "のこりは置いて先へ進む"},

  // --- The rest ------------------------------------------------------------------------------------------------------
  {"en": "A quiet alcove", "to": "静かなくぼみ"},
  {"en": "The hum of the Machine is almost soothing. Rest to recover %d Integrity.", "to": "機械のうなりが、なんだか心地いい。休むとHPが%d回復するよ。"},
  {"en": "Rearrange your spells first if you like; resting moves you on.", "to": "呪文を並べかえたいなら、先にやっておこう。休むと次へ進むよ。"},
  {"en": "Rest (+%d Integrity)", "to": "休む（HP +%d）"},
  {"en": "Cleanse %s instead of healing", "to": "回復のかわりに%sをはらう"},

  // --- The forge -----------------------------------------------------------------------------------------------------
  {"en": "An abandoned forge", "to": "見すてられた炉（ろ）"},
  {"en": "Do one thing here: rework a card (upgrade it, or repair a broken one), widen a spell by one slot, melt a card out of your deck, or bind a new spell to your book.", "to": "ここでできるのは一つだけ。カードを作り直す（強化するか、こわれたものを直す）か、呪文のスロットを一つ広げるか、デッキからカードを1枚とかすか、新しい呪文を本にくわえるか。"},
  {"en": "Do one thing here: rework a shard (upgrade it, or repair a broken one), widen a spell by one slot, or bind a new spell to your book.", "to": "ここでできるのは一つだけ。シャードを作り直す（強化するか、こわれたものを直す）か、呪文のスロットを一つ広げるか、新しい呪文を本にくわえるか。"},
  {"en": "Do one thing here: refactor a card, melt a card out of your deck, or widen your Program by a slot.", "to": "ここでできるのは一つだけ。カードをリファクタするか、デッキからカードを1枚とかすか、プログラムのスロットを一つ広げるか。"},
  {"en": "Melt a card down", "to": "カードをとかす"},
  {"en": "Your deck is already as thin as it can be (%d cards).", "to": "デッキはもう、これ以上へらせないよ（%d枚）。"},
  {"en": "Melt %s (1 of %d)", "to": "%sをとかす（%d枚のうち1枚）"},
  {"en": "Melt %s", "to": "%sをとかす"},
  {"en": "Rework a card", "to": "カードを作り直す"},
  {"en": "Rework a shard", "to": "シャードを作り直す"},
  {"en": "Upgrade", "to": "強化"},
  {"en": "Repair", "to": "修理"},
  {"en": "Optimize", "to": "最適化"},
  {"en": "Widen the Program", "to": "プログラムを広げる"},
  {"en": "Widen a spell", "to": "呪文を広げる"},
  {"en": "Widen %s to %d slots", "to": "%sをスロット%dつに広げる"},
  {"en": "Bind a new spell", "to": "新しい呪文を作る"},
  {"en": "An empty spell with %d slots, ready for the spare shards you carry.", "to": "スロットが%dつある、空っぽの呪文。持っている予備のシャードをはめこめるよ。"},
  {"en": "Bind %s", "to": "%sを作る"},
  {"en": "Leave the forge as it is", "to": "炉（ろ）はそのままにして行く"},
  {"en": "Refactor a card", "to": "カードをリファクタする"},
  {"en": "Every card has a better version. Pick one to read its diff: what the refactor removes and adds.", "to": "どのカードにも、もっといい形があるよ。えらぶと、その差分が読めるよ。リファクタで消える行と、ふえる行だよ。"},
  {"en": "Optimise %s", "to": "%sを最適化する"},
  {"en": "Refactor %s", "to": "%sをリファクタする"},
  {"en": "One refactor per forge.", "to": "リファクタは、炉（ろ）一つにつき一回だけ。"},
  {"en": "Melting destroys one copy for good. Your deck goes from %d to %d cards.", "to": "溶かすと、1枚が完全に消える。デッキは%d枚から%d枚になる。"},
  {"en": "Choose a card to melt. The rest of the deck is unchanged.", "to": "溶かすカードを選ぼう。デッキのほかのカードは変わらない。"},
  {"en": "%s will be melted: one copy leaves your deck for good.", "to": "%sを溶かす。1枚がデッキから完全に消える。"},
  {"en": "Keep it", "to": "やめておく"},
  {"en": "Choose", "to": "えらぶ"},
  {"en": "This card has no better version.", "to": "このカードには、より良い版がない。"},
  {"en": "Deck: %d → %d cards", "to": "デッキ: %d → %d枚"},
  {"en": "Cards with a better version: %d", "to": "より良い版のあるカード: %d枚"},
  {"en": "No card here has a better version.", "to": "ここには、より良い版のあるカードがない。"},
  {"en": "Destroy one card from your deck for good. A thinner deck deals its best cards more often.", "to": "デッキから1枚を完全に消す。デッキが薄いほど、強いカードが出やすくなる。"},
  {"en": "Rewrite a card into its better version: the same card, changed in place.", "to": "カードを、より良い版に書きかえる。同じカードが、その場で変わる。"},
  {"en": "Every spell is at its widest.", "to": "どの呪文も、もうこれ以上広げられない。"},
  {"en": "Slots: %d → %d", "to": "スロット: %d → %d"},
  {"en": "%d spells have room for a slot.", "to": "%d個の呪文に、スロットを足せる。"},
  {"en": "Give the Program one more slot for shards.", "to": "プログラムに、シャードを置くスロットを一つ足す。"},
  {"en": "Give a spell one more slot for shards.", "to": "呪文に、シャードを置くスロットを一つ足す。"},
  {"en": "Add a spell to your book. It starts empty, ready for the shards you carry.", "to": "呪文を一つ本に加える。空っぽで始まり、持っているシャードをすぐ入れられる。"},
  {"en": "%d slots", "to": "スロット%d"},
  {"en": "cost %d → %d", "to": "コスト %d → %d"},
  {"en": "%s The code is the same: the refactor is in what the card costs or does in the deck.", "to": "%s コードは同じだよ。かわるのは、カードのコストか、デッキでの働きなんだ。"},

  // --- The end of a run and the Stats panel --------------------------------------------------------------------------
  {"en": "Well played, %s.", "to": "%s、おつかれさま！"},
  {"en": "Pip's Trial complete!", "to": "トライアル達成！"},
  {"en": "The Machine is cleared", "to": "機械をクリアした！"},
  {"en": "You climbed back out", "to": "地上へもどってきた"},
  {"en": "The run", "to": "この冒険"},
  {"en": "SCORE", "to": "スコア"},
  {"en": "rank", "to": "ランク"},
  {"en": "TRIAL SCORE", "to": "トライアルのスコア"},
  {"en": "progress", "to": "進みぐあい"},
  {"en": "combat", "to": "戦い"},
  {"en": "build", "to": "カードと遺物"},
  {"en": "survival", "to": "生き残り"},
  {"en": "tempo", "to": "速さ"},
  {"en": "completion", "to": "クリア"},
  {"en": "penalties", "to": "ペナルティ"},
  {"en": "%d fights · %d casts · %d retries", "to": "戦い %d回 · 詠唱（えいしょう） %d回 · やり直し %d回"},
  {"en": "layers cleared", "to": "クリアした階層"},
  {"en": "fights", "to": "戦い"},
  {"en": "turns", "to": "ターン"},
  {"en": "casts", "to": "詠唱（えいしょう）"},
  {"en": "damage dealt", "to": "あたえたダメージ"},
  {"en": "best cast", "to": "いちばんの詠唱"},
  {"en": "fizzled", "to": "不発"},
  {"en": "shards taken", "to": "もらったシャード"},
  {"en": "relics", "to": "遺物（いぶつ）"},
  {"en": "mana spent", "to": "使ったマナ"},
  {"en": "ARTIFICER · FIELD PORTRAIT", "to": "アーティフィサー · 冒険のすがた"},
  {"en": "Star-Script Witch", "to": "星文字の魔女"},
  {"en": "Salvage Runner", "to": "がらくた拾いのランナー"},
  {"en": "Hovering Caster", "to": "宙に浮かぶ術者"},
  {"en": "Animation lab", "to": "アニメーション実験室"},
  {"en": "This run", "to": "この冒険"},
  {"en": "Damage by spell", "to": "呪文ごとのダメージ"}
]
