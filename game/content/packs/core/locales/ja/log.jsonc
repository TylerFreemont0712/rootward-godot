// The fight's own sentences (ADR-0047): what the rules write into a run's log, and the refusals they give, keyed by
// the English format exactly as the rules write it (%s a name or word, %d a whole number). Text.sentence matches a
// logged line against these and fills the Japanese with the same values, the names in it translated too. When the
// Japanese needs the values in another order, number them: {1} is the first %s or %d of the English, {2} the second.
[
  // The seeds (ADR-0047). A hit, a fall, and who moves first.
  {"en": "%s takes %d.", "to": "%sに%dダメージ。", "kanji": "%sに%dダメージ。"},
  {"en": "%s breaks apart.", "to": "%sはくだけ散った。", "kanji": "%sはくだけ散った。"},
  {"en": "%s moves first: %d ops is faster than your %d.", "to": "{1}が先に動いた！ {2} opsは、きみの{3}より速い。", "kanji": "{1}が先に動いた！ {2} opsは、君の{3}より速い。"},
  // shardrun.gd: entering rooms and layers, claiming relics. A line of several sentences is split on ". " before it is
// matched, so each sentence has its own entry beside the whole.
  {"en": "This run is over. Start a new one.", "to": "この冒険はもう終わったよ。新しい冒険を始めよう。", "kanji": "この冒険はもう終わったよ。新しい冒険を始めよう。"},
  {"en": "This run is over.", "to": "この冒険はもう終わったよ。", "kanji": "この冒険はもう終わったよ。"},
  {"en": "Start a new one.", "to": "新しい冒険を始めよう。", "kanji": "新しい冒険を始めよう。"},
  {"en": "A quiet alcove. The hum of the Machine is almost soothing.", "to": "静かなくぼみ。機械のうなりが、なんだか心地いい。", "kanji": "静かなくぼみ。機械のうなりが、なんだか心地いい。"},
  {"en": "A quiet alcove.", "to": "静かなくぼみ。", "kanji": "静かなくぼみ。"},
  {"en": "The hum of the Machine is almost soothing.", "to": "機械のうなりが、なんだか心地いい。", "kanji": "機械のうなりが、なんだか心地いい。"},
  {"en": "An abandoned forge, still warm. A shard can be reworked, or a spell widened.", "to": "見捨てられた炉（ろ）。まだあたたかい。シャードを作りかえるか、呪文（じゅもん）を広げられる。", "kanji": "見捨てられた炉。まだあたたかい。シャードを作りかえるか、呪文を広げられる。"},
  {"en": "An abandoned forge, still warm. A card can be refactored, or the Program widened.", "to": "見捨てられた炉（ろ）。まだあたたかい。カードをリファクタするか、プログラムを広げられる。", "kanji": "見捨てられた炉。まだあたたかい。カードをリファクタするか、プログラムを広げられる。"},
  {"en": "An abandoned forge, still warm.", "to": "見捨てられた炉（ろ）。まだあたたかい。", "kanji": "見捨てられた炉。まだあたたかい。"},
  {"en": "A shard can be reworked, or a spell widened.", "to": "シャードを作りかえるか、呪文（じゅもん）を広げられる。", "kanji": "シャードを作りかえるか、呪文を広げられる。"},
  {"en": "A card can be refactored, or the Program widened.", "to": "カードをリファクタするか、プログラムを広げられる。", "kanji": "カードをリファクタするか、プログラムを広げられる。"},
  {"en": "A sealed cache, left behind by an earlier Maintainer.", "to": "前のメンテナーが残していった、封印（ふういん）されたキャッシュ。", "kanji": "前のメンテナーが残していった、封印されたキャッシュ。"},
  {"en": "The last guardian falls. The Salvage is yours.", "to": "最後の番人（ばんにん）がたおれた。遺構（いこう）はきみのものだ！", "kanji": "最後の番人がたおれた。遺構はきみのものだ！"},
  {"en": "The last guardian falls.", "to": "最後の番人（ばんにん）がたおれた。", "kanji": "最後の番人がたおれた。"},
  {"en": "The Salvage is yours.", "to": "遺構（いこう）はきみのものだ！", "kanji": "遺構はきみのものだ！"},
  {"en": "You descend into %s, recovering %d Integrity. %s", "to": "%sへ降りていく。HPが%d回復した。%s", "kanji": "%sへ降りていく。HPが%d回復した。%s"},
  {"en": "You descend into %s, recovering %d Integrity.", "to": "%sへ降りていく。HPが%d回復した。", "kanji": "%sへ降りていく。HPが%d回復した。"},
  {"en": "You claim %s: %s", "to": "%sを手に入れた：%s", "kanji": "%sを手に入れた：%s"},
  // shardrun_battle.gd: a spellbook fight. Two %s side by side cannot be told apart by the matcher, so a line whose
// format has them ("%s %s the way.") is also written out the ways it can come out.
  {"en": "%s %s the way.", "to": "{1}が行く手をふさいでいる！", "kanji": "{1}が行く手をふさいでいる！"},
  {"en": "%s blocks the way.", "to": "%sが行く手をふさいでいる！", "kanji": "%sが行く手をふさいでいる！"},
  {"en": "%s and %s block the way.", "to": "%sと%sが行く手をふさいでいる！", "kanji": "%sと%sが行く手をふさいでいる！"},
  {"en": "%s and %s and %s block the way.", "to": "%sと%sと%sが行く手をふさいでいる！", "kanji": "%sと%sと%sが行く手をふさいでいる！"},
  {"en": "%s and %s and %s and %s block the way.", "to": "%sと%sと%sと%sが行く手をふさいでいる！", "kanji": "%sと%sと%sと%sが行く手をふさいでいる！"},
  {"en": "%s needs mana you do not have.", "to": "%sを唱えるには、マナが足りない。", "kanji": "%sを唱えるには、マナが足りない。"},
  {"en": "%s fizzles: %s", "to": "%sは不発（ふはつ）：%s", "kanji": "%sは不発：%s"},
  {"en": "%s needs %d mana and you have %d.", "to": "%sにはマナが%d必要。今あるのは%d。", "kanji": "%sにはマナが%d必要。今あるのは%d。"},
  {"en": "%s: %d %s for %d mana.", "to": "{1}：ボルト{2}本、マナ{4}。", "kanji": "{1}：ボルト{2}本、マナ{4}。"},
  {"en": "%d %s fizzled.", "to": "{1}本のボルトが不発に終わった。", "kanji": "{1}本のボルトが不発に終わった。"},
  {"en": "The cast burns %d Integrity.", "to": "唱えた反動で、HPが%d減った。", "kanji": "唱えた反動で、HPが%d減った。"},
  {"en": "Your relics gather %d block after the cast.", "to": "遺物（いぶつ）が、唱えたあとにブロックを%d集めた。", "kanji": "遺物が、唱えたあとにブロックを%d集めた。"},
  {"en": "A ward gathers %d block.", "to": "防護がブロックを%d集めた。", "kanji": "防護がブロックを%d集めた。"},
  {"en": "%s swallows the first bolt whole.", "to": "%sは最初のボルトをまるのみにした。", "kanji": "%sは最初のボルトをまるのみにした。"},
  {"en": "A %d-power bolt glances off %s.", "to": "威力（いりょく）{1}のボルトは、{2}にはじかれた。", "kanji": "威力{1}のボルトは、{2}に弾かれた。"},
  {"en": "%s takes %d%s.", "to": "{1}に{2}{3}ダメージ。", "kanji": "{1}に{2}{3}ダメージ。"},
  {"en": "%s takes %d (%d into its shield).", "to": "{1}に{2}ダメージ（{3}はシールドが受けた）。", "kanji": "{1}に{2}ダメージ（{3}はシールドが受けた）。"},
  {"en": "%s raises a %d-point shield.", "to": "%sが%dのシールドを張った。", "kanji": "%sが%dのシールドを張った。"},
  {"en": "%s stokes its fire. Its next strike hits twice as hard.", "to": "%sが火をかき立てた。次の攻撃は2倍の強さだ！", "kanji": "%sが火をかき立てた。次の攻撃は2倍の強さだ！"},
  {"en": "%s stokes its fire.", "to": "%sが火をかき立てた。", "kanji": "%sが火をかき立てた。"},
  {"en": "Its next strike hits twice as hard.", "to": "次の攻撃は2倍の強さだ！", "kanji": "次の攻撃は2倍の強さだ！"},
  {"en": "%s mends %d HP.", "to": "%sのHPが%d回復した。", "kanji": "%sのHPが%d回復した。"},
  {"en": "%s reprints your wards as a %d-point shield.", "to": "%sがきみの防護を写しとって、%dのシールドにした。", "kanji": "%sがきみの防護を写しとって、%dのシールドにした。"},
  {"en": "%s has no program to reprint.", "to": "%sには、写しとるプログラムがない。", "kanji": "%sには、写しとるプログラムがない。"},
  {"en": "%s hits you for %d%s.", "to": "{1}の攻撃で、{2}{3}ダメージを受けた。", "kanji": "{1}の攻撃で、{2}{3}ダメージを受けた。"},
  {"en": "%s hits you for %d.", "to": "%sの攻撃で、%dダメージを受けた。", "kanji": "%sの攻撃で、%dダメージを受けた。"},
  {"en": "%s hits you for %d (%d blocked).", "to": "{1}の攻撃で、{2}ダメージを受けた（{3}はブロックした）。", "kanji": "{1}の攻撃で、{2}ダメージを受けた（{3}はブロックした）。"},
  {"en": "Your cursed relics burn %d Integrity.", "to": "呪われた遺物で、HPが%d減った。", "kanji": "呪われた遺物で、HPが%d減った。"},
  {"en": "Turn %d.", "to": "%dターン目。", "kanji": "%dターン目。"},
  {"en": "The discard pile is compacted into a new draw pile: %d block.", "to": "捨て札をまとめて新しい山札（やまふだ）にした：ブロック%d。", "kanji": "捨て札をまとめて新しい山札にした：ブロック%d。"},
  {"en": "Your patch kit restores %d Integrity.", "to": "パッチキットで、HPが%d回復した。", "kanji": "パッチキットで、HPが%d回復した。"},
  {"en": "The guardian falls. The way down opens.", "to": "番人がたおれた。下への道がひらいた。", "kanji": "番人がたおれた。下への道がひらいた。"},
  {"en": "The guardian falls.", "to": "番人がたおれた。", "kanji": "番人がたおれた。"},
  {"en": "The way down opens.", "to": "下への道がひらいた。", "kanji": "下への道がひらいた。"},
  {"en": "The way is clear. Shards scatter across the floor.", "to": "道がひらけた。シャードが床に散らばっている。", "kanji": "道がひらけた。シャードが床に散らばっている。"},
  {"en": "The way is clear.", "to": "道がひらけた。", "kanji": "道がひらけた。"},
  {"en": "Shards scatter across the floor.", "to": "シャードが床に散らばっている。", "kanji": "シャードが床に散らばっている。"},
  {"en": "Kernel panic. The Salvage keeps what you carried.", "to": "カーネルパニック。持っていたものは遺構に残された。", "kanji": "カーネルパニック。持っていたものは遺構に残された。"},
  {"en": "Kernel panic.", "to": "カーネルパニック。", "kanji": "カーネルパニック。"},
  {"en": "The Salvage keeps what you carried.", "to": "持っていたものは遺構に残された。", "kanji": "持っていたものは遺構に残された。"},
  // shardrun_commands.gd: rooms, rewards, the forge, and what the rules refuse.
  {"en": "There is nothing to leave behind.", "to": "置いていくものは何もない。", "kanji": "置いていくものは何もない。"},
  {"en": "You leave the rest where it lies.", "to": "残りはそのままにしておいた。", "kanji": "残りはそのままにしておいた。"},
  {"en": "There is nowhere to rest here.", "to": "ここには休める場所がない。", "kanji": "ここには休める場所がない。"},
  {"en": "You rest and recover %d Integrity.", "to": "ひと休みして、HPが%d回復した。", "kanji": "ひと休みして、HPが%d回復した。"},
  {"en": "You climb back out of the Salvage. The shards stay behind.", "to": "遺構から外へはい上がった。シャードは置いていった。", "kanji": "遺構から外へはい上がった。シャードは置いていった。"},
  {"en": "You climb back out of the Salvage.", "to": "遺構から外へはい上がった。", "kanji": "遺構から外へはい上がった。"},
  {"en": "The shards stay behind.", "to": "シャードは置いていった。", "kanji": "シャードは置いていった。"},
  {"en": "Dev commands only work in a sandbox run.", "to": "開発コマンドは、サンドボックスの冒険でしか使えない。", "kanji": "開発コマンドは、サンドボックスの冒険でしか使えない。"},
  {"en": "Finish the room you are in first.", "to": "まず、今いる部屋を終わらせよう。", "kanji": "まず、今いる部屋を終わらせよう。"},
  {"en": "No path leads there from here.", "to": "ここからそこへ行く道はない。", "kanji": "ここからそこへ行く道はない。"},
  {"en": "A deck run fills its spells from the hand, during a fight.", "to": "デッキの冒険では、戦いの中で手札（てふだ）から呪文を組み立てるよ。", "kanji": "デッキの冒険では、戦いの中で手札から呪文を組み立てるよ。"},
  {"en": "Spells can only be rearranged between fights.", "to": "呪文を並べかえられるのは、戦いと戦いのあいだだけ。", "kanji": "呪文を並べかえられるのは、戦いと戦いのあいだだけ。"},
  {"en": "Every spell must be listed exactly once.", "to": "どの呪文も、ちょうど一回ずつ並べてね。", "kanji": "どの呪文も、ちょうど一回ずつ並べてね。"},
  {"en": "%s holds at most %d shards.", "to": "%sに入るシャードは%d個まで。", "kanji": "%sに入るシャードは%d個まで。"},
  {"en": "Rearranging cannot create or destroy shards.", "to": "並べかえで、シャードを増やしたり消したりはできない。", "kanji": "並べかえで、シャードを増やしたり消したりはできない。"},
  {"en": "There is nothing to cast at.", "to": "唱える相手がいない。", "kanji": "唱える相手がいない。"},
  {"en": "No such spell.", "to": "そんな呪文はない。", "kanji": "そんな呪文はない。"},
  {"en": "%s is spent until your next turn.", "to": "%sは次のターンまで使えない。", "kanji": "%sは次のターンまで使えない。"},
  {"en": "A %d-card cast draws %d more.", "to": "カード%d枚で唱えたので、さらに%d枚引く。", "kanji": "カード%d枚で唱えたので、さらに%d枚引く。"},
  {"en": "Only a deck run plays cards from a hand.", "to": "手札からカードを出せるのは、デッキの冒険だけ。", "kanji": "手札からカードを出せるのは、デッキの冒険だけ。"},
  {"en": "Cards are only played during a fight.", "to": "カードを出せるのは、戦いの中だけ。", "kanji": "カードを出せるのは、戦いの中だけ。"},
  {"en": "%s holds at most %d cards.", "to": "%sに入るカードは%d枚まで。", "kanji": "%sに入るカードは%d枚まで。"},
  {"en": "You can hold %d %s into the next turn.", "to": "次のターンに残せるのは{1}枚まで。", "kanji": "次のターンに残せるのは{1}枚まで。"},
  {"en": "Playing cards cannot create or destroy them.", "to": "カードを出しても、カードが増えたり消えたりはしない。", "kanji": "カードを出しても、カードが増えたり消えたりはしない。"},
  {"en": "There is no turn to end.", "to": "終わらせるターンがない。", "kanji": "終わらせるターンがない。"},
  {"en": "There are no shards to take.", "to": "もらえるシャードはない。", "kanji": "もらえるシャードはない。"},
  {"en": "That shard was not offered.", "to": "そのシャードは選べない。", "kanji": "そのシャードは選べない。"},
  {"en": "%s joins your deck.", "to": "%sがデッキに加わった！", "kanji": "%sがデッキに加わった！"},
  {"en": "You salvage %s.", "to": "%sを拾った。", "kanji": "%sを拾った。"},
  {"en": "There is no sealed chest to open.", "to": "開ける封印の箱はない。", "kanji": "開ける封印の箱はない。"},
  {"en": "The seal breaks. A curse binds itself to your run; a rest can cleanse it instead of healing.", "to": "封印がやぶれた。呪いが冒険にとりついた。休けいで、回復のかわりにはらえるよ。", "kanji": "封印がやぶれた。呪いが冒険にとりついた。休けいで、回復のかわりにはらえるよ。"},
  {"en": "The seal breaks.", "to": "封印がやぶれた。", "kanji": "封印がやぶれた。"},
  {"en": "A curse binds itself to your run; a rest can cleanse it instead of healing.", "to": "呪いが冒険にとりついた。休けいで、回復のかわりにはらえるよ。", "kanji": "呪いが冒険にとりついた。休けいで、回復のかわりにはらえるよ。"},
  {"en": "The cache opens safely. Choose a relic.", "to": "キャッシュは無事に開いた。遺物を一つ選ぼう。", "kanji": "キャッシュは無事に開いた。遺物を一つ選ぼう。"},
  {"en": "The cache opens safely.", "to": "キャッシュは無事に開いた。", "kanji": "キャッシュは無事に開いた。"},
  {"en": "Choose a relic.", "to": "遺物を一つ選ぼう。", "kanji": "遺物を一つ選ぼう。"},
  {"en": "The cache is empty.", "to": "キャッシュは空っぽだった。", "kanji": "キャッシュは空っぽだった。"},
  {"en": "There is no relic to claim.", "to": "もらえる遺物はない。", "kanji": "もらえる遺物はない。"},
  {"en": "That relic was not offered.", "to": "その遺物は選べない。", "kanji": "その遺物は選べない。"},
  {"en": "There is no new spell here.", "to": "ここに新しい呪文はない。", "kanji": "ここに新しい呪文はない。"},
  {"en": "Your spellbook is full.", "to": "呪文書（じゅもんしょ）はいっぱいだ。", "kanji": "呪文書はいっぱいだ。"},
  {"en": "A new spell, %s, with %d empty slots.", "to": "新しい呪文、%s。空きスロットは%d。", "kanji": "新しい呪文、%s。空きスロットは%d。"},
  {"en": "Curses can only be cleansed at a rest.", "to": "呪いをはらえるのは、休けいのときだけ。", "kanji": "呪いをはらえるのは、休けいのときだけ。"},
  {"en": "That is not a curse you carry.", "to": "その呪いは持っていない。", "kanji": "その呪いは持っていない。"},
  {"en": "You cleanse %s instead of healing.", "to": "回復のかわりに、%sをはらった。", "kanji": "回復のかわりに、%sをはらった。"},
  {"en": "There is no forge here.", "to": "ここに炉はない。", "kanji": "ここに炉はない。"},
  {"en": "You leave the forge as you found it.", "to": "炉には手をつけずに立ち去った。", "kanji": "炉には手をつけずに立ち去った。"},
  {"en": "That shard cannot be reworked.", "to": "そのシャードは作りかえられない。", "kanji": "そのシャードは作りかえられない。"},
  {"en": "That card is not in your deck.", "to": "そのカードはデッキにない。", "kanji": "そのカードはデッキにない。"},
  {"en": "You do not carry that shard.", "to": "そのシャードは持っていない。", "kanji": "そのシャードは持っていない。"},
  {"en": "You %s %s into %s.", "to": "{2}を{3}に{1}した。", "kanji": "{2}を{3}に{1}した。"},
  {"en": "You upgrade %s into %s.", "to": "%sを%sに強化した！", "kanji": "%sを%sに強化した！"},
  {"en": "You repair %s into %s.", "to": "%sを直して、%sにした。", "kanji": "%sを直して、%sにした。"},
  {"en": "You optimize %s into %s.", "to": "%sを%sに最適化（さいてきか）した！", "kanji": "%sを%sに最適化した！"},
  {"en": "%s cannot hold more shards.", "to": "%sには、もうシャードが入らない。", "kanji": "%sには、もうシャードが入らない。"},
  {"en": "You widen %s to %d slots.", "to": "%sを広げて、スロットを%dにした。", "kanji": "%sを広げて、スロットを%dにした。"},
  {"en": "There is no room in your spellbook for another spell.", "to": "呪文書には、もう呪文を入れる場所がない。", "kanji": "呪文書には、もう呪文を入れる場所がない。"},
  {"en": "You bind a new spell, %s, with %d empty slots.", "to": "新しい呪文%sを作った。空きスロットは%d。", "kanji": "新しい呪文%sを作った。空きスロットは%d。"},
  {"en": "Only a deck run has cards to melt down.", "to": "カードを溶かせるのは、デッキの冒険だけ。", "kanji": "カードを溶かせるのは、デッキの冒険だけ。"},
  {"en": "A deck cannot be pruned below %d cards.", "to": "デッキは%d枚より少なくできない。", "kanji": "デッキは%d枚より少なくできない。"},
  {"en": "You melt %s down. %d cards remain.", "to": "%sを溶かした。残りは%d枚。", "kanji": "%sを溶かした。残りは%d枚。"},
  {"en": "You melt %s down.", "to": "%sを溶かした。", "kanji": "%sを溶かした。"},
  {"en": "%d cards remain.", "to": "残りのカードは%d枚。", "kanji": "残りのカードは%d枚。"},
  // app/shardrun_session.gd: a refusal made outside core/, in the same voice.
  {"en": "There is no run underway.", "to": "進行中の冒険はない。", "kanji": "進行中の冒険はない。"},
  // shardrun_dev.gd: the sandbox run's dev commands. "[dev] %s" holds a note with its own slot, so each is written out.
  {"en": "No such shard.", "to": "そんなシャードはない。", "kanji": "そんなシャードはない。"},
  {"en": "No such relic.", "to": "そんな遺物はない。", "kanji": "そんな遺物はない。"},
  {"en": "%s is already held.", "to": "%sはもう持っている。", "kanji": "%sはもう持っている。"},
  {"en": "That relic is not in this run.", "to": "その遺物は、この冒険にない。", "kanji": "その遺物は、この冒険にない。"},
  {"en": "There is no fight to end.", "to": "終わらせる戦いがない。", "kanji": "終わらせる戦いがない。"},
  {"en": "No such layer.", "to": "そんな階層はない。", "kanji": "そんな階層はない。"},
  {"en": "That is not a dev command.", "to": "それは開発コマンドではない。", "kanji": "それは開発コマンドではない。"},
  {"en": "That card is not in this deck.", "to": "そのカードは、このデッキにない。", "kanji": "そのカードは、このデッキにない。"},
  {"en": "That shard is not in this run.", "to": "そのシャードは、この冒険にない。", "kanji": "そのシャードは、この冒険にない。"},
  {"en": "No such foes.", "to": "そんな敵はいない。", "kanji": "そんな敵はいない。"},
  {"en": "[dev] %s", "to": "[開発] %s", "kanji": "[開発] %s"},
  {"en": "won the fight", "to": "戦いに勝った", "kanji": "戦いに勝った"},
  {"en": "[dev] won the fight", "to": "[開発] 戦いに勝った", "kanji": "[開発] 戦いに勝った"},
  {"en": "[dev] granted %s", "to": "[開発] %sを手に入れた", "kanji": "[開発] %sを手に入れた"},
  {"en": "[dev] removed %s", "to": "[開発] %sを外した", "kanji": "[開発] %sを外した"},
  {"en": "[dev] added the spell %s", "to": "[開発] 呪文%sを足した", "kanji": "[開発] 呪文%sを足した"},
  {"en": "[dev] Integrity set to %d", "to": "[開発] HPを%dにした", "kanji": "[開発] HPを%dにした"},
  {"en": "[dev] mana set to %d", "to": "[開発] マナを%dにした", "kanji": "[開発] マナを%dにした"},
  {"en": "[dev] jumped to %s", "to": "[開発] %sへ移動した", "kanji": "[開発] %sへ移動した"},
  {"en": "[dev] spawned %s", "to": "[開発] %sを呼び出した", "kanji": "[開発] %sを呼び出した"},
  // program_draft.gd: choosing a paradigm and drafting the first deck.
  {"en": "Before the descent, choose how your program thinks.", "to": "降りていく前に、きみのプログラムの考え方を選ぼう。", "kanji": "降りていく前に、きみのプログラムの考え方を選ぼう。"},
  {"en": "There is no paradigm to choose now.", "to": "今は選べるパラダイムがない。", "kanji": "今は選べるパラダイムがない。"},
  {"en": "That paradigm was not offered.", "to": "そのパラダイムは選べない。", "kanji": "そのパラダイムは選べない。"},
  {"en": "%s: %s join your deck.", "to": "{1}：{2}がデッキに加わった！", "kanji": "{1}：{2}がデッキに加わった！"},
  {"en": "%s: %s and %s join your deck.", "to": "{1}：{2}と{3}がデッキに加わった！", "kanji": "{1}：{2}と{3}がデッキに加わった！"},
  {"en": "%s: %s and %s and %s join your deck.", "to": "{1}：{2}と{3}と{4}がデッキに加わった！", "kanji": "{1}：{2}と{3}と{4}がデッキに加わった！"},
  {"en": "There is no pack open.", "to": "開いているパックはない。", "kanji": "開いているパックはない。"},
  {"en": "That card is not in the pack.", "to": "そのカードはパックにない。", "kanji": "そのカードはパックにない。"},
  {"en": "Your deck holds %d cards. The Salvage opens below.", "to": "デッキのカードは%d枚。足もとに遺構が口をあけた。", "kanji": "デッキのカードは%d枚。足もとに遺構が口をあけた。"},
  {"en": "Your deck holds %d cards.", "to": "デッキのカードは%d枚。", "kanji": "デッキのカードは%d枚。"},
  {"en": "The Salvage opens below.", "to": "足もとに遺構が口をあけた。", "kanji": "足もとに遺構が口をあけた。"},
  // program_deck.gd and program_relics.gd: imports, cards that write cards, and what relics do after a program.
  {"en": "%s: in force for the rest of the fight.", "to": "%s：この戦いのあいだ、ずっと効いている。", "kanji": "%s：この戦いのあいだ、ずっと効いている。"},
  {"en": "%s writes %d %s on top of your draw pile.", "to": "{1}が{3}を{2}枚、山札の上に書きこんだ。", "kanji": "{1}が{3}を{2}枚、山札の上に書きこんだ。"},
  {"en": "Freed references: %d more mana next turn.", "to": "参照を解放：次のターン、マナ+%d。", "kanji": "参照を解放：次のターン、マナ+%d。"},
  {"en": "Collected: you recover %d.", "to": "回収：HPが%d回復した。", "kanji": "回収：HPが%d回復した。"},
  {"en": "Every line ran: %d block.", "to": "全部の行が動いた：ブロック%d。", "kanji": "全部の行が動いた：ブロック%d。"},
  // program_rules.gd: a program's cast and landing. "%s%s takes %d%s." (a lead such as "Initiative: " before the name) is
// written out with its lead, since two %s side by side cannot be matched apart.
  {"en": "%s needs a sorted volley, and %s left it unsorted.", "to": "{1}には並んだ一斉射（いっせいしゃ）がいるのに、{2}が並びをくずしている。", "kanji": "{1}には並んだ一斉射がいるのに、{2}が並びをくずしている。"},
  {"en": "the seed", "to": "はじめのボルト", "kanji": "はじめのボルト"},
  {"en": "%s crashes: %s", "to": "%sがクラッシュした：%s", "kanji": "%sがクラッシュした：%s"},
  {"en": "%s runs out of time: %d ops against a budget of %d.", "to": "{1}は時間切れ：{2} opsかかった（制限時間は{3}）。", "kanji": "{1}は時間切れ：{2} opsかかった（制限時間は{3}）。"},
  {"en": "%s: %d %s, %d ops, %d mana.", "to": "{1}：ボルト{2}本、{4} ops、マナ{5}。", "kanji": "{1}：ボルト{2}本、{4} ops、マナ{5}。"},
  {"en": "%d power flies at %s, already down.", "to": "威力{1}のボルトが{2}へ飛んだけれど、もうたおれている。", "kanji": "威力{1}のボルトが{2}へ飛んだけれど、もうたおれている。"},
  {"en": "%s recognises its own source: the same program cannot hurt it.", "to": "%sは自分のソースだと気づいた：同じプログラムでは傷つかない。", "kanji": "%sは自分のソースだと気づいた：同じプログラムでは傷つかない。"},
  {"en": "%s holds its lock: this program never touches %s.", "to": "{1}がロックをにぎっている：このプログラムは{2}にとどかない。", "kanji": "{1}がロックをにぎっている：このプログラムは{2}に届かない。"},
  {"en": "Initiative: ", "to": "先手（せんて）！", "kanji": "先手！"},
  {"en": "Initiative: %s takes %d.", "to": "先手（せんて）！%sに%dダメージ。", "kanji": "先手！%sに%dダメージ。"},
  {"en": "Initiative: %s takes %d (%d into its shield).", "to": "先手（せんて）！{1}に{2}ダメージ（{3}はシールドが受けた）。", "kanji": "先手！{1}に{2}ダメージ（{3}はシールドが受けた）。"},
  {"en": "The unused %d power is kept as block.", "to": "使われなかった威力%dは、ブロックとして残った。", "kanji": "使われなかった威力%dは、ブロックとして残った。"},
  {"en": "The overflow runs on: %s takes %d.", "to": "あふれた分が次へ：%sに%dダメージ。", "kanji": "あふれた分が次へ：%sに%dダメージ。"},
  {"en": "A faster foe ends the run before this program lands.", "to": "このプログラムがとどく前に、もっと速い敵に冒険を終わらされてしまう。", "kanji": "このプログラムがとどく前に、もっと速い敵に冒険を終わらされてしまう。"},
  {"en": "The cast's burn takes your last Integrity.", "to": "唱えた反動で、最後のHPがなくなってしまう。", "kanji": "唱えた反動で、最後のHPがなくなってしまう。"},
  // root_compiler.gd: the Root Compiler changes phase.
  {"en": "%s recompiles into %s. It spends its next turn doing it, shield down.", "to": "{1}が{2}に再コンパイルした。次のターンはそれにかかりきりで、シールドもない。", "kanji": "{1}が{2}に再コンパイルした。次のターンはそれにかかりきりで、シールドもない。"},
  {"en": "%s recompiles into %s.", "to": "{1}が{2}に再コンパイルした。", "kanji": "{1}が{2}に再コンパイルした。"},
  {"en": "It spends its next turn doing it, shield down.", "to": "次のターンはそれにかかりきりで、シールドもない。", "kanji": "次のターンはそれにかかりきりで、シールドもない。"},
  {"en": "itself", "to": "自分自身", "kanji": "自分自身"},
  // program_guardians.gd: the guardian pool's turns.
  {"en": "%s's loop goes around again: %d hits next time.", "to": "%sのループがもう一周：次は%d回たたく。", "kanji": "%sのループがもう一周：次は%d回たたく。"},
  {"en": "%s's unforced thunks are collected: %d pending becomes %d.", "to": "%sの評価されなかったサンクが回収された：保留%dが%dになった。", "kanji": "%sの評価されなかったサンクが回収された：保留%dが%dになった。"},
  {"en": "%s calls itself again: a new eval() frame (%d deep).", "to": "%sがまた自分を呼んだ：新しいeval()フレーム（深さ%d）。", "kanji": "%sがまた自分を呼んだ：新しいeval()フレーム（深さ%d）。"},
  {"en": "Stack Overflow! %s's frames spill over and it drops back to %d.", "to": "スタックオーバーフロー！%sのフレームがあふれて、%dまでもどった。", "kanji": "スタックオーバーフロー！%sのフレームがあふれて、%dまでもどった。"},
  {"en": "Stack Overflow!", "to": "スタックオーバーフロー！", "kanji": "スタックオーバーフロー！"},
  {"en": "%s's frames spill over and it drops back to %d.", "to": "%sのフレームがあふれて、%dまでもどった。", "kanji": "%sのフレームがあふれて、%dまでもどった。"},
  {"en": "%s is stunned and loses its turn.", "to": "%sは目を回して、ターンを失った。", "kanji": "%sは目を回して、ターンを失った。"},
  {"en": "%s is recompiling: it does nothing this turn.", "to": "%sは再コンパイル中：このターンは何もしない。", "kanji": "%sは再コンパイル中：このターンは何もしない。"},
  {"en": "%s is swapped out of memory and cannot strike.", "to": "%sはメモリから追い出されていて、攻撃できない。", "kanji": "%sはメモリから追い出されていて、攻撃できない。"},
  {"en": "%s reallocs: %d HP from %d blocks.", "to": "{1}がrealloc：{3}個のブロックからHPを{2}回復した。", "kanji": "{1}がrealloc：{3}個のブロックからHPを{2}回復した。"},
  {"en": "%s mends %d while it is swapped out.", "to": "%sはスワップアウト中に%d回復した。", "kanji": "%sはスワップアウト中に%d回復した。"},
  {"en": "Overflow fault: %s's count wraps to %d and it does nothing.", "to": "オーバーフロー：%sのカウントが%dに巻きもどって、何もしない。", "kanji": "オーバーフロー：%sのカウントが%dに巻きもどって、何もしない。"},
  {"en": "Caught! Your block handles the %d-power throw, and it bounces back: %s takes %d.", "to": "キャッチ！ブロックが威力%dの例外を受けとめて、はね返した：%sに%dダメージ。", "kanji": "キャッチ！ブロックが威力%dの例外を受けとめて、はね返した：%sに%dダメージ。"},
  {"en": "Caught!", "to": "キャッチ！", "kanji": "キャッチ！"},
  {"en": "Your block handles the %d-power throw, and it bounces back: %s takes %d.", "to": "ブロックが威力%dの例外を受けとめて、はね返した：%sに%dダメージ。", "kanji": "ブロックが威力%dの例外を受けとめて、はね返した：%sに%dダメージ。"},
  {"en": "Uncaught: the stack trace grows. Its throws hit +%d now.", "to": "キャッチできなかった：スタックトレースがのびた。例外の威力が+%dになった。", "kanji": "キャッチできなかった：スタックトレースが伸びた。例外の威力が+%dになった。"},
  {"en": "Uncaught: the stack trace grows.", "to": "キャッチできなかった：スタックトレースがのびた。", "kanji": "キャッチできなかった：スタックトレースが伸びた。"},
  {"en": "Its throws hit +%d now.", "to": "例外の威力が+%dになった。", "kanji": "例外の威力が+%dになった。"},
  {"en": "%s allocates a %s.", "to": "%sが%sを確保した。", "kanji": "%sが%sを確保した。"},
  {"en": "Out of Memory! %s's %d blocks give way.", "to": "メモリ不足！%sの%d個のブロックがくずれた。", "kanji": "メモリ不足！%sの%d個のブロックがくずれた。"},
  {"en": "Out of Memory!", "to": "メモリ不足！", "kanji": "メモリ不足！"},
  {"en": "%s's %d blocks give way.", "to": "%sの%d個のブロックがくずれた。", "kanji": "%sの%d個のブロックがくずれた。"},
  {"en": "%s is freed.", "to": "%sは解放された。", "kanji": "%sは解放された。"},
  {"en": "%s finds nothing left to mutate.", "to": "%sには、もう変異させるものがない。", "kanji": "%sには、もう変異させるものがない。"},
  {"en": "%s mutates %s: they run as changed until a program kills them.", "to": "{1}が{2}を変異させた：プログラムで退治するまで、変わったまま動く。", "kanji": "{1}が{2}を変異させた：プログラムで退治するまで、変わったまま動く。"},
  {"en": "%s mutates %s and %s: they run as changed until a program kills them.", "to": "{1}が{2}と{3}を変異させた：プログラムで退治するまで、変わったまま動く。", "kanji": "{1}が{2}と{3}を変異させた：プログラムで退治するまで、変わったまま動く。"},
  {"en": "%s mutates %s and %s and %s: they run as changed until a program kills them.", "to": "{1}が{2}と{3}と{4}を変異させた：プログラムで退治するまで、変わったまま動く。", "kanji": "{1}が{2}と{3}と{4}を変異させた：プログラムで退治するまで、変わったまま動く。"},
  {"en": "%s is swapped in.", "to": "%sがメモリに読みこまれた。", "kanji": "%sがメモリに読みこまれた。"},
  // guardian_landing.gd: how a guardian takes a program's bolts. A lead before the name ("Forced! ...", "%d wraps to %d: ")
// is written out whole, like Initiative above.
  {"en": "%s never evaluates it: the first bolt was under %d, so the rest are short-circuited.", "to": "%sはそれを評価しない：最初のボルトが%d未満だったので、残りはショートサーキットされた。", "kanji": "%sはそれを評価しない：最初のボルトが%d未満だったので、残りはショートサーキットされた。"},
  {"en": "Page fault: %s was not in memory. The bolt swaps it in and does nothing.", "to": "ページフォルト：%sはメモリになかった。ボルトはそれを読みこんだだけで、何もしない。", "kanji": "ページフォルト：%sはメモリ煮なかった。ボルトはそれを読みこんだだけで、何もしない。"},
  {"en": "Page fault: %s was not in memory.", "to": "ページフォルト：%sはメモリになかった。", "kanji": "ページフォルト：%sはメモリ煮なかった。"},
  {"en": "The bolt swaps it in and does nothing.", "to": "ボルトはそれを読みこんだだけで、何もしない。", "kanji": "ボルトはそれを読みこんだだけで、何もしない。"},
  {"en": "Cache hit: %s already knows %d and does not even look up.", "to": "キャッシュヒット：%sはもう%dを知っていて、顔も上げない。", "kanji": "キャッシュヒット：%sはもう%dを知っていて、顔も上げない。"},
  {"en": "%s foresaw it: the bolt does nothing.", "to": "%sはお見通し：ボルトは何もしない。", "kanji": "%sはお見通し：ボルトは何もしない。"},
  {"en": "%s puts it off: %d more pending (%d in all).", "to": "%sはあとまわしにした：保留が%d増えた（全部で%d）。", "kanji": "%sはあとまわしにした：保留が%d増えた（全部で%d）。"},
  {"en": "Forced!", "to": "強制評価！", "kanji": "強制評価！"},
  {"en": "Forced! Everything pending lands at once: ", "to": "強制評価！保留していた分が、いっせいに来た：", "kanji": "強制評価！保留していた分が、いっせいに来た："},
  {"en": "Everything pending lands at once: %s takes %d.", "to": "保留していた分が、いっせいに来た：%sに%dダメージ。", "kanji": "保留していた分が、いっせいに来た：%sに%dダメージ。"},
  {"en": "Forced! Everything pending lands at once: %s takes %d.", "to": "強制評価！保留していた分が、いっせいに来た：%sに%dダメージ。", "kanji": "強制評価！保留していた分が、いっせいに来た：%sに%dダメージ。"},
  {"en": "%d wraps to %d: %s takes %d.", "to": "%dが%dに巻きもどる：%sに%dダメージ。", "kanji": "%dが%dに巻きもどる：%sに%dダメージ。"},
  {"en": "Overflow: %d wraps to %d in a signed byte, and %s heals %d.", "to": "オーバーフロー：符号つき1バイトで%dが%dに巻きもどり、%sが%d回復した。", "kanji": "オーバーフロー：符号つき1バイトで%dが%dに巻きもどり、%sが%d回復した。"},
  {"en": "%s's top frame takes %d%s.", "to": "{1}のいちばん上のフレームに{2}{3}ダメージ。", "kanji": "{1}のいちばん上のフレームに{2}{3}ダメージ。"},
  {"en": "%s's top frame takes %d.", "to": "%sのいちばん上のフレームに%dダメージ。", "kanji": "%sのいちばん上のフレームに%dダメージ。"},
  {"en": "%s's top frame takes %d, and is popped.", "to": "%sのいちばん上のフレームに%dダメージ。フレームはポップされた。", "kanji": "%sのいちばん上のフレームに%dダメージ。フレームはポップされた。"},
  {"en": ", and is popped", "to": "、フレームはポップされた", "kanji": "、フレームはポップされた"},
  {"en": "%s returns from main().", "to": "%sはmain()からreturnした。", "kanji": "%sはmain()からreturnした。"},
  {"en": "%s is freed with her.", "to": "%sも、いっしょに解放された。", "kanji": "%sも、いっしょに解放された。"},
  {"en": "free(): the block's memory comes back to you as %d block.", "to": "free()：ブロックのメモリが、きみのブロック%dになって返ってきた。", "kanji": "free()：ブロックのメモリが、きみのブロック%dになって返ってきた。"},
  {"en": "%s stops yielding: its strikes hit %d%% harder.", "to": "%sはもうゆずらない：攻撃が%d%強くなった。", "kanji": "%sはもうゆずらない：攻撃が%d%強くなった。"},
  {"en": "%s stops yielding: its strikes hit %d% harder.", "to": "%sはもうゆずらない：攻撃が%d%強くなった。", "kanji": "%sはもうゆずらない：攻撃が%d%強くなった。"},
  {"en": "`%s`: the loop breaks. %s is stunned.", "to": "`%s`：ループが止まった。%sは目を回した。", "kanji": "`%s`：ループが止まった。%sは目を回した。"},
  {"en": "`%s`: the loop breaks.", "to": "`%s`：ループが止まった。", "kanji": "`%s`：ループが止まった。"},
  {"en": "%s is stunned.", "to": "%sは目を回した。", "kanji": "%sは目を回した。"},
  {"en": "Certificate checked: %s is stunned.", "to": "証明書（しょうめいしょ）を確認：%sは目を回した。", "kanji": "証明書を確認：%sは目を回した。"},
  {"en": "%s was right about your program: %d is reflected.", "to": "%sの予言は当たった：%dがはね返された。", "kanji": "%sの予言は当たった：%dがはね返された。"},
  {"en": "Your tests catch the mutant %s: it is restored, and %s takes %d.", "to": "テストが変異体%sをつかまえた：元にもどり、%sに%dダメージ。", "kanji": "テストが変異体%sを捕まえた：元にもどり、%sに%dダメージ。"},
  // guardian_landing.gd: the notes the code panel shows before a program runs. Their percent sign is written single
// ("+%d% "), as the line shows it, so the matcher finds it.
  {"en": "↻ %s: `%s` ✓ met: the loop breaks, +%d% and it is stunned.", "to": "↻ %s：`%s` ✓ 成立：ループが止まり、+%d%、そして目を回す。", "kanji": "↻ %s：`%s` ✓ 成立：ループが止まり、+%d%、そして目を回す。"},
  {"en": "↻ %s: `%s` ✗ not met: it goes round again.", "to": "↻ %s：`%s` ✗ 不成立：もう一周する。", "kanji": "↻ %s：`%s` ✗ 不成立：もう一周する。"},
  {"en": "♒ %s's riddle: %s = %d ✓ certificate: double, and it is stunned.", "to": "♒ %sのなぞなぞ：%s = %d ✓ 証明書：ダメージ2倍、そして目を回す。", "kanji": "♒ %sのなぞなぞ：%s = %d ✓ 証明書：ダメージ2倍、そして目を回す。"},
  {"en": "♒ %s's riddle: no bolts at it add up to exactly %d ✗ its scales halve them.", "to": "♒ %sのなぞなぞ：合計がちょうど%dになるボルトがない ✗ うろこでダメージが半分になる。", "kanji": "♒ %sのなぞなぞ：合計がちょうど%dになるボルトがない ✗ うろこでダメージが半分になる。"},
  {"en": "👁 %s predicts %s: right ✗ it takes nothing, and half is reflected at you.", "to": "👁 {1}の予言「{2}」：当たり ✗ ダメージなし。半分がきみにはね返る。", "kanji": "👁 {1}の予言「{2}」：当たり ✗ ダメージなし。半分がきみにはね返る。"},
  {"en": "👁 %s predicts %s: wrong ✓ every bolt lands.", "to": "👁 {1}の予言「{2}」：はずれ ✓ ボルトは全部とどく。", "kanji": "👁 {1}の予言「{2}」：はずれ ✓ ボルトは全部とどく。"},
  {"en": "👁 %s predicts fewer than %d bolts: right ✗ it takes nothing, and half is reflected at you.", "to": "👁 {1}の予言「ボルトは{2}本より少ない」：当たり ✗ ダメージなし。半分がきみにはね返る。", "kanji": "👁 {1}の予言「ボルトは{2}本より少ない」：当たり ✗ ダメージなし。半分がきみにはね返る。"},
  {"en": "👁 %s predicts fewer than %d bolts: wrong ✓ every bolt lands.", "to": "👁 {1}の予言「ボルトは{2}本より少ない」：はずれ ✓ ボルトは全部とどく。", "kanji": "👁 {1}の予言「ボルトは{2}本より少ない」：はずれ ✓ ボルトは全部とどく。"},
  {"en": "👁 %s predicts slower than %s: right ✗ it takes nothing, and half is reflected at you.", "to": "👁 {1}の予言「{2}より遅い」：当たり ✗ ダメージなし。半分がきみにはね返る。", "kanji": "👁 {1}の予言「{2}より遅い」：当たり ✗ ダメージなし。半分がきみにはね返る。"},
  {"en": "👁 %s predicts slower than %s: wrong ✓ every bolt lands.", "to": "👁 {1}の予言「{2}より遅い」：はずれ ✓ ボルトは全部とどく。", "kanji": "👁 {1}の予言「{2}より遅い」：はずれ ✓ ボルトは全部とどく。"},
  {"en": "every bolt aimed at it", "to": "ボルトは全部自分をねらう", "kanji": "ボルトは全部自分をねらう"},
  {"en": "a fire bolt", "to": "火のボルトがある", "kanji": "火のボルトがある"},
  {"en": "a frost bolt", "to": "氷のボルトがある", "kanji": "氷のボルトがある"},
  {"en": "a spark bolt", "to": "雷のボルトがある", "kanji": "雷のボルトがある"},
  {"en": "⏱ %s profiles %s: ×%s damage.", "to": "⏱ {1}が{2}を計測：ダメージ×{3}。", "kanji": "⏱ {1}が{2}を計測：ダメージ×{3}。"},
  {"en": "⇄ Every hit on a twin swaps the twins' places: aim 0 alternates between them.", "to": "⇄ ふたごに当てるたび、二人の場所が入れかわる：aim 0 は二人を交互にねらう。", "kanji": "⇄ ふたごに当てるたび、二人の場所が入れかわる：aim 0 は二人を交互にねらう。"},
  {"en": "⚰ return at slot %d: %d of your cards are dead code. They do not run, and still cost mana.", "to": "⚰ スロット{1}にreturn：カード{2}枚がデッドコードだ。動かないのに、マナはかかる。", "kanji": "⚰ スロット{1}にreturn：カード{2}枚がデッドコードだ。動かないのに、マナはかかる。"},
  {"en": "⚰ return at slot %d: %d of your cards are dead code.", "to": "⚰ スロット{1}にreturn：カード{2}枚がデッドコードだ。", "kanji": "⚰ スロット{1}にreturn：カード{2}枚がデッドコードだ。"},
  {"en": "They do not run, and still cost mana.", "to": "動かないのに、マナはかかる。", "kanji": "動かないのに、マナはかかる。"},
  {"en": "⚰ A return is buried at slot %d: only slots 1 to %d run this turn.", "to": "⚰ スロット{1}にreturnがうまっている：このターンに動くのはスロット1〜{2}だけ。", "kanji": "⚰ スロット{1}にreturnが埋まっている：このターンに動くのはスロット1〜{2}だけ。"},
  {"en": "🛡 %s throws %d: your %d block will catch it and bounce it back.", "to": "🛡 {1}が威力{2}の例外を投げる：ブロック{3}で受けとめて、はね返せる。", "kanji": "🛡 {1}が威力{2}の例外を投げる：ブロック{3}で受けとめて、はね返せる。"},
  {"en": "⚠ %s throws %d: with %d block it will not be caught.", "to": "⚠ {1}が威力{2}の例外を投げる：ブロック{3}では受けとめられない。", "kanji": "⚠ {1}が威力{2}の例外を投げる：ブロック{3}では受けとめられない。"},
  {"en": "🔥 Hot path: %s (%d ops, %s).", "to": "🔥 ホットパス：%s（%d ops、%s）。", "kanji": "🔥 ホットパス：%s（%d ops、%s）。"},
  {"en": "🧬 %s is a mutant (%s). Land 25 on the Mutator to kill it.", "to": "🧬 %sは変異体（%s）。ミューテーターに25当てれば退治できる。", "kanji": "🧬 %sは変異体（%s）。ミューテーターに25当てれば退治できる。"},
  {"en": "🧬 %s is a mutant (%s).", "to": "🧬 %sは変異体（%s）。", "kanji": "🧬 %sは変異体（%s）。"},
  {"en": "Land 25 on the Mutator to kill it.", "to": "ミューテーターに25当てれば退治できる。", "kanji": "ミューテーターに25当てれば退治できる。"},
  // program_mutants.gd: the names of the Mutator's mutants, which fill the note above. The code in them stays.
  {"en": ">= becomes >", "to": ">= が > に", "kanji": ">= が > に"},
  {"en": "<= becomes <", "to": "<= が < に", "kanji": "<= が < に"},
  {"en": "> becomes >=", "to": "> が >= に", "kanji": "> が >= に"},
  {"en": "< becomes <=", "to": "< が <= に", "kanji": "< が <= に"},
  {"en": "max becomes min", "to": "max が min に", "kanji": "max が min に"},
  {"en": "min becomes max", "to": "min が max に", "kanji": "min が max に"},
  {"en": "+ 1 becomes - 1", "to": "+ 1 が - 1 に", "kanji": "+ 1 が - 1 に"},
  {"en": "- 1 becomes + 1", "to": "- 1 が + 1 に", "kanji": "- 1 が + 1 に"},
  {"en": "the sort turns around", "to": "並びが逆になる", "kanji": "並びが逆になる"},
  {"en": "* 2 becomes * 1", "to": "* 2 が * 1 に", "kanji": "* 2 が * 1 に"},
  {"en": "+ becomes -", "to": "+ が - に", "kanji": "+ が - に"},
  // trial_rules.gd and profile_rules.gd: Pip's Trial's fallback hint, and a profile name the rules refuse.
  {"en": "Read the preview and try again.", "to": "予想をよく見て、もう一度やってみよう。", "kanji": "予想をよく見て、もう一度やってみよう。"},
  {"en": "Enter a name.", "to": "名前を入れてね。", "kanji": "名前を入れてね。"},
  {"en": "Use at most %d characters.", "to": "%d文字までにしてね。", "kanji": "%d文字までにしてね。"},
  {"en": "Names cannot contain control characters.", "to": "名前に制御文字（せいぎょもじ）は使えないよ。", "kanji": "名前に制御文字は使えないよ。"},
  {"en": "That name is already in use.", "to": "その名前は、もう使われているよ。", "kanji": "その名前は、もう使われているよ。"},
  // The Halting Oracle's prediction on its own (GuardianLanding.prediction_text), as a guardian chip shows it.
  {"en": "fewer than %d bolts", "to": "ボルトは%d本より少ない", "kanji": "ボルトは%d本より少ない"},
