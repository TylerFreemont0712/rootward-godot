[
  {"en": "Gradient Ward", "to": "グラディエント・ウォード"},
  {"en": "On weakest-first attacks, each strict rise gives 1 block by shaving 1 power from its higher bolt, up to 6. With no rise, the weakest attack gives 1 block. Existing wards stay as they are.", "to": "弱い順の攻撃では、威力が上がるたびに強い方のボルトから威力を1移し、最大6ブロックを得る。上がり目がなければ、最弱の攻撃から1ブロックを得る。すでにある守りはそのまま。"},
  {"en": "Handoff Ward", "to": "ハンドオフ・ウォード"},
  {"en": "Turns Task Scheduler's idle spacers into block, up to 6 power in total; other bolts keep their power, and every idle mark is cleared.", "to": "Task Schedulerが作った待機用のスペーサーをブロックに変えます（合計威力6まで）。ほかの矢は威力を保ち、待機の印はすべて消えます。"},
  {"en": "Parity Lattice", "to": "パリティ・ラティス"},
  {"en": "In attack order, every third attack becomes block, up to 12 total block from this card. Wards and stashed bolts are skipped, and the scan stops at the first conversion that would pass 12.", "to": "攻撃を順番に数えて、三つごとの攻撃がブロックになります（このカードによるブロックは合計12まで）。ワードと索引にしまわれた矢は飛ばされ、三つ目の数え方はずれません。12を超える変換が来た時点で走査は止まります。"},
  {"en": "Collision Census", "to": "衝突調査"},
  {"en": "Among the first 24 bolts, each attack gains +1 for every other attack with the same power and element, up to +3. Wards, stashed bolts and later bolts do not count.", "to": "最初の24本の矢のうち、各攻撃は、威力と属性が同じほかの攻撃1本につき威力+1（最大+3）。ワード、索引にしまわれた矢、それ以降の矢は数えません。"},
  {"en": "Deadline Mint", "to": "デッドライン・ミント"},
  {"en": "Adds a neutral bolt aimed at the foe with the fastest attack intent (lowest tempo). Ties favour the greatest total damage; the bolt has damage × hits power, capped at 8, and nothing is added to a volley of 128 bolts or more.", "to": "攻撃意図がいちばん速い敵（tempoがいちばん小さい敵）を狙う、中立の矢を一本加えます。同率なら与えるダメージの合計がいちばん大きい敵を選びます。矢の威力はダメージ×回数で、上限は8です。矢が128本以上ある一斉射には、何も加えません。"},
  {"en": "Radix Sort", "to": "基数ソート"},
  {"en": "Stable-sorts bolt power from weakest to strongest in four base-16 passes, enough for every power up to the game's 9,999 cap.", "to": "威力を弱い順に、16進の四回の振り分けで安定に並べ替えます。四回で、ゲームの威力上限9,999までのあらゆる威力を並べられます。"},
  {"en": "Boundary Guard", "to": "境界の守り"},
  {"en": "In each recursive section with at least two attacks, turns that section's weakest attack into block. Each section can guard once; the other bolts keep attacking.", "to": "攻撃が2本以上ある再帰区間ごとに、その区間の最弱攻撃をブロックに変える。各区間で1回だけ守り、他のボルトは攻撃を続ける。"},
  {"en": "Median Pulse", "to": "中央値の脈動"},
  {"en": "Among the first 16 bolts in this section, gives the median attack bolt +2 power. Recurse applies the pulse separately to each smaller section.", "to": "この区間の最初のボルト16本から攻撃の中央値を選び、威力を+2する。Recurseで分割すると、小さな区間ごとに脈動が起こる。"},
  {"en": "Runoff Echo", "to": "上昇の残響"},
  {"en": "For each of up to three strict rises in a weakest-first attack volley, adds a 1-power echo of the stronger bolt with its element and target. Originals remain unchanged.", "to": "弱い順の攻撃で威力が上がる箇所ごとに、強いボルトの属性と狙いを引き継ぐ威力1の残響を作る。最大3本。元のボルトは変わらない。"},
  {"en": "Threat Index", "to": "脅威インデックス"},
  {"en": "For each of the first three attacking foes, binary-searches a weakest-first volley for the smallest unused bolt that covers its intent, then turns that bolt into block. Unmatched bolts still fly.", "to": "最初の三体の攻撃してくる敵それぞれについて、弱い順に並んだ一斉射から、その意図を覆える、まだ使っていないいちばん小さな矢を二分探索で選び、その矢をブロックに変えます。合わない矢は飛びます。"},
  {"en": "Builds a max-heap bottom-up in O(n), then gives its strongest root bolt +2 power. The rest stay in heap order, not sorted.", "to": "O(n)で下から最大ヒープを作り、根に来たいちばん強いボルトの威力を+2する。他は整列せず、ヒープ順のまま残る。"},
  {"en": "Builds a max-heap bottom-up in O(n), then gives its strongest root bolt +3 power. The rest stay in heap order.", "to": "最大ヒープを下から O(n) で組み立て、いちばん強い根の矢に威力+3を与えます。残りの矢はヒープの順番のままです。"},
  {"en": "Reorders the volley so no two bolts of one element are neighbours. When no other element is left to run, it inserts a 1-power spacer marked idle; Handoff Ward can turn only those spacers into block.", "to": "同じ属性の矢が隣り合わないように、一斉射を並べ替えます。ほかの属性の矢が残っていなければ、威力1の待機用スペーサー（待機の印付き）を入れます。Handoff Wardは、そのスペーサーだけをブロックに変えられます。"},
  {"en": "Reorders the volley so no two bolts of one element are neighbours. When no other element is left to run, it inserts a 2-power spacer marked idle; Handoff Ward can turn only those spacers into block.", "to": "同じ属性の矢が隣り合わないように、一斉射を並べ替えます。ほかの属性の矢が残っていなければ、威力2の待機用スペーサー（待機の印付き）を入れます。Handoff Wardは、そのスペーサーだけをブロックに変えられます。"},
  {"en": "Shuffles the first six bolts until they sort or 120 shuffles pass. A successful sort gives those bolts +1 power; at the cap, the strongest bolt in the best attempt gets +3. Absurd work. volatile: gone if not played.", "to": "最初の6本を並べ替え、整列するか120回試すまで続ける。整列できれば対象ボルトの威力+1。上限まで成功しなければ、最良の試行にある最強ボルトの威力を+3する。仕事量は膨大。volatile：使わないと消える。"},
  {"en": "Finds the weakest bolt in each unsorted suffix and swaps it to the front. Always weakest first, with n² comparisons even on a sorted volley.", "to": "未整列部分から最弱のボルトを探して先頭と交換する。常に弱い順になり、整列済みの入力でも比較回数はn²。"},
  {"en": "A bounded 0/1 bitset prefers exact lethal damage, then the lowest lethal total through 1,024 power. Above that range, it selects the strongest bolts first until they kill. An exact kill can turn weak spare bolts into block, limited to the largest attack intent among surviving foes; other spare attacks go to the next foe.", "to": "上限付きの0/1ビットセットで、まず敵をちょうど倒す組を探し、攻撃力1,024までなら倒せる最小合計も探す。それを超える場合は強いボルトから選び、敵を倒す。ぴったり倒せたときは、生き残った敵の最大攻撃分まで余った弱いボルトをブロックにし、他は次の敵へ向ける。"},
  {"en": "Searches the first two foes in order with a bounded 0/1 bitset: exact lethal totals first, then the lowest lethal total through 1,024 power. Above that range, each target uses strongest-first greedy. Exact kills can turn weak spare bolts into block, limited to attack intent among foes left alive after both searches; other bolts go to the next foe.", "to": "上限付きの0/1ビットセットで、先頭2体を順に探索する。まずぴったり倒す組を探し、攻撃力1,024までなら倒せる最小合計も探す。それを超える場合は強いボルトから選ぶ。ぴったり倒したとき、両方の探索後に生き残った敵の攻撃分まで余った弱いボルトをブロックにする。他のボルトは次の敵へ向かう。"},
  {"en": "A bounded 64-bit bitset finds the closest split through 1,024 total attack power, using at most nine words per bolt. Above that, deterministic strongest-first greedy places each bolt on the lighter side. The larger side attacks; the smaller becomes block up to incoming threat, with any excess kept as attack. Only a truly equal split gets +25% on both groups. Existing wards pass through.", "to": "攻撃力の合計が1,024以下なら、最大9個の64ビット語を使うビットセットで半分に最も近い組を探す。それを超えると、強いボルトから順に合計が小さい側へ振り分ける。大きい側が攻撃し、小さい側は敵の攻撃分までブロックにする。余りは攻撃のまま。完全に同じ合計のときだけ両方に威力+25%。既存の守りはそのまま通す。"},
  {"en": "A bounded 64-bit bitset finds the closest split through 1,024 total attack power, using at most nine words per bolt. Above that, deterministic strongest-first greedy places each bolt on the lighter side. The larger side attacks; the smaller becomes block up to incoming threat, with any excess kept as attack. Only a truly equal split gets the forge’s +40% bonus on both groups. Existing wards pass through.", "to": "攻撃力の合計が1,024以下なら、最大9個の64ビット語を使うビットセットで半分に最も近い組を探す。それを超えると、強いボルトから順に合計が小さい側へ振り分ける。大きい側が攻撃し、小さい側は敵の攻撃分までブロックにする。余りは攻撃のまま。完全に同じ合計のときだけ両方に威力+40%。既存の守りはそのまま通す。"},
  {"en": "Shuffles the first seven bolts, seeded by the turn and the bolts. If they reach sorted order, each gains +1 power; if the 120-try cap is reached first, the strongest bolt in the best try gains +3. Bolts after the first seven pass through unchanged. Absurd work. volatile: gone if not played.", "to": "ターン数とボルトを種にして、最初の7本を並べ替える。整列すれば各ボルトの威力+1。120回試しても整列しなければ、最良の試行にある最強ボルトの威力を+3する。7本目以降は変わらない。仕事量は膨大。volatile：使わないと消える。"}
]
