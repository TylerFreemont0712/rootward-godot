// Japanese for Lanternroot's overworld screens (ADR-0061): the boots editor, the creator, Hotaru's remarks and the
// boots' own messages, keyed by the English exactly (ADR-0047). The words match the talk overlay (overworld-talk.jsonc):
// くつ for boots, しゅうりやさん for the tinker, ルール, コード and キー, in hiragana first with spaces between phrases.
// Code (on_key, onKey, x, y), Python, JavaScript, the arrows and the placeholders stay as they are.
[
  // The boots editor
  {"en": "Your boots", "to": "きみの くつ"},
  {"en": "Blocks", "to": "ブロック"},
  {"en": "Python", "to": "Python"},
  {"en": "JavaScript", "to": "JavaScript"},
  {"en": "+ Add a rule", "to": "+ ルールを ふやす"},
  {"en": "When", "to": "もし"},
  {"en": "is pressed:", "to": "を おしたら、"},
  {"en": "change", "to": "かえる："},
  {"en": "by", "to": "を"},
  {"en": "↑  up", "to": "↑  うえ"},
  {"en": "↓  down", "to": "↓  した"},
  {"en": "←  left", "to": "←  ひだり"},
  {"en": "→  right", "to": "→  みぎ"},
  {"en": "x  across", "to": "x  よこ"},
  {"en": "y  down", "to": "y  たて"},
  {"en": "x is across (right makes x bigger), y is down (down makes y bigger).", "to": "x は よこ（みぎへ いくと おおきく なる）、y は たて（したへ いくと おおきく なる）。"},
  {"en": "No rules yet. Add one, and your boots will know what to do with a key.", "to": "まだ ルールが ないよ。ひとつ ふやすと、くつが キーで どう うごくか わかるよ。"},
  {"en": "The code your blocks make:", "to": "ブロックが つくる コード："},
  {"en": "Try them  ▶", "to": "ためしてみる  ▶"},
  {"en": "Not run yet. Press Try them to run these.", "to": "まだ うごかして いないよ。「ためしてみる」を おしてね。"},
  {"en": "Hotaru is trying your boots on…", "to": "ほたるが くつを ためして いるよ…"},
  {"en": "Each rule says what one key does. x is how far across you are; y is how far down.", "to": "ルールは、ひとつの キーで なにが おきるかを きめるよ。x は よこに どれだけ いるか、y は したに どれだけ いるか。"},
  {"en": "Your first rule: when right is pressed, x goes up by 1. Press Try them, then walk right.", "to": "さいしょの ルール：みぎを おすと、x が 1 ふえるよ。「ためしてみる」を おしてから、みぎへ あるいて みてね。"},
  {"en": "All four ways! You can change them however you like.", "to": "4つ ぜんぶ おぼえたね！ すきなように かえて いいよ。"},
  {"en": "Your boots know %d of the four keys. Still to teach: %s.", "to": "くつは 4つの キーの うち %d つを しって いるよ。あと：%s。"},
  {"en": "Your boots know: %s.", "to": "くつが しって いる キー：%s。"},
  {"en": "Your boots loaded, but no key moves you yet.", "to": "くつは よみこめたけど、まだ どの キーでも うごかないよ。"},
  {"en": "They remember things between steps; each step should depend only on the key and where you stand.", "to": "くつが いっぽごとに なにかを おぼえて いるよ。いっぽは、キーと いまの ばしょ だけで きまるように しよう。"},

  // Key names, as the boots and Hotaru say them
  {"en": "up", "to": "うえ"},
  {"en": "down", "to": "した"},
  {"en": "left", "to": "ひだり"},
  {"en": "right", "to": "みぎ"},

  // Walking: Hotaru's remarks and the help line
  {"en": "Arrows: walk   Space: talk   B: boots   Esc: leave", "to": "やじるし：あるく   スペース：はなす   B：くつ   Esc：でる"},
  {"en": "Space: talk to %s", "to": "スペース：%s と はなす"},
  {"en": "Space: read", "to": "スペース：よむ"},
  {"en": "Hotaru is reading your boots...", "to": "ほたるが くつを よんで いるよ..."},
  {"en": "Your boots are empty! Press B to open them.", "to": "くつが からっぽだよ！ B を おして ひらいてね。"},
  {"en": "Your boots don't know the %s key yet. Press B to teach them.", "to": "くつは まだ %s の キーを しらないよ。B を おして おしえて あげてね。"},
  {"en": "Your boots tripped on line %d: %s", "to": "くつが %d ぎょうめで つまずいたよ：%s"},
  {"en": "Whoa! Boots only take one step at a time: change x or y by 1.", "to": "わっ！ くつは いちどに いっぽ だけ。x か y を 1 だけ かえてね。"},
  {"en": "That step would take you right off the map!", "to": "その いっぽで、ちずの そとに でちゃうよ！"},
  {"en": "Bonk! Something is in the way.", "to": "ゴツン！ なにかが じゃまを しているよ。"},

  // The boots' own messages (the sandbox and its harnesses)
  {"en": "boots run in Python or JavaScript", "to": "くつは Python か JavaScript で うごくよ"},
  {"en": "the boots did not answer", "to": "くつが こたえなかったよ"},
  {"en": "the boots answered for the wrong number of tiles", "to": "くつの こたえの かずが、ますの かずと あわないよ"},
  {"en": "your boots took too long: is there a loop that never ends?", "to": "くつが じかんを かけすぎたよ。おわらない くりかえしが ないかな？"},
  {"en": "the recursion went too deep", "to": "関数が じぶんを よびすぎたよ"},
  {"en": "there is no function on_key(key, player)", "to": "on_key(key, player) という 関数が ないよ"},
  {"en": "there is no function onKey(key, player)", "to": "onKey(key, player) という 関数が ないよ"},

  // The creator
  {"en": "Who are you?", "to": "きみは だれ？"},
  {"en": "The new tinker of Lanternroot. Make yourself!", "to": "ともしび村の あたらしい しゅうりやさん。じぶんを つくろう！"},
  {"en": "Name", "to": "なまえ"},
  {"en": "Tinker", "to": "しゅうりやさん"},
  {"en": "Hair", "to": "かみがた"},
  {"en": "Hair colour", "to": "かみの いろ"},
  {"en": "Skin", "to": "はだの いろ"},
  {"en": "Clothes", "to": "ふく"},
  {"en": "Clothes colour", "to": "ふくの いろ"},
  {"en": "Trim colour", "to": "ふちの いろ"},
  {"en": "Something extra", "to": "アクセサリー"},
  {"en": "Surprise me", "to": "おまかせ"},
  {"en": "That's me!  ▶", "to": "これが わたし！  ▶"},
  {"en": "Short", "to": "ショート"},
  {"en": "Long", "to": "ロング"},
  {"en": "Bun", "to": "おだんご"},
  {"en": "Spiky", "to": "ツンツン"},
  {"en": "Fluffy", "to": "ふわふわ"},
  {"en": "Braid", "to": "みつあみ"},
  {"en": "Tunic", "to": "チュニック"},
  {"en": "Dress and apron", "to": "ワンピースと エプロン"},
  {"en": "Warm coat", "to": "あったかい コート"},
  {"en": "Vest", "to": "ベスト"},
  {"en": "Robe", "to": "ローブ"},
  {"en": "Nothing", "to": "なし"},
  {"en": "Goggles", "to": "ゴーグル"},
  {"en": "Leaf crown", "to": "はっぱの かんむり"},
  {"en": "Wide hat", "to": "つばの ひろい ぼうし"},
  {"en": "Hood", "to": "フード"},
  {"en": "Glasses", "to": "めがね"}
]
