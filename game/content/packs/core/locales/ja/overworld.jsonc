// Japanese for Lanternroot's overworld screens (ADR-0061): the boots editor, the creator, Hotaru's remarks and the
// boots' own messages, keyed by the English exactly (ADR-0047). The words match the talk overlay (overworld-talk.jsonc):
// くつ for boots, しゅうりやさん for the tinker, ルール, コード and キー, in hiragana first with spaces between phrases.
// Code (on_key, onKey, x, y), Python, JavaScript, the arrows and the placeholders stay as they are.
[
  {"en": "Hiragana", "to": "ひらがな", "kanji": "ひらがな"},
  {"en": "Kanji", "to": "かんじ", "kanji": "漢字"},
  {"en": "Japanese reading", "to": "にほんごの よみかた", "kanji": "日本語の表記"},
  {"en": "Choose hiragana or standard Japanese with kanji. You can change this in Settings anytime.", "to": "ひらがなと かんじを えらべるよ。あとから せっていで かえられるよ。", "kanji": "ひらがな中心の表記か、漢字を使った通常の日本語を選べます。設定からいつでも変更できます。"},
  // The boots editor
  {"en": "Your boots", "to": "きみの くつ", "kanji": "君の靴"},
  {"en": "Blocks", "to": "ブロック", "kanji": "ブロック"},
  {"en": "Python", "to": "Python", "kanji": "Python"},
  {"en": "JavaScript", "to": "JavaScript", "kanji": "JavaScript"},
  {"en": "+ Add a rule", "to": "+ ルールを ふやす", "kanji": "+ ルールを増やす"},
  {"en": "When", "to": "もし", "kanji": "もし"},
  {"en": "is pressed:", "to": "を おしたら、", "kanji": "を押したら、"},
  {"en": "change", "to": "かえる：", "kanji": "変える："},
  {"en": "by", "to": "を", "kanji": "を"},
  {"en": "↑  up", "to": "↑  うえ", "kanji": "↑  上"},
  {"en": "↓  down", "to": "↓  した", "kanji": "↓  下"},
  {"en": "←  left", "to": "←  ひだり", "kanji": "←  左"},
  {"en": "→  right", "to": "→  みぎ", "kanji": "→  右"},
  {"en": "x  across", "to": "x  よこ", "kanji": "x  横"},
  {"en": "y  down", "to": "y  たて", "kanji": "y  縦方向"},
  {"en": "x is across (right makes x bigger), y is down (down makes y bigger).", "to": "x は よこ（みぎへ いくと おおきく なる）、y は たて（したへ いくと おおきく なる）。", "kanji": "x は横方向（右に進むと増加）、y は縦方向（下に進むと増加）の座標です。"},
  {"en": "No rules yet. Add one, and your boots will know what to do with a key.", "to": "まだ ルールが ないよ。ひとつ ふやすと、くつが キーで どう うごくか わかるよ。", "kanji": "まだルールがありません。ルールを追加して、キーを押したときの靴の動きを決めましょう。"},
  {"en": "The code your blocks make:", "to": "ブロックが つくる コード：", "kanji": "ブロックが作るコード："},
  {"en": "Try them  ▶", "to": "ためしてみる  ▶", "kanji": "試す  ▶"},
  {"en": "Not run yet. Press Try them to run these.", "to": "まだ うごかして いないよ。「ためしてみる」を おしてね。", "kanji": "未実行です。「試す」を押して実行してください。"},
  {"en": "Hotaru is trying your boots on…", "to": "ほたるが くつを ためして いるよ…", "kanji": "ほたるが靴を試しているよ…"},
  {"en": "Each rule says what one key does. x is how far across you are; y is how far down.", "to": "ルールは、ひとつの キーで なにが おきるかを きめるよ。x は よこに どれだけ いるか、y は したに どれだけ いるか。", "kanji": "各ルールで、一つのキーの動作を指定します。x は横方向、y は縦方向の位置を表します。"},
  {"en": "Your first rule: when right is pressed, x goes up by 1. Press Try them, then walk right.", "to": "さいしょの ルール：みぎを おすと、x が 1 ふえるよ。「ためしてみる」を おしてから、みぎへ あるいて みてね。", "kanji": "最初のルールは、右キーを押すと x を1増やします。「試す」を押してから右に歩いてみましょう。"},
  {"en": "All four ways! You can change them however you like.", "to": "4つ ぜんぶ おぼえたね！ すきなように かえて いいよ。", "kanji": "4つ全部覚えたね！すきなように変えていいよ。"},
  {"en": "Your boots know %d of the four keys. Still to teach: %s.", "to": "くつは 4つの キーの うち %d つを しって いるよ。あと：%s。", "kanji": "靴は 4つのキーのうち %d つを知っているよ。後：%s。"},
  {"en": "Your boots know: %s.", "to": "くつが しって いる キー：%s。", "kanji": "靴が知っているキー：%s。"},
  {"en": "Your boots loaded, but no key moves you yet.", "to": "くつは よみこめたけど、まだ どの キーでも うごかないよ。", "kanji": "靴は読み込めたけど、まだどのキーでも動かないよ。"},
  {"en": "They remember things between steps; each step should depend only on the key and where you stand.", "to": "くつが いっぽごとに なにかを おぼえて いるよ。いっぽは、キーと いまの ばしょ だけで きまるように しよう。", "kanji": "靴が一歩ごとに何かを覚えているよ。一歩は、キーと今の場所だけで決まるようにしよう。"},

  // Key names, as the boots and Hotaru say them
  {"en": "up", "to": "うえ", "kanji": "上"},
  {"en": "down", "to": "した", "kanji": "下"},
  {"en": "left", "to": "ひだり", "kanji": "左"},
  {"en": "right", "to": "みぎ", "kanji": "右"},

  // Walking: Hotaru's remarks and the help line
  {"en": "Space: talk to %s", "to": "スペース：%s と はなす", "kanji": "Space：%s と話す"},
  {"en": "Space: read", "to": "スペース：よむ", "kanji": "Space：読む"},
  {"en": "Hotaru is reading your boots...", "to": "ほたるが くつを よんで いるよ...", "kanji": "ほたるが靴のコードを読み込んでいます…"},
  {"en": "Your boots are empty! Press B to open them.", "to": "くつが からっぽだよ！ B を おして ひらいてね。", "kanji": "靴が空っぽだよ！ B を押して開いてね。"},
  {"en": "Your boots don't know the %s key yet. Press B to teach them.", "to": "くつは まだ %s の キーを しらないよ。B を おして おしえて あげてね。", "kanji": "靴はまだ %s のキーを知らないよ。B を押して教えてあげてね。"},
  {"en": "Your boots tripped on line %d: %s", "to": "くつが %d ぎょうめで つまずいたよ：%s", "kanji": "靴が %d 行目でつまずいたよ：%s"},
  {"en": "Whoa! Boots only take one step at a time: change x or y by 1.", "to": "わっ！ くつは いちどに いっぽ だけ。x か y を 1 だけ かえてね。", "kanji": "わっ！靴は一度に一歩だけ。x か y を 1 だけ変えてね。"},
  {"en": "That step would take you right off the map!", "to": "その いっぽで、ちずの そとに でちゃうよ！", "kanji": "その一歩で、ちずの外にでちゃうよ！"},
  {"en": "Bonk! Something is in the way.", "to": "ゴツン！ なにかが じゃまを しているよ。", "kanji": "ゴツン！何かが邪魔をしているよ。"},

  // The boots' own messages (the sandbox and its harnesses)
  {"en": "boots run in Python or JavaScript", "to": "くつは Python か JavaScript で うごくよ", "kanji": "靴は Python か JavaScript で動くよ"},
  {"en": "the boots did not answer", "to": "くつが こたえなかったよ", "kanji": "靴の処理が結果を返しませんでした"},
  {"en": "the boots answered for the wrong number of tiles", "to": "くつの こたえの かずが、ますの かずと あわないよ", "kanji": "靴が返した移動先の数が、必要なマス数と一致しません"},
  {"en": "your boots took too long: is there a loop that never ends?", "to": "くつが じかんを かけすぎたよ。おわらない くりかえしが ないかな？", "kanji": "靴の処理が制限時間を超えました。無限ループがないか確認してください。"},
  {"en": "the recursion went too deep", "to": "かんすうが じぶんを よびすぎたよ", "kanji": "再帰呼び出しが深すぎます"},
  {"en": "there is no function on_key(key, player)", "to": "on_key(key, player) という かんすうが ないよ", "kanji": "on_key(key, player) 関数が定義されていません"},
  {"en": "there is no function onKey(key, player)", "to": "onKey(key, player) という かんすうが ないよ", "kanji": "onKey(key, player) 関数が定義されていません"},

  // The creator
  {"en": "Who are you?", "to": "きみは だれ？", "kanji": "キャラクター作成"},
  {"en": "The new tinker of Lanternroot. Make yourself!", "to": "ともしび村の あたらしい しゅうりやさん。じぶんを つくろう！", "kanji": "ともしび村の新しい修理屋。あなたのキャラクターを作りましょう。"},
  {"en": "Name", "to": "なまえ", "kanji": "名前"},
  {"en": "Tinker", "to": "しゅうりやさん", "kanji": "修理屋さん"},
  {"en": "Style", "to": "かみがた", "kanji": "髪型"},
  {"en": "Colour", "to": "いろ", "kanji": "色"},
  {"en": "That's me!  ▶", "to": "これが わたし！  ▶", "kanji": "このキャラクターで始める  ▶"},
  {"en": "Expand journal", "to": "てちょうを ひろげる", "kanji": "手帳を拡張"},
  {"en": "Compact view", "to": "ちいさく みる", "kanji": "簡易表示"},
  {"en": "Pip can help you build a larger quest journal.", "to": "ピップと コードを かくと、てちょうを もっと べんりに できるよ。", "kanji": "ピップとコードを書けば、履歴を確認できる便利な手帳を作れます。"},
  {"en": "%d under way", "to": "すすんでいる クエスト：%d", "kanji": "進行中のクエスト：%d"},
  {"en": "What to do", "to": "いま やること", "kanji": "次にやること"},
  {"en": "To finish this quest", "to": "クリアするには", "kanji": "クエストの達成条件"},
  {"en": "Click for quest instructions", "to": "クリックして やりかたを みる", "kanji": "クリックして手順を確認"},
  {"en": "Press Try them, then take a step.", "to": "「はいてみる」を おして、いっぽ あるこう。", "kanji": "「試す」を押してから、一歩歩きましょう。"},
  {"en": "Add another direction to your boots.", "to": "ブーツに もうひとつの むきを おしえよう。", "kanji": "ブーツにもう一つの向きを教えよう。"},
  {"en": "Press B to open your boots. The starting rule moves right. Press Try them, close the editor, and press an arrow key that your rules support.", "to": "Bで ブーツを ひらこう。はじめの ルールは みぎに あるくよ。「はいてみる」を おして、とじたら おしえた むきの やじるしキーを おそう。", "kanji": "B で靴のエディターを開きます。最初のルールでは右に歩けます。「試す」を押してエディターを閉じ、ルールを設定した矢印キーを押しましょう。"},
  {"en": "Make up, down, left and right each move one tile in the matching direction, then press Try them. Up makes y smaller; right makes x bigger.", "to": "うえ・した・ひだり・みぎの キーで、それぞれの むきに ひとマス あるけるようにして「はいてみる」を おそう。うえは yが へり、みぎは xが ふえるよ。", "kanji": "上下左右の各キーで対応する方向へ一マス移動するように設定し、「試す」を押しましょう。上に進むと y が減り、右に進むと x が増えます。"},
  {"en": "Walk through the door at the bottom of the room. Earlier steps can be finished later; your progress is kept.", "to": "へやの したにある ドアから でよう。まえの もくひょうは あとでも できるよ。できたことは のこるからね。", "kanji": "部屋のしたにあるドアから出よう。前の目標は後でもできるよ。できたことは残るからね。"},
  {"en": "Find the cabbage plot in Home Hollow. Face the gate and press X to edit its code. Run its checks, close the editor, then press Space to use it. Your boots need all four directions.", "to": "いえの ちかくの キャベツばたけへ いこう。もんを むいて Xで コードを ひらこう。チェックして とじたら、Spaceで うごかそう。ブーツは よっつの むきを しっている ひつようが あるよ。", "kanji": "家の近くのキャベツ畑へ向かいましょう。門に向かって X を押すとコードを編集できます。テストを実行してエディターを閉じ、Space で門を使ってください。靴には上下左右の移動ルールが必要です。"},
  {"en": "Your progress() fills quest bars and unlocks the expanded journal.", "to": "progress()で クエストの バーが うごき、てちょうを ひろげられるよ。", "kanji": "progress() が進捗バーを更新し、拡張された手帳を使えるようにします。"},
  {"en": "Pip's bar fills up now! Open Quests and choose Expand journal to see your history.", "to": "ピップの バーが うごくよ！ クエストを ひらいて「てちょうを ひろげる」を えらぶと、できたことも みられるよ。", "kanji": "ピップの進捗バーが動いたよ！クエストから「手帳を拡張」を選ぶと、これまでの履歴も確認できるよ。"},
  {"en": "Press B. Add a rule for another arrow key and change x or y by one tile. Press Try them to check it.", "to": "Bを おそう。べつの やじるしキーの ルールを たして、xか yを ひとマス かえよう。「はいてみる」で たしかめよう。", "kanji": "B を押して別の矢印キーのルールを追加し、x または y を一マス分変化させてください。「試す」で動作を確認できます。"},
  {"en": "T: track   Esc: back", "to": "T：おいかける   Esc：もどる", "kanji": "T：追跡   Esc：戻る"},
]
