// Japanese for Lanternroot's chapter 3 quests and for the talk of Pip, Brisk, Nix, Brannoc, Morrow, Fern, Hollis,
// Nym, Mira, Vell, Orin, Lumen and Hotaru's glow (Concept/v0.4/06), keyed by the English exactly (ADR-0047). Code
// (the functions, the values in quotes, the keys and the placeholders) stays as it is.
[
  // quests.jsonc: the titles, summaries, steps and hints of chapter 3's quests.
  {"en": "A drill can pass by luck. Does yours tell Brisk's double apart from a right one?", "to": "ドリルは まぐれで とおる ことも あるよ。きみの ドリルは、ブリスクの double と ただしい double を みわけられる？", "kanji": "ドリルはまぐれで通ることもあるよ。君のドリルは、ブリスクの double と正しい double を見分けられる？"},
  {"en": "A lock is only as good as the codes it refuses. Nix wants a checker that tells good codes from bad ones.", "to": "かぎの つよさは、はじく あんごうしだい。ニックスは、いい あんごうと わるい あんごうを みわける チェッカーを ほしがって いるよ。", "kanji": "鍵の強さは、弱い暗証番号を拒否できるかどうかで決まります。ニックスが求めているのは、強い暗証番号と弱い暗証番号を見分ける判定関数です。"},
  {"en": "A neat bag is a happy bag, and Mira knows bags. Teach yours to count its things and to tidy itself.", "to": "きれいな かばんは しあわせな かばん。ミラは かばんに くわしいよ。きみの かばんに、ものを かぞえる ことと、じぶんで かたづける ことを おしえて あげよう。", "kanji": "綺麗な鞄は幸せな鞄。ミラは鞄に詳しいよ。君の鞄に、ものを数えることと、自分で片付けることを教えてあげよう。"},
  {"en": "A price for one, times how many. An item not on the list costs nothing.", "to": "ひとつの ねだん かける かず。リストに のって いない もちものは、ただ。", "kanji": "単価に個数を掛けるの。価格表に載っていない品物は無料よ。"},
  {"en": "A remainder can repeat a pattern, second after second.", "to": "わりざんの あまりで、もようを びょうごとに くりかえせるよ。", "kanji": "割り算の余りで、模様を秒ごとに繰り返せるよ。"},
  {"en": "A tidy bag", "to": "きれいな かばん", "kanji": "綺麗な鞄"},
  {"en": "Add every count together, not the number of piles.", "to": "それぞれの かずを ぜんぶ たそう。山の かずでは ないよ。", "kanji": "それぞれの数を全部足そう。山の数ではないよ。"},
  {"en": "At last, a shop with prices. Sell what you pick, and buy what you need with coins.", "to": "やっと、ねだんの ある おみせ！ ひろった ものを うって、ひつような ものを コインで かおう。", "kanji": "やっと、値段のあるお店！拾ったものを売って、必要なものをコインで買おう。"},
  {"en": "Brisk's drills", "to": "ブリスクの ドリル", "kanji": "ブリスクのドリル"},
  {"en": "Brisk's first works for most lists. Which lists are not like most?", "to": "ブリスクの first は、ほとんどの リストで ちゃんと はたらくよ。ほとんどと ちがう リストは どれかな？", "kanji": "ブリスクの first は、ほとんどのリストでちゃんと働くよ。ほとんどと違うリストはどれかな？"},
  {"en": "Buy something from Nym.", "to": "ニムから なにかを かって みよう。", "kanji": "ニムから何かを購入しよう。"},
  {"en": "Check the hour against a range, one range at a time.", "to": "じかんを はんいと くらべよう。はんいは ひとつずつ。", "kanji": "時間を範囲と比べよう。範囲は一つずつ。"},
  {"en": "Count the characters first. Then look at each one.", "to": "まずは もじの かずを かぞえよう。それから ひとつずつ みて いこう。", "kanji": "まずは文字の数を数えよう。それから一つずつ見て行こう。"},
  {"en": "Count the lines from 1, the way a reader does.", "to": "ぎょうは 1から かぞえよう。よむ ひとと おなじように。", "kanji": "行番号は、文章を読むときと同じように1から数えます。"},
  {"en": "Do not change the list you were given. Make a new one.", "to": "もらった リストは かえない。あたらしい リストを つくろう。", "kanji": "もらったリストは変えない。新しいリストを作ろう。"},
  {"en": "Does total see every number in the list?", "to": "total は、リストの すうじを ぜんぶ みて いるかな？", "kanji": "total は、リストの数字を全部見ているかな？"},
  {"en": "Every version of your code is a page in the Archive. Vell wants a changelog that says what changed.", "to": "きみの コードの バージョンは、ぜんぶ きろくこの ページに なるよ。ヴェルは、なにが かわったかを かいた へんこう きろくを ほしがって いるよ。", "kanji": "コードの各バージョンは記録庫の一ページになります。ヴェルのために、変更箇所を示す変更履歴を作りましょう。"},
  {"en": "Everyone's hours", "to": "みんなの じかん", "kanji": "みんなの時間"},
  {"en": "Exactly enough coins is enough.", "to": "ちょうど ある コインなら、それで たりるよ。", "kanji": "ちょうどあるコインなら、それで足りるよ。"},
  {"en": "Fern's weather", "to": "ファーンの てんき", "kanji": "ファーンの天気"},
  {"en": "Follow each step. What goes into the list first?", "to": "ひとつずつ たどろう。リストに さいしょに はいる ものは なに？", "kanji": "一つずつ辿ろう。リストに最初に入るものは何？"},
  {"en": "Follow the loop one turn at a time.", "to": "くりかえしを、ひと まわりずつ たどろう。", "kanji": "ループの処理を一回ずつ追ってみましょう。"},
  {"en": "Four of the same digit is a very easy guess.", "to": "おなじ すうじが よっつ ならぶ あんごうは、とても あてやすいよ。", "kanji": "同じ数字が四つ並ぶ暗号は、とてもあてやすいよ。"},
  {"en": "Go down the list. Only the lit ones count.", "to": "リストを ひとつずつ みよう。ともって いる ものだけ かぞえるよ。", "kanji": "リストを一つずつ見よう。灯っているものだけ数えるよ。"},
  {"en": "Hear Hotaru ask for a glow of her own.", "to": "ほたるが じぶんだけの ひかりを ほしがるのを きこう。", "kanji": "ほたるが自分だけの光を欲しがるのを聞こう。"},
  {"en": "Hollis is tired of standing in one place all day, and so is everyone. Write where people go, hour by hour.", "to": "ホリスは、いちにち じゅう おなじ ところに たつのが つかれたって。みんなも おなじだよ。ひとが どこへ いくかを、じかんごとに かこう。", "kanji": "ホリスは、一日中同じ場所に立っているのに疲れたらしい。村のみんなも同じだ。時間ごとの行き先をコードで決めよう。"},
  {"en": "Hotaru has only ever shone with a borrowed light. She asks the tinker for a glow of her own.", "to": "ほたるは ずっと、かりた ひかりで ひかって きたの。じぶんだけの ひかりを、しゅうりやさんに たのんで いるよ。", "kanji": "ほたるはずっと、かりた光で光ってきたの。自分だけの光を、修理屋さんに頼んでいるよ。"},
  {"en": "Hotaru's glow", "to": "ほたるの ひかり", "kanji": "ほたるの光"},
  {"en": "Let the old stones rest.", "to": "ふるい いしを やすませよう。", "kanji": "古い石をやすませよう。"},
  {"en": "Morrow's old stones", "to": "モロウの ふるい いし", "kanji": "モロウの古い石"},
  {"en": "Nix's lock", "to": "ニックスの かぎ", "kanji": "ニックスの鍵"},
  {"en": "Open the Workbench's changelog.", "to": "さぎょうだいの へんこう きろくを ひらこう。", "kanji": "作業台の変更履歴を開こう。"},
  {"en": "Pip's count", "to": "ピップの かぞえ", "kanji": "ピップの数え"},
  {"en": "Pip's tally board by the Root says how many lanterns are lit. Teach it to count only the lit ones.", "to": "ねっこの そばの ピップの かぞえ かんばんには、ともって いる ランタンが なんこ かいて あるよ。ともって いる ものだけ かぞえる ように おしえよう。", "kanji": "根のそばにあるピップの集計板には、灯っているランタンの数が表示されるよ。点灯しているものだけを数えるようにしてみよう。"},
  {"en": "Read Pip's tally board by the Root.", "to": "ねっこの そばの ピップの かぞえ かんばんを よもう。", "kanji": "根のそばにあるピップの集計板を読もう。"},
  {"en": "Read the first stone: what does its loop give?", "to": "さいしょの いしを よもう：くりかえしは、なにを かえす？", "kanji": "最初の石を読もう：繰り返しは、何を返す？"},
  {"en": "Read the second stone: what does its if give?", "to": "にばんめの いしを よもう：if は、なにを かえす？", "kanji": "二番目の石を読もう：if 文は何を返す？"},
  {"en": "Read the third stone: what list does it build?", "to": "さんばんめの いしを よもう：どんな リストを つくる？", "kanji": "三番目の石を読もう：どんなリストを作る？"},
  {"en": "Same iron in, same tool out, and nothing else touched. Brannoc's forge needs a function that keeps its word.", "to": "おなじ てつを いれたら、おなじ どうぐが でる。ほかの ものには さわらない。ブラノックの かじばには、やくそくを まもる かんすうが ひつようだ。", "kanji": "同じ鉄を入れたら、同じ道具が出る。他のものにはさわらない。ブラノックの鍛冶場には、約束を守る関数が必要だ。"},
  {"en": "Sell something to Nym.", "to": "ニムに なにかを うって みよう。", "kanji": "ニムに何かを売ってみよう。"},
  {"en": "Someone wrote Brisk's drills wrong. A drill that never fails catches nothing, so write drills that catch the bugs.", "to": "だれかが ブリスクの ドリルを まちがえて かいて しまったよ。しっぱいしない ドリルは、なにも つかまえられない。だから、バグを つかまえる ドリルを かこう。", "kanji": "誰かがブリスクのドリルを間違えて書いてしまったよ。失敗しないドリルは、何も捕まえられない。だから、バグを捕まえるドリルを書こう。"},
  {"en": "Take Brisk's pebble medal.", "to": "ブリスクの こいしの メダルを もらおう。", "kanji": "ブリスクの小石のメダルをもらおう。"},
  {"en": "Take the gear Brannoc forges.", "to": "ブラノックが きたえた はぐるまを もらおう。", "kanji": "ブラノックが鍛えた歯車をもらおう。"},
  {"en": "Take the key from Nix's lockbox.", "to": "ニックスの かぎの はこから、かぎを とろう。", "kanji": "ニックスの鍵の箱から、鍵を取ろう。"},
  {"en": "Talk to Brannoc about the forge.", "to": "ブラノックに、かじばの ことを きこう。", "kanji": "ブラノックに、鍛冶場のことを聞こう。"},
  {"en": "Talk to Fern about the rain.", "to": "ファーンに、あめの ことを きこう。", "kanji": "ファーンに、雨のことを聞こう。"},
  {"en": "Talk to Hollis about the hours.", "to": "ホリスに、じかんの ことを きこう。", "kanji": "ホリスに、時間のことを聞こう。"},
  {"en": "Talk to Mira about the bag.", "to": "ミラに、かばんの ことを きこう。", "kanji": "ミラに、鞄のことを聞こう。"},
  {"en": "Talk to Morrow about the old stones.", "to": "モロウに、ふるい いしの ことを きこう。", "kanji": "モロウに、古い石のことを聞こう。"},
  {"en": "Talk to Nix about the lockbox.", "to": "ニックスに、かぎの はこの ことを きこう。", "kanji": "ニックスに、鍵の箱のことを聞こう。"},
  {"en": "Talk to Nym about the shop.", "to": "ニムに、おみせの ことを きこう。", "kanji": "ニムに、お店のことを聞こう。"},
  {"en": "Talk to Pip about the tally board.", "to": "ピップに、かぞえ かんばんの ことを きこう。", "kanji": "ピップに、集計板のことを聞こう。"},
  {"en": "Talk to Sergeant Brisk about the drills.", "to": "ぐんそう ブリスクに、ドリルの ことを きこう。", "kanji": "軍曹ブリスクに、ドリルのことを聞こう。"},
  {"en": "Talk to Vell about the changelog.", "to": "ヴェルに、へんこう きろくの ことを きこう。", "kanji": "ヴェルに、変更履歴のことを聞こう。"},
  {"en": "The days repeat. A remainder can find where a day sits in the cycle.", "to": "ひには くりかえす ものが ある。わりざんの あまりで、その ひが くりかえしの なかの どこに あるかを みつけられるよ。", "kanji": "日々の天気は周期的に繰り返す。割り算の余りを使えば、何日目が周期のどこに当たるか分かる。"},
  {"en": "The forge never lies", "to": "かじばは うそを つかない", "kanji": "鍛冶場はうそを付かない"},
  {"en": "The grove needs rain, and the town has no weather at all. Write the weather, one day at a time.", "to": "もりには あめが ひつようなのに、村には てんきが ぜんぜん ない。ひとつの ひずつ、てんきを かこう。", "kanji": "木立には雨が必要なのに、村には天気がない。日ごとの天気を決める関数を書こう。"},
  {"en": "The old stones carry old code. Read what each one says, and they can rest.", "to": "ふるい いしには ふるい コードが はいって いる。それぞれの いしが なにを いって いるかを よめば、やすめるよ。", "kanji": "古い石には古いコードが入っている。それぞれの石が何を言っているかを読めば、休めるよ。"},
  {"en": "The same things, in a new order. Nothing gets lost.", "to": "おなじ ものを、あたらしい じゅんばんで。なにも なくならないよ。", "kanji": "同じものを、新しい順番で。何もなくならないよ。"},
  {"en": "Tidy your bag with T.", "to": "T で かばんを かたづけよう。", "kanji": "T で鞄を片付けよう。"},
  {"en": "Vell's changelog", "to": "ヴェルの へんこう きろく", "kanji": "ヴェルの変更履歴"},
  {"en": "Watch someone walk to their hour.", "to": "だれかが じぶんの じかんに あるいて いくのを みよう。", "kanji": "誰かが自分の時間に歩いていくのを見よう。"},
  {"en": "Watch the rain fall in town.", "to": "まちに あめが ふるのを みよう。", "kanji": "町に雨がふるのを見よう。"},
  {"en": "Which word does the if check, and which branch runs?", "to": "if は どの ことばを しらべて、どちらの ほうが うごく？", "kanji": "if はどの言葉を調べて、どちらのほうが動く？"},
  {"en": "Write can_buy: do you have enough coins?", "to": "can_buy を かこう：コインは たりる？", "kanji": "can_buy を書こう：コインは足りる？"},
  {"en": "Write changed again: new lines at the end count too.", "to": "changed を もういちど かこう：おわりに ついた あたらしい ぎょうも、かぞえて ね。", "kanji": "changed をもう一度書こう：終わりに付いた新しい行も、数えてね。"},
  {"en": "Write changed: which lines differ?", "to": "changed を かこう：どの ぎょうが ちがう？", "kanji": "changed を書こう：どの行が違う？"},
  {"en": "Write count: how many lanterns are lit?", "to": "count を かこう：ともって いる ランタンは なんこ？", "kanji": "count を書こう：灯っているランタンは何個？"},
  {"en": "Write drills: catch the bug in double.", "to": "drills を かこう：double の バグを つかまえよう。", "kanji": "drills を書こう：double のバグを捕まえよう。"},
  {"en": "Write drills: catch the bug in first.", "to": "drills を かこう：first の バグを つかまえよう。", "kanji": "drills を書こう：first のバグを捕まえよう。"},
  {"en": "Write drills: catch the bug in total.", "to": "drills を かこう：total の バグを つかまえよう。", "kanji": "drills を書こう：total のバグを捕まえよう。"},
  {"en": "Write forge: which tool do these materials make?", "to": "forge を かこう：この ざいりょうから、どの どうぐが できる？", "kanji": "forge を書こう：この材料から、どの道具ができる？"},
  {"en": "Write glow: how bright is each second?", "to": "glow を かこう：びょうごとの あかるさは どれくらい？", "kanji": "glow を書こう：秒ごとの明るさはどれくらい？"},
  {"en": "Write good_code again: refuse the easy codes.", "to": "good_code を もういちど かこう：かんたんな あんごうは はじこう。", "kanji": "good_code をもう一度書こう：簡単な暗号は弾こう。"},
  {"en": "Write good_code: is this a good lock code?", "to": "good_code を かこう：これは いい かぎの あんごうかな？", "kanji": "good_code を書こう：これはいい鍵の暗号かな？"},
  {"en": "Write price: what do these goods cost?", "to": "price を かこう：この しなものは、いくらかな？", "kanji": "price を書こう：この品物の代金はいくら？"},
  {"en": "Write tidy: put the bag in name order.", "to": "tidy を かこう：かばんを なまえの じゅんに ならべよう。", "kanji": "tidy を書こう：鞄を名前の順に並べよう。"},
  {"en": "Write total: how many things are in the bag?", "to": "total を かこう：かばんに ものは ぜんぶで いくつ？", "kanji": "total を書こう：鞄にものは全部でいくつ？"},
  {"en": "Write weather: sun, rain or cloud for a day.", "to": "weather を かこう：ひとつの ひの てんきを、「sun」「rain」「cloud」の どれかで。", "kanji": "weather を書こう：その日の天気を sun、rain、cloud のいずれかで返す。"},
  {"en": "Write where: home, work or the inn, by the hour.", "to": "where を かこう：「home」「work」「inn」の どれかを、じかんごとに。", "kanji": "where を書こう：「home」「work」「inn」のどれかを、時間ごとに。"},
  // talk/archivist.jsonc
  {"en": "A changelog! I do love a changelog. Show me which lines changed.", "to": "へんこう きろく！ わたし、へんこう きろく だいすきなの。どの ぎょうが かわったか、みせて！", "kanji": "変更履歴！私、変更履歴大好きなの。どの行が変わったか、見せて！"},
  {"en": "Every version of your code is a page in the Archive. Now each page says what changed.", "to": "コードの バージョンは、どれも きろくこの ページに なるんですよ。いまは どの ページにも、なにが かわったかを かけるように なりました。", "kanji": "コードのバージョンは、どれも記録庫のページになるんですよ。今はどのページにも、何が変わったかをかけるようになりました。"},
  {"en": "I keep a changelog for every tinker. It says which lines are different from the version before.", "to": "わたしは しゅうりやさん ひとりひとりの へんこう きろくを つけて いるんですよ。まえの バージョンと ちがう ぎょうが どれかが、そこに かいて あるんです。", "kanji": "私は修理屋さん一人ひとりの変更履歴を付けているんですよ。前のバージョンと違う行がどれかが、そこに書いてあるんです。"},
  {"en": "Tell me the numbers of the lines that changed. Count from 1.", "to": "かわった ぎょうの ばんごうを おしえて ください。1から かぞえてね。", "kanji": "変わった行の番号を教えてください。1から数えてね。"},
  {"en": "Tinker, you changed your code again. Good. Every change deserves a record.", "to": "しゅうりやさん、また コードを かえたんですね。いいことです。かわった ことは、ぜんぶ きろくに のこす ねうちが ありますから。", "kanji": "修理屋さん、またコードをかえたんですね。いいことです。変わったことは、全部記録に残す価値がありますから。"},
  {"en": "Two lists of lines, side by side: the old version and the new one.", "to": "ふたつの ぎょうの リストを ならべて みましょう。ふるい バージョンと、あたらしい バージョンです。", "kanji": "二つの行のリストを並べてみましょう。古いバージョンと、新しいバージョンです。"},
  {"en": "Your changelog is still blank. Shall we write it?", "to": "きみの へんこう きろくは、まだ まっしろですよ。いっしょに かいて みましょうか？", "kanji": "君の変更履歴は、まだ真っ白ですよ。一緒に書いてみましょうか？"},
  // talk/artificer.jsonc
  {"en": "A bag that tidies itself? Ooh, I want to see it!", "to": "じぶんで かたづく かばん？ わあ、みたい！", "kanji": "自分でかたづく鞄？わあ、みたい！"},
  {"en": "First total: how many things are in the bag, with every pile counted.", "to": "まずは total よ！ 山を ぜんぶ かぞえて、かばんに ものが ぜんぶで なんこ あるかを だすの。", "kanji": "まずは total よ！各スタックの個数を合計して、鞄の中身が全部で何個あるか求めるの。"},
  {"en": "Let's tidy it.", "to": "かたづけよう。", "kanji": "片付けよう。"},
  {"en": "Teach it to count everything it holds, and to tidy itself. A neat bag is a happy bag.", "to": "かばんに、なかの ものを ぜんぶ かぞえる ことと、じぶんで かたづける ことを おしえて あげて。きれいな かばんは、しあわせな かばんなのよ。", "kanji": "鞄に、中のものを全部数えることと、自分で片付けることを教えてあげて。綺麗な鞄は、幸せな鞄なのよ。"},
  {"en": "Then tidy: the same piles, put in order by name, from A to Z.", "to": "つぎは tidy よ。おなじ 山を、なまえの じゅんに ならべるの。A から Z まで。", "kanji": "次は tidy よ。同じ山を、名前の順に並べるの。A から Z まで。"},
  {"en": "Tinker! Your bag is full, and everything in it is in no order at all.", "to": "しゅうりやさん！ かばんは いっぱいなのに、なかの ものが ぜんぜん ばらばらよ！", "kanji": "修理屋さん！鞄はいっぱいなのに、中のものがぜんぜんばらばらよ！"},
  {"en": "Your bag is still in a muddle. Shall we tidy it?", "to": "かばんは、まだ ぐちゃぐちゃよ。いっしょに かたづけよう？", "kanji": "鞄は、まだぐちゃぐちゃよ。一緒に片付けよう？"},
  {"en": "Your bag is tidy! Every pile in its place, from A to Z. A neat bag is a happy bag.", "to": "かばんが きれいに なったわ！ 山が ぜんぶ、A から Z まで きちんと ならんだわ。きれいな かばんは、しあわせな かばんなのよ！", "kanji": "鞄が綺麗になったわ！山が全部、A から Z まできちんと並んだわ。綺麗な鞄は、幸せな鞄なのよ！"},
  // talk/compiler.jsonc
  {"en": "A gear from my forge, the same as every time. Keep it well.", "to": "おれの かじばの はぐるまだ。いつもと おなじ できだ。だいじに しろよ。", "kanji": "俺の鍛冶場で作った歯車だ。いつもと同じ出来だ。大事にしろよ。"},
  {"en": "Especially the list. Make a new one, and leave the one you were given alone.", "to": "とくに リストだ。あたらしい リストを つくれ。もらった リストには、さわるな。", "kanji": "特にリストだ。新しいリストを作れ。もらったリストには、触るな。"},
  {"en": "Hm. Careful work, I hear. Good. Now try a careful forge.", "to": "ふん。ていねいに やったと きいた。いいだろう。じゃあ、ていねいな かじを やって みろ。", "kanji": "ふん。丁寧にやったと聞いた。いいだろう。じゃあ、丁寧なかじをやってみろ。"},
  {"en": "I'll forge it.", "to": "きたえて みるね。", "kanji": "鍛えてみるね。"},
  {"en": "Let's forge it.", "to": "きたえよう！", "kanji": "鍛えよう！"},
  {"en": "Look at that. A proper tool, made the right way, and the list is as I gave it.", "to": "ほら、みろ。ちゃんとした どうぐが、ただしい やりかたで できただろう。リストも、おれが わたした まま だ。", "kanji": "ほら、見ろ。ちゃんとした道具が、正しいやり方でできただろう。リストも、俺が渡したままだ。"},
  {"en": "Nothing else? Not even the list?", "to": "ほかには なにも？ リストも さわって ないの？", "kanji": "他には何も？リストも触ってないの？"},
  {"en": "Same materials in any order, the same tool out. The list you were given stays as it was.", "to": "ざいりょうは どの じゅんでも、できる どうぐは おなじだ。もらった リストは、そのまま だ。", "kanji": "材料はどの順でも、できる道具は同じだ。もらったリストは、そのままだ。"},
  {"en": "Take this gear. Every gear from my forge works the same way, every single time.", "to": "この はぐるまを もって いけ。おれの かじばの はぐるまは、どれも いつも おなじ はたらきを する。", "kanji": "この歯車を持って行け。俺の鍛冶場の歯車は、どれもいつも同じ働きをする。"},
  {"en": "The forge never lies. Same iron in, same tool out, and nothing else touched.", "to": "かじばは うそを つかない。おなじ てつを いれれば、おなじ どうぐが でる。ほかの ものには さわらない。", "kanji": "鍛冶場はうそを付かない。同じ鉄を入れれば、同じ道具が出る。他のものにはさわらない。"},
  {"en": "The iron is still waiting. Iron does not like to wait, and neither do I.", "to": "てつは まだ まって いるぞ。てつは まつのが きらいだ。おれも だ。", "kanji": "鉄はまだ待っているぞ。鉄はまつのがきらいだ。俺もだ。"},
  {"en": "The iron will keep. It always does.", "to": "てつは いたまない。いつも そうだ。", "kanji": "鉄はいたまない。いつもそうだ。"},
  // talk/guard.jsonc
  {"en": "At last, a rest! I am going to sit down. Right here, on the gate.", "to": "やっと やすめる！ ここの もんに すわるよ。", "kanji": "やっと休める！ここの門に座るよ。"},
  {"en": "Everyone is still standing in one place. Shall we get them walking?", "to": "みんな、まだ おなじ ところに たって いるね。あるかせて みようか？", "kanji": "みんな、まだ同じところに立っているね。歩かせてみようか？"},
  {"en": "Fine. I will stay here. I am very good at standing.", "to": "いいよ。ここに いるよ。たつのは とくいだから。", "kanji": "いいよ。ここにいるよ。たつのは得意だから。"},
  {"en": "Home, work and the inn. A different place for each hour of the day.", "to": "いえ、しごと、やどや。いちにちの じかんごとに、ちがう ばしょへ。", "kanji": "家、仕事、宿屋。一日の時間ごとに、違う場所へ。"},
  {"en": "I'll make them walk.", "to": "あるかせて みるね。", "kanji": "歩かせてみるね。"},
  {"en": "Most of the night is spent at home. The middle of the day is for work. The evening is for the inn.", "to": "よるは ほとんど いえで すごす。ひるの まんなかは しごと。ゆうがたは やどやへ。", "kanji": "夜はほとんど家ですごす。昼の真ん中は仕事。夕方は宿屋へ。"},
  {"en": "Poor things! Everyone should have somewhere to go, and a time to go there.", "to": "かわいそう！ みんなにも、いく ところと、いく じかんが あったら いいよね！", "kanji": "かわいそう！みんなにも、行くところと、行く時間があったらいいよね！"},
  {"en": "So has everyone else in town. Nobody walks anywhere. They just stand where they were put.", "to": "まちの ほかの みんなも おなじだよ。だれも あるいて いない。おかれた ところに、ただ たって いるだけなんだ。", "kanji": "町の他のみんなも同じだよ。誰も歩いていない。置かれたところに、ただ立っているだけなんだ。"},
  {"en": "Someone walked to the right place at the right hour, just as your code said!", "to": "だれかが、ただしい ばしょへ、ただしい じかんに あるいて いったよ。きみの コードの とおりに！", "kanji": "誰かが、君のコードの通りに、決まった時間に正しい場所へ歩いていったよ！"},
  {"en": "Tinker! Could you help me with a thing? I have stood in this one spot since sunrise.", "to": "しゅうりやさん！ ちょっと てつだって くれる？ わたしは あさから ずっと、この ひとつの ばしょに たって いるんだ。", "kanji": "修理屋さん！ちょっと手伝ってくれる？私は朝からずっと、この一つの場所に立っているんだ。"},
  {"en": "Write where(person, hour): home, work or inn. The hour is a number from 0 to 23.", "to": "where(person, hour) を かこう：「home」「work」「inn」の どれか。hour は 0 から 23 までの かずだよ。", "kanji": "where(person, hour) を書こう：「home」「work」「inn」のどれか。hour は 0 から 23 までの数だよ。"},
  // talk/guildmaster.jsonc
  {"en": "Lanternroot has its parts back, but it is so still. Nobody keeps an hour. Not even the rain.", "to": "ともしび村は パーツを とりもどしたが、まだ とても しずかじゃ。だれも じかんを まもって おらん。あめさえも、そうじゃ。", "kanji": "ともしび村はパーツをとりもどしたが、まだとても静かじゃ。誰も時間を守っておらん。雨さえも、そうじゃ。"},
  {"en": "Listen. The rain falls on the days it should, and everyone keeps their hours.", "to": "よく きいて おくれ。あめは ふる ひに ふり、みんなは じかんを まもって おる。", "kanji": "耳を澄ませておくれ。雨は決まった日に降り、みんなが時間通りに暮らしておる。"},
  {"en": "The town keeps its own time now.", "to": "村は いま、じぶんの じかんを もって おるのじゃ。", "kanji": "村は今、自分の時間を持っておるのじゃ。"},
  {"en": "Then let's wake it up!", "to": "それなら、まちを おこそう！", "kanji": "それなら、町をおこそう！"},
  // talk/hotaru-glow.jsonc
  {"en": "Blink for me, up and down. I promise I will not be too fast!", "to": "うえと したに、ぴかぴか して みせて。はやく しすぎない って、やくそく するね！", "kanji": "上としたに、ぴかぴかしてみせて。速くしすぎないって、約束するね！"},
  {"en": "Give me one number for each second, from 0 to 1. I will shine to your numbers.", "to": "びょうごとに、0 から 1 までの かずを ひとつずつ ちょうだい。その かずの とおりに ひかって みせるね。", "kanji": "秒ごとに、0 から 1 までの数を一つずつちょうだい。その数の通りに光ってみせるね。"},
  {"en": "My light is only the lantern's. I would love one with a pattern that is mine.", "to": "わたしの ひかりは、ランタンの ひかりだけなの。じぶんだけの もようの ひかりが あったら、すてきなのに。", "kanji": "私の光は、ランタンの光だけなの。自分だけの模様の光があったら、素敵なのに。"},
  {"en": "Tinker! Can you make me a glow of my own?", "to": "しゅうりやさん！ わたしだけの ひかりを つくって くれる？", "kanji": "修理屋さん！私だけの光を作ってくれる？"},
  // talk/keeper.jsonc
  {"en": "I'll write it.", "to": "かいて みるね。", "kanji": "書いてみるね。"},
  {"en": "Let the day number decide. Every week needs some rain and some sun.", "to": "ひの ばんごうで きめて もらおう。まいしゅう、あめも はれも すこしずつ ひつようなの。", "kanji": "日数から決めればいいの。毎週、雨の日も晴れの日も必要なのよ。"},
  {"en": "Let's wait for the rain.", "to": "あめを まって みよう。", "kanji": "雨を待ってみよう。"},
  {"en": "Make the weather for each day, and the clouds will do as they are told!", "to": "ひとつずつの ひの てんきを つくって！ そうしたら、くもたちも いう ことを きくよ！", "kanji": "日ごとの天気を決めてね。そうすれば、雲もその通りに動いてくれるよ！"},
  {"en": "No rush. The roots will hum until you are ready.", "to": "あわてなくて いいのよ。じゅんびが できるまで、ねっこが ハミングして いるから。", "kanji": "あわてなくていいのよ。準備ができるまで、根がハミングしているから。"},
  {"en": "Rain on the grove! Every leaf is shining, and the roots are singing!", "to": "もりに あめ！ はっぱは ぜんぶ きらきら、ねっこは うたって いるわ！", "kanji": "森に雨！葉っぱは全部きらきら、根は歌っているわ！"},
  {"en": "Sit with me under the Root. We'll wake on the first day your weather says rain.", "to": "ねっこの したで、いっしょに すわりましょう。きみの てんきで、あめに なった さいしょの ひに、目を さますのよ。", "kanji": "根の下で、一緒に座りましょう。君の天気予報で、初めて雨が降る日に目を覚ますのよ。"},
  {"en": "The grove is so thirsty, though. Shall we wait for your first rain?", "to": "でも、もりは とても のどが かわいて いるの。さいしょの あめを、まって みましょうか？", "kanji": "でも、森はとてものどが渇いているの。最初の雨を、待ってみましょうか？"},
  {"en": "The grove is still waiting for its weather. Shall we write it?", "to": "もりは まだ、てんきを まって いるの。かいて みましょうか？", "kanji": "森はまだ、天気を待っているの。書いてみましょうか？"},
  {"en": "The grove needs rain now and then, and a sunny day every week.", "to": "もりには ときどき あめが ひつようで、まいしゅう いちどは はれの ひも ひつようなのよ。", "kanji": "木立には時々雨が必要なの。それに、毎週晴れの日もなくてはね。"},
  {"en": "Tinker! The grove is thirsty, and the roots have been waiting for rain.", "to": "しゅうりやさん！ もりは のどが かわいて、ねっこは ずっと あめを まって いたのよ！", "kanji": "修理屋さん！森はのどが渇いて、根はずっと雨を待っていたのよ！"},
  {"en": "Write weather(day): the weather for a day, as sun, rain or cloud. Day 0 is the first day.", "to": "weather(day) を かこう：ひとつの ひの てんきを、「sun」「rain」「cloud」の どれかで。0にちめ が さいしょの ひ。", "kanji": "weather(day) を書こう。日ごとの天気を sun、rain、cloud のいずれかで返すんだ。最初は0日目だよ。"},
  {"en": "Your weather is in the sky now. Every day takes its weather from your code.", "to": "きみの てんきが、そらに でたよ。ひとつひとつの ひは、きみの コードから てんきを もらって いるの。", "kanji": "君の天気が空に現れたわ。これから毎日の天気が、君のコードで決まるの。"},
  // talk/necromancer.jsonc
  {"en": "All three have spoken. Now they can rest. Nothing here is dead, you know.", "to": "みっつ ぜんぶ、はなしたね。これで やすめるわ。ここには しんだ ものなんて ないのよ、しってた？", "kanji": "三つ全部、話したね。これで休めるわ。ここには死んだものなんてないのよ、知ってた？"},
  {"en": "I'll read them.", "to": "よんで みるね。", "kanji": "読んでみるね。"},
  {"en": "Let's read it.", "to": "よんで みよう。", "kanji": "読んでみよう。"},
  {"en": "Oh. You are the one who read Pip's board. Pip was very loud about it.", "to": "あら。ピップの かんばんを よんだ ひとね。ピップは、それは それは おおきな こえで いって いたのよ。", "kanji": "あら。ピップの看板を読んだ人ね。ピップは、それはそれは大きな声で行っていたのよ。"},
  {"en": "Old code, like a riddle? I love riddles!", "to": "ふるい コードは、なぞなぞみたい？ なぞなぞ だいすき！", "kanji": "古いコードは、なぞなぞみたい？なぞなぞ大好き！"},
  {"en": "Only retired. And look, the stones are blooming!", "to": "やすんで いる だけよ。ほら、いしに お花が さいて いるわ！", "kanji": "休んでいるだけよ。ほら、石にお花が咲いているわ！"},
  {"en": "Read each stone, and say what it gives back. Tell me what they say, and they can rest.", "to": "いしを ひとつずつ よんで、なにを かえすのか いって ちょうだい。いしが なにを いって いるか おしえて くれたら、やすめるわ。", "kanji": "石を一つずつ読んで、何を返すのか言ってちょうだい。石が何を言っているか教えてくれたら、休めるわ。"},
  {"en": "Some of my old stones still talk. They talk in old code, and nobody reads it any more.", "to": "わたしの ふるい いしの なかには、いまでも はなす ものが あるの。ふるい コードで はなすけど、もう だれも よめないの。", "kanji": "私の古い石の中には、今でも話すものがあるの。古いコードで話すけど、もう誰もよめないの。"},
  {"en": "Start with the first stone. Trace its loop one turn at a time, and say what it gives back.", "to": "さいしょの いしから はじめて。くりかえしを ひと まわりずつ たどって、なにを かえすのかを いって ちょうだい。", "kanji": "最初の石から始めましょう。ループを一回ずつ追って、最後に何を返すか答えてね。"},
  {"en": "The first stone is still silent. Read its code, one line at a time.", "to": "さいしょの いしは、まだ だまったまま。コードを ひと ぎょうずつ よんで みて。", "kanji": "最初の石は、まだだまったまま。コードを人行ずつ読んでみて。"},
  {"en": "The first stone speaks! Now the second. Look at what the if checks, and which branch runs.", "to": "さいしょの いしが はなした！ つぎは にばんめ。if が なにを しらべて、どちらの ほうが うごくかを みて。", "kanji": "最初の石が話した！次はに番目。if が何を調べて、どちらのほうが動くかを見て。"},
  {"en": "The stones are quiet, and the flowers are not. Thank you, tinker.", "to": "いしは しずかに なって、お花は にぎやかに なったわ。ありがとう、しゅうりやさん。", "kanji": "石は静かになって、お花はにぎやかになったわ。ありがとう、修理屋さん。"},
  {"en": "The stones will wait. They are very good at waiting.", "to": "いしは まって くれるわ。まつのが とても じょうずなの。", "kanji": "石は待ってくれるわ。まつのがとても上手なの。"},
  {"en": "Two stones are awake. The third one builds its list backwards. Follow each step, one at a time.", "to": "ふたつの いしは、もう めを さまして いる。さんばんめの いしは、リストを うしろむきに つくって いるの。ひとつずつ、ステップを たどって みて。", "kanji": "二つの石は、もう目を覚ましたわ。三番目の石は、リストを逆順に作るの。処理を一つずつ追ってみて。"},
  // talk/oracle.jsonc
  {"en": "Hotaru has asked for a light of her own. A tinker's work, for a light that is hers.", "to": "ほたるが じぶんだけの ひかりを ほしがって いるの。しゅうりやさんの しごとよ。ほたるの ための ひかりを。", "kanji": "ほたるが自分だけの光を欲しがっているの。修理屋さんの仕事よ。ほたるのための光を。"},
  {"en": "Hotaru shines in your pattern now, and she has not stopped blinking since.", "to": "いまは ほたるが、きみの もように そって ひかって いるわ。それから ずっと、ぴかぴか しつづけて いるの。", "kanji": "今はほたるが、君の模様に沿って光っているわ。それからずっと、ぴかぴかしつづけているの。"},
  {"en": "Let's make her glow.", "to": "ひかりを つくろう。", "kanji": "光を作ろう。"},
  {"en": "Pleeease? Just one number for each second!", "to": "おねがい！ びょうごとに かず ひとつだけ！", "kanji": "おねがい！秒ごとに数一つだけ！"},
  {"en": "She will wait. Fireflies are patient, mostly.", "to": "まって いて くれるわ。ほたるは、たいてい がまんづよいの。", "kanji": "待っていてくれるわ。ほたるは、たいてい我慢強いの。"},
  {"en": "Yay! One number for each second, from 0 to 1.", "to": "やったぁ！ びょうごとに、0 から 1 までの かず ひとつ！", "kanji": "やったぁ！秒ごとに、0 から 1 までの数一つ！"},
  // talk/pip.jsonc
  {"en": "...Fine. The board is right. Ten was a long time ago.", "to": "…わかったよ。かんばんが ただしい。じゅう なんて、ずっと まえの はなしだったね。", "kanji": "…分かったよ。看板が正しい。十なんて、ずっと前の話だったね。"},
  {"en": "Eleven lanterns, Pip. You counted them.", "to": "ランタンは じゅういっこ だよ、ピップ。ピップが ちゃんと かぞえたもん。", "kanji": "ランタンは十一個だよ、ピップ。ピップがちゃんと数えたもん。"},
  {"en": "Eleven? I counted TEN! Then the board will count them, and it will not argue.", "to": "じゅういっこ？ ぼくは じゅう って かぞえたのに！ じゃあ、かんばんに かぞえて もらおう。かんばんは、いいかえさないもんね。", "kanji": "十一個？ぼくは十って数えたのに！じゃあ、看板に数えてもらおう。看板は、いいかえさないもんね。"},
  {"en": "It says ELEVEN! My board says eleven, all by itself!", "to": "かんばんが じゅういっこって いった！ ぼくの かんばんが、ひとりで じゅういっこって いったよ！", "kanji": "看板が十一個って言った！ぼくの看板が、一人で十一個って言ったよ！"},
  {"en": "Let's teach it.", "to": "おしえて あげよう。", "kanji": "教えてあげよう。"},
  {"en": "Lit ones only, tinker. A dark lantern does not count, even if it is nearly lit.", "to": "しゅうりやさん、ともって いる ものだけだよ。くらい ランタンは、もうすこしで ともりそうでも、かぞえないんだ。", "kanji": "修理屋さん、灯っているものだけだよ。暗いランタンは、もうすこしで灯りそうでも、数えないんだ。"},
  {"en": "My board still says ten. Teach it to count the lit ones!", "to": "ぼくの かんばんは、まだ じゅう って いって いる。ともって いる ものだけ かぞえる ように おしえて！", "kanji": "ぼくの看板は、まだ十って言っている。灯っているものだけ数えるように教えて！"},
  {"en": "Shh! My tally board is by the Root, and it has a terrible problem. It says TEN.", "to": "しーっ！ ぼくの かぞえ かんばんは ねっこの そばに あるんだけど、たいへんな もんだいが あるの。じゅう って いって いるんだ。", "kanji": "しーっ！ぼくの集計板は根のそばにあるんだけど、たいへんな問題があるの。十って言っているんだ。"},
  {"en": "Teach it to count. Go down the list, one lantern at a time, and count only the lit ones.", "to": "かぞえられる ように おしえて。リストを ひとつずつ、ランタンも ひとつずつ みて、ともって いる ものだけ かぞえて。", "kanji": "数えられるように教えて。リストを一つずつ、ランタンも一つずつ見て、灯っているものだけ数えて。"},
  {"en": "The board can count! Now go and look at it, by the Root. Stand by it and press Space.", "to": "かぞえ かんばんが かぞえられる ように なった！ さあ、ねっこの そばの かんばんを みに いって！ そばに たって、スペースを おして！", "kanji": "集計板が数えられるようになった！さあ、根のそばの看板をみに行って！そばに立って、スペースを押して！"},
  {"en": "There are eleven lanterns, Pip. I can see all of them.", "to": "ランタンは じゅういっこ あるよ、ピップ。ぜんぶ みえるもん。", "kanji": "ランタンは十一個あるよ、ピップ。全部見えるもん。"},
  // talk/quartermaster.jsonc
  {"en": "Bread, lantern oil and gears, on the shelves. Pay with coins, not with pebbles.", "to": "たなには パン、ランタンの あぶら、はぐるま。はらう のは コインで。こいしで はらわないでね。", "kanji": "棚にはパン、ランタンの油、歯車。払うのはコインで。小石ではらわないでね。"},
  {"en": "It has shelves, a counter and a door. It has no prices on anything.", "to": "たなが あって、カウンターが あって、とびらも ある。でも、なにひとつ ねだんが ついて いないのよ。", "kanji": "棚があって、カウンターがあって、扉もある。でも、なにひとつ値段がついていないのよ。"},
  {"en": "Let's trade!", "to": "とりひき しよう！", "kanji": "取引しよう！"},
  {"en": "Let's write them.", "to": "かいて みよう。", "kanji": "書いてみよう。"},
  {"en": "Look at that! The prices work. Coins go in, and things come out.", "to": "みて！ ねだんが はたらいたわ。コインを いれたら、ものが でて くる。", "kanji": "見て！値段が働いたわ。コインを入れたら、ものが出てくる。"},
  {"en": "Not now.", "to": "いまは だめ。", "kanji": "今はだめ。"},
  {"en": "Prices! Then things can be sold, and bought, with coins!", "to": "ねだん！ そうすれば、ものを うったり かったり コインで できるね！", "kanji": "値段！そうすれば、ものをうったりかったりコインでできるね！"},
  {"en": "Shall we trade? Sell me what you do not need. Buy what you do.", "to": "とりひき する？ いらない ものは うって。ひつような ものは かって いけばいいよ。", "kanji": "取引しようか？不要なものは売って、必要なものを買っていけばいいよ。"},
  {"en": "The shelves still have no prices. Shall we write a few?", "to": "たなには、まだ ねだんが ないのよ。いくつか かいて みる？", "kanji": "棚には、まだ値段がないのよ。いくつか書いてみる？"},
  {"en": "Then write can_buy(coins, cost): true when your coins are enough to pay.", "to": "では can_buy(coins, cost) を かいてね。しはらえる だけの コインが あれば、true よ。", "kanji": "では can_buy(coins, cost) を書いてね。しはらえるだけのコインがあれば、true よ。"},
  {"en": "Tinker. My shop is nearly open. Very, very nearly.", "to": "しゅうりやさん。おみせは もうすぐ あくよ。ほんとに、ほんとに もうすぐ。", "kanji": "修理屋さん。お店はもうすぐあくよ。本当に、本当にもうすぐ。"},
  {"en": "Write price(prices, item, count): the coins for some of an item. A thing with no price costs nothing.", "to": "price(prices, item, count) を かいて：もちものを いくつか かった ときの コイン。ねだんが ない ものは ただ。", "kanji": "price(prices, item, count) を書いてね。指定された品物と個数の代金を返すんだ。価格表にない品物は無料だよ。"},
  {"en": "Yes. A price for everything on the shelf. It would be a first for Lanternroot.", "to": "そう。たなの ぜんぶに ねだんを つけるの。ともしび村では はじめてなのよ。", "kanji": "そう。棚の全部に値段を付けるの。ともしび村では初めてなのよ。"},
  // talk/sergeant.jsonc
  {"en": "A drill is a pair: an input, and the answer it should give back. Make them catch the bugs!", "to": "ドリルは ペアだ。いれる もの と、かえして ほしい こたえ。バグを つかまえろ！", "kanji": "ドリルはペアだ。入力値と、返して欲しい答え。バグを捕まえろ！"},
  {"en": "A drill that never fails catches nothing. Three bugs are hiding in my functions.", "to": "しっぱい しない ドリルは、なにも つかまえられない。わたしの かんすうに、バグが みっつ かくれて いる！", "kanji": "失敗しないドリルは、何も捕まえられない。私の関数に、バグが三つ隠れている！"},
  {"en": "Double is caught! Good eyes. Now total. It keeps losing a number somewhere.", "to": "double を つかまえた！ いい めだ。つぎは total。どこかで かずを なくして しまう。", "kanji": "double を捕まえた！いいめだ。次は total。どこかで数を失くしてしまう。"},
  {"en": "I'll catch them.", "to": "つかまえて みせる。", "kanji": "捕まえてみせる。"},
  {"en": "Keep that pebble, tinker. Stand up straight, and keep catching bugs.", "to": "その こいしは もって いろ、しゅうりやさん。せすじを のばして、バグを つかまえつづけろ！", "kanji": "その小石は持って色、修理屋さん。背筋を伸ばして、バグをつかまえつづけろ！"},
  {"en": "Let's catch them.", "to": "つかまえよう！", "kanji": "捕まえよう！"},
  {"en": "Look at the end of the list, tinker. What does total forget?", "to": "リストの さいごを みろ、しゅうりやさん。total は なにを わすれて いる？", "kanji": "リストの最後を見ろ、修理屋さん。total は何を忘れている？"},
  {"en": "March on, then. Come back when you are ready, tinker!", "to": "では、すすめ！ じゅんびが できたら、また こい、しゅうりやさん！", "kanji": "では、進め！準備ができたら、またこい、修理屋さん！"},
  {"en": "My drills are still wrong. Three bugs, tinker. Stand up straight and catch them.", "to": "わたしの ドリルは、まだ まちがって いる。バグは みっつだ、しゅうりやさん。せすじを のばして、つかまえろ！", "kanji": "私のドリルは、まだ間違っている。バグは三つだ、修理屋さん。背筋を伸ばして、捕まえろ！"},
  {"en": "One drill set for each bug, one at a time. Start with double. Go!", "to": "バグ ひとつに ドリル ひとつ。ひとつずつ だ。まずは double から。いけ！", "kanji": "バグ一つにドリル一つ。一つずつだ。まずは double から。行け！"},
  {"en": "Take this pebble. It is a medal from my drill yard, and the best one I have.", "to": "この こいしを もって いけ。ドリルの にわの メダルだ。わたしの いちばんの ものだぞ。", "kanji": "この小石を持って行け。ドリルのにわのメダルだ。私の一番のものだぞ。"},
  {"en": "Three bugs caught, and every drill checked! That is what a good soldier does.", "to": "バグは みっつ つかまえたし、ドリルも ぜんぶ たしかめた！ それが いい ぐんじんの しごとだ！", "kanji": "バグは三つ捕まえたし、ドリルも全部確かめた！それがいいぐんじんの仕事だ！"},
  {"en": "Three bugs? Where?", "to": "バグが みっつ？ どこに？", "kanji": "バグが三つ？どこに？"},
  {"en": "Tinker! Stand up straight! Someone wrote my drills wrong, and I want the bugs caught.", "to": "しゅうりやさん！ せすじを のばせ！ だれかが わたしの ドリルを まちがえて かいたのだ。バグを つかまえて ほしい。", "kanji": "修理屋さん！背筋を伸ばせ！誰かが私のドリルを間違えて書いたのだ。バグを捕まえて欲しい。"},
  {"en": "Total is caught! One bug left, in first. Stand up straight!", "to": "total は つかまえた！ のこりの バグは first の ひとつだ。せすじを のばせ！", "kanji": "total は捕まえた！残りのバグは first の一つだ。背筋を伸ばせ！"},
  {"en": "What should first do when the list is empty? Drill it, and see.", "to": "リストが からっぽの とき、first は なにを すべき だ？ ドリルで ためして みろ。", "kanji": "リストが空っぽのとき、first は何をすべきだ？ドリルで試してみろ。"},
  // talk/shade.jsonc
  {"en": "A lock is only as good as the codes it refuses. Write yours, and I will try my best tricks.", "to": "かぎは、はじく あんごうしだい。きみの チェッカーを かいて。わたしの とっておきの わざを ためして みるから。", "kanji": "鍵は、弾くあんごうしだい。君のチェッカーを書いて。私のとっておきのわざを試してみるから。"},
  {"en": "Click! Hah, it is open! Your checker refused every trick I had.", "to": "カチッ！ ふふ、あいた！ きみの チェッカーは、わたしの わざを ぜんぶ はじいて いたね。", "kanji": "カチッ！ふふ、開いた！君のチェッカーは、私のわざを全部弾いていたね。"},
  {"en": "Come back when you are ready. I will be somewhere you cannot see me.", "to": "じゅんびが できたら、また おいで。わたしは きみに みえない どこかに いるから。", "kanji": "準備ができたら、またおいで。私は君に見えないどこかにいるから。"},
  {"en": "Count the characters first. Then look at each one, and refuse anything that is not a digit.", "to": "まずは もじの かずを かぞえて。それから ひとつずつ みて、すうじじゃない ものは ぜんぶ はじいて。", "kanji": "まずは文字の数を数えて。それから一つずつ見て、数字じゃないものは全部弾いて。"},
  {"en": "Four digits, good! But a thief always tries 1111 first. So do I.", "to": "よっつの すうじ、いいね！ でも どろぼうは かならず 1111 から ためす。わたしも そうだよ。", "kanji": "四つの数字、いいね！でも泥棒はかならず 1111 から試す。私もそうだよ。"},
  {"en": "Here. A key, for a tinker who tests like a thief.", "to": "ほら。かぎを あげる。どろぼうみたいに ためして くれた しゅうりやさんに。", "kanji": "ほら。鍵をあげる。泥棒みたいに試してくれた修理屋さんに。"},
  {"en": "I'll write the checker.", "to": "チェッカーを かくよ。", "kanji": "チェッカーをかくよ。"},
  {"en": "Let's check the codes.", "to": "あんごうを しらべよう。", "kanji": "暗号を調べよう。"},
  {"en": "Nobody gets into my lockbox that way. Good work, tinker.", "to": "そんな やりかたじゃ、わたしの かぎの はこには はいれないね。よく やったよ、しゅうりやさん。", "kanji": "そんなやり方じゃ、私の鍵の箱には入れないね。よくやったよ、修理屋さん。"},
  {"en": "Psst! Tinker! Over here, behind the crate.", "to": "しーっ！ しゅうりやさん！ こっち、はこの うしろだよ。", "kanji": "しーっ！修理屋さん！こっち、箱の後ろだよ。"},
  {"en": "Refuse the easy codes too, tinker. The same digit four times is no lock at all.", "to": "かんたんな あんごうも はじいて ね、しゅうりやさん。おなじ すうじ よっつは、かぎ とは いえないよ。", "kanji": "簡単な暗証番号も拒否してね、修理屋さん。同じ数字を四つ並べただけでは、鍵とは言えないよ。"},
  {"en": "The lockbox is still shut, and my tricks are getting bored.", "to": "かぎの はこは まだ しまって いるし、わたしの わざも あきて きちゃった。", "kanji": "鍵の箱はまだ閉まっているし、私のわざもあきてきちゃった。"},
  {"en": "The lockbox needs a checker. It must say yes to a good code, and no to the rest.", "to": "かぎの はこには チェッカーが いるよ。いい あんごうには はい、それ いがいには いいえ と いう チェッカーが。", "kanji": "鍵付きの箱には判定関数が必要だよ。有効な暗証番号には真、それ以外には偽を返す関数だ。"},
  {"en": "Your checker is a good one, tinker. The lockbox is open, and it will stay that way. For now.", "to": "きみの チェッカーは いいね、しゅうりやさん。かぎの はこは あいた。このまま あいて いるよ。いまのところは ね。", "kanji": "君のチェッカーはいいね、修理屋さん。鍵の箱は開いた。このまま開いているよ。今のところはね。"}
]
