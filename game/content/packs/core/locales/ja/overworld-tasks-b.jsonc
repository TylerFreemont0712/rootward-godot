// Japanese for five of Lanternroot's tasks (Concept/v0.4/06): the bag, the clock, the credits, the map and Pip's
// progress bar. Names, goals, hints, the advice after a try, the glossary, the cases' descriptions, the Builder's
// labels and the starter code's comments, keyed by the English exactly (ADR-0047). Code (add, remove, time_of_day,
// True, null, "green", the keys and the placeholders) stays as it is.
[
  // tasks/bag
  {"en": "A stack with nothing left in it should not stay in the bag. What number would it hold when it is empty?", "to": "なにも のこって いない スタックは、かばんに のこして おけないよ。からの とき、かずは いくつに なるかな？", "kanji": "何も残っていないスタックは、鞄に残しておけないよ。空のとき、数はいくつになるかな？"},
  {"en": "Adding {name} should make {want} in the bag, but it makes {got}.", "to": "{name}を たすと、かばんは {want}に なる はずなのに、{got}に なって しまったよ。", "kanji": "{name}をたすと、鞄は {want}になるはずなのに、{got}になってしまったよ。"},
  {"en": "Adds one thing to the end of a list.", "to": "リストの おわりに、ものを ひとつ たすよ。", "kanji": "リストの終わりに、ものを一つたすよ。"},
  {"en": "Adds one thing to the end of an array.", "to": "array の おわりに、ものを ひとつ たすよ。", "kanji": "array の終わりに、ものを一つたすよ。"},
  {"en": "Adds to the number a name holds, and keeps the new number there.", "to": "なまえが もって いる かずに たして、あたらしい かずを そこに のこすよ。", "kanji": "名前が持っている数に足して、新しい数をそこに残すよ。"},
  {"en": "Asks whether two things are the same. The answer is True or False.", "to": "ふたつの ものが おなじかを たずねるよ。答えは True か False。", "kanji": "二つのものが同じかを尋ねるよ。答えは True か False。"},
  {"en": "Asks whether two things are the same. The answer is true or false.", "to": "ふたつの ものが おなじかを たずねるよ。答えは true か false。", "kanji": "二つのものが同じかを尋ねるよ。答えは true か false。"},
  {"en": "Does its indented lines once for each thing in a list, in order.", "to": "リストの 中の ものの かずだけ、インデントした 行を じゅんばんに くりかえすよ。", "kanji": "リストの中のものの数だけ、インデントした行を順番に繰り返すよ。"},
  {"en": "Does its indented lines once for each thing in an array, in order.", "to": "array の 中の ものの かずだけ、インデントした 行を じゅんばんに くりかえすよ。", "kanji": "array の中のものの数だけ、インデントした行を順番に繰り返すよ。"},
  {"en": "Find the item and take one away", "to": "もちものを さがして、ひとつ とりのぞく", "kanji": "持ち物を探して、一つ取り除く"},
  {"en": "Give back the whole bag: a list of stacks. Yours gave back {got}.", "to": "かばん ぜんぶを かえしてね：スタックの リストだよ。きみの かんすうは {got}を かえしたよ。", "kanji": "鞄全部を返してね：スタックのリストだよ。君の関数は {got}を返したよ。"},
  {"en": "Gives an answer back and stops the function there.", "to": "答えを かえして、そこで かんすうを とめるよ。", "kanji": "答えを返して、そこで関数を止めるよ。"},
  {"en": "Gives the place of a thing in an array, or -1 when it is not there.", "to": "array の 中で、ものが ある 場所を かえすよ。ない ときは -1。", "kanji": "array の中で、ものがある場所を返すよ。ないときは -1。"},
  {"en": "If no stack has the item, the bag needs a new stack at its end. Which list word adds something to the end?", "to": "どの スタックにも もちものが なければ、かばんの おわりに 新しい スタックが いるよ。リストの どの ことばで、おわりに ものを たせるかな？", "kanji": "どのスタックにも持ち物がなければ、鞄の終わりに新しいスタックがいるよ。リストのどの言葉で、終わりにものを足せるかな？"},
  {"en": "If this stack is the item", "to": "もし この スタックが その もちものなら", "kanji": "もしこのスタックがその持ち物なら"},
  {"en": "One of the stacks is {got}. Every stack needs an \"item\" (a word) and a \"count\" (a whole number).", "to": "スタックの 1つが {got}に なって いるよ。どの スタックにも、\"item\"（ことば）と \"count\"（かず、整数）が いるよ。", "kanji": "スタックの 1つが {got}になっているよ。どのスタックにも、\"item\"（言葉）と \"count\"（数、整数）がいるよ。"},
  {"en": "Only the item you were given should change. {name} should be {want}, but it is {got}.", "to": "かわって いい のは、わたされた もちものだけ。{name}は {want}の はずなのに、{got}に なって いるよ。", "kanji": "変わっていいのは、渡された持ち物だけ。{name}は {want}のはずなのに、{got}になっているよ。"},
  {"en": "Otherwise, a new stack", "to": "それ以外は、新しい スタック", "kanji": "それ以外は、新しいスタック"},
  {"en": "Put one more of an item in the bag: in its own stack if it already has one, else in a new stack.", "to": "もちものを もう ひとつ かばんに いれよう。そのもちものの スタックが あれば そこに、なければ 新しい スタックに 入れてね。", "kanji": "持ち物をもう一つ鞄に入れよう。そのもちもののスタックがあればそこに、なければ新しいスタックに入れてね。"},
  {"en": "Python lists have remove, which takes a thing out. JavaScript arrays have splice, which needs the place of the thing, and indexOf can find that place.", "to": "Python の リストには remove が あって、ものを とりのぞけるよ。JavaScript の array には splice が あって、ものの 場所が いるよ。その 場所は indexOf で さがせるよ。", "kanji": "Python のリストには remove があって、ものを取り除けるよ。JavaScript の array には splice があって、ものの場所がいるよ。その場所は indexOf で探せるよ。"},
  {"en": "Runs the lines in its braces only when its question is true.", "to": "中かっこの 中の 行を、しつもんが true の ときだけ うごかすよ。", "kanji": "中かっこの中の行を、質問が true のときだけ動かすよ。"},
  {"en": "Runs the lines under it only when its question is True.", "to": "その 下の 行を、しつもんが True の ときだけ うごかすよ。", "kanji": "その下の行を、質問が True のときだけ動かすよ。"},
  {"en": "Take an empty stack out", "to": "からの スタックを とりのぞく", "kanji": "空のスタックを取り除く"},
  {"en": "Take one of an item out of the bag, and take its stack out once its count reaches 0.", "to": "もちものを ひとつ かばんから とりだそう。かずが 0に なったら、そのスタックも とりのぞいてね。", "kanji": "持ち物を一つ鞄から取り出そう。数が 0になったら、そのスタックも取り除いてね。"},
  {"en": "Takes from the number a name holds, and keeps the new number there.", "to": "なまえが もって いる かずから ひいて、あたらしい かずを そこに のこすよ。", "kanji": "名前が持っている数から引いて、新しい数をそこに残すよ。"},
  {"en": "Takes the first thing that matches out of a list.", "to": "リストの 中から、いちばん はじめに 合う ものを とりのぞくよ。", "kanji": "リストの中から、一番初めに合うものを取り除くよ。"},
  {"en": "Takes things out of an array, starting at a place: splice(place, how many).", "to": "array の ものを、場所から はじめて とりだすよ：splice(place, how many)。", "kanji": "array のものを、場所から始めて取り出すよ：splice(place, how many)。"},
  {"en": "Taking away is the opposite of adding. Which way should the count go?", "to": "とりのぞく ことは、たす ことの はんたいだよ。かずは どっちに うごかせば いいかな？", "kanji": "取り除くことは、足すことの反対だよ。数はどっちに動かせばいいかな？"},
  {"en": "Taking {name} away should leave {want} in the bag, but it leaves {got}.", "to": "{name}を とりのぞくと、かばんには {want}が のこる はずなのに、{got}が のこって しまったよ。", "kanji": "{name}を取り除くと、鞄には {want}が残るはずなのに、{got}が残ってしまったよ。"},
  {"en": "That item wasn't in the bag, so nothing should change. {name} should stay at {want}, but it is {got}.", "to": "その もちものは かばんに なかったから、なにも かわらないはずだよ。{name}は {want}の ままの はずなのに、{got}に なって いるよ。", "kanji": "その持ち物は鞄になかったから、何も変わらないはずだよ。{name}は {want}のままのはずなのに、{got}になっているよ。"},
  {"en": "The Bag", "to": "かばん", "kanji": "鞄"},
  {"en": "The bag holds {name} in two stacks. Each item has one stack, and its count grows.", "to": "かばんに {name}が 2つの スタックに わかれて いるよ。もちもの ごとに スタックは 1つ。かずは ふえて いくんだよ。", "kanji": "鞄に {name}が 2つのスタックに分かれているよ。持ち物ごとにスタックは 1つ。数は増えていくんだよ。"},
  {"en": "The bag, with one fewer of the item in it. A stack whose count reaches 0 is taken out. An item that is not in the bag leaves the bag as it was.", "to": "もちものが ひとつ 少なく なった かばん。かずが 0に なった スタックは とりのぞかれるよ。かばんに ない もちものの ときは、かばんは まえと おなじ ままだよ。", "kanji": "持ち物が一つ少なくなった鞄。数が 0になったスタックは取り除かれるよ。鞄にない持ち物のときは、鞄は前と同じままだよ。"},
  {"en": "The bag, with one more of the item in it. A stack of that item grows by one; if there is none, a new stack of one is added.", "to": "もちものが ひとつ ふえた かばん。その もちものの スタックは ひとつ ふえるよ。スタックが なければ、1つ入りの 新しい スタックが たされるよ。", "kanji": "持ち物が一つ増えた鞄。その持ち物のスタックは一つ増えるよ。スタックがなければ、1つ入りの新しいスタックが足されるよ。"},
  {"en": "The name of what is given away, such as \"cabbage\".", "to": "わたす もちものの 名前。たとえば \"cabbage\"。", "kanji": "渡す持ち物の名前。例えば \"cabbage\"。"},
  {"en": "The name of what was picked up, such as \"apple\".", "to": "ひろった もちものの 名前。たとえば \"apple\"。", "kanji": "拾った持ち物の名前。例えば \"apple\"。"},
  {"en": "The {name} stack has a count of {got}. A stack holds 1 or more, or it should not be in the bag.", "to": "{name}の スタックの かずが {got}に なって いるよ。スタックは 1こ いじょう 入って いないと、かばんに いては いけないよ。", "kanji": "{name}のスタックの数が {got}になっているよ。スタックは 1個以上入っていないと、鞄にいてはいけないよ。"},
  {"en": "The {name} stack is down to {got}, and an empty stack should leave the bag.", "to": "{name}の スタックは {got}まで へって しまったよ。からの スタックは、かばんから でて いく はずだよ。", "kanji": "{name}のスタックは {got}まで減ってしまったよ。空のスタックは、鞄から出て行くはずだよ。"},
  {"en": "Things you pick up go in your bag with your add().", "to": "ひろった ものは、きみの add() で かばんに 入るよ。", "kanji": "拾ったものは、君の add() で鞄に入るよ。"},
  {"en": "When you find the stack with that item, what should happen to its count? Look at the words += and -=.", "to": "その もちものの スタックを みつけたら、かずは どう かわるべきかな？ += と -= を 見て みてね。", "kanji": "その持ち物のスタックを見つけたら、数はどうかわるべきかな？ += と -= を見てみてね。"},
  {"en": "Your bag is a list of stacks. Look at each stack's item: is any of them the item you were given?", "to": "かばんは スタックの リストだよ。それぞれの スタックの もちものを 見てみよう。わたされた もちものは、そのどれかに あるかな？", "kanji": "鞄はスタックのリストだよ。それぞれのスタックの持ち物を見てみよう。渡された持ち物は、そのどれかにあるかな？"},
  {"en": "Your bag: a list of stacks. Each stack is a dictionary with \"item\" (what it holds) and \"count\" (how many), such as {\"item\": \"pear\", \"count\": 1}.", "to": "きみの かばん：スタックの リスト。それぞれの スタックは 辞書 で、\"item\"（中に 入って いる もの）と \"count\"（いくつ）を もって いるよ。たとえば {\"item\": \"pear\", \"count\": 1}。", "kanji": "君の鞄：スタックのリスト。それぞれのスタックは辞書で、\"item\"（中に入っているもの）と \"count\"（いくつ）を持っているよ。例えば {\"item\": \"pear\", \"count\": 1}。"},
  {"en": "an empty bag, and an apple", "to": "からの かばんと りんご", "kanji": "空の鞄とりんご"},
  {"en": "an empty bag, and an apple that is not there", "to": "からの かばんと、かばんに ない りんご", "kanji": "空の鞄と、鞄にないりんご"},
  {"en": "keep looking", "to": "さがしつづける", "kanji": "さがしつづける"},
  {"en": "one apple in the bag, and another apple", "to": "かばんに りんごが ひとつ、もう ひとつ りんご", "kanji": "鞄にりんごが一つ、もう一つりんご"},
  {"en": "one cabbage and two apples, and the cabbage taken away", "to": "キャベツ 1つと りんご 2つ、キャベツを とりのぞいた あと", "kanji": "キャベツ 1つとりんご 2つ、キャベツを取り除いた後"},
  {"en": "stop here", "to": "ここで とまる", "kanji": "ここで止まる"},
  {"en": "the count", "to": "かず", "kanji": "数"},
  {"en": "then", "to": "そのあと", "kanji": "その後"},
  {"en": "three cabbages, and one cabbage taken away", "to": "キャベツが 3つ、そこから 1つ とりのぞいた あと", "kanji": "キャベツが 3つ、そこから 1つ取り除いた後"},
  {"en": "three stacks, and the cabbage in the middle", "to": "スタックが 3つ、まんなかに キャベツ", "kanji": "スタックが 3つ、真ん中にキャベツ"},
  {"en": "two apples in the bag, and a cabbage", "to": "かばんに りんごが 2つ、そして キャベツ", "kanji": "鞄にりんごが 2つ、そしてキャベツ"},
  {"en": "two apples, and a pumpkin that is not there", "to": "りんご 2つと、かばんに ない かぼちゃ", "kanji": "りんご 2つと、鞄にないかぼちゃ"},
  // tasks/bag starter
  {"en": "Give back the bag with one more of item in it.", "to": "かばんを かえしてね。中の item が もう 1つ ふえた かばんだよ。", "kanji": "鞄を返してね。中の item がもう 1つ増えた鞄だよ。"},
  {"en": "bag is your bag: a list of stacks, each {\"item\": ..., \"count\": ...}. item is the name of what was picked up.", "to": "bag は きみの かばん。スタックの リストで、それぞれ {\"item\": ..., \"count\": ...} だよ。item は ひろった もちものの 名前。", "kanji": "bag は君の鞄。スタックのリストで、それぞれ {\"item\": ..., \"count\": ...} だよ。item は拾った持ち物の名前。"},
  {"en": "bag is your bag: a list of stacks, each {item: ..., count: ...}. item is the name of what was picked up.", "to": "bag は きみの かばん。スタックの リストで、それぞれ {item: ..., count: ...} だよ。item は ひろった もちものの 名前。", "kanji": "bag は君の鞄。スタックのリストで、それぞれ {item: ..., count: ...} だよ。item は拾った持ち物の名前。"},
  // tasks/clock
  {"en": "18:00 exactly", "to": "18:00ちょうど", "kanji": "18:00ちょうど"},
  {"en": "21:00 exactly", "to": "21:00ちょうど", "kanji": "21:00ちょうど"},
  {"en": "23:59, the last minute of the day", "to": "23:59、一日の さいごの 分", "kanji": "23:59、一日の最後の分"},
  {"en": "6:00 exactly", "to": "6:00ちょうど", "kanji": "6:00ちょうど"},
  {"en": "A minute of 5 should show as 05. Padding text with zeros on the left is what zfill does in Python and padStart does in JavaScript. Which of those makes the minutes two digits?", "to": "分が 5なら、05と 出したいよ。文字の 左を 0で うめるのは、Python では zfill、JavaScript では padStart だよ。どちらが 分を 2けたに するかな？", "kanji": "分が 5なら、05と出したいよ。文字の左を 0で埋めるのは、Python では zfill、JavaScript では padStart だよ。どちらが分を 2桁にするかな？"},
  {"en": "Ask about the hours in order, starting with the first one. Is the minute before that hour? If it is, the answer is that part of the day. If it is not, ask about the next hour.", "to": "じかんの 区切りを じゅんばんに、いちばん はじめから 見ていこう。その じかんより 前の 分かな？ そうなら、その 時間帯が 答えだよ。ちがうなら、つぎの じかんを 見てみよう。", "kanji": "時間の区切りを順番に、一番初めから見ていこう。その時間より前の分かな？そうなら、その時間帯が答えだよ。違うなら、次の時間を見てみよう。"},
  {"en": "Asks whether one number is less than another. The answer is True or False.", "to": "ひとつの かずが、もうひとつの かずより 小さいかを たずねるよ。答えは True か False。", "kanji": "一つの数が、もう一つの数より小さいかを尋ねるよ。答えは True か False。"},
  {"en": "Asks whether one number is less than another. The answer is true or false.", "to": "ひとつの かずが、もうひとつの かずより 小さいかを たずねるよ。答えは true か false。", "kanji": "一つの数が、もう一つの数より小さいかを尋ねるよ。答えは true か false。"},
  {"en": "At {say}, your answer was {got}, but it should be {want}.", "to": "「{say}」の とき、きみの 答えは {got}だったけど、{want}に なる はずだよ。", "kanji": "「{say}」のとき、君の答えは {got}だったけど、{want}になるはずだよ。"},
  {"en": "Divides and throws away the fraction: how many whole groups fit.", "to": "わって、はしたを すてるよ。まるまる はいる かたまりの かずだよ。", "kanji": "わって、はしたをすてるよ。まるまる入る塊の数だよ。"},
  {"en": "For {say}, time_of_day gave nothing back. It should give {want}.", "to": "「{say}」の とき、time_of_day は なにも かえさなかったよ。{want}を かえすはずだよ。", "kanji": "「{say}」のとき、time_of_day は何も返さなかったよ。{want}を返すはずだよ。"},
  {"en": "Gives what is left over after dividing one number by another.", "to": "わって、あまった ぶんを かえすよ。", "kanji": "わって、余ったぶんを返すよ。"},
  {"en": "Hours are easier as minutes: 6:00 is minute 360. Each question can be an if with < and a return, and the last part of the day is the one you give back when no question was True.", "to": "じかんは 分で 考えると かんたんだよ。6:00は 360分だね。しつもんは それぞれ、< と return を つかった if で 書けるよ。どの しつもんも True に ならなかったら、いちばん さいごの 時間帯を かえせばいいよ。", "kanji": "時間は分で考えると簡単だよ。6:00は 360分だね。質問はそれぞれ、< と return を使った if で書けるよ。どの質問も True にならなかったら、一番最後の時間帯を返せばいいよ。"},
  {"en": "Joins two texts into one.", "to": "ふたつの 文字を ひとつに つなぐよ。", "kanji": "二つの文字を一つに繋ぐよ。"},
  {"en": "Make clock_text(minute) say the time as text, like 18:40, with two digits for the minutes.", "to": "clock_text(minute) で、時間を 文字で 出そう。たとえば 18:40のように、分は かならず 2けたに してね。", "kanji": "clock_text(minute) で、時間を文字で出そう。例えば 18:40のように、分はかならず 2桁にしてね。"},
  {"en": "Make time_of_day(minute) say which part of the day the minute is in, using the town's hours in the starter's comments.", "to": "time_of_day(minute) で、その 分が 一日の どの 時間帯に 入るかを 出そう。スターターの コメントに 書いて ある 村の じかんを つかってね。", "kanji": "time_of_day(minute) で、その分が一日のどの時間帯に入るかを出そう。スターターのコメントに書いてある村の時間を使ってね。"},
  {"en": "One hour is 60 minutes. Dividing the minute by 60 gives the hours, and what is left over after the division gives the minutes.", "to": "1じかんは 60分だよ。分を 60で わると じかんが わかるよ。わった あまりが 分に なるよ。", "kanji": "1時間は 60分だよ。分を 60でわると時間が分かるよ。わったあまりが分になるよ。"},
  {"en": "Pads a text with a character at its start, up to a width.", "to": "文字の はじめに 1文字を つけて、はばまで うめるよ。", "kanji": "文字の初めに 1文字を付けて、幅まで埋めるよ。"},
  {"en": "Pads a text with zeros on the left, up to a width.", "to": "文字の 左に 0を ならべて、はばまで うめるよ。", "kanji": "文字の左に 0を並べて、幅まで埋めるよ。"},
  {"en": "Rounds a number down to a whole number.", "to": "かずを 小さい ほうに まるめて、整数に するよ。", "kanji": "数を小さいほうにまるめて、整数にするよ。"},
  {"en": "Say the time as text", "to": "時間を 文字で いう", "kanji": "時間を文字で言う"},
  {"en": "The Clock", "to": "とけい", "kanji": "時計"},
  {"en": "The minute of the town's day: 0 is midnight, and 1439 is 23:59, the last minute before midnight.", "to": "村の 一日の 分。0は まよなか、1439は 23:59で、まよなかの まえの さいごの 分だよ。", "kanji": "村の一日の分。0は真夜中、1439は 23:59で、真夜中の前の最後の分だよ。"},
  {"en": "The part of the day, as text: \"night\", \"morning\", \"afternoon\" or \"evening\".", "to": "一日の どの 時間帯かを、文字で かえすよ：\"night\"、\"morning\"、\"afternoon\"、\"evening\" の どれか。", "kanji": "一日のどの時間帯かを、文字で返すよ：\"night\"、\"morning\"、\"afternoon\"、\"evening\" のどれか。"},
  {"en": "The time as text: the hour, a colon, then the minutes with two digits, so the minutes are never one digit long.", "to": "文字で 出す 時間。じかん、コロン（:）、それから 2けたの 分。だから、分が 1けたに なる ことは ないよ。", "kanji": "時刻を文字列で表します。時、コロン（:）、2桁の分の順に並べ、分が1桁になる場合は0で埋めます。"},
  {"en": "The town's day follows your time_of_day() now.", "to": "村の 一日は、いま きみの time_of_day() に したがうよ。", "kanji": "村の一日は、今君の time_of_day() に従うよ。"},
  {"en": "Turns a number into text.", "to": "かずを 文字に かえるよ。", "kanji": "数を文字に変えるよ。"},
  {"en": "Your answers are right, except at the edges. At {say} it goes wrong, so look at which side of that exact minute your comparison puts it on.", "to": "きみの 答えは、ふちの ところ以外は あって いるよ。「{say}」で まちがって いるから、その ちょうどの 分が、くらべ方で どちら側に 入って いるか 見てみてね。", "kanji": "君の答えは、縁のところ以外はあっているよ。「{say}」で間違っているから、そのちょうどの分が、くらべ方でどちら側に入っているか見てみてね。"},
  {"en": "Your function is given a minute of the day, such as 65. How many whole hours fit into it, and how many minutes are left over?", "to": "きみの かんすうには、一日の 分が わたされるよ。たとえば 65。その中に、まるまる はいる じかんは いくつ？ あまりの 分は いくつ？", "kanji": "君の関数には、一日の分が渡されるよ。例えば 65。その中に、まるまる入る時間はいくつ？あまりの分はいくつ？"},
  {"en": "Your function is given a minute of the town's day, from 0 to 1439. The starter's comments say when each part of the day ends. Which part does this minute fall in?", "to": "きみの かんすうには、村の 一日の 分が わたされるよ。0から 1439まで。スターターの コメントに、それぞれの 時間帯が いつ おわるか 書いてあるよ。この 分は、どの 時間帯に 入るかな？", "kanji": "君の関数には、村の一日の分が渡されるよ。0から 1439まで。スターターのコメントに、それぞれの時間帯がいつ終わるか書いてあるよ。この分は、どの時間帯に入るかな？"},
  {"en": "after that", "to": "そのあと", "kanji": "その後"},
  {"en": "afternoon until", "to": "ひるすぎの おわり", "kanji": "ひるすぎの終わり"},
  {"en": "clock_text should give back text, such as \"18:40\", not {got}.", "to": "clock_text は、たとえば \"18:40\" のような 文字を かえすはずだよ。{got}では ないよ。", "kanji": "clock_text は、例えば \"18:40\" のような文字を返すはずだよ。{got}ではないよ。"},
  {"en": "eighteen hours and thirty-nine minutes in", "to": "18じかん 39分 けいかした 時点", "kanji": "18時間 39分けいかした時点"},
  {"en": "evening until", "to": "ゆうがたの おわり", "kanji": "夕方の終わり"},
  {"en": "midnight", "to": "まよなか", "kanji": "真夜中"},
  {"en": "morning until", "to": "あさの おわり", "kanji": "朝の終わり"},
  {"en": "night until", "to": "よるの おわり", "kanji": "夜の終わり"},
  {"en": "noon exactly", "to": "ひるの 12:00ちょうど", "kanji": "昼の 12:00ちょうど"},
  {"en": "one hour and five minutes in", "to": "1じかん 5分 けいかした 時点", "kanji": "1時間 5分けいかした時点"},
  {"en": "one minute before 18:00", "to": "18:00の 1分まえ", "kanji": "18:00の 1分まえ"},
  {"en": "one minute before 21:00", "to": "21:00の 1分まえ", "kanji": "21:00の 1分まえ"},
  {"en": "one minute before 6:00", "to": "6:00の 1分まえ", "kanji": "6:00の 1分まえ"},
  {"en": "one minute before noon", "to": "ひるの 1分まえ", "kanji": "昼の 1分まえ"},
  {"en": "ten o'clock in the morning", "to": "あさの 10じ", "kanji": "朝の 10時"},
  {"en": "the hours are the minutes", "to": "じかんは、分を", "kanji": "時間は、分を"},
  {"en": "the last minute of the day", "to": "一日の さいごの 分", "kanji": "一日の最後の分"},
  {"en": "the minutes as text", "to": "分を 文字で", "kanji": "分を文字で"},
  {"en": "the minutes left over", "to": "分は、あまった ぶん", "kanji": "分は、余った分"},
  {"en": "{got} has one digit for the minutes. The minutes always take two digits, so it should be {want}.", "to": "{got}は、分が 1けたに なって いるよ。分は いつも 2けたに するから、{want}が 正しいよ。", "kanji": "{got}は、分が 1桁になっているよ。分はいつも 2桁にするから、{want}が正しいよ。"},
  // tasks/clock starter
  {"en": "Give back \"night\", \"morning\", \"afternoon\" or \"evening\".", "to": "かえしてね：\"night\"、\"morning\"、\"afternoon\"、\"evening\" の どれか。", "kanji": "返してね：\"night\"、\"morning\"、\"afternoon\"、\"evening\" のどれか。"},
  {"en": "The town's hours: night until 6:00, morning until 12:00, afternoon until 18:00, evening until 21:00, then night.", "to": "村の じかん：よるは 6:00まで、あさは 12:00まで、ひるすぎは 18:00まで、ゆうがたは 21:00まで。そのあと よる。", "kanji": "村の時間：夜は 6:00まで、朝は 12:00まで、ひるすぎは 18:00まで、夕方は 21:00まで。その後夜。"},
  {"en": "minute is a minute of the town's day: 0 is midnight, and 1439 is 23:59.", "to": "minute は 村の 一日の 分だよ。0は まよなか、1439は 23:59。", "kanji": "minute は村の一日の分だよ。0は真夜中、1439は 23:59。"},
  // tasks/credits
  {"en": "A list of lines of text, in the order the credits show them: one line for each thing to show.", "to": "文字の 行の リスト。クレジットに でて くる じゅんばんに、出す ものごとに 1行ずつ。", "kanji": "文字の行のリスト。クレジットに出てくる順番に、出すものごとに 1行ずつ。"},
  {"en": "A list of the names of the parts the player built, as text, in the order they built them.", "to": "きみが つくった パーツの 名前を、文字の リストで。つくった じゅんばんに 入って いるよ。", "kanji": "君が作ったパーツの名前を、文字のリストで。作った順番に入っているよ。"},
  {"en": "Add every part", "to": "パーツを ぜんぶ 足す", "kanji": "パーツを全部足す"},
  {"en": "Add the maker", "to": "つくった人を 足す", "kanji": "つくった人を足す"},
  {"en": "After the maker's line, go through the parts one at a time. Each part gets a line of its own.", "to": "つくった人の 行の あとで、パーツを ひとつずつ 見ていこう。パーツには、それぞれ 自分の 行を 1つずつ あげてね。", "kanji": "つくった人の行の後で、パーツを一つずつ見ていこう。パーツには、それぞれ自分の行を 1つずつあげてね。"},
  {"en": "Does the lines in its braces once for each thing in a list, one after another.", "to": "リストの ものの かずだけ、中かっこの 中の 行を、じゅんばんに くりかえすよ。", "kanji": "リストのものの数だけ、中かっこの中の行を、順番に繰り返すよ。"},
  {"en": "Does the lines under it once for each thing in a list, one after another.", "to": "リストの ものの かずだけ、その 下の 行を、じゅんばんに くりかえすよ。", "kanji": "リストのものの数だけ、その下の行を、順番に繰り返すよ。"},
  {"en": "Joins two pieces of text into one.", "to": "ふたつの 文字を ひとつに つなぐよ。", "kanji": "二つの文字を一つに繋ぐよ。"},
  {"en": "Kai, with five parts", "to": "Kai、パーツが 5こ", "kanji": "Kai、パーツが 5個"},
  {"en": "Line {index} is not text. Every line must be text, in quotes.", "to": "{index}行目は 文字では ないよ。どの 行も、\"\" で かこんだ 文字で なければ いけないよ。", "kanji": "{index}行目は文字ではないよ。どの行も、\"\" で囲んだ文字でなければいけないよ。"},
  {"en": "Make the credits: a line with the player's name, then a line for each part they built.", "to": "クレジットを つくろう。きみの 名前の 行を 1つ、そのあと、つくった パーツごとに 1行ずつ。", "kanji": "クレジットを作ろう。君の名前の行を 1つ、その後、作ったパーツごとに 1行ずつ。"},
  {"en": "Makes a list: things in square brackets, with a comma between each one.", "to": "リストを つくるよ。[ ] の 中に ものを 入れて、ものと ものの あいだに コンマを 入れるよ。", "kanji": "リストを作るよ。[ ] の中にものを入れて、ものとものの間にコンマを入れるよ。"},
  {"en": "Mina, with one part", "to": "Mina、パーツが ひとつ", "kanji": "Mina、パーツが一つ"},
  {"en": "No line has the name {arg0} in it. Put the maker's name on one of the lines.", "to": "{arg0}と いう 名前の 行が ないよ。つくった人の 名前を、どれか 行に 入れてね。", "kanji": "{arg0}という名前の行がないよ。つくった人の名前を、どれか行に入れてね。"},
  {"en": "No line names {name}. Every part the player built needs a line of its own.", "to": "{name}と 書いた 行が ないよ。きみが つくった パーツには、それぞれ 自分の 行が 必要だよ。", "kanji": "{name}と書いた行がないよ。君が作ったパーツには、それぞれ自分の行が必要だよ。"},
  {"en": "Text joins with +. Add each line to the list with append, then give the whole list back.", "to": "文字は + で つなげるよ。それぞれの 行を append で リストに 足して、そのあと リスト ぜんぶを かえそう。", "kanji": "文字は + で繋げるよ。それぞれの行を append でリストに足して、その後リスト全部を返そう。"},
  {"en": "The Credits", "to": "クレジット", "kanji": "クレジット"},
  {"en": "The credits are a list of lines. The first line is for the maker. What goes into the list first?", "to": "クレジットは 行の リストだよ。さいしょの 行は、つくった人の 行。さいしょに リストへ 入れるのは どれかな？", "kanji": "クレジットは行のリストだよ。最初の行は、つくった人の行。最初にリストへ入れるのはどれかな？"},
  {"en": "The credits hold 40 lines at most, and 60 letters on a line. Make the lines shorter, or fewer.", "to": "クレジットは 40行まで、1行は 60文字までだよ。行を みじかく するか、行の かずを 減らしてね。", "kanji": "クレジットは 40行まで、1行は 60文字までだよ。行を短くするか、行の数を減らしてね。"},
  {"en": "The credits roll a list of lines, so give back a list. {got} is not a list.", "to": "クレジットは 行の リストを 流すから、リストを かえしてね。{got}は リストじゃ ないよ。", "kanji": "クレジットは行のリストを流すから、リストを返してね。{got}はリストじゃないよ。"},
  {"en": "The credits roll with your lines.", "to": "きみの 行で、クレジットが 流れるよ。", "kanji": "君の行で、クレジットが流れるよ。"},
  {"en": "The player's name, as text, as they typed it.", "to": "きみの 名前。入力した とおりの 文字で。", "kanji": "君の名前。入力した通りの文字で。"},
  {"en": "Tinker, with ten parts", "to": "しゅうりやさん、パーツが 10こ", "kanji": "修理屋さん、パーツが 10個"},
  {"en": "the first line", "to": "さいしょの 行", "kanji": "最初の行"},
  // tasks/credits starter
  {"en": "Give back a list of lines of text, in the order the credits show them.", "to": "文字の 行の リストを かえしてね。クレジットに でる じゅんばんで。", "kanji": "文字の行のリストを返してね。クレジットに出る順番で。"},
  {"en": "maker is the player's name, as text. parts is the list of the names of the parts they built, in order.", "to": "maker は きみの 名前（文字）。parts は、つくった じゅんばんに 並んだ パーツの 名前の リストだよ。", "kanji": "maker は君の名前（文字）。parts は、作った順番に並んだパーツの名前のリストだよ。"},
  // tasks/map
  {"en": "A box holds the cells from its left and top edges, up to but not including its right and bottom edges. Once you find one, give back its name. If you reach the end, give back \"\".", "to": "はこは、左と上の ふちの マスから、右と下の ふちの 手前までを 入れて いるよ。見つけたら、その 名前を かえしてね。さいごまで いったら、\"\" を かえしてね。", "kanji": "箱は、左と上の縁のマスから、右と下の縁の手前までを入れているよ。見つけたら、その名前を返してね。最後まで行ったら、\"\" を返してね。"},
  {"en": "A colour's name, as text: green, dark green, light green, blue, light blue, brown, tan, grey, dark grey, white, yellow, orange, red, pink, purple or black.", "to": "色の 名前を 文字で。\"green\"、\"dark green\"、\"light green\"、\"blue\"、\"light blue\"、\"brown\"、\"tan\"、\"grey\"、\"dark grey\"、\"white\"、\"yellow\"、\"orange\"、\"red\"、\"pink\"、\"purple\"、\"black\" の どれか。", "kanji": "色の名前を文字で。\"green\"、\"dark green\"、\"light green\"、\"blue\"、\"light blue\"、\"brown\"、\"tan\"、\"grey\"、\"dark grey\"、\"white\"、\"yellow\"、\"orange\"、\"red\"、\"pink\"、\"purple\"、\"black\" のどれか。"},
  {"en": "A dictionary holds pairs: a ground on the left, its colour on the right. Look a ground up by putting it in square brackets.", "to": "辞書 には ペアが 入って いるよ。左が ground、右が その 色。ground を [ ] に 入れると、その 色が 見つかるよ。", "kanji": "辞書にはペアが入っているよ。左が ground、右がその色。ground を [ ] に入れると、その色が見つかるよ。"},
  {"en": "A list of places. Each is a box with a \"name\" (its text), and \"x\", \"y\", \"w\" and \"h\": the cell at its top-left corner, then its width and height in cells.", "to": "ばしょの リスト。それぞれ、\"name\"（文字）と \"x\"、\"y\"、\"w\"、\"h\" を もつ はこだよ。\"x\" と \"y\" は 左上の マス、\"w\" と \"h\" は はばと たかさ（マスの かず）。", "kanji": "場所のリスト。それぞれ、\"name\"（文字）と \"x\"、\"y\"、\"w\"、\"h\" を持つ箱だよ。\"x\" と \"y\" は左上のマス、\"w\" と \"h\" は幅と高さ（マスの数）。"},
  {"en": "Adds two numbers together.", "to": "ふたつの かずを 足すよ。", "kanji": "二つの数を足すよ。"},
  {"en": "Asks whether the first number is less than the second. <= asks the same, and also takes equal.", "to": "さいしょの かずが、つぎの かずより 小さいかを たずねるよ。<= は、おなじ かずの ときも 入るよ。", "kanji": "最初の数が、次の数より小さいかを尋ねるよ。<= は、同じ数のときも入るよ。"},
  {"en": "At {say}, the function gave back {got}, but it should give back {want}.", "to": "「{say}」の とき、かんすうは {got}を かえしたけど、{want}を かえすはずだよ。", "kanji": "「{say}」のとき、関数は {got}を返したけど、{want}を返すはずだよ。"},
  {"en": "At {say}, the function gave back {got}, which is not text. Give back a place's name as text, or \"\".", "to": "「{say}」の とき、かんすうは {got}を かえしたよ。でも それは 文字では ないよ。ばしょの 名前を 文字で、または \"\" で かえしてね。", "kanji": "「{say}」のとき、関数は {got}を返したよ。でもそれは文字ではないよ。場所の名前を文字で、または \"\" で返してね。"},
  {"en": "Every kind of ground gets one colour. Make a list of the grounds, and beside each one, the colour it should be.", "to": "マスの しゅるい（ground）ごとに、色は ひとつだよ。ground の リストを つくって、それぞれの となりに、その 色を 書いてね。", "kanji": "マスの種類（ground）ごとに、色は一つだよ。ground のリストを作って、それぞれの隣に、その色を書いてね。"},
  {"en": "Give each kind of ground a colour name, so the minimap can draw it.", "to": "ground の しゅるいごとに、色の 名前を つけよう。ミニマップに えがけるように ね。", "kanji": "ground の種類ごとに、色の名前を付けよう。ミニマップにえがけるようにね。"},
  {"en": "Go through the boxes one at a time. For each one, ask whether the cell's column and its row are both inside it.", "to": "はこを ひとつずつ 見ていこう。それぞれの はこで、マスの 列と 行が、どちらも はこの 中に 入って いるかを たずねてね。", "kanji": "箱を一つずつ見ていこう。それぞれの箱で、マスの列と行が、どちらも箱の中に入っているかを尋ねてね。"},
  {"en": "Joins two questions. The answer is True only when both are True.", "to": "ふたつの しつもんを つなぐよ。どちらも True の ときだけ、答えは True だよ。", "kanji": "二つの質問を繋ぐよ。どちらも True のときだけ、答えは True だよ。"},
  {"en": "Joins two questions. The answer is true only when both are true.", "to": "ふたつの しつもんを つなぐよ。どちらも true の ときだけ、答えは true だよ。", "kanji": "二つの質問を繋ぐよ。どちらも true のときだけ、答えは true だよ。"},
  {"en": "Look closely at {say}. A box holds its left and top edges, but not its right or bottom edges: check the cell is less than where the box stops.", "to": "「{say}」を よく 見てね。はこは 左と上の ふちは 入るけど、右と下の ふちは 入らないよ。マスが、はこの おわりより 小さいかを たしかめてね。", "kanji": "「{say}」をよく見てね。箱は左と上の縁は入るけど、右と下の縁は入らないよ。マスが、箱の終わりより小さいかを確かめてね。"},
  {"en": "Look through each place", "to": "ばしょを ひとつずつ 見る", "kanji": "場所を一つずつ見る"},
  {"en": "Looks up one named part of an object, after a dot.", "to": "ドット（.）の あとに 書いて、オブジェクト の 中の 名前つきの 部分を 見るよ。", "kanji": "ドット（.）の後に書いて、オブジェクトの中の名前つきの部分を見るよ。"},
  {"en": "Looks up one thing in a dictionary by its name, in square brackets.", "to": "辞書 の 中から、名前で ものを ひとつ 見るよ。その 名前を [ ] の 中に 書いてね。", "kanji": "辞書の中から、名前でものを一つ見るよ。その名前を [ ] の中に書いてね。"},
  {"en": "Looks up the value for one name in a dictionary, when the name is in square brackets after it.", "to": "辞書 の 中で、名前に 合う 値を さがすよ。名前は、あとから [ ] に 入れてね。", "kanji": "辞書の中で、名前に合う値を探すよ。名前は、後から [ ] に入れてね。"},
  {"en": "Looks up the value for one name in an object, when the name is in square brackets after it.", "to": "オブジェクト の 中で、名前に 合う 値を さがすよ。名前は、あとから [ ] に 入れてね。", "kanji": "オブジェクトの中で、名前に合う値を探すよ。名前は、後から [ ] に入れてね。"},
  {"en": "Makes a dictionary: pairs of a name and its value, in braces, with a colon between each name and value and a comma between the pairs.", "to": "{ } で 辞書 を つくるよ。名前と 値の ペアを ならべて、名前と 値の あいだに コロン、ペアと ペアの あいだに コンマを 入れるよ。", "kanji": "{ } で辞書を作るよ。名前と値のペアを並べて、名前と値の間にコロン、ペアとペアの間にコンマを入れるよ。"},
  {"en": "Makes an object: pairs of a name and its value, in braces, with a colon between each name and value and a comma between the pairs.", "to": "{ } で オブジェクト を つくるよ。名前と 値の ペアを ならべて、名前と 値の あいだに コロン、ペアと ペアの あいだに コンマを 入れるよ。", "kanji": "{ } でオブジェクトを作るよ。名前と値のペアを並べて、名前と値の間にコロン、ペアとペアの間にコンマを入れるよ。"},
  {"en": "Pell's map is a list of boxes. This function asks which box, if any, holds the cell.", "to": "ペルの ちずは はこの リストだよ。この かんすうは、マスを 入れて いる はこが あれば、どの はこかを たずねるよ。", "kanji": "ペルのちずは箱のリストだよ。この関数は、マスを入れている箱があれば、どの箱かを尋ねるよ。"},
  {"en": "Say which place a cell is in, or \"\" when it is in none.", "to": "マスが どの ばしょに あるかを かえそう。どの ばしょにも なければ、\"\" を かえしてね。", "kanji": "マスがどの場所にあるかを返そう。どの場所にもなければ、\"\" を返してね。"},
  {"en": "The \"name\" of the place the cell is in, as text. \"\" (nothing) when the cell is in no place.", "to": "マスが いる ばしょの \"name\"（文字）。どの ばしょにも いない ときは \"\"（なにもない）。", "kanji": "マスがいる場所の \"name\"（文字）。どの場所にもいないときは \"\"（何もない）。"},
  {"en": "The Map", "to": "ちず", "kanji": "地図"},
  {"en": "The cell's column: a whole number, 0 at the left.", "to": "マスの 列。整数（せいすう）で、左が 0。", "kanji": "マスの列。整数で、左が 0。"},
  {"en": "The cell's row: a whole number, 0 at the top.", "to": "マスの 行。整数（せいすう）で、上が 0。", "kanji": "マスの行。整数で、上が 0。"},
  {"en": "The kind of map cell, as text: a ground such as \"grass\", \"water\" or \"path\", or \"building\", \"tree\" or \"thing\" (any other solid prop).", "to": "マスの しゅるい（文字）。\"grass\"、\"water\"、\"path\" などの ground か、\"building\"、\"tree\"、\"thing\"（そのほか かたい もの）。", "kanji": "マスの種類（文字）。\"grass\"、\"water\"、\"path\" などの ground か、\"building\"、\"tree\"、\"thing\"（そのほか固いもの）。"},
  {"en": "The minimap is drawn in your map_colour() colours.", "to": "ミニマップは、きみの map_colour() の 色で えがかれるよ。", "kanji": "ミニマップは、君の map_colour() の色でえがかれるよ。"},
  {"en": "Water is {got}, the same colour as the grass. Water should look different from the grass.", "to": "みずは {got}だけど、くさと おなじ色だよ。みずは くさと ちがう 色に 見えないと いけないよ。", "kanji": "水は {got}だけど、草とおなじ色だよ。水は草と違う色に見えないといけないよ。"},
  {"en": "Water, paths, cobbles and buildings each need a colour the grass does not have. Buildings also need one the path does not have.", "to": "みず、みち、石だたみ、たてものには、それぞれ くさに ない 色が いるよ。たてものには、みちに ない 色も 必要だよ。", "kanji": "水、道、石だたみ、建物には、それぞれ草にない色がいるよ。建物には、道にない色も必要だよ。"},
  {"en": "a bridge", "to": "はし", "kanji": "橋"},
  {"en": "a building", "to": "たてもの", "kanji": "建物"},
  {"en": "a cell in no place", "to": "どの ばしょにも ない マス", "kanji": "どの場所にもないマス"},
  {"en": "a cell in the second of two places", "to": "ふたつの ばしょの 2つ目の マス", "kanji": "二つの場所の 2つ目のマス"},
  {"en": "a cell inside a place", "to": "ばしょの 中の マス", "kanji": "場所の中のマス"},
  {"en": "a floor", "to": "ゆか", "kanji": "床"},
  {"en": "a hedge", "to": "いけがき", "kanji": "生け垣"},
  {"en": "a path", "to": "みち", "kanji": "道"},
  {"en": "a rug", "to": "じゅうたん", "kanji": "絨毯"},
  {"en": "a tree", "to": "木", "kanji": "木"},
  {"en": "a wall", "to": "かべ", "kanji": "壁"},
  {"en": "an empty list of places", "to": "からの ばしょの リスト", "kanji": "空の場所のリスト"},
  {"en": "any other solid thing", "to": "ほかの かたい もの", "kanji": "他の固いもの"},
  {"en": "building", "to": "たてもの", "kanji": "建物"},
  {"en": "cobbles", "to": "石だたみ", "kanji": "石だたみ"},
  {"en": "everything else", "to": "そのほか ぜんぶ", "kanji": "そのほか全部"},
  {"en": "flowers", "to": "花", "kanji": "花"},
  {"en": "grass", "to": "くさ", "kanji": "草"},
  {"en": "path", "to": "みち", "kanji": "道"},
  {"en": "the right edge", "to": "右の ふち", "kanji": "右の縁"},
  {"en": "the right edge of a place (outside, on the edge)", "to": "ばしょの 右の ふち（外がわ、ふちの 上）", "kanji": "場所の右の縁（外がわ、縁の上）"},
  {"en": "the top-left corner of a place (inside, on the edge)", "to": "ばしょの 左上の かど（中がわ、ふちの 上）", "kanji": "場所の左上のかど（中がわ、縁の上）"},
  {"en": "the void", "to": "void（なにもない ところ）", "kanji": "void（何もないところ）"},
  {"en": "tree", "to": "木", "kanji": "木"},
  {"en": "water", "to": "みず", "kanji": "水"},
  {"en": "{name} gives {got}, which is not a colour name from the gives list. Choose one of those names, as text.", "to": "{name}は {got}を かえしたけど、かえすものの リストに ない 色の 名前だよ。リストの 名前から えらんで、文字で かえしてね。", "kanji": "{name}は {got}を返したけど、返すもののリストにない色の名前だよ。リストの名前から選んで、文字で返してね。"},
  {"en": "{name} is {got}, the same colour as the grass or the path. A building should stand out from both.", "to": "{name}は {got}だけど、くさや みちと おなじ色だよ。たてものは どちらからも 目立つ 色に しよう。", "kanji": "{name}は {got}だけど、くさや道とおなじ色だよ。建物はどちらからも目立つ色にしよう。"},
  {"en": "{name} is {got}, the same colour as the grass. A path should stand out from the grass.", "to": "{name}は {got}だけど、くさと おなじ色だよ。みちは くさから 目立つ 色に しよう。", "kanji": "{name}は {got}だけど、草とおなじ色だよ。道は草から目立つ色にしよう。"},
  // tasks/map starter
  {"en": "Give back the colour's name, as text, from the gives list in the Hints column.", "to": "色の 名前を 文字で かえしてね。ヒントの らんの、かえすものの リストから えらんでね。", "kanji": "色の名前を文字で返してね。ヒントのらんの、返すもののリストから選んでね。"},
  {"en": "ground is the kind of map cell, as text: \"grass\", \"water\", \"building\" and so on.", "to": "ground は マスの しゅるい（文字）。\"grass\"、\"water\"、\"building\" など。", "kanji": "ground はマスの種類（文字）。\"grass\"、\"water\"、\"building\" など。"},
  // tasks/progress
  {"en": "A fraction like 0.5 is a part of one whole. Which kind of division gives back only whole numbers?", "to": "0.5の ような 小数は、1を わけた 一部だよ。整数だけを かえす わり算は どれかな？", "kanji": "0.5のような小数は、1を分けた一部だよ。整数だけを返すわり算はどれかな？"},
  {"en": "A quest with no steps would divide by zero, which can't be done. Put that case first, and say what it should give back.", "to": "クエストに ステップが ないと、0で わる ことに なって できないよ。その ばあいを さいしょに 書いて、なにを かえすべきか 決めてね。", "kanji": "クエストにステップがないと、0でわることになってできないよ。その場合を最初に書いて、何をかえすべきか決めてね。"},
  {"en": "A quest with no steps: {arg0} out of {arg1}. There is nothing to finish, so it should give 0. You gave {got}.", "to": "ステップが ない クエスト。{arg1}ステップの うち {arg0}つ。かんりょう する ものが ないから、0を かえすはずだよ。きみは {got}を かえしたよ。", "kanji": "ステップがないクエスト。{arg1}ステップのうち {arg0}つ。完了するものがないから、0を返すはずだよ。君は {got}を返したよ。"},
  {"en": "Divides and keeps only the whole number, leaving out the part after the point.", "to": "わって、小数点より あとは すてて、整数だけ のこすよ。", "kanji": "わって、小数点より後はすてて、整数だけ残すよ。"},
  {"en": "Give back the percent done, a whole number from 0 to 100. A quest with no steps gives 0.", "to": "できた パーセントを かえそう。0から 100までの 整数だよ。ステップが ない クエストは 0を かえしてね。", "kanji": "できたパーセントを返そう。0から 100までの整数だよ。ステップがないクエストは 0を返してね。"},
  {"en": "How many steps are finished. A whole number, 0 or more.", "to": "かんりょうした ステップの かず。整数で、0いじょう。", "kanji": "完了したステップの数。整数で、0以上。"},
  {"en": "How many steps the quest has in all. A whole number, 0 or more.", "to": "クエストに ある ステップ ぜんぶの かず。整数で、0いじょう。", "kanji": "クエストにあるステップ全部の数。整数で、0以上。"},
  {"en": "JavaScript's word for nothing at all.", "to": "JavaScript で「なにも ない」を あらわす ことば。", "kanji": "JavaScript で「何もない」を表す言葉。"},
  {"en": "Multiplies two numbers.", "to": "ふたつの かずを かけるよ。", "kanji": "二つの数をかけるよ。"},
  {"en": "Pip counts out of 100, not out of 1. If 2 of 4 steps are done, how many hundredths of the steps is that?", "to": "ピップは、1ではなく 100を もとに かぞえるよ。4つの ステップの うち 2つが できたら、それは 100ぶんの 何ぶんかな？", "kanji": "ピップは、1ではなく 100をもとに数えるよ。4つのステップのうち 2つができたら、それは 100ぶんの何ぶんかな？"},
  {"en": "Pip counts out of 100, not out of 1. {got} is a part of one whole, so Pip can't show it.", "to": "ピップは 1ではなく 100を もとに かぞえるよ。{got}は 1を わけた 一部だから、ピップには 出せないよ。", "kanji": "ピップは 1ではなく 100をもとに数えるよ。{got}は 1を分けた一部だから、ピップには出せないよ。"},
  {"en": "Python's word for nothing at all.", "to": "Python で「なにも ない」を あらわす ことば。", "kanji": "Python で「何もない」を表す言葉。"},
  {"en": "Rounds a number down to the whole number below it.", "to": "かずを、その 下の 整数に まるめて 小さく するよ。", "kanji": "数を、その下の整数にまるめて小さくするよ。"},
  {"en": "The Progress Bar", "to": "しんちょくバー", "kanji": "進捗バー"},
  {"en": "The percent done, a whole number from 0 to 100. A quest with no steps gives 0, and not an error.", "to": "できた パーセント。0から 100までの 整数。ステップが ない クエストは、エラーに せず 0を かえすよ。", "kanji": "できたパーセント。0から 100までの整数。ステップがないクエストは、エラーにせず 0を返すよ。"},
  {"en": "When there are no steps", "to": "ステップが ない とき", "kanji": "ステップがないとき"},
  {"en": "With {arg0} of {arg1} steps done, Pip wants about {want} percent. You gave {got}.", "to": "{arg1}ステップの うち {arg0}つが できたら、ピップは だいたい {want}パーセントを のぞんで いるよ。きみは {got}を かえしたよ。", "kanji": "{arg1}ステップのうち{arg0}ステップが完了した場合、進捗は約{want}パーセントになるよ。君の結果は{got}だったよ。"},
  {"en": "a quest with no steps at all", "to": "まったく ステップが ない クエスト", "kanji": "まったくステップがないクエスト"},
  {"en": "done times 100, rounded down", "to": "done かける 100、小さく まるめる", "kanji": "done かける 100、小さくまるめる"},
  {"en": "every step done", "to": "ステップが ぜんぶ できて いる 状態", "kanji": "ステップが全部できている状態"},
  {"en": "give back", "to": "かえすのは", "kanji": "返すのは"},
  {"en": "half of four steps", "to": "4つの ステップの 半分", "kanji": "4つのステップの半分"},
  {"en": "no steps done yet", "to": "まだ ひとつも できて いない 状態", "kanji": "まだ一つもできていない状態"},
  {"en": "one step of three", "to": "3つの ステップの 1つ", "kanji": "3つのステップの 1つ"},
  {"en": "total divided by done", "to": "total を done で わる", "kanji": "total を done でわる"},
  {"en": "two steps of three", "to": "3つの ステップの 2つ", "kanji": "3つのステップの 2つ"},
  {"en": "with no steps, give back", "to": "ステップが ないとき、かえすのは", "kanji": "ステップがないとき、返すのは"},
  {"en": "{got} has bits after the point. Pip wants a whole number of percent, like 50.", "to": "{got}には 小数点の あとに 数が ついて いるよ。ピップは 50のような、パーセントの 整数を のぞんで いるよ。", "kanji": "{got}には小数点の後に数がついているよ。ピップは 50のような、パーセントの整数をのぞんでいるよ。"},
  // tasks/progress starter
  {"en": "done is how many steps are finished, and total is how many steps the quest has in all.", "to": "done は かんりょうした ステップの かず、total は クエストに ある ステップ ぜんぶの かずだよ。", "kanji": "done は完了したステップの数、total はクエストにあるステップ全部の数だよ。"}
]
