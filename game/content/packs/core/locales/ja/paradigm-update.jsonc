[
  {
    "en": "Sprint",
    "to": "スプリント", "kanji": "スプリント"
  },
  {
    "en": "Programs with 1–3 cards count as doing 25% less work toward timeouts and foes that move first.",
    "to": "1〜3枚のカードのプログラムは、タイムアウトと先に動く敵に向けた仕事が25%少ないものとして数えられます。", "kanji": "1〜3枚のカードのプログラムは、タイムアウトと先に動く敵に向けた仕事が25%少ないものとして数えられます。"
  },
  {
    "en": "Tiny cheap programs every turn; kill chains for mana.",
    "to": "短く安いプログラムで先手を取り、連続で倒してマナを得よう。", "kanji": "短く安いプログラムで先手を取り、連続で倒してマナを得よう。"
  },
  {
    "en": "Short-circuiting, break, streaming.",
    "to": "短絡評価、break、ストリーミング。", "kanji": "短絡評価、break、ストリーミング。"
  },
  {
    "en": "From the first turn of every fight, import heapq is free: each strike card is handed the volley strongest first.",
    "to": "どの戦闘の最初のターンからも、import heapqは無料です。どの攻撃カードも、一斉射を威力の強い順に渡されます。", "kanji": "どの戦闘の最初のターンからも、import heapqは無料です。どの攻撃カードも、一斉射を威力の強い順に渡されます。"
  },
  {
    "en": "A few huge bolts, strongest first.",
    "to": "強いボルトを少数作り、大きい順に使おう。", "kanji": "強いボルトを少数作り、大きい順に使おう。"
  },
  {
    "en": "Heaps, priority queues, heapify in O(n).",
    "to": "ヒープ、優先キュー、O(n) のヒープ構築。", "kanji": "ヒープ、優先キュー、O(n) のヒープ構築。"
  },
  {
    "en": "Scheduler",
    "to": "スケジューラー", "kanji": "スケジューラー"
  },
  {
    "en": "If a program hits every living foe, each attack bolt gains +1 power.",
    "to": "プログラムが生きている敵全員に攻撃を当てると、各攻撃ボルトの威力が1上がります。", "kanji": "プログラムが生きている敵全員に攻撃を当てると、各攻撃ボルトの威力が1上がります。"
  },
  {
    "en": "Spread bolts over crowds exactly.",
