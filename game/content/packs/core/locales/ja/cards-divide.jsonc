[
  {"en": "Halve", "to": "半分（はんぶん）に分ける"},
  {"en": "Halve+", "to": "半分（はんぶん）に分ける+"},
  {"en": "Does nothing but split: the card after it runs once on each half of the volley.", "to": "ただ半分に分けるだけ。次のカードは、ボルトの束（たば）の前半と後半で1回ずつ動く。"},
  {"en": "Splits, and gives the first bolt of each half 1 more power.", "to": "半分に分けて、前半と後半の最初のボルトの威力（いりょく）を1上げる。"},
  {"en": "Tower of Hanoi", "to": "ハノイの塔（とう）"},
  {"en": "Tower of Hanoi+", "to": "ハノイの塔（とう）+"},
  {"en": "Solves a four-disk Tower of Hanoi by recursion and adds its 15 moves to the volley, one bolt each: the disk's size plus 1 (2, 3, 2, 4, 2, 3, 2, 5 ...). The work doubles with every disk.", "to": "4枚の円盤（えんばん）のハノイの塔を再帰（さいき）で解き、15回の動きを1つずつボルトにして足す。威力は円盤の大きさ+1（2、3、2、4、2、3、2、5…）。円盤が1枚ふえるごとに、仕事量は2倍になる。"},
  {"en": "Solves five disks: 31 moves, the biggest disk making a bolt of 6.", "to": "円盤5枚を解く。動きは31回で、いちばん大きい円盤は威力6のボルトになる。"},
  {"en": "Fast Power", "to": "高速（こうそく）べき乗（じょう）"},
  {"en": "Fast Power+", "to": "高速（こうそく）べき乗（じょう）+"},
  {"en": "Raises 2 to the third power by repeated squaring and multiplies the strongest bolt by it: doubled three times, ×8. Once a fight.", "to": "2の3乗を、2乗をくり返して求め、いちばん強いボルトにかける。3回2倍で×8。1戦に1回だけ。"},
  {"en": "Raises 2 to the fourth power by repeated squaring: the strongest bolt is doubled four times, ×16.", "to": "2の4乗を、2乗をくり返して求める。いちばん強いボルトが4回2倍になって×16。"},
  {"en": "Karatsuba", "to": "カラツバ法"},
  {"en": "Karatsuba+", "to": "カラツバ法+"},
  {"en": "Multiplies the two strongest bolts with Karatsuba's three recursive multiplications instead of four, and adds a new bolt of a × b ÷ 10.", "to": "いちばん強い2本のボルトを、4回ではなく3回の再帰的（さいきてき）なかけ算（カラツバ法）でかけ合わせ、a × b ÷ 10 の威力の新しいボルトを足す。"},
  {"en": "Adds a new bolt of a × b ÷ 8.", "to": "a × b ÷ 8 の威力の新しいボルトを足す。"},
  {"en": "Max Subarray (D&C)", "to": "最大部分配列（さいだいぶぶんはいれつ）（D&C）"},
  {"en": "Max Subarray (D&C)+", "to": "最大部分配列（さいだいぶぶんはいれつ）（D&C）+"},
  {"en": "Divide and conquer for Kadane's answer: the best run, each bolt scoring its power minus 3, lies in the left half, the right half or across the middle. It fuses into one bolt of its whole power, 1 stronger for every level of the recursion.", "to": "分割統治（ぶんかつとうち）でKadaneと同じ答えを出す。各ボルトの点は威力−3。いちばんよい連続した並びは、前半、後半、または真ん中をまたぐ部分にある。それを全部の威力の合計の1本に合体し、再帰の1段ごとに1ずつ強くなる。"},
  {"en": "The best run fuses into one bolt of its whole power, 2 stronger for every level of the recursion.", "to": "いちばんよい連続した並びを合体して1本にする。再帰の1段ごとに2ずつ強くなる。"},
  {"en": "Counting Inversions", "to": "逆転数（ぎゃくてんすう）を数える"},
  {"en": "Counting Inversions+", "to": "逆転数（ぎゃくてんすう）を数える+"},
  {"en": "Merge sort that counts: each bolt gains the number of stronger bolts before it, and the volley keeps its order. The more disordered the volley, the more it pays: play it before sorting.", "to": "数えながらマージソートする。各ボルトは、自分より前にある強いボルトの数だけ強くなり、順番（じゅんばん）は変わらない。ばらばらなほど得をするので、ソートの前に使おう。"},
  {"en": "Each bolt gains the number of stronger bolts before it and the number of weaker bolts after it.", "to": "各ボルトは、前にある強いボルトの数と、後ろにある弱いボルトの数だけ強くなる。"},
  {"en": "Closest Pair", "to": "いちばん近いペア"},
  {"en": "Closest Pair+", "to": "いちばん近いペア+"},
  {"en": "Finds the two bolts closest in power (divide and conquer, with the strip trick) and fuses them into one bolt of double their total.", "to": "威力がいちばん近い2本のボルトを（分割統治とストリップのくふうで）見つけ、合計の2倍の1本に合体する。"},
  {"en": "Fuses the closest pair, then the closest pair among the rest.", "to": "いちばん近いペアを合体し、残りの中でいちばん近いペアも合体する。"},
  {"en": "Skyline", "to": "スカイライン"},
  {"en": "Skyline+", "to": "スカイライン+"},
  {"en": "Each bolt is a tower. A bolt hidden behind a taller one before it is fused into the tallest tower in front of it, adding half its power (rounded down).", "to": "ボルトを1本ずつの塔（とう）と見る。前にある高い塔にかくれたボルトは、その前のいちばん高い塔に合体し、威力の半分（切り捨て）を足す。"},
  {"en": "Each bolt is a tower. A bolt hidden behind a taller one before it is fused into the tallest tower in front of it, adding its full power.", "to": "ボルトを1本ずつの塔（とう）と見る。前にある高い塔にかくれたボルトは、その前のいちばん高い塔に合体し、威力を全部足す。"},
  {"en": "Median of Medians", "to": "中央値（ちゅうおうち）の中央値"},
  {"en": "Median of Medians+", "to": "中央値（ちゅうおうち）の中央値+"},
  {"en": "Finds the median power in guaranteed linear time (groups of five), like Quickselect but never slow: bolts at or above it fly at the toughest foe, the rest at the weakest. The first bolt equal to the median is the pivot.", "to": "5つずつのグループで、かならず線形時間（せんけいじかん）で中央値（ちゅうおうち）を見つける。Quickselectと同じだが、おそくならない。中央値以上のボルトはいちばんタフな敵へ、残りはいちばん弱い敵へ。中央値と同じ最初のボルトがピボット。"},
  {"en": "The same selection, and the pivot gains 3.", "to": "同じ選び方で、ピボットの威力が3上がる。"},
  {"en": "Introsort", "to": "イントロソート"},
  {"en": "Introsort+", "to": "イントロソート+"},
  {"en": "Sorts weakest first with quick sort, and falls back to heap sort once the recursion is deeper than 2·⌊log₂ n⌋, so no volley can make it slow. Equal powers keep their order.", "to": "クイックソートで弱い順に並べ、再帰が2·⌊log₂ n⌋より深くなったらヒープソートに切りかえる。どんな並びでもおそくならない。同じ威力のボルトは順番が変わらない。"},
  {"en": "The same hybrid sort, for no mana.", "to": "同じハイブリッドソートが、マナ0で使える。"}
]
