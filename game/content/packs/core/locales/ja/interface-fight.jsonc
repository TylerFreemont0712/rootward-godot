  {"en": "Hand empty: run %s, or end the turn.", "to": "手札（てふだ）がないよ。%sを実行するか、ターン終了しよう。", "kanji": "手札がないよ。%sを実行するか、ターン終了しよう。"},
  {"en": "%s is full: run it, or end the turn.", "to": "%sはいっぱい。実行するか、ターン終了しよう。", "kanji": "%sはいっぱい。実行するか、ターン終了しよう。"},
  {"en": "Click or drag cards into %s; they run left to right. Right-click holds one.", "to": "カードをクリックかドラッグで%sへ。左から右に動くよ。右クリックで1枚キープ。", "kanji": "カードをクリックかドラッグで%sへ。左から右に動くよ。右クリックで1枚キープ。"},
  {"en": "Your hand is empty. Cast what you built, or end the turn to draw a new hand.", "to": "手札（てふだ）がないよ。作った呪文（じゅもん）を唱えるか、ターン終了して新しい手札を引こう。", "kanji": "手札がないよ。作った呪文を唱えるか、ターン終了して新しい手札を引こう。"},
  {"en": "Your spell is full or spent: cast it, or end the turn. Right-click a card to hold it for next turn.", "to": "呪文（じゅもん）がいっぱいか、もう使ったよ。唱えるか、ターン終了しよう。カードを右クリックすると、次のターンまでキープできるよ。", "kanji": "呪文がいっぱいか、もう使ったよ。唱えるか、ターン終了しよう。カードを右クリックすると、次のターンまでキープできるよ。"},
  {"en": "Click a card to play it into %s, or drag it to a slot; cards run left to right. Right-click to hold one. ", "to": "カードをクリックして%sに入れるか、スロットにドラッグしよう。カードは左から右に動くよ。右クリックで1枚キープ。", "kanji": "カードをクリックして%sに入れるか、スロットにドラッグしよう。カードは左から右に動くよ。右クリックで1枚キープ。"},
  {"en": "A blank spell still casts one plain bolt.", "to": "からっぽの呪文（じゅもん）でも、ふつうのボルトを1発うてるよ。", "kanji": "からっぽの呪文でも、ふつうのボルトを1発うてるよ。"},
