[
  {"en": "Read Input", "to": "入力を読む"},
  {"en": "Read Input+", "to": "入力を読む+"},
  {"en": "One bolt per foe, its power the total of that foe's next attack (damage per hit times hits, at least 1): the battle is your input.", "to": "各敵に矢を一本ずつ。その威力は、その敵の次の攻撃の合計（一回あたりのダメージ×回数、最低1）です。戦いがあなたの入力になります。"},
  {"en": "One bolt per foe, its power the total of that foe's next attack (damage per hit times hits) plus 2, at least 3: the battle is your input.", "to": "各敵に矢を一本ずつ。その威力は、その敵の次の攻撃の合計（一回あたりのダメージ×回数）に2を足したもの（最低3）です。戦いがあなたの入力になります。"},
  {"en": "Monte Carlo", "to": "モンテカルロ"},
  {"en": "Monte Carlo+", "to": "モンテカルロ+"},
  {"en": "Eight bolts of power 1 to 6, rolled from a seed taken from the battle, so the preview is the cast.", "to": "戦いから決めた種（たね）で、威力1から6のボルトを8本ふる。だから予告と実行が同じになる。"},
  {"en": "Eight bolts of power 2 to 7, rolled from a seed taken from the battle, so the preview is the cast.", "to": "戦いから決めた種（たね）で、威力2から7のボルトを8本ふる。だから予告と実行が同じになる。"},
  {"en": "Reservoir Sampling", "to": "リザーバーサンプリング"},
  {"en": "Reservoir Sampling+", "to": "リザーバーサンプリング+"},
  {"en": "One pass keeps three random bolts, each doubled, and the rest fade; with fewer than three, all are kept. Seeded by the turn and the volley, so the preview is the cast.", "to": "一回の走査で、ランダムな矢を三本残し、それぞれの威力を2倍にします。残りは消えます。三本未満なら、すべて残ります。種はターンと一斉射なので、プレビューは実際の発動と同じです。"},
  {"en": "One pass keeps four random bolts, each doubled, and the rest fade; with fewer than four, all are kept. Seeded by the turn and the volley, so the preview is the cast.", "to": "一回の走査で、ランダムな矢を四本残し、それぞれの威力を2倍にします。残りは消えます。四本未満なら、すべて残ります。種はターンと一斉射なので、プレビューは実際の発動と同じです。"},
  {"en": "Swap", "to": "スワップ"},
  {"en": "Swap+", "to": "スワップ+"},
  {"en": "The first and last bolts change places.", "to": "先頭と最後のボルトが入れかわる。"},
  {"en": "The first and last bolts change places, then the new first bolt gains 1.", "to": "先頭と最後のボルトが入れかわり、新しい先頭の威力が1上がる。"},
  {"en": "Rotate", "to": "ローテート"},
  {"en": "Rotate+", "to": "ローテート+"},
  {"en": "The volley rotates by one: the last bolt comes first.", "to": "ボルトの列を1つ回す。最後のボルトが先頭に来る。"},
  {"en": "The volley rotates by two: the last two bolts come first.", "to": "ボルトの列を2つ回す。最後の2本が先頭に来る。"},
  {"en": "Enumerate", "to": "エニュメレート"},
  {"en": "Enumerate+", "to": "エニュメレート+"},
  {"en": "Each bolt gains its index (0, 1, 2 ...), so later bolts gain more.", "to": "ボルトが自分の番号（0、1、2…）を足す。後ろのボルトほど強くなる。"},
  {"en": "Each bolt gains its index plus 1 (1, 2, 3 ...), so later bolts gain more.", "to": "ボルトが自分の番号に1を足した数（1、2、3…）を足す。後ろのボルトほど強くなる。"},
  {"en": "Slice", "to": "スライス"},
  {"en": "Slice+", "to": "スライス+"},
  {"en": "Keeps the first four bolts (bolts[:4]), each gaining 2; the rest are dropped, power and all.", "to": "最初の4本の矢を残し、それぞれの威力を2上げます。それ以降の矢は、威力ごと捨てられます。"},
  {"en": "Keeps the first four bolts (bolts[:4]), each gaining 3; the rest are dropped, power and all.", "to": "最初の4本の矢を残し、それぞれの威力を3上げます。それ以降の矢は、威力ごと捨てられます。"},
  {"en": "Pop", "to": "ポップ"},
  {"en": "Pop+", "to": "ポップ+"},
  {"en": "Removes the last bolt and adds its power to the first; a lone bolt is left as it is.", "to": "最後の矢を取り除き、その威力を最初の矢に足します。矢が一本だけなら、そのままです。"},
  {"en": "Removes the last bolt and adds its power plus 1 to the first; a lone bolt is left as it is.", "to": "最後の矢を取り除き、その威力に1を足したものを最初の矢に足します。矢が一本だけなら、そのままです。"},
  {"en": "Bit Shift", "to": "ビットシフト"},
  {"en": "Bit Shift+", "to": "ビットシフト+"},
  {"en": "Every bolt doubles (bolt << 1), but a result past 31 wraps around (& 31).", "to": "すべてのボルトが2倍になる（bolt << 1）。ただし31をこえた分は、ぐるっと回ってもどる（& 31）。"},
  {"en": "Every bolt doubles (bolt << 1), but a result past 63 wraps around (& 63).", "to": "すべてのボルトが2倍になる（bolt << 1）。ただし63をこえた分は、ぐるっと回ってもどる（& 63）。"},
  {"en": "Sort by Key", "to": "キーで並べかえ"},
  {"en": "Sort by Key+", "to": "キーで並べかえ+"},
  {"en": "A stable sort by element (none, fire, frost, then spark), then by power: the elements are grouped, and equal bolts keep their order.", "to": "属性（なし、火、霜、雷の順）で安定に並べ替え、その後で威力順にします。属性ごとにまとまり、同じ矢は元の順番を保ちます。"},
  {"en": "A stable sort by element, then by power: the elements are grouped, and equal bolts keep their order. Costs 0 mana.", "to": "属性、次に威力の順に、安定して並べかえる。同じ属性が集まり、同じボルトは元の順のまま。0マナ。"},
  {"en": "Range", "to": "レンジ"},
  {"en": "Range+", "to": "レンジ+"},
  {"en": "range(2, 10, 2): four more bolts, 2, 4, 6 and 8, rising by the step.", "to": "range(2, 10, 2)：2、4、6、8のボルトを4本ふやす。ステップごとに大きくなる。"},
  {"en": "range(3, 15, 3): four more bolts, 3, 6, 9 and 12, rising by the step.", "to": "range(3, 15, 3)：3、6、9、12のボルトを4本ふやす。ステップごとに大きくなる。"},
  {"en": "List Comprehension", "to": "リスト内包表記（ないほうひょうき）"},
  {"en": "List Comprehension+", "to": "リスト内包表記（ないほうひょうき）+"},
  {"en": "[b + 2 for b in bolts if b >= 3]: bolts under 3 are dropped, the rest gain 2.", "to": "[b + 2 for b in bolts if b >= 3]：威力3より小さいボルトは消え、残りは威力が2上がる。"},
  {"en": "[b + 3 for b in bolts if b >= 3]: bolts under 3 are dropped, the rest gain 3.", "to": "[b + 3 for b in bolts if b >= 3]：威力3より小さいボルトは消え、残りは威力が3上がる。"}
]
