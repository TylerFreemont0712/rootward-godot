[
  {"en": "Open", "to": "オープン"},
  {"en": "Closed", "to": "クローズ"},
  {"en": "Pick %d card(s) from your deck.", "to": "デッキからカードを%d枚えらぼう。"},
  {"en": "Pick up to %d cards from your deck.", "to": "デッキからカードを%d枚までえらぼう。"},
  {"en": "Confirm", "to": "決定"},
  {"en": "Choose a paradigm.", "to": "パラダイムをえらぼう。"},
  {"en": "Take one card.", "to": "カードを1枚もらおう。"},
  {"en": "Take nothing", "to": "何ももらわない"},
  {"en": "Choose another focus. The signature card you hold stays.", "to": "ほかのフォーカスをえらぼう。持っているシグネチャーカードはのこる。"},
  {"en": "Running your card in the sandbox...", "to": "サンドボックスでカードを走らせているよ…"},
  {"en": "What does %s return for the bolts %s?", "to": "%sは、ボルト%sを受けとると何を返す？"},
  {"en": "How many bolts does %s return for the powers %s?", "to": "%sは、威力%sのボルトを受けとると、何本返す？"},
  {"en": "The test: %s on %s must return %s. Which version passes?", "to": "テスト：%sに%sを入れると%sが返るはず。どのバージョンが通る？"},
  {"en": "A forum answer for %s. Copy it into your deck?", "to": "%sについてのフォーラムの回答。デッキにコピーする？"},
  {"en": "Line %d was changed: %s  →  %s", "to": "%d行目が変わっている：%s  →  %s"},
  {"en": "On %d bolts, which of your cards does less work?", "to": "ボルトが%d本のとき、どちらのカードの仕事が少ない？"},
  {"en": "Will %s finish within this layer's budget of %d operations, on %d bolts?", "to": "%sは、ボルト%3$d本のとき、この階層の予算（%2$dオペレーション）の中で終わる？"},
  {"en": "Version %s", "to": "バージョン%s"},
  {"en": "It finishes", "to": "終わる"},
  {"en": "It times out", "to": "時間切れになる"},
  {"en": "The same", "to": "同じ"},
  {"en": "Copy it", "to": "コピーする"},
  {"en": "Close the issue", "to": "イシューをクローズする"},
