// Japanese for Lanternroot's chapter 3 tasks: glow, weather, hours, count and stones (Concept/v0.4/06): their names,
// goals, hints, advice, the glossary's meanings, the cases, the Builder's labels and the starter code's comments,
// keyed by the English exactly (ADR-0047). Code, placeholders and the code words in quotes stay as they are.
[
  {"en": "Each lantern has a lit part that is True or False. Ask about it with if, and only then add one to your tally.", "to": "ランタンには、ついて いるかを しめす パーツが あるよ。その こたえは True か False。if で たずねて、ついて いる ときだけ、きみの かぞえに 1を たそう。", "kanji": "ランタンには、ついているかを示すパーツがあるよ。その答えは True か False。if で尋ねて、ついているときだけ、君の数えに 1を足そう。"},
  {"en": "For {say}, your count gave nothing back. Pip's board needs a number.", "to": "「{say}」の とき、きみの count() は なにも かえさなかったね。ピップの かんばんには すうじが いるよ。", "kanji": "「{say}」のとき、君の count() は何も返さなかったね。ピップの看板には数字がいるよ。"},
  {"en": "For {say}, your count gave {got}, but it should give {want}. Did you look at every lantern, and count only the lit ones?", "to": "「{say}」の とき、きみの count() は {got} を かえしたけど、ほんとうは {want} に なるはずだよ。ランタンを ぜんぶ みて、ついて いる ものだけを かぞえたかな？", "kanji": "「{say}」のとき、君の count() は {got} を返したけど、本当は {want} になるはずだよ。ランタンを全部見て、ついているものだけを数えたかな？"},
  {"en": "For {say}, your count gave {got}. Pip's board needs a number.", "to": "「{say}」の とき、きみの count() は {got} を かえしたよ。ピップの かんばんには すうじが いるんだよ。", "kanji": "「{say}」のとき、君の count() は {got} を返したよ。ピップの看板には数字がいるんだよ。"},
  {"en": "Give back your tally after the loop has looked at every lantern. Where must the give-back line go to do that?", "to": "くりかえしが ランタンを ぜんぶ みおわった あとに、きみの かぞえを かえしてね。そのためには、かえす ぎょうを どこに おかないと いけないかな？", "kanji": "繰り返しがランタンを全部みおわった後に、君の数えを返してね。そのためには、返す行をどこに置かないといけないかな？"},
  {"en": "How many lanterns are lit, as a whole number from 0 up.", "to": "ついて いる ランタンの かず。0から はじまる、まるい すうじで。", "kanji": "灯っているランタンの数。0から始まる、丸い数字で。"},
  {"en": "Keep a number that starts at 0 before the loop. It is your tally: how many lit lanterns you have counted so far.", "to": "くりかえしの まえに、0から はじまる かずを おこう。それが きみの かぞえだよ。いままで かぞえた、ついて いる ランタンの かずだね。", "kanji": "ループの前で、0から始まる変数を用意しよう。これが集計用の変数だよ。点灯しているランタンをいくつ数えたか、記録しておくんだ。"},
  {"en": "Pip wants to count the lit lanterns. Give back how many of them are lit.", "to": "ピップは ついて いる ランタンを かぞえたいんだって。ついて いる ものが いくつ あるかを かえしてね。", "kanji": "ピップは灯っているランタンを数えたいんだって。ついているものがいくつあるかを返してね。"},
  {"en": "Pip's Tally", "to": "ピップの かぞえ", "kanji": "ピップの数え"},
  {"en": "Pip's board has to look at each lantern in the list, one by one. Which kind of loop does that?", "to": "ピップの かんばんは、リストの ランタンを ひとつずつ みないと いけないよ。それは、どんな くりかえしで できるかな？", "kanji": "ピップの看板は、リストのランタンを一つずつ見ないといけないよ。それは、どんな繰り返しでできるかな？"},
  {"en": "Pip's tally board counts the lit lanterns with your count().", "to": "ピップの かぞえ かんばんは、きみの count() で、ついて いる ランタンを かぞえるよ。", "kanji": "ピップの集計板は、君の count() で点灯しているランタンを数えています。"},
  {"en": "Puts a value into a name, so you can use it later.", "to": "なまえに あたいを いれて、あとで つかえる ように するよ。", "kanji": "名前に値を入れて、後で使えるようにするよ。"},
  {"en": "Reads one part of a dictionary, by the name of that part in quotes.", "to": "辞書 の パーツを ひとつ よむよ。パーツの なまえを \"\" で かこんで かくよ。", "kanji": "辞書のパーツを一つよむよ。パーツの名前を \"\" で囲んでかくよ。"},
  {"en": "Reads one part of an object, by the name of that part in quotes.", "to": "オブジェクト の パーツを ひとつ よむよ。パーツの なまえを \"\" で かこんで かくよ。", "kanji": "オブジェクトのパーツを一つよむよ。パーツの名前を \"\" で囲んでかくよ。"},
  {"en": "Runs the lines in its braces once for each item in a list, one item at a time.", "to": "リストの もの ひとつずつに、かっこ { } の なかの ぎょうを 1かいずつ うごかすよ。", "kanji": "リストのもの一つずつに、括弧 { } の中の行を 1回ずつ動かすよ。"},
  {"en": "Runs the lines under it once for each item in a list, one item at a time.", "to": "リストの もの ひとつずつに、その した の ぎょうを 1かいずつ うごかすよ。", "kanji": "リストのもの一つずつに、そのしたの行を 1回ずつ動かすよ。"},
  {"en": "The town's lanterns. Each one is a dictionary with a \"name\" and a \"lit\", which is true when the lantern is lit.", "to": "まちの ランタン。ひとつずつ、\"name\" と \"lit\" を もつ 辞書 だよ。\"lit\" は、ランタンが ついて いる ときに true に なるよ。", "kanji": "町のランタン。一つずつ、\"name\" と \"lit\" を持つ辞書だよ。\"lit\" は、ランタンがついているときに true になるよ。"},
  {"en": "add", "to": "たす", "kanji": "足す"},
  {"en": "all five lit", "to": "5こ ぜんぶ ついて いる", "kanji": "5個全部ついている"},
  {"en": "no lanterns at all", "to": "ランタンが ひとつも ない", "kanji": "ランタンが一つもない"},
  {"en": "none lit", "to": "ひとつも ついて いない", "kanji": "一つもついていない"},
  {"en": "three of five lit", "to": "5こ のうち 3こ ついて いる", "kanji": "5個のうち 3個ついている"},
  {"en": "which part", "to": "どの パーツ", "kanji": "どのパーツ"},
  {"en": "Give back how many lanterns are lit, as a whole number.", "to": "ついて いる ランタンの かずを、まるい すうじで かえしてね。", "kanji": "灯っているランタンの数を、丸い数字で返してね。"},
  {"en": "lanterns is the town's list of lanterns. Each one has a \"name\" and a \"lit\", which is True when it is lit.", "to": "lanterns は まちの ランタンの リストだよ。ひとつずつ \"name\" と \"lit\" を もって いて、\"lit\" は ついて いる ときに True に なるよ。", "kanji": "lanterns は町のランタンのリストだよ。一つずつ \"name\" と \"lit\" を持っていて、\"lit\" はついているときに True になるよ。"},
  {"en": "lanterns is the town's list of lanterns. Each one has a \"name\" and a \"lit\", which is true when it is lit.", "to": "lanterns は まちの ランタンの リストだよ。ひとつずつ \"name\" と \"lit\" を もって いて、\"lit\" は ついて いる ときに true に なるよ。", "kanji": "lanterns は町のランタンのリストだよ。一つずつ \"name\" と \"lit\" を持っていて、\"lit\" はついているときに true になるよ。"},
  {"en": "For {say}, Hotaru needs a number from 0.0 to 1.0, but your glow() gave {got}.", "to": "「{say}」の とき、ほたるは 0.0から 1.0までの かずを ほしがって いるよ。でも、きみの glow() は {got} を かえしたね。", "kanji": "「{say}」のとき、ほたるは 0.0から 1.0までの数を欲しがっているよ。でも、君の glow() は {got} を返したね。"},
  {"en": "For {say}, your glow() gave {got}. Hotaru can only shine from 0.0 (dark) to 1.0 (bright).", "to": "「{say}」の とき、きみの glow() は {got} を かえしたよ。ほたるは、0.0（くらい）から 1.0（あかるい）までの あかるさで ひかるよ。", "kanji": "「{say}」のとき、君の glow() は {got} を返したよ。ほたるは、0.0（暗い）から 1.0（明るい）までの明るさで光るよ。"},
  {"en": "Gives what is left over after sharing a number out. 11 % 5 is 1: 5 fits into 11 twice, and 1 is left.", "to": "かずを わけた あとに あまる ぶんを かえすよ。11 % 5 は 1。5 は 11に 2かい はいって、1が あまるから。", "kanji": "数を分けた後に余るぶんを返すよ。11 % 5 は 1。5 は 11に 2回入って、1が余るから。"},
  {"en": "Hotaru asks: make my light blink! Each second, give me a brightness from 0.0 (dark) to 1.0 (bright).", "to": "ほたるが いうよ：わたしの ひかりを ぴかぴか させて！ 1びょうごとに、0.0（くらい）から 1.0（あかるい）までの あかるさを ちょうだい！", "kanji": "ほたるがいうよ：私の光をぴかぴかさせて！ 1秒ごとに、0.0（暗い）から 1.0（明るい）までの明るさをちょうだい！"},
  {"en": "Hotaru does not blink yet. Some seconds need a dim brightness (0.3 or less), and some need a bright one (0.7 or more).", "to": "ほたるは まだ ぴかぴか して いないよ。くらい あかるさ（0.3 いか）が いる びょうと、あかるい あかるさ（0.7 いじょう）が いる びょうが あるよ。", "kanji": "ほたるはまだぴかぴかしていないよ。暗い明るさ（0.3 以下）がいる秒と、明るい明るさ（0.7 以上）がいる秒があるよ。"},
  {"en": "Hotaru shines in the pattern your glow() makes.", "to": "ほたるは、きみの glow() が つくる もようで ひかるよ。", "kanji": "ほたるは、君の glow() が作る模様で光るよ。"},
  {"en": "Hotaru's Glow", "to": "ほたるの ひかり", "kanji": "ほたるの光"},
  {"en": "Hotaru's brightness: 0.0 is dark and 1.0 is bright.", "to": "ほたるの あかるさ。0.0は くらい、1.0は あかるい。", "kanji": "ほたるの明るさ。0.0は暗い、1.0は明るい。"},
  {"en": "I need to blink, so some seconds must be dim and some bright. Dim is 0.3 or less, and bright is 0.7 or more. Which seconds should be dim?", "to": "わたし、ぴかぴか したいの。だから、くらい びょうと あかるい びょうが いるのよ。くらいは 0.3 いか、あかるいは 0.7 いじょう。どの びょうを くらく したら いいかな？", "kanji": "私、ぴかぴかしたいの。だから、暗い秒と明るい秒がいるのよ。暗いは 0.3 以下、明るいは 0.7 以上。どの秒を暗くしたらいいかな？"},
  {"en": "The second of the minute, from 0 to 59. It goes up by one each second.", "to": "1ぷんの なかの びょう。0から 59まで。1びょうごとに 1ずつ ふえるよ。", "kanji": "1ぷんの中の秒。0から 59まで。1秒ごとに 1ずつ増えるよ。"},
  {"en": "The words column has a sign that gives back what is left over after sharing. As t counts up, a left-over goes round and round: 0, 1, 0, 1, or 0, 1, 2, 0, 1, 2. How could a pattern like that turn into dim and bright?", "to": "ことばの らんに ある しるし（%）は、わけた あとに あまる ぶんを かえすよ。t が ふえると、あまりは ぐるぐる まわるの。0, 1, 0, 1 や、0, 1, 2, 0, 1, 2 みたいに。そんな もようを、くらい と あかるい に どう かえたら いいかな？", "kanji": "用語欄にある印（%）は、分けた後に余るぶんを返すよ。t が増えると、あまりはぐるぐる回るの。0, 1, 0, 1 や、0, 1, 2, 0, 1, 2 みたいに。そんな模様を、暗いと明るいにどう変えたらいいかな？"},
  {"en": "Think of the seconds in pairs: 0 and 1, then 2 and 3, then 4 and 5. Each pair has a first second and a second second. How can your function tell them apart?", "to": "びょうを ふたつずつ 組に して かんがえて みよう。0と 1、つぎに 2と 3、そのつぎに 4と 5。ひと組には、1ばんめの びょうと、2ばんめの びょうが あるよ。きみの かんすうは、その ふたつを どう やって わけるかな？", "kanji": "秒を二つずつ組にして考えてみよう。0と 1、次に 2と 3、そのつぎに 4と 5。ひと組には、1番目の秒と、2番目の秒があるよ。君の関数は、その二つをどうやって分けるかな？"},
  {"en": "second 0", "to": "0びょうめ", "kanji": "0秒目"},
  {"en": "second 1", "to": "1びょうめ", "kanji": "1秒目"},
