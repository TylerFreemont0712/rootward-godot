[
  // The program run's cards and their +, relics, foes, paradigms and keywords (ADR-0018). Names that are code
  // (import heapq, global total, -O3...) stay code: a program's words are the same in every language.
  {
    "en": "Adds 4 power to every bolt. The more bolts, the more it adds.",
    "to": "すべての矢の威力を4上げます。矢が多いほど、上がる合計も増えます。"
  },
  {
    "en": "Adds 3 power to every bolt. The more bolts, the more it adds.",
    "to": "すべての矢の威力を3上げます。矢が多いほど、上がる合計も増えます。"
  },
  {
    "en": "Binary Execute+",
    "to": "二分探索の一撃+"
  },
  {
    "en": "For each foe, weakest first, binary-searches the sorted volley for the smallest bolt that kills it. The bolts left over still fly, at the front foe.",
    "to": "弱い敵から順に、並んだ一斉射を二分探索して、その敵を倒せるいちばん小さな矢を選びます。残った矢も、前列の敵へ飛びます。"
  },
  {
    "en": "Binary Execute",
    "to": "二分探索の一撃"
  },
  {
    "en": "For each foe, weakest first, binary-searches the sorted volley for the smallest bolt that kills it. Only those bolts fly. On unsorted data it picks wrong.",
    "to": "弱い敵から順に、並んだ一斉射を二分探索して、その敵を倒せるいちばん小さな矢を選びます。飛ぶのは選んだ矢だけ。並んでいないデータでは選び間違えます。"
  },
  {
    "en": "Bisect Insert+",
    "to": "二分挿入+"
  },
  {
    "en": "Binary-searches for where an 8-power bolt belongs and puts it there, three times. A sorted volley stays sorted.",
    "to": "威力8の矢が入るべき場所を二分探索で見つけて差し込むことを、3回くり返します。並んだ一斉射は並んだままです。"
  },
  {
    "en": "Bisect Insert",
    "to": "二分挿入"
  },
  {
    "en": "Binary-searches for where a 7-power bolt belongs and puts it there, twice. A sorted volley stays sorted; an unsorted one gets them wherever the search lands.",
    "to": "威力7の矢が入るべき場所を二分探索で見つけて差し込むことを、2回くり返します。並んだ一斉射は並んだまま。並んでいなければ、探索がたどり着いた場所に入ります。"
  },
  {
    "en": "Bubble Sort",
    "to": "バブルソート"
  },
  {
    "en": "Walks the volley again and again, swapping neighbours that are out of order, until a pass swaps nothing: weakest first. Free, and slow, O(n²). A forge optimises it into Merge Sort.",
    "to": "一斉射を何度もたどり、順番の違う隣どうしを入れ替えます。入れ替えのない一巡が来たら終わり、弱い順に並びます。マナはかからず、O(n²)で遅い。鍛冶場でマージソートに最適化できます。"
  },
  {
    "en": "Charge+",
    "to": "充填+"
  },
  {
    "en": "Sets every bolt to spark, 2 stronger. Foes weak to spark take half again as much.",
    "to": "すべての矢を雷属性にし、威力を2上げます。雷に弱い敵は1.5倍のダメージを受けます。"
  },
  {
    "en": "Sets every bolt to spark, 1 stronger. Foes weak to spark take half again as much.",
    "to": "すべての矢を雷属性にし、威力を1上げます。雷に弱い敵は1.5倍のダメージを受けます。"
  },
  {
    "en": "Sets every bolt to frost, 2 stronger. Foes weak to frost take half again as much.",
    "to": "すべての矢を霜属性にし、威力を2上げます。霜に弱い敵は1.5倍のダメージを受けます。"
  },
  {
    "en": "Sets every bolt to frost, 1 stronger. Foes weak to frost take half again as much.",
    "to": "すべての矢を霜属性にし、威力を1上げます。霜に弱い敵は1.5倍のダメージを受けます。"
  },
  {
    "en": "Dedupe+",
    "to": "重複除去+"
  },
  {
    "en": "A set remembers every power seen: a bolt whose power was seen before is dropped, and every bolt that stays gains 3.",
    "to": "集合が見た威力をすべて覚えます。前に見た威力の矢は取り除き、残った矢はそれぞれ威力が3上がります。"
  },
  {
    "en": "Dedupe",
    "to": "重複除去"
  },
  {
    "en": "A set remembers every power seen: a bolt whose power was seen before is dropped, and every bolt that stays gains 2.",
    "to": "集合が見た威力をすべて覚えます。前に見た威力の矢は取り除き、残った矢はそれぞれ威力が2上がります。"
  },
  {
    "en": "Divide+",
    "to": "分割+"
  },
  {
    "en": "Splits the volley in half, and each half in half, down to single bolts. Every level makes every bolt 2 stronger (3 with import math): about 2 log₂ n each.",
    "to": "一斉射を半分に、そのまた半分にと、1本ずつになるまで分けます。一段ごとにすべての矢の威力が2上がり（import math があれば3）、1本あたりおよそ 2 log₂ n 強くなります。"
  },
  {
    "en": "Divide",
    "to": "分割"
  },
  {
    "en": "Splits the volley in half, and each half in half, down to single bolts. Every level makes every bolt 1 stronger: about log₂ n each.",
    "to": "一斉射を半分に、そのまた半分にと、1本ずつになるまで分けます。一段ごとにすべての矢の威力が1上がり、1本あたりおよそ log₂ n 強くなります。"
  },
  {
    "en": "Exhaustive Kill+",
    "to": "総当たりの一撃+"
  },
  {
    "en": "Tries every subset of the first 12 bolts to find the one that kills the front foe with the least overkill; those bolts hit it, the rest hit the weakest of the other foes.",
    "to": "先頭12本の矢のすべての部分集合を試し、前列の敵をいちばん無駄なく倒せる組を探します。その矢で前列の敵を撃ち、残りはほかの敵のうち最も弱い敵を撃ちます。"
  },
  {
    "en": "Exhaustive Kill",
    "to": "総当たりの一撃"
  },
  {
    "en": "Tries every subset of the first 12 bolts to find the one that kills the front foe with the least overkill (2ⁿ subsets). The rest go at the next foe.",
    "to": "先頭12本の矢のすべての部分集合（2ⁿ通り）を試し、前列の敵をいちばん無駄なく倒せる組を探します。残りの矢は次の敵へ向かいます。"
  },
  {
    "en": "Exhaustive Ward+",
    "to": "総当たりの守り+"
  },
  {
    "en": "Tries every subset of the first ten bolts (2ⁿ of them) for the one that reaches 16 block with the least to spare. Those guard; the rest still fly.",
    "to": "先頭10本の矢のすべての部分集合（2ⁿ通り）から、防御16にいちばん無駄なく届く組を探します。その矢が守りになり、残りはそのまま飛びます。"
  },
  {
    "en": "Exhaustive Ward",
    "to": "総当たりの守り"
  },
  {
    "en": "Tries every subset of the first ten bolts (2ⁿ of them) for the one that reaches 12 block with the least to spare. Those bolts guard you; the rest still fly. Perfect, and slow.",
    "to": "先頭10本の矢のすべての部分集合（2ⁿ通り）から、防御12にいちばん無駄なく届く組を探します。その矢があなたを守り、残りはそのまま飛びます。完璧で、そして遅い。"
  },
  {
    "en": "Fibonacci Table+",
    "to": "フィボナッチ表+"
  },
  {
    "en": "The Fibonacci surge from a table built once: each bolt gains fib(i) for its place i, up to fib(20), in O(n).",
    "to": "一度だけ作った表から、フィボナッチの奔流を放ちます。i 番目の矢は威力が fib(i) 上がり（最大 fib(20)）、O(n)で済みます。"
  },
  {
    "en": "Fibonacci Table",
    "to": "フィボナッチ表"
  },
  {
    "en": "The same Fibonacci surge, remembered instead of recomputed: each fib(i) is the sum of the two before it. O(n) where the naive one was O(2ⁿ).",
    "to": "同じフィボナッチの奔流を、計算し直さずに覚えておきます。fib(i) はそれぞれ直前の2つの和。素朴な再帰がO(2ⁿ)だったところを、O(n)で。"
  },
  {
    "en": "Fibonacci Surge",
    "to": "フィボナッチの奔流"
  },
  {
    "en": "Each bolt gains fib(i) power for its place i in the volley (up to fib(16)), computed by naive recursion: about 2ⁿ calls. A forge can optimise it.",
    "to": "一斉射の i 番目の矢は威力が fib(i) 上がります（最大 fib(16)）。素朴な再帰で計算するので、呼び出しはおよそ 2ⁿ 回。鍛冶場で最適化できます。"
  },
  {
