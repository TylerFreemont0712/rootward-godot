[
  // The program run's cards and their +, relics, foes, paradigms and keywords (ADR-0018). Names that are code
  // (import heapq, global total, -O3...) stay code: a program's words are the same in every language.
  {
    "en": "Adds 4 power to every bolt. The more bolts, the more it adds.",
    "to": "すべての矢の威力を4上げます。矢が多いほど、上がる合計も増えます。", "kanji": "すべての矢の威力を4上げます。矢が多いほど、上がる合計も増えます。"
  },
  {
    "en": "Adds 3 power to every bolt. The more bolts, the more it adds.",
    "to": "すべての矢の威力を3上げます。矢が多いほど、上がる合計も増えます。", "kanji": "すべての矢の威力を3上げます。矢が多いほど、上がる合計も増えます。"
  },
  {
    "en": "Binary Execute+",
    "to": "二分探索の一撃+", "kanji": "二分探索の一撃+"
  },
  {
    "en": "For each foe, weakest first, binary-searches the sorted volley for the smallest bolt that kills it. The bolts left over still fly, at the front foe.",
    "to": "弱い敵から順に、並んだ一斉射を二分探索して、その敵を倒せるいちばん小さな矢を選びます。残った矢も、前列の敵へ飛びます。", "kanji": "弱い敵から順に、並んだ一斉射を二分探索して、その敵を倒せるいちばん小さな矢を選びます。残った矢も、前列の敵へ飛びます。"
  },
  {
    "en": "Binary Execute",
    "to": "二分探索の一撃", "kanji": "二分探索の一撃"
  },
  {
    "en": "For each foe, weakest first, binary-searches the sorted volley for the smallest bolt that kills it (the strongest if none does). Only those bolts fly. On unsorted data it picks wrong.",
    "to": "敵ごとに弱い順に、並んだ一斉射を二分探索して、その敵を倒せるいちばん小さな矢を選びます（倒せる矢がなければ、いちばん強い矢）。選んだ矢だけが飛びます。並んでいないデータでは、選び間違えます。", "kanji": "敵ごとに弱い順に、並んだ一斉射を二分探索して、その敵を倒せるいちばん小さな矢を選びます（倒せる矢がなければ、いちばん強い矢）。選んだ矢だけが飛びます。並んでいないデータでは、選び間違えます。"
  },
  {
    "en": "Bisect Insert+",
    "to": "二分挿入+", "kanji": "二分挿入+"
  },
  {
    "en": "Binary-searches for where an 8-power bolt belongs and puts it there, three times. A sorted volley stays sorted.",
    "to": "威力8の矢が入るべき場所を二分探索で見つけて差し込むことを、3回くり返します。並んだ一斉射は並んだままです。", "kanji": "威力8の矢が入るべき場所を二分探索でみつけて差し込むことを、3回くり返します。並んだ一斉射は並んだままです。"
  },
  {
    "en": "Bisect Insert",
    "to": "二分挿入", "kanji": "二分挿入"
  },
  {
    "en": "Binary-searches for where a 7-power bolt belongs and puts it there, twice. A sorted volley stays sorted; an unsorted one gets them wherever the search lands.",
    "to": "威力7の矢が入るべき場所を二分探索で見つけて差し込むことを、2回くり返します。並んだ一斉射は並んだまま。並んでいなければ、探索がたどり着いた場所に入ります。", "kanji": "威力7の矢が入るべき場所を二分探索でみつけて差し込むことを、2回くり返します。並んだ一斉射は並んだまま。並んでいなければ、探索がたどり着いた場所に入ります。"
  },
  {
    "en": "Bubble Sort",
    "to": "バブルソート", "kanji": "バブルソート"
  },
  {
    "en": "Walks the volley again and again, swapping neighbours that are out of order, until a pass swaps nothing: weakest first. Free, and slow, O(n²). A forge optimises it into Merge Sort.",
    "to": "一斉射を何度もたどり、順番の違う隣どうしを入れ替えます。入れ替えのない一巡が来たら終わり、弱い順に並びます。マナはかからず、O(n²)で遅い。鍛冶場でマージソートに最適化できます。", "kanji": "一斉射を何度もたどり、順番の違う隣どうしを入れ替えます。入れ替えのない一巡が来たら終わり、弱い順に並びます。マナはかからず、O(n²)で遅い。鍛冶場でマージソートに最適化できます。"
  },
  {
