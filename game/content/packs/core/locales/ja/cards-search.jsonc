[
  {"en": "Range Query", "to": "範囲検索（はんいけんさく）"},
  {"en": "Range Query+", "to": "範囲検索（はんいけんさく）+"},
  {"en": "Two binary searches find, for each foe, the bolts with power from half its HP up to its HP; they fly at it. Needs a sorted volley. The rest are stashed in the index.", "to": "二分探索を2回使い、敵ごとにHPの半分からHPまでの威力のボルトを見つけて、その敵へ送る。ボルトは弱い順にそろえておく。残りはインデックスへ。"},
  {"en": "Two binary searches find, for each foe, the bolts with power from a third of its HP up to its HP; they fly at it. Needs a sorted volley. The rest are stashed in the index.", "to": "二分探索を2回使い、敵ごとにHPの3分の1からHPまでの威力のボルトを見つけて、その敵へ送る。ボルトは弱い順にそろえておく。残りはインデックスへ。"},
  {"en": "Lower-Bound Ward", "to": "下限（かげん）のまもり"},
  {"en": "Lower-Bound Ward+", "to": "下限（かげん）のまもり+"},
  {"en": "Binary-searches the index for the smallest bolt that covers the biggest incoming attack and takes it as block. Exact defence.", "to": "二分探索で、いちばん大きい攻撃を防げる最小のボルトをインデックスから取り、ブロックにする。ぴったりの守り。"},
  {"en": "Binary-searches the index for the smallest bolt that covers the biggest incoming attack and takes it as block. Also gives 2 block.", "to": "二分探索で、いちばん大きい攻撃を防げる最小のボルトをインデックスから取り、ブロックにする。さらにブロック2。"},
  {"en": "Write-Ahead Log", "to": "先行書き込みログ"},
  {"en": "Write-Ahead Log+", "to": "先行書き込みログ+"},
  {"en": "Every bolt under 4 power is stashed into the index instead of flying: nothing weak is wasted.", "to": "威力が4未満のボルトは、飛ばさずにインデックスへしまう。弱いボルトもむだにならない。"},
  {"en": "Every bolt under 5 power is stashed into the index instead of flying: nothing weak is wasted.", "to": "威力が5未満のボルトは、飛ばさずにインデックスへしまう。弱いボルトもむだにならない。"},
  {"en": "Cursor", "to": "カーソル"},
  {"en": "Cursor+", "to": "カーソル+"},
  {"en": "Takes the three weakest bolts from the index in order; each brings a 2-power bolt of its element.", "to": "インデックスから、いちばん弱い3本を順に取る。どれも、同じ属性の威力2のボルトを1本連れてくる。"},
  {"en": "Takes the four weakest bolts from the index in order; each brings a 2-power bolt of its element.", "to": "インデックスから、いちばん弱い4本を順に取る。どれも、同じ属性の威力2のボルトを1本連れてくる。"},
  {"en": "Bloom Filter", "to": "ブルームフィルタ"},
  {"en": "Bloom Filter+", "to": "ブルームフィルタ+"},
  {"en": "One pass marks the elements the foes might be weak to; every bolt that might match gains 2. One false positive, picked by the turn, gains it wrongly; a real match is never missed.", "to": "敵の弱点かもしれない属性を1回で印づけ、当てはまりそうなボルトの威力を2上げる。ターンで決まる1本は、まちがえて上がる。本当の弱点は見のがさない。"},
  {"en": "An exact set of the foes' weak elements replaces the filter: every bolt that matches gains 2, with no false positive.", "to": "フィルタの代わりにぴったりの集合を使う。敵の弱点に当てはまるボルトの威力を2上げる。まちがいはない。"},
  {"en": "Consistent Hashing", "to": "コンシステントハッシュ"},
  {"en": "Consistent Hashing+", "to": "コンシステントハッシュ+"},
  {"en": "Foes sit on a ring and each bolt hashes to a point, flying at the next foe clockwise. When a foe falls, only its bolts move on to the next; none are wasted.", "to": "敵は輪の上に並び、ボルトは輪の上の点になって、時計回りで次の敵へ飛ぶ。敵が倒れても、その敵のボルトだけが次へ進む。むだはない。"},
  {"en": "Foes sit on a ring and each bolt hashes to a point, flying at the next foe clockwise. When a foe falls, only its bolts move on to the next, and they gain 1.", "to": "敵は輪の上に並び、ボルトは輪の上の点になって、時計回りで次の敵へ飛ぶ。敵が倒れたら、その敵のボルトだけが次へ進み、威力が1上がる。"},
  {"en": "Exponential Search", "to": "指数探索（しすうたんさく）"},
  {"en": "Exponential Search+", "to": "指数探索（しすうたんさく）+"},
  {"en": "On a sorted volley, gallops 1, 2, 4, 8 ... until a bolt kills the front foe, then binary-searches the last gap. Cheapest when the answer is near the front.", "to": "弱い順にそろえたボルトを1、2、4、8…と跳んで、前の敵を倒せるボルトを見つけ、最後のすきまだけ二分探索する。答えが前にあるほど速い。"},
  {"en": "On a sorted volley, gallops 1, 2, 4, 8 ... until a bolt kills each foe, weakest first, then binary-searches the last gap.", "to": "弱い順にそろえたボルトを1、2、4、8…と跳んで、弱い敵から順に倒せるボルトを見つけ、最後のすきまだけ二分探索する。"},
  {"en": "Ternary Search", "to": "三分探索（さんぶんたんさく）"},
  {"en": "Ternary Search+", "to": "三分探索（さんぶんたんさく）+"},
  {"en": "On a volley that rises then falls, finds the peak by cutting it in thirds and doubles that bolt.", "to": "上がってから下がるボルトの列を3つに分けて山の頂上を見つけ、そのボルトを2倍にする。"},
  {"en": "On a volley that rises then falls, finds the peak by cutting it in thirds, doubles that bolt and gives its neighbours +2.", "to": "上がってから下がるボルトの列を3つに分けて山の頂上を見つけ、そのボルトを2倍にし、となりのボルトの威力を2上げる。"},
  {"en": "Counting Sort", "to": "計数（けいすう）ソート"},
  {"en": "Counting Sort+", "to": "計数（けいすう）ソート+"},
  {"en": "Sorts weakest first by counting how many bolts have each power, never comparing two. Costs n plus the strongest bolt's power.", "to": "ボルトを比べずに、威力ごとの数をかぞえて弱い順にならべる。仕事量は、ボルトの数に最も強い威力を足した分。"},
  {"en": "Sorts weakest first by counting powers up to 64; stronger bolts are sorted after the rest. Costs at most n plus 64.", "to": "64までの威力をかぞえて弱い順にならべ、それより強いボルトは最後に別にならべる。仕事量は、多くてボルトの数に64を足した分。"}
]
