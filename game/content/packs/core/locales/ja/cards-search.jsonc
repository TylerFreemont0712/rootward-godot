[
  {"en": "Range Query", "to": "範囲検索（はんいけんさく）", "kanji": "範囲検索"},
  {"en": "Range Query+", "to": "範囲検索（はんいけんさく）+", "kanji": "範囲検索+"},
  {"en": "Two binary searches find, for each foe, the bolts with power from half its HP plus shield up to that sum; they fly at it. Needs a sorted volley. The rest are stashed in the index.", "to": "二回の二分探索で、敵ごとに、HPにシールドを足した値の半分から、その合計までの威力の矢を見つけます。それらはその敵へ飛びます。並んだ一斉射が必要です。残りは索引にしまわれます。", "kanji": "二回の二分探索で、敵ごとに、HPにシールドを足した値の半分から、その合計までの威力の矢を見つけます。それらはその敵へ飛びます。並んだ一斉射が必要です。残りは索引にしまわれます。"},
  {"en": "Two binary searches find, for each foe, the bolts with power from a third of its HP plus shield up to that sum; they fly at it. Needs a sorted volley. The rest are stashed in the index.", "to": "二回の二分探索で、敵ごとに、HPにシールドを足した値の3分の1から、その合計までの威力の矢を見つけます。それらはその敵へ飛びます。並んだ一斉射が必要です。残りは索引にしまわれます。", "kanji": "二回の二分探索で、敵ごとに、HPにシールドを足した値の3分の1から、その合計までの威力の矢を見つけます。それらはその敵へ飛びます。並んだ一斉射が必要です。残りは索引にしまわれます。"},
  {"en": "Lower-Bound Ward", "to": "下限（かげん）のまもり", "kanji": "下限のまもり"},
  {"en": "Lower-Bound Ward+", "to": "下限（かげん）のまもり+", "kanji": "下限のまもり+"},
  {"en": "Binary-searches the index for the smallest bolt that covers the biggest incoming attack (damage times hits) and takes it as block; if none covers it, the strongest does. Exact defence.", "to": "索引を二分探索して、来る攻撃（ダメージ×回数）を覆えるいちばん小さな矢を、ブロックとして取ります。覆える矢がなければ、いちばん強い矢を取ります。確実な守りです。", "kanji": "索引を二分探索して、来る攻撃（ダメージ×回数）を覆えるいちばん小さな矢を、ブロックとして取ります。覆える矢がなければ、いちばん強い矢を取ります。確実な守りです。"},
  {"en": "Binary-searches the index for the smallest bolt that covers the biggest incoming attack and takes it as block. Also gives 2 block.", "to": "二分探索で、いちばん大きい攻撃を防げる最小のボルトをインデックスから取り、ブロックにする。さらにブロック2。", "kanji": "二分探索で、いちばん大きい攻撃を防げる最小のボルトをインデックスから取り、ブロックにする。さらにブロック2。"},
  {"en": "Write-Ahead Log", "to": "先行書き込みログ", "kanji": "先行書き込みログ"},
  {"en": "Write-Ahead Log+", "to": "先行書き込みログ+", "kanji": "先行書き込みログ+"},
  {"en": "Every bolt under 4 power that is not a ward is stashed into the index instead of flying: nothing weak is wasted.", "to": "威力4未満の矢は、飛ばずに索引にしまわれます（ワードは除く）。弱い矢は無駄になりません。", "kanji": "威力4未満の矢は、飛ばずに索引にしまわれます（ワードは除く）。弱い矢は無駄になりません。"},
  {"en": "Every bolt under 5 power that is not a ward is stashed into the index instead of flying: nothing weak is wasted.", "to": "威力5未満の矢は、飛ばずに索引にしまわれます（ワードは除く）。弱い矢は無駄になりません。", "kanji": "威力5未満の矢は、飛ばずに索引にしまわれます（ワードは除く）。弱い矢は無駄になりません。"},
  {"en": "Cursor", "to": "カーソル", "kanji": "カーソル"},
  {"en": "Cursor+", "to": "カーソル+", "kanji": "カーソル+"},
  {"en": "Takes the three weakest bolts from the index in order; each flies and brings a 2-power bolt of its element.", "to": "索引から弱い三本を順に取ります。取った矢はそれぞれ飛び、さらに同じ属性の威力2の矢を一本ずつ持ってきます。", "kanji": "索引から弱い三本を順に取ります。取った矢はそれぞれ飛び、さらに同じ属性の威力2の矢を一本ずつ持ってきます。"},
  {"en": "Takes the four weakest bolts from the index in order; each brings a 2-power bolt of its element.", "to": "インデックスから、いちばん弱い4本を順に取る。どれも、同じ属性の威力2のボルトを1本連れてくる。", "kanji": "インデックスから、いちばん弱い4本を順に取る。どれも、同じ属性の威力2のボルトを1本連れてくる。"},
  {"en": "Bloom Filter", "to": "ブルームフィルタ", "kanji": "ブルームフィルタ"},
  {"en": "Bloom Filter+", "to": "ブルームフィルタ+", "kanji": "ブルームフィルタ+"},
  {"en": "One pass marks the elements the foes might be weak to; every bolt that might match gains 2. One bolt of an element no foe is weak to also gains 2, picked by the turn; a real match is never missed.", "to": "一回の走査で、敵が弱いかもしれない属性に印を付けます。その属性に合う可能性のある矢はすべて威力2上がります。ただし、どの敵も弱くない属性の矢が一本、選ばれて誤って威力2上がることがあります。本当に合う矢を見逃すことはありません。", "kanji": "一回の走査で、敵が弱いかもしれない属性に印を付けます。その属性に合う可能性のある矢はすべて威力2上がります。ただし、どの敵も弱くない属性の矢が一本、選ばれて誤って威力2上がることがあります。本当に合う矢を見逃すことはありません。"},
  {"en": "An exact set of the foes' weak elements replaces the filter: every bolt that matches gains 2, with no false positive.", "to": "フィルタの代わりにぴったりの集合を使う。敵の弱点に当てはまるボルトの威力を2上げる。まちがいはない。", "kanji": "フィルタの代わりにぴったりの集合を使う。敵の弱点に当てはまるボルトの威力を2上げる。間違いはない。"},
  {"en": "Consistent Hashing", "to": "コンシステントハッシュ", "kanji": "コンシステントハッシュ"},
  {"en": "Consistent Hashing+", "to": "コンシステントハッシュ+", "kanji": "コンシステントハッシュ+"},
  {"en": "Foes sit on a ring and each bolt hashes to a point, flying at the next foe clockwise. When a foe falls, only its bolts move on to the next; none are wasted while a foe lives.", "to": "敵は輪の上に並び、各矢は点にハッシュされて、時計回りの次の敵へ飛びます。敵が倒れると、その矢だけが次の敵へ移ります。生きている敵がいる限り、無駄になる矢はありません。", "kanji": "敵は輪の上に並び、各矢は点にハッシュされて、時計回りの次の敵へ飛びます。敵が倒れると、その矢だけが次の敵へ移ります。生きている敵がいる限り、無駄になる矢はありません。"},
  {"en": "Foes sit on a ring and each bolt hashes to a point, flying at the next foe clockwise. When a foe falls, only its bolts move on to the next, and they gain 1.", "to": "敵は輪の上に並び、ボルトは輪の上の点になって、時計回りで次の敵へ飛ぶ。敵が倒れたら、その敵のボルトだけが次へ進み、威力が1上がる。", "kanji": "敵は輪の上に並び、ボルトは輪の上の点になって、時計回りで次の敵へ飛ぶ。敵が倒れたら、その敵のボルトだけが次へ進み、威力が1上がる。"},
  {"en": "Exponential Search", "to": "指数探索（しすうたんさく）", "kanji": "指数探索"},
  {"en": "Exponential Search+", "to": "指数探索（しすうたんさく）+", "kanji": "指数探索+"},
  {"en": "On a sorted volley, gallops 1, 2, 4, 8 ... until a bolt kills the front foe (the strongest, if none does), then binary-searches the last gap. Cheapest when the answer is near the front.", "to": "並んだ一斉射で、1, 2, 4, 8…と進んで、矢がその前の敵を倒すまで進みます（倒せる矢がなければ、いちばん強い矢）。最後の区間を二分探索します。答えが前の方にあるほど安く済みます。", "kanji": "並んだ一斉射で、1, 2, 4, 8…と進んで、矢がその前の敵を倒すまで進みます（倒せる矢がなければ、いちばん強い矢）。最後の区間を二分探索します。答えが前の方にあるほど安く済みます。"},
  {"en": "On a sorted volley, gallops 1, 2, 4, 8 ... until a bolt kills each foe, weakest first, then binary-searches the last gap.", "to": "弱い順にそろえたボルトを1、2、4、8…と跳んで、弱い敵から順に倒せるボルトを見つけ、最後のすきまだけ二分探索する。", "kanji": "弱い順にそろえたボルトを1、2、4、8…と跳んで、弱い敵から順に倒せるボルトを見つけ、最後のすきまだけ二分探索する。"},
  {"en": "Ternary Search", "to": "三分探索（さんぶんたんさく）", "kanji": "三分探索"},
  {"en": "Ternary Search+", "to": "三分探索（さんぶんたんさく）+", "kanji": "三分探索+"},
  {"en": "On a volley that rises then falls, finds the peak by cutting it in thirds and doubles that bolt.", "to": "上がってから下がるボルトの列を3つに分けて山の頂上を見つけ、そのボルトを2倍にする。", "kanji": "上がってから下がるボルトの列を3つに分けて山の頂上を見つけ、そのボルトを2倍にする。"},
  {"en": "On a volley that rises then falls, finds the peak by cutting it in thirds, doubles that bolt and gives its neighbours +2.", "to": "上がってから下がるボルトの列を3つに分けて山の頂上を見つけ、そのボルトを2倍にし、となりのボルトの威力を2上げる。", "kanji": "上がってから下がるボルトの列を3つに分けて山の頂上を見つけ、そのボルトを2倍にし、となりのボルトの威力を2上げる。"},
  {"en": "Counting Sort", "to": "計数（けいすう）ソート", "kanji": "計数ソート"},
  {"en": "Counting Sort+", "to": "計数（けいすう）ソート+", "kanji": "計数ソート+"},
  {"en": "Sorts weakest first by counting how many bolts have each power, never comparing two. Its work grows with n plus the strongest bolt's power, so one huge bolt makes it slow.", "to": "威力ごとに何本あるかを数えて、弱い順に並べます。二つを比べることはありません。仕事量は矢の数と、いちばん強い矢の威力に応じて増えるので、一本でも極端に強い矢があると遅くなります。", "kanji": "威力ごとに何本あるかを数えて、弱い順に並べます。二つを比べることはありません。仕事量は矢の数と、いちばん強い矢の威力に応じて増えるので、一本でも極端に強い矢があると遅くなります。"},
  {"en": "Sorts weakest first by counting powers up to 64; stronger bolts are sorted after the rest. Its work grows with n, plus a fixed cost for the powers up to 64.", "to": "威力64までを数えて、弱い順に並べます。64より強い矢は、残りの後に並べます。仕事量は矢の数に応じて増え、威力64までのぶんは一定の手間がかかります。", "kanji": "威力64までを数えて、弱い順に並べます。64より強い矢は、残りの後に並べます。仕事量は矢の数に応じて増え、威力64までのぶんは一定の手間がかかります。"}
]
