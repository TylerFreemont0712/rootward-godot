[
  {"en": "Grid Paths", "to": "格子（こうし）の道順（みちじゅん）", "kanji": "格子の道順"},
  {"en": "Grid Paths+", "to": "格子（こうし）の道順（みちじゅん）+", "kanji": "格子の道順+"},
  {"en": "Counts the paths across a 4x4 grid by recursion: 70 of them, one bolt of power 10. Naive recursion is exponential; with functools.cache in force every square is solved once.", "to": "4×4の格子を横切る道順を再帰で数える。70通りで、威力10のボルトが1本。メモなしの再帰は指数時間。functools.cache が使えると、各マスを1回だけ解く。", "kanji": "4×4の格子を横切る道順を再帰で数える。70通りで、威力10のボルトが1本。メモなしの再帰は指数時間。functools.cache が使えると、各マスを1回だけ解く。"},
  {"en": "Counts the paths across a 5x5 grid by recursion: 252 of them, one bolt of power 25. Naive recursion is exponential; with functools.cache in force every square is solved once.", "to": "5×5の格子を横切る道順を再帰で数える。252通りで、威力25のボルトが1本。メモなしの再帰は指数時間。functools.cache が使えると、各マスを1回だけ解く。", "kanji": "5×5の格子を横切る道順を再帰で数える。252通りで、威力25のボルトが1本。メモなしの再帰は指数時間。functools.cache が使えると、各マスを1回だけ解く。"},
  {"en": "Memo Ward", "to": "メモの守り", "kanji": "メモの守り"},
  {"en": "Memo Ward+", "to": "メモの守り+", "kanji": "メモの守り+"},
  {"en": "Block as large as the best damage any program landed this fight (the biggest row of the table), at least 4.", "to": "この戦闘で、どのプログラムよりも大きかったダメージ（表でいちばん大きい行）と同じだけの防御。最低4。", "kanji": "この戦闘で、どのプログラムよりも大きかったダメージ（表でいちばん大きい行）と同じだけの防御。最低4。"},
  {"en": "Block as large as the best damage any program landed this fight (the biggest row of the table), at least 6.", "to": "この戦闘で、どのプログラムよりも大きかったダメージ（表でいちばん大きい行）と同じだけの防御。最低6。", "kanji": "この戦闘で、どのプログラムよりも大きかったダメージ（表でいちばん大きい行）と同じだけの防御。最低6。"},
  {"en": "Longest Common Subsequence", "to": "最長共通部分列（さいちょうきょうつうぶぶんれつ）", "kanji": "最長共通部分列"},
  {"en": "Longest Common Subsequence+", "to": "最長共通部分列（さいちょうきょうつうぶぶんれつ）+", "kanji": "最長共通部分列+"},
  {"en": "Finds the longest common subsequence of this volley's powers and the last program's landed volley; the bolts in it gain 2 each. Repeating a good program pays.", "to": "今回のボルトの威力と、前のプログラムが当てたボルトの威力で、最長の共通部分列を見つける。その列のボルトは威力が2上がる。よかったプログラムをくり返すと得をする。", "kanji": "今回のボルトの威力と、前のプログラムが当てたボルトの威力で、最長の共通部分列を見つける。その列のボルトは威力が2上がる。よかったプログラムをくり返すと得をする。"},
  {"en": "Finds the longest common subsequence of this volley's powers and the last program's landed volley; the bolts in it gain 3 each. Repeating a good program pays.", "to": "今回のボルトの威力と、前のプログラムが当てたボルトの威力で、最長の共通部分列を見つける。その列のボルトは威力が3上がる。よかったプログラムをくり返すと得をする。", "kanji": "今回のボルトの威力と、前のプログラムが当てたボルトの威力で、最長の共通部分列を見つける。その列のボルトは威力が3上がる。よかったプログラムをくり返すと得をする。"},
  {"en": "Catalan", "to": "カタラン数（すう）", "kanji": "カタラン数"},
  {"en": "Catalan+", "to": "カタラン数（すう）+", "kanji": "カタラン数+"},
  {"en": "Appends a bolt of the turn's Catalan number (1, 2, 5, 14, 42, then 42 for good), built bottom up from the smaller ones.", "to": "このターンのカタラン数（1、2、5、14、42、その先も42）のボルトを足す。小さい数から順に積み上げて作る。", "kanji": "このターンのカタラン数（1、2、5、14、42、その先も42）のボルトを足す。小さい数から順に積み上げて作る。"},
  {"en": "Appends a bolt of next turn's Catalan number (1, 2, 5, 14, 42, then 42 for good), built bottom up from the smaller ones: one turn ahead.", "to": "次のターンのカタラン数（1、2、5、14、42、その先も42）のボルトを足す。小さい数から順に積み上げて作る。1ターン先取り。", "kanji": "次のターンのカタラン数（1、2、5、14、42、その先も42）のボルトを足す。小さい数から順に積み上げて作る。1ターン先取り。"},
  {"en": "Table Ward", "to": "表の守り", "kanji": "表の守り"},
  {"en": "Table Ward+", "to": "表の守り+", "kanji": "表の守り+"},
  {"en": "Block equal to the table's last row divided by 3, at least 3.", "to": "DP表の最後の行を3で割った数だけ防御。最低3。", "kanji": "DP表の最後の行を3で割った数だけ防御。最低3。"},
  {"en": "Block equal to the table's last row divided by 2, at least 3.", "to": "DP表の最後の行を2で割った数だけ防御。最低3。", "kanji": "DP表の最後の行を2で割った数だけ防御。最低3。"},
  {"en": "Rod Cutting", "to": "ロッドカット", "kanji": "ロッドカット"},
  {"en": "Rod Cutting+", "to": "ロッドカット+", "kanji": "ロッドカット+"},
  {"en": "Cuts the strongest bolt into the pieces worth the most by a price table (a 3 is worth 4, a 5 worth 7, a 7 worth 10; other sizes are worth themselves). Each piece is a bolt of its worth.", "to": "最も強いボルトを、価格表でいちばん値打ちが出る長さに切り分ける（3は4、5は7、7は10、ほかは長さのまま）。切った1つ1つが、その値打ちのボルトになる。", "kanji": "最も強いボルトを、価格表でいちばん値打ちが出る長さに切り分ける（3は4、5は7、7は10、ほかは長さのまま）。切った1つ1つが、その値打ちのボルトになる。"},
  {"en": "Cuts the strongest bolt into the pieces worth the most by a price table (a 2 is worth 3, a 3 worth 4, a 5 worth 7, a 7 worth 10; other sizes are worth themselves). Each piece is a bolt of its worth.", "to": "最も強いボルトを、価格表でいちばん値打ちが出る長さに切り分ける（2は3、3は4、5は7、7は10、ほかは長さのまま）。切った1つ1つが、その値打ちのボルトになる。", "kanji": "最も強いボルトを、価格表でいちばん値打ちが出る長さに切り分ける（2は3、3は4、5は7、7は10、ほかは長さのまま）。切った1つ1つが、その値打ちのボルトになる。"},
  {"en": "Equal Partition", "to": "等分割（とうぶんかつ）", "kanji": "等分割"},
  {"en": "Equal Partition+", "to": "等分割（とうぶんかつ）+", "kanji": "等分割+"},
  {"en": "If the volley can be split into two groups of equal sum (subset-sum DP), each group fuses into one bolt and both gain 25%. Otherwise nothing changes.", "to": "ボルトを合計が同じ2組に分けられるなら（部分和のDP）、各組を1本に合体して、どちらも威力が25%上がる。分けられなければ何も変わらない。", "kanji": "ボルトを合計が同じ2組に分けられるなら（部分和のDP）、各組を1本に合体して、どちらも威力が25%上がる。分けられなければ何も変わらない。"},
  {"en": "If the volley can be split into two groups of equal sum (subset-sum DP), each group fuses into one bolt and both gain 40%. Otherwise nothing changes.", "to": "ボルトを合計が同じ2組に分けられるなら（部分和のDP）、各組を1本に合体して、どちらも威力が40%上がる。分けられなければ何も変わらない。", "kanji": "ボルトを合計が同じ2組に分けられるなら（部分和のDP）、各組を1本に合体して、どちらも威力が40%上がる。分けられなければ何も変わらない。"},
  {"en": "Unbounded Knapsack", "to": "個数無制限（こすうむせいげん）のナップサック", "kanji": "個数無制限のナップサック"},
  {"en": "Unbounded Knapsack+", "to": "個数無制限（こすうむせいげん）のナップサック+", "kanji": "個数無制限のナップサック+"},
  {"en": "Appends copies of the volley's bolts (any number of each) that sum exactly to the front foe's HP, aimed at it. Nothing is added when no exact sum exists.", "to": "同じボルトを何本でもコピーして、前の敵のHPとぴったり同じ合計になる組を、その敵へ向けて足す。ぴったりの合計がなければ何も足さない。", "kanji": "同じボルトを何本でもコピーして、前の敵のHPとぴったり同じ合計になる組を、その敵へ向けて足す。ぴったりの合計がなければ何も足さない。"},
  {"en": "Appends copies of the volley's bolts (any number of each) that sum exactly to the front foe's HP, aimed at it, and each copy gains 1. Nothing is added when no exact sum exists.", "to": "同じボルトを何本でもコピーして、前の敵のHPとぴったり同じ合計になる組を、その敵へ向けて足す。コピーは威力が1上がる。ぴったりの合計がなければ何も足さない。", "kanji": "同じボルトを何本でもコピーして、前の敵のHPとぴったり同じ合計になる組を、その敵へ向けて足す。コピーは威力が1上がる。ぴったりの合計がなければ何も足さない。"},
  {"en": "Edit Distance Aim", "to": "編集距離（へんしゅうきょり）の狙い", "kanji": "編集距離の狙い"},
  {"en": "Edit Distance Aim+", "to": "編集距離（へんしゅうきょり）の狙い+", "kanji": "編集距離の狙い+"},
  {"en": "Aligns the sorted volley with the sorted foes' HP using the fewest edits; each matched bolt flies at its foe, the unmatched ones at the front.", "to": "強さ順のボルトと、HP順の敵を、いちばん少ない編集で並べる。組になったボルトはその敵へ、余ったボルトは先頭の敵へ飛ぶ。", "kanji": "強さ順のボルトと、HP順の敵を、いちばん少ない編集で並べる。組になったボルトはその敵へ、余ったボルトは先頭の敵へ飛ぶ。"},
  {"en": "Aligns the sorted volley with the sorted foes' HP using the fewest edits; each matched bolt flies at its foe, the unmatched ones become block.", "to": "強さ順のボルトと、HP順の敵を、いちばん少ない編集で並べる。組になったボルトはその敵へ、余ったボルトは防御になる。", "kanji": "強さ順のボルトと、HP順の敵を、いちばん少ない編集で並べる。組になったボルトはその敵へ、余ったボルトは防御になる。"}
]
