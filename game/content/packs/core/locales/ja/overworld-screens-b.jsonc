// Japanese for the town's screens (Concept/v0.4/06): the creator and character select, the pocket and the player's
// menu, the Options page, the music box, the bag, the Workbench, the task editor's results and TaskWords (Hotaru's
// advice), the tracker, the quest log, the maps, the credits, the part banner and the parts' runtime messages.
// Keyed by the English exactly (ADR-0047). Code (add(), place_of(), x, y), keys and the placeholders stay as they are.
[
  // bag_panel.gd
  {"en": "%d kinds", "to": "%d しゅるい", "kanji": "%d 種類"},
  {"en": "1 kind", "to": "1 しゅるい", "kanji": "1 種類"},
  {"en": "Arrows: choose   Esc or I: close", "to": "やじるし：えらぶ   Esc か I：とじる", "kanji": "矢印：選ぶ   Esc か I：閉じる"},
  {"en": "Bag", "to": "かばん", "kanji": "鞄"},
  {"en": "Nothing yet. Apple trees are a good start.", "to": "まだ なにも ないよ。まずは りんごの きが いいかも。", "kanji": "まだ何もないよ。まずはりんごのきがいいかも。"},
  {"en": "Nym's design, your code: add() put these here.", "to": "ニムの デザイン、きみの コード：add() が ここに いれた ものだよ。", "kanji": "ニムのデザイン、君のコード：add() がここに入れたものだよ。"},
  // character_card.gd
  {"en": "%d h %d min", "to": "%d じかん %d ふん", "kanji": "%d 時間 %d 分"},
  {"en": "%d min", "to": "%d ふん", "kanji": "%d 分"},
  {"en": "A few minutes", "to": "すこしの あいだ", "kanji": "少しの間"},
  {"en": "Not played yet", "to": "まだ あそんで いないよ", "kanji": "まだ遊んでいないよ"},
  {"en": "Played %d days ago", "to": "%d にち まえに あそんだよ", "kanji": "%d 日前に遊んだよ"},
  {"en": "Played on %s", "to": "%s に あそんだよ", "kanji": "%s に遊んだよ"},
  {"en": "Played today", "to": "きょう あそんだよ", "kanji": "今日遊んだよ"},
  {"en": "Played yesterday", "to": "きのう あそんだよ", "kanji": "昨日遊んだよ"},
  // character_creator.gd
  {"en": "Character", "to": "キャラクター", "kanji": "キャラクター"},
  {"en": "Male", "to": "だんせい", "kanji": "男性"},
  {"en": "Female", "to": "じょせい", "kanji": "女性"},
  {"en": "Arrows: choose   Enter: press   Esc: back", "to": "やじるし：えらぶ   Enter：おす   Esc：もどる", "kanji": "矢印：選択   Enter：決定   Esc：戻る"},
  {"en": "D-pad: choose   A: press   B: back", "to": "十字ボタン：えらぶ   A：おす   B：もどる", "kanji": "十字キー：選択   A：決定   B：戻る"},
  {"en": "Builder: blocks", "to": "ブロックで つくる", "kanji": "ビルダー：ブロックで作る"},
  {"en": "How do you build?", "to": "どうやって つくる？", "kanji": "プログラムの作り方"},
  {"en": "Scribe: type code", "to": "コードを かく", "kanji": "スクライブ：コードを書く"},
  {"en": "Snap blocks together, and see the code they make beside them.", "to": "ブロックを くっつけると、できた コードが よこに でるよ。", "kanji": "ブロックを組み合わせ、隣に表示されるコードを確認しながら作ります。"},
  {"en": "Type the code yourself, the way programmers do.", "to": "プログラマーと おなじ やりかたで、じぶんで コードを かくよ。", "kanji": "プログラマーと同じように、自分でコードを入力して作ります。"},
  // character_select.gd
  {"en": "%s and everything they have done go for good. This cannot be undone.", "to": "%s と、いままで やった ことは ぜんぶ きえちゃうよ。もとに もどせないよ。", "kanji": "%s と、今までやったことは全部きえちゃうよ。もとにもどせないよ。"},
  {"en": "All done for now", "to": "いまは ぜんぶ おわったよ", "kanji": "今は全部終わったよ"},
  {"en": "Arrows: choose   Enter: play   P: progress   Delete: delete   Esc: back", "to": "やじるし：えらぶ   Enter：あそぶ   P：しんちょく   Delete：けす   Esc：もどる", "kanji": "矢印：選ぶ   Enter：遊ぶ   P：進捗   Delete：消す   Esc：戻る"},
  {"en": "D-pad: choose   A: play   Y: progress   X: delete   B: back", "to": "十字ボタン：えらぶ   A：あそぶ   Y：しんちょく   X：けす   B：もどる", "kanji": "十字ボタン：選ぶ   A：遊ぶ   Y：進捗   X：消す   B：戻る"},
  {"en": "Delete", "to": "けす", "kanji": "消す"},
  {"en": "Delete %s?", "to": "%s を けす？", "kanji": "%s を消す？"},
  {"en": "Delete for good", "to": "ほんとうに けす", "kanji": "本当に消す"},
  {"en": "Keep %s", "to": "%s を のこす", "kanji": "%s を残す"},
  {"en": "Lanternroot is yours to explore.", "to": "ともしび村は、きみが たんけん できるよ。", "kanji": "ともしび村は、君が探検できるよ。"},
  {"en": "Make a character", "to": "キャラクターを つくる", "kanji": "キャラクターを作る"},
  {"en": "Make someone new to walk the town: a new name, a new look, a fresh start.", "to": "まちを あるく、あたらしい だれかを つくろう。あたらしい なまえ、あたらしい すがた、あたらしい スタート。", "kanji": "町を歩く、新しい誰かを作ろう。新しい名前、新しい姿、新しいスタート。"},
  {"en": "New character", "to": "あたらしい キャラクター", "kanji": "新しいキャラクター"},
  {"en": "Nobody lives here yet. Make your first character!", "to": "まだ だれも すんで いないよ。さいしょの キャラクターを つくろう！", "kanji": "まだ誰も住んでいないよ。最初のキャラクターを作ろう！"},
  {"en": "Now:", "to": "いま：", "kanji": "今："},
  {"en": "Play  ▶", "to": "あそぶ  ▶", "kanji": "遊ぶ  ▶"},
  {"en": "Progress", "to": "しんちょく", "kanji": "進捗"},
  {"en": "Who walks into town today?", "to": "きょう、まちに だれが くる？", "kanji": "今日、町に誰が来る？"},
  {"en": "◀  Back", "to": "◀  もどる", "kanji": "◀  戻る"},
  // credits_roll.gd
  {"en": "Lanternroot, made by %s", "to": "ともしび村、つくったのは %s", "kanji": "ともしび村、作ったのは %s"},
  {"en": "Thank you for playing.", "to": "あそんで くれて ありがとう。", "kanji": "遊んでくれてありがとう。"},
  // front_panel.gd
  {"en": "Play", "to": "あそぶ", "kanji": "遊ぶ"},
  // full_map.gd
  {"en": "Doors", "to": "とびら", "kanji": "扉"},
  {"en": "Drawn with your map_colour()", "to": "きみの map_colour() で えがいたよ", "kanji": "君の map_colour() でえがいたよ"},
  {"en": "Esc or M: close", "to": "Esc か M：とじる", "kanji": "Esc か M：閉じる"},
  {"en": "Legend", "to": "いろの いみ", "kanji": "色の意味"},
  {"en": "Map", "to": "ちず", "kanji": "地図"},
  {"en": "People", "to": "ひとたち", "kanji": "人たち"},
  {"en": "You", "to": "きみ", "kanji": "君"},
  {"en": "Your next step", "to": "つぎに いく ところ", "kanji": "次の目標"},
  // music_panel.gd
  {"en": "%d tunes", "to": "%d きょく", "kanji": "%d 曲"},
  {"en": "1 tune", "to": "1 きょく", "kanji": "1 曲"},
  {"en": "Arrows: choose   Enter: play   R: next   Esc: back", "to": "やじるし：えらぶ   Enter：かける   R：つぎ   Esc：もどる", "kanji": "矢印：選ぶ   Enter：かける   R：次   Esc：戻る"},
  {"en": "In town: %s", "to": "まちの おんがく：%s", "kanji": "町の音楽：%s"},
  {"en": "In town: Lanternroot's own", "to": "まちの おんがく：ともしび村の きょく", "kanji": "町の音楽：ともしび村の曲"},
  {"en": "Lanternroot's own", "to": "ともしび村の きょく", "kanji": "ともしび村の曲"},
  {"en": "Music box", "to": "オルゴール", "kanji": "オルゴール"},
  {"en": "Next ▶", "to": "つぎ ▶", "kanji": "次 ▶"},
  {"en": "Play in town: %s", "to": "まちで かける：%s", "kanji": "町でかける：%s"},
  {"en": "The music box has no tunes yet.", "to": "オルゴールには まだ きょくが ないよ。", "kanji": "オルゴールにはまだ曲がないよ。"},
  {"en": "in town", "to": "まちで", "kanji": "町で"},
  // options_page.gd
  {"en": "%d → %d%%", "to": "%d → %d%%", "kanji": "%d → %d%%"},
  {"en": "Arrows: choose and change   Enter: pick   Esc: back", "to": "やじるし：えらんで かえる   Enter：きめる   Esc：もどる", "kanji": "矢印：選んで変える   Enter：決める   Esc：戻る"},
  {"en": "Choose…", "to": "えらぶ…", "kanji": "選ぶ…"},
  {"en": "More settings…", "to": "もっと せってい…", "kanji": "もっと設定…"},
  {"en": "Seren's knob isn't wired yet", "to": "セレンの つまみは まだ つながって いないよ", "kanji": "セレンのつまみはまだつながっていないよ"},
  {"en": "Your volume curve", "to": "きみの おとの おおきさの カーブ", "kanji": "君の音の大きさのカーブ"},
  // overworld.gd
  {"en": "%s, into the bag! (%d now)", "to": "%s を かばんに いれたよ！（いま %d こ）", "kanji": "%s を鞄に入れたよ！（今 %d 個）"},
  {"en": "A bag! Let's find something to put in it. Apple trees?", "to": "かばんだ！ なにか いれる ものを さがそう。りんごの きは どうかな？", "kanji": "鞄だ！何か入力値を探そう。りんごのきはどうかな？"},
  {"en": "An Options page, all yours. It's in your menu.", "to": "オプションの ページだよ、ぜんぶ きみの もの！ メニューの なかに あるよ。", "kanji": "オプションのページだよ、全部君のもの！メニューの中にあるよ。"},
  {"en": "Arrows: walk   Space: talk   B: boots   Esc: menu", "to": "やじるし：あるく   スペース：はなす   B：くつ   Esc：メニュー", "kanji": "矢印：歩くスペース：話す   B：靴   Esc：メニュー"},
  {"en": "Boots", "to": "くつ", "kanji": "靴"},
  {"en": "Lamps", "to": "ランプ", "kanji": "ランプ"},
  {"en": "Look up there! Pell's little map, in your colours.", "to": "みあげて！ ペルの ちいさな ちずだよ。きみの いろに なったよ。", "kanji": "みあげて！ペルの小さなちずだよ。君の色になったよ。"},
  {"en": "Made by %s", "to": "つくったのは %s", "kanji": "作ったのは %s"},
  {"en": "Ooh, we could pick that! But where would we put it? Nym makes bags... well, Nym codes bags.", "to": "わあ、とれそう！ でも どこに いれよう？ ニムは かばんを つくるよ…いや、ニムは かばんを コードで つくるんだった。", "kanji": "わあ、とれそう！でもどこに入れよう？ニムは鞄を作るよ…いや、ニムは鞄をコードでつくるんだった。"},
  {"en": "Save", "to": "セーブ", "kanji": "保存"},
  {"en": "Saved!", "to": "セーブ したよ！", "kanji": "保存しました！"},
  {"en": "Saving...", "to": "セーブ ちゅう…", "kanji": "保存中…"},
  {"en": "Space: pick %s", "to": "スペース：%s を とる", "kanji": "Space：%s を拾う"},
  {"en": "Space: use it   X: its code", "to": "スペース：つかう   X：その コード", "kanji": "Space：使う   X：コードを編集"},
  {"en": "That isn't built yet. %s can help!", "to": "まだ できて いないよ。%s が てつだって くれるよ！", "kanji": "まだできていないよ。%s が手伝ってくれるよ！"},
  {"en": "The town has a clock now. Wait and see what evening looks like!", "to": "まちに とけいが できたよ！ まって みてね、ゆうがたが どんな ふうか わかるよ。", "kanji": "町に時計ができたよ！待ってみてね、夕方がどんなふうか分かるよ。"},
  {"en": "Tick, tock. It's %s.", "to": "チクタク。いま %s だよ。", "kanji": "チクタク。今 %s だよ。"},
  {"en": "We picked that already. It'll grow back soon.", "to": "もう とったよ。すぐ また みが なるよ。", "kanji": "もう取ったよ。すぐまたみがなるよ。"},
  {"en": "Your bag's code is in the Workbench.", "to": "かばんの コードは さぎょうだいに あるよ。", "kanji": "鞄のコードは作業台にあるよ。"},
  {"en": "Your keys listen to you now! Mira has one more piece for the menu.", "to": "キーが きみの いう ことを きくよ！ ミラが メニューの パーツを もう ひとつ もって いるよ。", "kanji": "キーが君の言うことをきくよ！ミラがメニューのパーツをもう一つ持っているよ。"},
  {"en": "Your very own menu! Press Esc and see it.", "to": "きみだけの メニューだよ！ Esc を おして みてね。", "kanji": "君だけのメニューだよ！ Esc を押してみてね。"},
  // part_banner.gd
  {"en": "NEW PART", "to": "あたらしい パーツ", "kanji": "新しいパーツ"},
  {"en": "PART IMPROVED", "to": "パーツが パワーアップ！", "kanji": "パーツがパワーアップ！"},
  // parts_runtime.gd
  {"en": " (line %d)", "to": "（%d ぎょうめ）", "kanji": "（%d 行目）"},
  {"en": "There's no bag to put it in yet.", "to": "まだ いれる かばんが ないよ。", "kanji": "まだ入れる鞄がないよ。"},
  {"en": "Your %s didn't run: %s", "to": "きみの %s は うごかなかったよ：%s", "kanji": "君の %s は動かなかったよ：%s"},
  {"en": "Your %s gave %s for %s. The town can't use that, so it uses its own.", "to": "きみの %s は、%s を かえして きたよ（%s の ばあい）。まちは それを つかえないから、まちの ものを つかうね。", "kanji": "君の %s は、%s を返してきたよ（%s の場合）。町はそれを使えないから、町のものを使うね。"},
  {"en": "Your %s tripped on %s: %s", "to": "きみの %s は %s で つまずいたよ：%s", "kanji": "君の %s は %s でつまずいたよ：%s"},
  {"en": "Your %s() didn't work for %s: %s", "to": "きみの %s() は %s では うまく いかなかったよ：%s", "kanji": "君の %s() は %s ではうまく行かなかったよ：%s"},
  {"en": "Your add() tripped: %s", "to": "きみの add() が つまずいたよ：%s", "kanji": "君の add() がつまずいたよ：%s"},
  {"en": "Your bag can't give things away yet.", "to": "かばんは まだ もちものを だせないよ。", "kanji": "鞄はまだ持ち物をだせないよ。"},
  {"en": "Your credits() didn't give lines the credits can roll.", "to": "きみの credits() は、クレジットで ながせる ぎょうを かえして くれなかったよ。", "kanji": "君の credits() は、クレジットでながせる行を返してくれなかったよ。"},
  {"en": "Your credits() tripped: %s", "to": "きみの credits() が つまずいたよ：%s", "kanji": "君の credits() がつまずいたよ：%s"},
  {"en": "Your menu_items() didn't give a menu the town can use, so the menu is in the town's order for now.", "to": "きみの menu_items() は、まちが つかえる メニューを かえして くれなかったよ。だから、いまは まちの じゅんばんで メニューが でるよ。", "kanji": "menu_items() が有効なメニューを返さなかったため、現在は町の標準の順番で表示しています。"},
  {"en": "Your menu_items() tripped: %s. The menu is in the town's order for now.", "to": "きみの menu_items() が つまずいたよ：%s。いまは まちの じゅんばんで メニューが でるよ。", "kanji": "君の menu_items() がつまずいたよ：%s。今は町の順番でメニューがでるよ。"},
  {"en": "Your place_of() gave %s, which is no place on this map. The map leaves that cell's name blank.", "to": "きみの place_of() は %s を かえしたよ。でも、この ちずに そんな ばしょは ないよ。ちずは そのますの なまえを あけて おくね。", "kanji": "君の place_of() は %s を返したよ。でも、このちずにそんな場所はないよ。ちずはそのますの名前をあけておくね。"},
  {"en": "Your place_of() tripped on x %d, y %d: %s", "to": "きみの place_of() は x %d、y %d で つまずいたよ：%s", "kanji": "君の place_of() は x %d、y %d でつまずいたよ：%s"},
  {"en": "Your remove() tripped: %s", "to": "きみの remove() が つまずいたよ：%s", "kanji": "君の remove() がつまずいたよ：%s"},
  {"en": "Your titles() didn't give one title per track, so the music box shows the tracks' own names.", "to": "きみの titles() は、きょくごとの なまえを ひとつずつ かえして くれなかったよ。だから オルゴールは きょくの もとの なまえを だすよ。", "kanji": "君の titles() は、曲ごとの名前を一つずつ返してくれなかったよ。だからオルゴールは曲のもとの名前をだすよ。"},
  // pause_menu.gd
  {"en": "%d h %02d min", "to": "%d じかん %02d ふん", "kanji": "%d 時間 %02d 分"},
  {"en": "Arrows: choose   Enter: pick   Esc: back", "to": "やじるし：えらぶ   Enter：きめる   Esc：もどる", "kanji": "矢印：選択   Enter：決定   Esc：戻る"},
  {"en": "Characters", "to": "キャラクター", "kanji": "キャラクター"},
  {"en": "Continue", "to": "つづける", "kanji": "続ける"},
  {"en": "Credits", "to": "クレジット", "kanji": "クレジット"},
  {"en": "Quests", "to": "クエスト", "kanji": "クエスト"},
  {"en": "Quit game", "to": "ゲームを やめる", "kanji": "ゲームを終了"},
  {"en": "Quit to title", "to": "タイトルへ", "kanji": "タイトルに戻る"},
  {"en": "Settings", "to": "せってい", "kanji": "設定"},
  {"en": "Time played: %s", "to": "あそんだ じかん：%s", "kanji": "プレイ時間：%s"},
  {"en": "Workbench", "to": "さぎょうだい", "kanji": "作業台"},
  {"en": "You will build saving yourself. Ask Vell at the Archive.", "to": "セーブは きみが つくるんだよ。きろくこの ヴェルに きいてみてね。", "kanji": "セーブは君が作るんだよ。記録庫のヴェルに聞いてみてね。"},
  {"en": "less than a minute", "to": "1 ふんより みじかい", "kanji": "1分未満"},
  // pocket_menu.gd
  {"en": "Fix it", "to": "なおす", "kanji": "直す"},
  {"en": "Hotaru's pocket menu", "to": "ほたるの ポケットメニュー", "kanji": "ほたるのポケットメニュー"},
  {"en": "This is just my pocket menu. Mira at the workshop could build you a real one!", "to": "これは わたしの ポケットメニューだよ。こうぼうの ミラに たのめば、ちゃんとした メニューを つくって もらえるよ！", "kanji": "これは私のポケットメニューだよ。工房のミラに頼めば、ちゃんとしたメニューを作ってもらえるよ！"},
  {"en": "Your shortcut() doesn't open the menu on Esc.", "to": "きみの shortcut() は、Esc で メニューを ひらけないよ。", "kanji": "君の shortcut() は、Esc でメニューを開けないよ。"},
  // progress_panel.gd
  {"en": "%d of %d done", "to": "%d / %d おわり", "kanji": "%d / %d 達成"},
  {"en": "%d of %d met", "to": "%d / %d にん あえたよ", "kanji": "%d / %d 人と会話済み"},
  {"en": "Builds with blocks, and reads their code.", "to": "ブロックで つくって、コードを よむよ。", "kanji": "ブロックで作って、コードをよむよ。"},
  {"en": "Keys your boots know:", "to": "くつが しって いる キー：", "kanji": "靴が知っているキー："},
  {"en": "Later", "to": "あとで", "kanji": "後で"},
  {"en": "Now", "to": "いま", "kanji": "今"},
  {"en": "Still to come.", "to": "まだ さきだよ。", "kanji": "これから始まります。"},
  {"en": "The code your boots run (you typed it):", "to": "くつが うごかす コード（きみが かいた もの）：", "kanji": "靴が動かすコード（君が書いたもの）："},
  {"en": "Time in town: %s", "to": "まちに いた じかん：%s", "kanji": "町にいた時間：%s"},
  {"en": "Townspeople", "to": "まちの ひとたち", "kanji": "町の人たち"},
  {"en": "Types the code by hand.", "to": "じぶんで コードを かくよ。", "kanji": "自分でコードをかくよ。"},
  {"en": "Up and down: scroll the quests   Esc: back", "to": "うえ・した：クエストを スクロール   Esc：もどる", "kanji": "上・下：クエストをスクロール   Esc：戻る"},
  // quest_log.gd
  {"en": "Finish the quests before this one to find out what it is.", "to": "この まえの クエストを おわらせると、これが なにか わかるよ。", "kanji": "この前のクエストを終わらせると、これが何か分かるよ。"},
  {"en": "From %s", "to": "%s から", "kanji": "%s から"},
  {"en": "From Hotaru", "to": "ほたるから", "kanji": "ほたるから"},
  {"en": "Track", "to": "おいかける", "kanji": "追跡"},
  {"en": "Tracking this quest", "to": "この クエストを おいかけて いるよ", "kanji": "このクエストを追跡中"},
  {"en": "Under way", "to": "とちゅう", "kanji": "進行中"},
  {"en": "or press T", "to": "か、T を おしてね", "kanji": "か、T を押してね"},
  // quest_tracker.gd
  {"en": "%d tiles", "to": "%d マス", "kanji": "%d マス"},
  {"en": "1 tile", "to": "1 マス", "kanji": "1 マス"},
  {"en": "At home", "to": "いえに", "kanji": "家に"},
  {"en": "In %s", "to": "%s に", "kanji": "%s に"},
  {"en": "Inside %s", "to": "%s の なかに", "kanji": "%s の中に"},
  {"en": "Quest complete: %s", "to": "クエスト おわり：%s", "kanji": "クエスト達成：%s"},
  {"en": "Right here", "to": "ここだよ", "kanji": "ここだよ"},
  // task_editor.gd
  {"en": "Arrows: move   Enter: choose or switch   Esc: close", "to": "やじるし：うごく   Enter：えらぶ・きりかえる   Esc：とじる", "kanji": "矢印：動く   Enter：選ぶ・きりかえる   Esc：閉じる"},
  {"en": "Done ✓", "to": "おわり ✓", "kanji": "完了 ✓"},
  {"en": "Hint %d of %d", "to": "ヒント %d / %d", "kanji": "ヒント %d / %d"},
  {"en": "It didn't run yet.", "to": "まだ うごいて いないよ。", "kanji": "まだ動いていないよ。"},
  {"en": "Next hint", "to": "つぎの ヒント", "kanji": "次のヒント"},
  {"en": "Stage %d of %d", "to": "ステージ %d / %d", "kanji": "ステージ %d / %d"},
  {"en": "Type here. The game calls your function.", "to": "ここに かいてね。ゲームが きみの かんすうを よぶよ。", "kanji": "ここにコードを入力してください。ゲームがこの関数を呼び出します。"},
  // task_host.gd
  {"en": "Stage %d works now.", "to": "ステージ %d が うごくように なったよ。", "kanji": "ステージ %d が動くようになったよ。"},
  // task_results.gd
  {"en": "%s (line %d)", "to": "%s（%d ぎょうめ）", "kanji": "%s（%d 行目）"},
  {"en": "Line %d", "to": "%d ぎょうめ", "kanji": "%d 行目"},
  {"en": "Tried your code:", "to": "きみの コードを ためしたよ：", "kanji": "君のコードを試したよ："},
  {"en": "Tried your function:", "to": "きみの かんすうを ためしたよ：", "kanji": "君の関数を試したよ："},
  {"en": "Your code: %s", "to": "きみの コード：%s", "kanji": "君のコード：%s"},
  // task_words.gd
  {"en": "%d of %d cases work.", "to": "%d / %d の ばあいが うまく いってるよ。", "kanji": "%d / %d 件のテストに成功。"},
  {"en": "Every case works! Press Done and the game will use your code.", "to": "ぜんぶの ばあいが うまく いったよ！「おわり」を おすと、ゲームは きみの コードを つかうよ。", "kanji": "全部の場合がうまく行ったよ！「終わり」をおすと、ゲームは君のコードを使うよ。"},
  {"en": "For {say}, almost! The item at place {index} is {got}, and it should be {want}. Counting starts at 0.", "to": "「{say}」の とき、あとちょっと！ ばしょ {index} の ものが {got} だけど、{want} に なるはずだよ。かぞえは 0 から はじまるよ。", "kanji": "「{say}」のとき、後ちょっと！場所 {index} のものが {got} だけど、{want} になるはずだよ。数えは 0 から始まるよ。"},
  {"en": "For {say}, the list has the wrong number of things. It gave back {got}, and it should be {want}.", "to": "「{say}」の とき、リストの ものの かずが ちがうよ。{got} が かえって きたけど、{want} に なるはずだよ。", "kanji": "「{say}」のとき、リストのものの数が違うよ。{got} が返ってきたけど、{want} になるはずだよ。"},
  {"en": "For {say}, your function gave back nothing. Is there a return, and does it run?", "to": "「{say}」の とき、きみの かんすうは なにも かえさなかったよ。return は あるかな？ ちゃんと うごいて いるかな？", "kanji": "「{say}」のとき、君の関数は何も返さなかったよ。return はあるかな？ちゃんと動いているかな？"},
  {"en": "For {say}, your function gave back {got}, but it should give back {want}.", "to": "「{say}」の とき、きみの かんすうは {got} を かえしたけど、{want} を かえす はずだよ。", "kanji": "「{say}」のとき、君の関数は {got} を返したけど、{want} を返すはずだよ。"},
  {"en": "For {say}, your function gave back {got}, but the answer should be a different kind of thing, like {want}.", "to": "「{say}」の とき、きみの かんすうは {got} を かえしたよ。でも こたえは、{want} みたいな ちがう しゅるいの ものに なるはずだよ。", "kanji": "「{say}」のとき、君の関数は {got} を返したよ。でも答えは、{want} みたいな違う種類のものになるはずだよ。"},
  {"en": "For {say}, {got} isn't one of the answers I was hoping for. Try another way.", "to": "「{say}」の とき、{got} は わたしが まって いた こたえじゃ ないよ。ほかの やりかたも ためして みてね。", "kanji": "「{say}」のとき、{got} は私が待っていた答えじゃないよ。他のやり方も試してみてね。"},
  {"en": "I can't find your function {name}. Is its name spelled the same as in the goal?", "to": "かんすう {name} が みつからないよ。もくひょうと おなじ つづりに なって いるかな？", "kanji": "関数 {name} が見つからないよ。目標と同じつづりになっているかな？"},
  {"en": "It works for the usual ones, but {say} is a tricky one! What happens right at the edge?", "to": "ふつうの ばあいは うまく いくよ。でも「{say}」は むずかしい ばあいだね！ ちょうど はしっこで なにが おきるかな？", "kanji": "通常の入力では動いているけれど、「{say}」には注意が必要だね！境界での動作はどうなるかな？"},
  {"en": "It works!", "to": "うまく いったよ！", "kanji": "成功！"},
  {"en": "Not quite yet. Look at the case that missed, {say}, and try again.", "to": "まだ もう少しだよ。まちがえた「{say}」を みて、もういちど ためしてね。", "kanji": "まだもう少しだよ。間違えた「{say}」を見て、もう一度試してね。"},
  {"en": "Press Try it. I'll call your function on each of these and show what it gives back.", "to": "「ためす」を おしてね。ひとつずつ、きみの かんすうを よんで、かえして きた ものを みせるよ。", "kanji": "「試す」を押してね。一つずつ、君の関数を呼んで、返してきたものを見せるよ。"},
  {"en": "Still works:", "to": "まだ うまく いくよ：", "kanji": "まだうまくいくよ："},
  {"en": "These worked before. Do they still?", "to": "まえは うまく いってたね。いまも うまく いくかな？", "kanji": "前はうまくいってたね。今もうまくいくかな？"},
  {"en": "Trying {say}, your code tripped on line {line}. The red line shows where.", "to": "「{say}」を ためして、きみの コードが {line} ぎょうめで つまずいたよ。あかい 行で ばしょが わかるよ。", "kanji": "「{say}」を試して、君のコードが {line} 行目でつまずいたよ。赤い行で場所が分かるよ。"},
  {"en": "Trying {say}, your code tripped. Read the error beside it.", "to": "「{say}」を ためして、きみの コードが つまずいたよ。よこの エラーを よんでみてね。", "kanji": "「{say}」を試して、君のコードがつまずいたよ。横のエラーを読んでみてね。"},
  {"en": "Your code can't run yet. Line {line} is where it got stuck: look there first.", "to": "きみの コードは まだ うごかないよ。{line} ぎょうめで ひっかかって いるよ。まず そこを みてね。", "kanji": "君のコードはまだ動かないよ。{line} 行目でひっかかっているよ。まずそこをみてね。"},
  {"en": "Your code can't run yet. Look for a missing bracket, quote or colon.", "to": "きみの コードは まだ うごかないよ。かっこ、クォート、コロンの どれかが ぬけて いないかな？", "kanji": "君のコードはまだ動かないよ。括弧、クォート、コロンのどれかが抜けていないかな？"},
  // workbench_panel.gd
  {"en": "%d of %d parts built", "to": "パーツ %d / %d が できたよ", "kanji": "パーツ %d / %d ができたよ"},
  {"en": "%s · Stage %d of %d", "to": "%s · ステージ %d / %d", "kanji": "%s · ステージ %d / %d"},
  {"en": "%s · Stage %d waits: %s has an idea", "to": "%s · ステージ %d は まち ちゅう：%s に アイデアが あるよ", "kanji": "%s · ステージ %d は未達成：%s に相談しよう"},
  {"en": "Arrows: choose   Enter: look at the code   Esc: back", "to": "やじるし：えらぶ   Enter：コードを みる   Esc：もどる", "kanji": "矢印：選ぶ   Enter：コードを見る   Esc：戻る"},
  {"en": "Built", "to": "できた", "kanji": "できた"},
  {"en": "Check again", "to": "もういちど しらべる", "kanji": "再確認"},
  {"en": "Checking...", "to": "しらべて いるよ…", "kanji": "確認中…"},
  {"en": "Every check still passes (%d of %d).", "to": "しらべた ぜんぶが、まだ とおるよ（%d / %d）。", "kanji": "全てのテストに引き続き成功しています（%d / %d）。"},
  {"en": "Not yet: ask %s", "to": "まだだよ。%s に きいてね", "kanji": "まだだよ。%s に聞いてね"},
  {"en": "Nothing is built here yet. %s can help you start.", "to": "ここには まだ なにも できて いないよ。%s が はじめかたを おしえて くれるよ。", "kanji": "ここにはまだ何もできていないよ。%s がはじめかたを教えてくれるよ。"},
  {"en": "The Lamp Lane", "to": "ランプの こみち", "kanji": "ランプの小道"},
  {"en": "The Workbench", "to": "さぎょうだい", "kanji": "作業台"},
  {"en": "The program that runs", "to": "うごいて いる プログラム", "kanji": "動いているプログラム"},
  {"en": "The town remembers where you were.", "to": "まちは、きみが どこに いたかを おぼえて いるよ。", "kanji": "町は、君がどこにいたかを覚えているよ。"},
  {"en": "You walk where your code says.", "to": "きみの コードが いう ところを あるくよ。", "kanji": "君のコードが言うところを歩くよ。"},
  {"en": "Your Boots", "to": "きみの くつ", "kanji": "君の靴"},
  {"en": "Your Save", "to": "きみの セーブ", "kanji": "君のセーブ"},
  {"en": "Your code lights every lamp on the lane.", "to": "きみの コードが、こみちの ランプを ぜんぶ てらすよ。", "kanji": "君のコードが、小道のランプを全部照らすよ。"},
  {"en": "Your newest try isn't used until it passes.", "to": "いちばん あたらしい ためしは、とおるまで つかわれないよ。", "kanji": "一番新しい試しは、通るまで使われないよ。"}
