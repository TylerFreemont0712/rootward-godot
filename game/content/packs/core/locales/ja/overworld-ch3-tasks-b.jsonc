// Japanese for six of Lanternroot's tasks (Concept/v0.4/06): the drills, the forge, the changelog, the lock, the shop
// and the tidy bag. Names, goals, hints, the advice after a try, the glossary's meanings, the cases' descriptions, the
// Builder's labels and the starter code's comments, keyed by the English exactly (ADR-0047). Code (double, total,
// first, [ ], True, None, null, the quoted values such as "iron", and the placeholders) stays as it is.
[
  // tasks/drills
  {"en": "A drill catches the bug only when Brisk's double gives a different answer from the right one. Try numbers where adding 2 and multiplying by 2 do not agree.", "to": "ブリスクの double が、正しい こたえと ちがう こたえを かえした ときだけ、ドリルは バグを つかまえられるよ。2を たす ことと 2を かける ことが、おなじに ならない かずで ためして みよう。", "kanji": "ブリスクの double が、正しい答えと違う答えを返したときだけ、ドリルはバグを捕まえられるよ。2を足すことと 2をかけることが、同じにならない数で試してみよう。"},
  {"en": "A drill catches the bug only when Brisk's total gives a different answer from the right sum. Look at what his total adds up, and what it leaves out.", "to": "ブリスクの total が、正しい ごうけいと ちがう こたえを かえした ときだけ、ドリルは バグを つかまえられるよ。ブリスクの total が なにを たして、なにを ぬかして いるか 見てみよう。", "kanji": "ブリスクの total が、正しい合計と違う答えを返したときだけ、ドリルはバグを捕まえられるよ。ブリスクの total が何を足して、何をぬかしているか見てみよう。"},
  {"en": "A list of drills needs from 1 to 10 drills. Yours has {got}.", "to": "ドリルの リストには、ドリルが 1 こから 10 こ いるよ。きみの リストには {got} こ あるよ。", "kanji": "ドリルのリストには、ドリルが 1 個から 10 個いるよ。君のリストには {got} 個あるよ。"},
  {"en": "A list of drills, from 1 to 10 of them. Each drill is [input, expected]: an input for Brisk's function, and the answer the right function gives for it.", "to": "ドリルの リスト。1 こから 10 こまで。ドリル 1 こは [いれる もの, こたえ] の ペア。いれる ものは ブリスクの かんすうに わたす もの、こたえは ただしい かんすうが その いれる ものに かえす こたえだよ。", "kanji": "ドリルのリスト。1 個から 10 こまで。ドリル 1 こは [入力値, 答え] のペア。入力値はブリスクの関数に渡すもの、答えは正しい関数がその入力値に返す答えだよ。"},
  {"en": "A list: things in square brackets, with commas between them, kept in order. An empty list has nothing in it.", "to": "リスト：[ ] の かっこで かこんだ もの を、コンマで わけて、じゅんばんに ならべた もの。からの リストには なにも はいって いないよ。", "kanji": "リスト：[ ] の括弧で囲んだものを、コンマで分けて、順番に並べたもの。空のリストには何も入っていないよ。"},
  {"en": "Add up the numbers in a list you make by hand. Does Brisk's total give the same answer? Try lists of different lengths.", "to": "じぶんで つくった リストの かずを たして みよう。ブリスクの total も おなじ こたえを かえすかな？ ながさの ちがう リストで ためして みよう。", "kanji": "自分で作ったリストの数を足してみよう。ブリスクの total も同じ答えを返すかな？長さの違うリストで試してみよう。"},
  {"en": "An array: things in square brackets, with commas between them, kept in order. An empty array has nothing in it.", "to": "array：[ ] の かっこで かこんだ もの を、コンマで わけて、じゅんばんに ならべた もの。からの array には なにも はいって いないよ。", "kanji": "array：[ ] の括弧で囲んだものを、コンマで分けて、順番に並べたもの。空の array には何も入っていないよ。"},
  {"en": "Brisk's Drills", "to": "ブリスクの ドリル", "kanji": "ブリスクのドリル"},
  {"en": "Brisk's double", "to": "ブリスクの double", "kanji": "ブリスクの double"},
  {"en": "Brisk's double should give back twice its number. Write drills that catch the bug in it.", "to": "ブリスクの double は、その かずの 2 ばいを かえすはずだよ。その中の バグを つかまえる ドリルを かいてみよう。", "kanji": "ブリスクの double は、その数の 2 ばいを返すはずだよ。その中のバグを捕まえるドリルを書いてみよう。"},
  {"en": "Brisk's drill board shows the bugs your tests caught.", "to": "ブリスクの ドリルばんには、きみの テストが つかまえた バグが でるよ。", "kanji": "ブリスクのドリルばんには、君のテストが捕まえたバグがでるよ。"},
  {"en": "Brisk's first", "to": "ブリスクの first", "kanji": "ブリスクの first"},
  {"en": "Brisk's first should give back the first item of a list. Write drills that catch the bug in it.", "to": "ブリスクの first は、リストの さいしょの もの を かえすはずだよ。その中の バグを つかまえる ドリルを かいてみよう。", "kanji": "ブリスクの first は、リストの最初のものを返すはずだよ。その中のバグを捕まえるドリルを書いてみよう。"},
  {"en": "Brisk's total", "to": "ブリスクの total", "kanji": "ブリスクの total"},
  {"en": "Brisk's total should give back the sum of a list of numbers. Write drills that catch the bug in it.", "to": "ブリスクの total は、かずの リストの ごうけいを かえすはずだよ。その中の バグを つかまえる ドリルを かいてみよう。", "kanji": "ブリスクの total は、数のリストの合計を返すはずだよ。その中のバグを捕まえるドリルを書いてみよう。"},
  {"en": "Each drill is two things in square brackets: an input, then the answer the right double gives for that input.", "to": "ドリルは [ ] の なかの ふたつ：いれる もの、そして、その いれる ものに たいして ただしい double が かえす こたえ。", "kanji": "ドリルは [ ] の中の二つ：入力値、そして、その入力値に対して正しい double が返す答え。"},
  {"en": "Give back a list of drills, in square brackets. Yours gave back {got}.", "to": "ドリルの リストを、[ ] の かっこで かこんで かえしてね。きみは {got} を かえしたよ。", "kanji": "ドリルのリストを、[ ] の括弧で囲んで返してね。君は {got} を返したよ。"},
  {"en": "Good tests try the strange cases as well as the usual ones. What is the strangest list there could be?", "to": "いい テストは、ふつうの ばあいと いっしょに、へんな ばあいも ためすよ。いちばん へんな リストって どんな リストかな？", "kanji": "いいテストは、通常の場合と一緒に、変な場合も試すよ。一番変なリストってどんなリストかな？"},
  {"en": "If Brisk's first cannot give back any item, it crashes. A crash is not the answer you wrote, so it catches the bug.", "to": "ブリスクの first が どの もの も かえせない ときは、クラッシュして しまうよ。クラッシュは、きみが かいた こたえ では ないから、バグを つかまえられるんだ。", "kanji": "ブリスクの first がどのものも返せないときは、クラッシュしてしまうよ。クラッシュは、君が書いた答えではないから、バグを捕まえられるんだ。"},
  {"en": "None of your drills catches the bug in Brisk's {name}, because his {name} gives the right answer for every one of them. Find an input where his answer comes out different.", "to": "きみの ドリルの どれも、ブリスクの {name} の バグを つかまえて いないよ。ブリスクの {name} は、そのぜんぶで ただしい こたえを かえして しまうからね。ブリスクの こたえが ちがって なる いれる ものを さがして みよう。", "kanji": "君のドリルのどれも、ブリスクの {name} のバグを捕まえていないよ。ブリスクの {name} は、そのぜんぶで正しい答えを返してしまうからね。ブリスクの答えが違ってなる入力値を探してみよう。"},
  {"en": "Takes the thing at a place in a list. Places count from 0, so the first thing is at place 0.", "to": "リストの ばしょを 指定して、その もの を とりだすよ。ばしょは 0 から かぞえるから、さいしょの もの は ばしょ 0 に あるよ。", "kanji": "リストの場所を指定して、そのものを取り出すよ。場所は 0 から数えるから、最初のものは場所 0 にあるよ。"},
  {"en": "Takes the thing at a place in an array. Places count from 0, so the first thing is at place 0.", "to": "array の ばしょを 指定して、その もの を とりだすよ。ばしょは 0 から かぞえるから、さいしょの もの は ばしょ 0 に あるよ。", "kanji": "array の場所を指定して、そのものを取り出すよ。場所は 0 から数えるから、最初のものは場所 0 にあるよ。"},
  {"en": "The input of a first drill is a list. Its expected answer is the first item in that list.", "to": "first の ドリルの いれる ものは リストだよ。その こたえは、そのリストの さいしょの もの だよ。", "kanji": "first のドリルの入力値はリストだよ。その答えは、そのリストの最初のものだよ。"},
  {"en": "The input of a total drill is a list of numbers. Its expected answer is the sum of all the numbers in it.", "to": "total の ドリルの いれる ものは、かずの リストだよ。その こたえは、リストの かずを ぜんぶ たした ごうけいだよ。", "kanji": "total のドリルの入力値は、数のリストだよ。その答えは、リストの数を全部足した合計だよ。"},
  {"en": "Work out the right answer yourself first. Twice the number is what double should give.", "to": "さきに、ただしい こたえを じぶんで だして みよう。2 ばいの かずが、double が かえす べき もの だよ。", "kanji": "さきに、正しい答えを自分で出してみよう。2 ばいの数が、double が返すべきものだよ。"},
  {"en": "Your drill says Brisk's {name} of {arg0} gives {got}, but the right answer is {want}. Work it out again.", "to": "きみの ドリルは、ブリスクの {name} に {arg0} を いれると {got} が かえって くると いって いるけど、ただしい こたえは {want} だよ。もういちど 計算して みてね。", "kanji": "君のドリルは、ブリスクの {name} に {arg0} を入れると {got} が返ってくると言っているけど、正しい答えは {want} だよ。もう一度計算してみてね。"},
  {"en": "its answer", "to": "その こたえ", "kanji": "その答え"},
  {"en": "the input", "to": "いれる もの", "kanji": "入力値"},
  {"en": "the list", "to": "リスト", "kanji": "リスト"},
  {"en": "{got} is not a proper drill. A drill is two things in square brackets: an input the function takes, then the answer it should give.", "to": "{got} は ちゃんとした ドリルじゃ ないよ。ドリルは [ ] の なかの ふたつ：かんすうが うけとる いれる もの、そして かんすうが かえす べき こたえだよ。", "kanji": "{got} はちゃんとしたドリルじゃないよ。ドリルは [ ] の中の二つ：関数が受け取る入力値、そして関数が返すべき答えだよ。"},
  // tasks/drills: the comments of the starter code
  {"en": "Give back a list of drills for Brisk's double. A drill is [input, expected].", "to": "ブリスクの double の ドリルの リストを かえしてね。ドリルは [いれる もの, こたえ] だよ。", "kanji": "ブリスクの double のドリルのリストを返してね。ドリルは [入力値, 答え] だよ。"},
  {"en": "Give back a list of drills for Brisk's first. A drill is [input, expected].", "to": "ブリスクの first の ドリルの リストを かえしてね。ドリルは [いれる もの, こたえ] だよ。", "kanji": "ブリスクの first のドリルのリストを返してね。ドリルは [入力値, 答え] だよ。"},
  {"en": "Give back a list of drills for Brisk's total. A drill is [input, expected].", "to": "ブリスクの total の ドリルの リストを かえしてね。ドリルは [いれる もの, こたえ] だよ。", "kanji": "ブリスクの total のドリルのリストを返してね。ドリルは [入力値, 答え] だよ。"},
  // tasks/forge
  {"en": "A list. Its items go in square brackets, separated by commas.", "to": "リスト。もの は [ ] の かっこに いれて、コンマで わけるよ。", "kanji": "リスト。ものは [ ] の括弧に入れて、コンマで分けるよ。"},
  {"en": "An array. Its items go in square brackets, separated by commas.", "to": "array。もの は [ ] の かっこに いれて、コンマで わけるよ。", "kanji": "array。ものは [ ] の括弧に入れて、コンマで分けるよ。"},
  {"en": "Brannoc tried {say} and got nothing back. Give back {want}.", "to": "ブラノックは「{say}」を ためしたけど、なにも かえって こなかったよ。{want} を かえしてね。", "kanji": "ブラノックは「{say}」を試したけど、何も返ってこなかったよ。{want} を返してね。"},
  {"en": "Brannoc tried {say}, and the list {arg0} came out changed. The forge must not change what it is given. Make a new, ordered list instead.", "to": "ブラノックは「{say}」を ためしたら、リスト {arg0} が かわって しまったよ。かじばは、わたされた ものを かえては いけないよ。かわりに、じゅんばんに ならべた あたらしい リストを つくってね。", "kanji": "ブラノックは「{say}」を試したら、リスト {arg0} が変わってしまったよ。鍛冶場は、渡されたものを変えてはいけないよ。代わりに、順番に並べた新しいリストを作ってね。"},
  {"en": "Brannoc tried {say}, the strange case. The forge gave back {got}, but it should give back {want}.", "to": "ブラノックは「{say}」の へんな ばあいを ためしたよ。かじばは {got} を かえしたけど、{want} を かえす はずだよ。", "kanji": "ブラノックは「{say}」の変な場合を試したよ。鍛冶場は {got} を返したけど、{want} を返すはずだよ。"},
  {"en": "Brannoc tried {say}. Give back the name of the tool as text, such as {want}.", "to": "ブラノックは「{say}」を ためしたよ。どうぐの なまえを 文字で かえしてね。たとえば {want} みたいにね。", "kanji": "ブラノックは「{say}」を試したよ。道具の名前を文字で返してね。例えば {want} みたいにね。"},
  {"en": "Brannoc tried {say}. The forge gave back {got}, but it should give back {want}.", "to": "ブラノックは「{say}」を ためしたよ。かじばは {got} を かえしたけど、{want} を かえす はずだよ。", "kanji": "ブラノックは「{say}」を試したよ。鍛冶場は {got} を返したけど、{want} を返すはずだよ。"},
  {"en": "Brannoc's forge follows your forge(), and touches nothing else.", "to": "ブラノックの かじばは きみの forge() に したがうよ。ほかの ものには、なにも さわらないよ。", "kanji": "ブラノックの鍛冶場は君の forge() に従うよ。他のものには、何もさわらないよ。"},
  {"en": "Gives a name a value. The name then holds that value.", "to": "なまえに あたいを いれるよ。なまえは、その あたいを もつように なるよ。", "kanji": "名前に値を入れるよ。名前は、その値をもつようになるよ。"},
  {"en": "Gives back a new list with the same items in order. The list it was given is not changed.", "to": "おなじ もの を じゅんばんに ならべた、あたらしい リストを かえすよ。わたされた リストは かわらないよ。", "kanji": "同じものを順番に並べた、新しいリストを返すよ。渡されたリストは変わらないよ。"},
  {"en": "Joins the items of an array into one text, with the text given between them.", "to": "array の もの を ひとつの 文字に つなげるよ。あいだには、わたした 文字を いれるよ。", "kanji": "array のものを一つの文字に繋げるよ。間には、渡した文字を入れるよ。"},
  {"en": "Look at the pairs. Which two materials make a hammer, which make a gear, and which make a stick?", "to": "ペアを 見てみよう。どの ふたつの ざいりょうで ハンマーが できて、どの ふたつで はぐるまが できて、どの ふたつで ぼうが できるかな？", "kanji": "ペアを見てみよう。どの二つの材料でハンマーができて、どの二つで歯車ができて、どの二つでぼうができるかな？"},
  {"en": "Make forge() give back the tool the materials make, in either order. Leave the list it was given as it was.", "to": "forge() が、ざいりょうで できる どうぐを かえすように しよう。どちらの じゅんばんでも いいよ。わたされた リストは、そのまま にして おこう。", "kanji": "forge() が、材料でできる道具を返すようにしよう。どちらの順番でもいいよ。渡されたリストは、そのままにしておこう。"},
  {"en": "Makes a copy of an array. Changing the copy leaves the first one as it was.", "to": "array の コピーを つくるよ。コピーを かえても、もとの array は そのまま のこるよ。", "kanji": "array のコピーを作るよ。コピーを変えても、もとの array はそのまま残るよ。"},
  {"en": "Put the order on a copy, not on the list you were given. The words column says which way of ordering makes a copy.", "to": "じゅんばんは、わたされた リストで は なく、コピーに つけよう。ことばの らんに、コピーを つくる ならべかたが 書いて あるよ。", "kanji": "順番は、渡されたリストではなく、コピーに付けよう。用語欄に、コピーを作るならべかたが書いてあるよ。"},
  {"en": "Puts a list in order by changing that list itself. It gives back nothing.", "to": "リストの じゅんばんを、そのリスト じたいを かえて ととのえるよ。なにも かえさないよ。", "kanji": "リストの順番を、そのリスト自体を変えて整えるよ。何も返さないよ。"},
  {"en": "Puts an array in order by changing that array itself.", "to": "array の じゅんばんを、その array じたいを かえて ととのえるよ。", "kanji": "array の順番を、その array 自体を変えて整えるよ。"},
  {"en": "The Forge", "to": "かじば", "kanji": "鍛冶場"},
  {"en": "The materials put in the forge, as a list of text, such as \"iron\" or \"wood\". The list belongs to whoever gave it to you.", "to": "かじばに いれた ざいりょう。文字の リストで、たとえば \"iron\" や \"wood\"。このリストは、わたして くれた 人の ものだよ。", "kanji": "鍛冶場に入れた材料。文字のリストで、例えば \"iron\" や \"wood\"。このリストは、渡してくれた人のものだよ。"},
  {"en": "The name of the tool the materials make, as text. \"nothing\" when they make no tool.", "to": "ざいりょうで できる どうぐの なまえ。文字で。どうぐが できない ときは \"nothing\"。", "kanji": "材料でできる道具の名前。文字で。道具ができないときは \"nothing\"。"},
  {"en": "Two materials can come in either order. If you put the pair in order first, each tool needs only one check.", "to": "ざいりょう ふたつは、どちらが さきに きても いいよ。ペアを さきに じゅんばんに ならべて おけば、どうぐ ごとの たしかめは ひとつで すむよ。", "kanji": "材料二つは、どちらがさきにきてもいいよ。ペアをさきに順番に並べておけば、道具ごとの確認は一つですむよ。"},
  {"en": "iron and wood", "to": "てつと もくざい", "kanji": "鉄と木材"},
  {"en": "no materials at all", "to": "ざいりょうが ひとつも ない", "kanji": "材料が一つもない"},
  {"en": "stone on its own", "to": "いし ひとつだけ", "kanji": "石一つだけ"},
  {"en": "two irons", "to": "てつ 2つ", "kanji": "鉄 2つ"},
  {"en": "two woods", "to": "もくざい 2つ", "kanji": "木材 2つ"},
  {"en": "wood and iron, the other way round", "to": "もくざいと てつ、ぎゃくの じゅんばん", "kanji": "木材と鉄、ぎゃくの順番"},
  // tasks/forge: the comments of the starter code
  {"en": "Give back the name of the tool they make, as text, or \"nothing\" when they make no tool.", "to": "ざいりょうで できる どうぐの なまえを、文字で かえしてね。どうぐが できない ときは \"nothing\" を かえしてね。", "kanji": "材料でできる道具の名前を、文字で返してね。道具ができないときは \"nothing\" を返してね。"},
  {"en": "materials is the list of materials put in the forge, as text, such as \"iron\" or \"wood\".", "to": "materials は かじばに いれた ざいりょうの リスト。文字で、たとえば \"iron\" や \"wood\"。", "kanji": "materials は鍛冶場に入れた材料のリスト。文字で、例えば \"iron\" や \"wood\"。"},
  // tasks/history
  {"en": "A line's number is its place plus one, because the numbers start from 1. Which number goes in your list?", "to": "ぎょうの ばんごうは、その ばしょに 1 を たした かずだよ。かずは 1 から はじまるからね。きみの リストには、どの かずを いれるかな？", "kanji": "行の番号は、その場所に 1 を足した数だよ。数は 1 から始まるからね。君のリストには、どの数を入れるかな？"},
  {"en": "A place that the shorter list does not have counts as changed. Check the length of each list before you look at a place in it.", "to": "みじかい リストに ない ばしょは、かわった ものと かぞえるよ。ばしょを 見る まえに、それぞれの リストの ながさを たしかめよう。", "kanji": "短いリストにない場所は、変わったものと数えるよ。場所を見る前に、それぞれのリストの長さを確かめよう。"},
  {"en": "Asks whether two things are not the same. The answer is True or False.", "to": "ふたつの ものが おなじで ない かを たずねるよ。こたえは True か False。", "kanji": "二つのものが同じでないかを尋ねるよ。答えは True か False。"},
  {"en": "Asks whether two things are not the same. The answer is true or false.", "to": "ふたつの ものが おなじで ない かを たずねるよ。こたえは true か false。", "kanji": "二つのものが同じでないかを尋ねるよ。答えは true か false。"},
  {"en": "Counts how many things a list holds.", "to": "リストに はいって いる もの の かずを かぞえるよ。", "kanji": "リストに入っているものの数を数えるよ。"},
  {"en": "For {say}, nothing came back. It should be {want}.", "to": "「{say}」の とき、なにも かえって こなかったよ。{want} に なる はずだよ。", "kanji": "「{say}」のとき、何も返ってこなかったよ。{want} になるはずだよ。"},
  {"en": "For {say}, the answer is {got}, but it should be {want}. Check the lines at the end too.", "to": "「{say}」の とき、こたえは {got} だけど、{want} に なる はずだよ。さいごの ぎょうも たしかめて みてね。", "kanji": "「{say}」のとき、答えは {got} だけど、{want} になるはずだよ。最後の行も確かめてみてね。"},
  {"en": "For {say}, the answer is {got}, but it should be {want}. Line numbers start from 1.", "to": "「{say}」の とき、こたえは {got} だけど、{want} に なる はずだよ。ぎょうの ばんごうは 1 から はじまるよ。", "kanji": "「{say}」のとき、答えは {got} だけど、{want} になるはずだよ。行の番号は 1 から始まるよ。"},
  {"en": "For {say}, the answer should be a list of line numbers, like {want}.", "to": "「{say}」の とき、こたえは ぎょうの ばんごうの リストに なる はずだよ。たとえば {want} みたいにね。", "kanji": "「{say}」のとき、答えは行の番号のリストになるはずだよ。例えば {want} みたいにね。"},
  {"en": "Give back the line numbers, counted from 1, of the lines that differ. Both versions have the same number of lines.", "to": "ちがって いる ぎょうの ばんごうを、1 から かぞえて かえしてね。ふたつの バージョンは、ぎょうの かずが おなじだよ。", "kanji": "違っている行の番号を、1 から数えて返してね。二つのバージョンは、行の数が同じだよ。"},
  {"en": "Gives the biggest of the numbers you give it.", "to": "わたした かずの なかで、いちばん 大きい かずを かえすよ。", "kanji": "渡した数の中で、一番大きい数を返すよ。"},
  {"en": "Go through the lines one at a time, by their place. Which places hold a different line in the two versions?", "to": "ぎょうを ばしょ ごとに、ひとつずつ 見ていこう。ふたつの バージョンで、どの ばしょの ぎょうが ちがって いるかな？", "kanji": "行を場所ごとに、一つずつ見ていこう。二つのバージョンで、どの場所の行が違っているかな？"},
  {"en": "How many things an array holds.", "to": "array に はいって いる もの の かずだよ。", "kanji": "array に入っているものの数だよ。"},
  {"en": "Joins two questions. The answer is True when either one is True.", "to": "ふたつの しつもんを つなぐよ。どちらか ひとつでも True なら、こたえは True だよ。", "kanji": "二つの質問を繋ぐよ。どちらか一つでも True なら、答えは True だよ。"},
  {"en": "Joins two questions. The answer is true when either one is true.", "to": "ふたつの しつもんを つなぐよ。どちらか ひとつでも true なら、こたえは true だよ。", "kanji": "二つの質問を繋ぐよ。どちらか一つでも true なら、答えは true だよ。"},
  {"en": "Let the new version be longer or shorter. A line that is only in one version counts as changed too.", "to": "あたらしい バージョンは、ながく なって も みじかく なって も いいよ。ひとつの バージョンにだけ ある ぎょうも、かわった ものと かぞえるよ。", "kanji": "新しいバージョンは、長くなっても短くなってもいいよ。一つのバージョンにだけある行も、変わったものと数えるよ。"},
  {"en": "Make your loop go as far as the longer of the two lists. Which function gives the bigger of two numbers?", "to": "くりかえしを、ながい ほうの リストの ところまで まわそう。ふたつの かずの おおきい ほうを かえす かんすうは どれかな？", "kanji": "繰り返しを、長いほうのリストのところまで回そう。二つの数の大きいほうを返す関数はどれかな？"},
  {"en": "Makes a name that holds a value, and that can change.", "to": "あたいを もって、かえる ことが できる なまえを つくるよ。", "kanji": "値を持って、変えることができる名前を作るよ。"},
  {"en": "Makes the whole numbers from 0 up to, but not including, the number you give.", "to": "わたした かずより 小さい せいすうを、0 から じゅんに つくるよ。わたした かず じたいは ふくまないよ。", "kanji": "渡した数より小さい整数を、0 から順に作るよ。渡した数自体はふくまないよ。"},
  {"en": "New or missing lines count as changed", "to": "あたらしい ぎょうや なくなった ぎょうも、かわった ものと かぞえる", "kanji": "新しい行やなくなった行も、変わったものと数える"},
  {"en": "Start with a list that is empty. Each time two lines differ, add the number to it. Which word adds something to the end of a list?", "to": "からの リストから はじめよう。ぎょうが ちがう たびに、その ばんごうを リストに くわえるよ。リストの おわりに なにかを くわえる ことばは どれかな？", "kanji": "空のリストから始めよう。行が違うたびに、その番号をリストに加えるよ。リストの終わりに何かを加える言葉はどれかな？"},
  {"en": "The Changelog", "to": "へんこうの れきし", "kanji": "変更のれきし"},
  {"en": "The Workbench shows what changed in your code, by your changed().", "to": "さぎょうだいには、きみの changed() で わかった、コードの かわった ところが でるよ。", "kanji": "作業台には、君の changed() で分かった、コードの変わったところがでるよ。"},
  {"en": "The line numbers, counted from 1, of the lines that differ, from the smallest to the biggest. An empty list when no line differs.", "to": "ちがう ぎょうの ばんごうを、1 から かぞえて、小さい じゅんに ならべた もの。どの ぎょうも ちがわない ときは、からの リストだよ。", "kanji": "違う行の番号を、1 から数えて、小さい順に並べたもの。どの行も違わないときは、空のリストだよ。"},
  {"en": "The lines of the new version, the same way: a list of text, one item for each line.", "to": "あたらしい バージョンの ぎょう。おなじように、文字の リストで、ぎょう ごとに ひとつずつだよ。", "kanji": "新しいバージョンの行。同じように、文字のリストで、行ごとに一つずつだよ。"},
  {"en": "The lines of the old version: a list of text, one item for each line.", "to": "もとの バージョンの ぎょう。文字の リストで、ぎょう ごとに ひとつずつだよ。", "kanji": "もとのバージョンの行。文字のリストで、行ごとに一つずつだよ。"},
  {"en": "This one is a special case: {say}. It should give {want}.", "to": "これは とくべつな ばあい：「{say}」。{want} を かえす はずだよ。", "kanji": "これは特別な場合：「{say}」。{want} を返すはずだよ。"},
  {"en": "What happens when one version has more lines than the other? Is there a line in the shorter one at the place of the extra line?", "to": "ひとつの バージョンが もうひとつより ぎょうが おおい ときは、どう なるかな？ みじかい ほうには、よけいな ぎょうの ばしょに ぎょうが あるかな？", "kanji": "一つのバージョンがもう一つより行が多いときは、どうなるかな？短いほうには、余計な行の場所に行があるかな？"},
  {"en": "an empty old version", "to": "からの もとの バージョン", "kanji": "空のもとのバージョン"},
  {"en": "compare", "to": "くらべる", "kanji": "比べる"},
  {"en": "go through", "to": "じゅんに まわす", "kanji": "順に回す"},
  {"en": "is not the same as", "to": "おなじで ない", "kanji": "同じでない"},
  {"en": "is the same as", "to": "おなじ", "kanji": "同じ"},
  {"en": "no line changed", "to": "かわった ぎょうが ひとつも ない", "kanji": "変わった行が一つもない"},
  {"en": "one line changed", "to": "かわった ぎょうが ひとつだけ", "kanji": "変わった行が一つだけ"},
  {"en": "one line changed, and one new line", "to": "かわった ぎょうが ひとつと、あたらしい ぎょうが ひとつ", "kanji": "変わった行が一つと、新しい行が一つ"},
  {"en": "the longer list", "to": "ながい ほうの リスト", "kanji": "長いほうのリスト"},
  {"en": "the old lines", "to": "もとの ぎょう", "kanji": "もとの行"},
  {"en": "two lines changed", "to": "かわった ぎょうが ふたつ", "kanji": "変わった行が二つ"},
  {"en": "two lines taken away from the end", "to": "おわりから ぎょうが ふたつ なくなった", "kanji": "終わりから行が二つなくなった"},
  {"en": "two new lines at the end", "to": "おわりに あたらしい ぎょうが ふたつ", "kanji": "終わりに新しい行が二つ"},
  // tasks/history: the comments of the starter code
  {"en": "Give back the line numbers, counted from 1, of the lines that differ, from the smallest to the biggest.", "to": "ちがう ぎょうの ばんごうを、1 から かぞえて、小さい じゅんに かえしてね。", "kanji": "違う行の番号を、1 から数えて、小さい順に返してね。"},
  {"en": "old is the lines of the old version, a list of text. latest is the lines of the new version, the same way.", "to": "old は もとの バージョンの ぎょう。文字の リストだよ。latest は あたらしい バージョンの ぎょう。おなじように、文字の リストだよ。", "kanji": "old はもとのバージョンの行。文字のリストだよ。latest は新しいバージョンの行。同じように、文字のリストだよ。"},
  // tasks/locks
  {"en": "A good code has two rules. Write one question for its length, and one question for its characters.", "to": "よい あんごうには、ルールが ふたつ あるよ。ながさを たしかめる しつもんを ひとつ、もじに ついての しつもんを ひとつ かこう。", "kanji": "有効な暗証番号には二つの条件があるよ。長さを調べる条件と、含まれる文字を調べる条件を書こう。"},
  {"en": "A thief's first guess is 1111. It has four digits, so the old checks let it through. What else is true of it?", "to": "どろぼうが さいしょに ためす のは 1111 だよ。すうじが 4つ あるから、いままでの しらべは とおして しまうよ。ほかに、この あんごうに ついて なにが いえるかな？", "kanji": "泥棒が最初に試すのは 1111 だよ。数字が 4つあるから、今までの調べは通してしまうよ。他に、この暗号について何が言えるかな？"},
  {"en": "Asks whether every character in some text is a digit from 0 to 9. The answer is True or False.", "to": "文字の なかの もじが ぜんぶ、0 から 9 までの すうじ か どうかを たずねるよ。こたえは True か False。", "kanji": "文字の中の文字が全部、0 から 9 までの数字かどうかを尋ねるよ。答えは True か False。"},
  {"en": "Asks whether some text fits a pattern. This pattern fits only text made of the digits 0 to 9. The answer is true or false.", "to": "文字が パターンに あって いるかを たずねるよ。この パターンに あうのは、0 から 9 の すうじだけで できた 文字だけだよ。こたえは true か false。", "kanji": "文字がパターンにあっているかを尋ねるよ。このパターンにあうのは、0 から 9 の数字だけでできた文字だけだよ。答えは true か false。"},
  {"en": "Asks whether two things are different. The answer is True or False.", "to": "ふたつの ものが ちがうかを たずねるよ。こたえは True か False。", "kanji": "二つのものが違うかを尋ねるよ。答えは True か False。"},
  {"en": "Asks whether two things are different. The answer is true or false.", "to": "ふたつの ものが ちがうかを たずねるよ。こたえは true か false。", "kanji": "二つのものが違うかを尋ねるよ。答えは true か false。"},
  {"en": "Counts the characters in some text.", "to": "文字の なかの もじを かぞえるよ。", "kanji": "文字の中の文字を数えるよ。"},
  {"en": "How many characters some text has.", "to": "文字に はいって いる もじの かず。", "kanji": "文字に入っている文字の数。"},
  {"en": "Length: len(code) in Python and code.length in JavaScript count the characters. Text can also tell you whether every character is a digit.", "to": "ながさ：Python では len(code)、JavaScript では code.length で、もじの かずを かぞえるよ。文字は、もじが ぜんぶ すうじか どうかも おしえて くれるよ。", "kanji": "長さ：Python では len(code)、JavaScript では code.length で、文字の数を数えるよ。文字は、文字が全部数字かどうかも教えてくれるよ。"},
  {"en": "Look at the first character. Could a code be that same character four times over?", "to": "さいしょの もじを 見てみよう。あんごうが、その もじを 4つ ならべた もの に なる ことは ありえるかな？", "kanji": "最初の文字を見てみよう。暗号が、その文字を 4つ並べたものになることはありえるかな？"},
  {"en": "Make a text that is the first character four times over, and ask whether the code is that text. The words column says how to repeat text.", "to": "さいしょの もじを 4つ ならべた 文字を つくって、あんごうが その 文字と おなじかを たずねよう。ことばの らんに、文字を くりかえす やりかたが 書いて あるよ。", "kanji": "最初の文字を 4つ並べた文字を作って、暗号がその文字と同じかを尋ねよう。用語欄に、文字を繰り返すやり方が書いてあるよ。"},
  {"en": "Make the lockbox take only good codes: exactly four characters, and all of them digits.", "to": "かぎの はこが よい あんごうだけ うけつけるように しよう。ちょうど 4もじ、そして ぜんぶ すうじの あんごうだけだよ。", "kanji": "鍵の箱がよい暗号だけ受け付けるようにしよう。ちょうど 4文字、そして全部数字の暗号だけだよ。"},
  {"en": "Makes some text again and again: \"ha\" * 3 is \"hahaha\".", "to": "文字を なんども くりかえして つくるよ。\"ha\" * 3 は \"hahaha\" だよ。", "kanji": "文字を何度も繰り返して作るよ。\"ha\" * 3 は \"hahaha\" だよ。"},
  {"en": "Makes some text again and again: \"ha\".repeat(3) is \"hahaha\".", "to": "文字を なんども くりかえして つくるよ。\"ha\".repeat(3) は \"hahaha\" だよ。", "kanji": "文字を何度も繰り返して作るよ。\"ha\".repeat(3) は \"hahaha\" だよ。"},
  {"en": "Nix checked {say} and got nothing back. Give back yes or no: True or False in Python, true or false in JavaScript.", "to": "ニックスは「{say}」を しらべたけど、なにも かえって こなかったよ。はい か いいえ で こたえてね。Python では True か False、JavaScript では true か false だよ。", "kanji": "ニックスは「{say}」を調べたけど、何も返ってこなかったよ。はいかいいえで答えてね。Python では True か False、JavaScript では true か false だよ。"},
  {"en": "Nix checked {say}. It gave back {got}, but it should give back {want}.", "to": "ニックスは「{say}」を しらべたよ。{got} を かえしたけど、{want} を かえす はずだよ。", "kanji": "ニックスは「{say}」を調べたよ。{got} を返したけど、{want} を返すはずだよ。"},
  {"en": "Nix checked {say}. It gave back {got}, which is not yes or no. Give back True or False, as the language writes them.", "to": "ニックスは「{say}」を しらべたよ。{got} を かえしたけど、それは はい か いいえ では ないよ。True か False を、その ことばの かきかたで かえしてね。", "kanji": "ニックスは「{say}」を調べたよ。{got} を返したけど、それははいかいいえではないよ。True か False を、その言葉の書き方で返してね。"},
  {"en": "Nix checks the strange codes too. For {say}, it gave back {got}, but it should give back {want}.", "to": "ニックスは へんな あんごうも しらべるよ。「{say}」の とき、{got} を かえしたけど、{want} を かえす はずだよ。", "kanji": "ニックスは変な暗号も調べるよ。「{say}」のとき、{got} を返したけど、{want} を返すはずだよ。"},
  {"en": "Nix's Lock", "to": "ニックスの かぎ", "kanji": "ニックスの鍵"},
  {"en": "Nix's lockbox trusts your good_code().", "to": "ニックスの かぎの はこは、きみの good_code() を しんじて いるよ。", "kanji": "ニックスの鍵の箱は、君の good_code() をしんじているよ。"},
  {"en": "Refuse one digit four times", "to": "おなじ すうじ 4つを ことわる", "kanji": "同じ数字 4つを断る"},
  {"en": "Refuse the codes a thief tries first: one digit four times, such as 1111.", "to": "どろぼうが さいしょに ためす あんごうを ことわろう。おなじ すうじを 4つ ならべた もの、たとえば 1111。", "kanji": "泥棒が最初に試す暗号を断ろう。同じ数字を 4つ並べたもの、例えば 1111。"},
  {"en": "The first character of some text. [1] is the second character, and so on.", "to": "文字の さいしょの もじ。[1] は 2 ばんめの もじ、というふうに つづくよ。", "kanji": "文字の最初の文字。[1] は 2 番目の文字、というふうに続くよ。"},
  {"en": "The lock code the player typed, as text: characters in a row, such as \"2580\".", "to": "プレイヤーが うちこんだ かぎの あんごう。文字で、もじを ならべた もの。たとえば \"2580\"。", "kanji": "プレイヤーが打ち込んだ鍵の暗号。文字で、文字を並べたもの。例えば \"2580\"。"},
  {"en": "Think like a thief. A thief tries codes that are too short, too long, or full of letters. Which of those should the lockbox refuse?", "to": "どろぼうに なって 考えて みよう。どろぼうは、みじかすぎる あんごう、ながすぎる あんごう、もじだらけの あんごうを ためすよ。かぎの はこは、そのうち どれを ことわる べきかな？", "kanji": "泥棒の立場で考えてみよう。短すぎる番号、長すぎる番号、数字以外の文字が入った番号。どれを拒否すべきだろう？"},
  {"en": "True when the code is a good lock code, and False when it is not. In JavaScript these are true and false.", "to": "よい あんごうなら True、そう じゃ なければ False。JavaScript では true と false だよ。", "kanji": "よい暗号なら True、そうじゃなければ False。JavaScript では true と false だよ。"},
  {"en": "Turns True into False, and False into True.", "to": "True を False に、False を True に かえるよ。", "kanji": "True を False に、False を True に変えるよ。"},
  {"en": "Turns true into false, and false into true.", "to": "true を false に、false を true に かえるよ。", "kanji": "true を false に、false を true に変えるよ。"},
  {"en": "a code of five digits", "to": "すうじ 5つの あんごう", "kanji": "数字 5つの暗号"},
  {"en": "a code of four digits", "to": "すうじ 4つの あんごう", "kanji": "数字 4つの暗号"},
  {"en": "a code of three digits", "to": "すうじ 3つの あんごう", "kanji": "数字 3つの暗号"},
  {"en": "a code with a letter in it", "to": "もじが まじった あんごう", "kanji": "文字がまじった暗号"},
  {"en": "a good length", "to": "ただしい ながさ", "kanji": "正しい長さ"},
  {"en": "an empty code", "to": "からっぽの あんごう", "kanji": "空っぽの暗号"},
  {"en": "is", "to": "おなじ", "kanji": "同じ"},
  {"en": "is more than", "to": "より おおい", "kanji": "より多い"},
  {"en": "is not", "to": "ちがう", "kanji": "違う"},
  {"en": "one digit four times", "to": "おなじ すうじが 4つ", "kanji": "同じ数字が 4つ"},
  {"en": "the digits", "to": "すうじ", "kanji": "数字"},
  {"en": "the length", "to": "ながさ", "kanji": "長さ"},
  {"en": "three of one digit and one other", "to": "おなじ すうじ 3つと、ほかの すうじ 1つ", "kanji": "同じ数字 3つと、他の数字 1つ"},
  // tasks/locks: the comments of the starter code
  {"en": "Give back True when it is a good lock code, or False when it is not.", "to": "よい かぎの あんごうなら True、そう じゃ なければ False を かえしてね。", "kanji": "よい鍵の暗号なら True、そうじゃなければ False を返してね。"},
  {"en": "Give back true when it is a good lock code, or false when it is not.", "to": "よい かぎの あんごうなら true、そう じゃ なければ false を かえしてね。", "kanji": "よい鍵の暗号なら true、そうじゃなければ false を返してね。"},
  {"en": "code is the lock code the player typed, as text, such as \"2580\".", "to": "code は プレイヤーが うちこんだ かぎの あんごう。文字で、たとえば \"2580\"。", "kanji": "code はプレイヤーが打ち込んだ鍵の暗号。文字で、例えば \"2580\"。"},
  // tasks/shop
  {"en": "10 coins for something that costs 5", "to": "10 コイン、ねだんが 5 の もの", "kanji": "10 コイン、値段が 5 のもの"},
  {"en": "4 coins for something that costs 5", "to": "4 コイン、ねだんが 5 の もの", "kanji": "4 コイン、値段が 5 のもの"},
  {"en": "An item that is not in the prices has no price to look up. Ask first whether it is there, using in, and give back 0 when it is not.", "to": "prices に はいって いない もちものは、ねだんを さがせないよ。まず in で あるかを たしかめて、なければ 0 を かえそう。", "kanji": "prices に入っていない持ち物は、値段を探せないよ。まず in であるかを確かめて、なければ 0 を返そう。"},
  {"en": "Asks whether a name is in a dictionary or a list. The answer is True or False.", "to": "なまえが 辞書 や リストに あるかを たずねるよ。こたえは True か False。", "kanji": "名前が辞書やリストにあるかを尋ねるよ。答えは True か False。"},
  {"en": "Asks whether a name is in an object. The answer is true or false.", "to": "なまえが オブジェクト に あるかを たずねるよ。こたえは true か false。", "kanji": "名前がオブジェクトにあるかを尋ねるよ。答えは true か false。"},
  {"en": "Asks whether one number is at least another: True when it is bigger or the same.", "to": "ひとつの かずが、もうひとつの かずと おなじか、それより おおきい かを たずねるよ。そうなら True。", "kanji": "一つの数が、もう一つの数と同じか、それより大きいかを尋ねるよ。そうなら True。"},
  {"en": "Asks whether one number is at least another: true when it is bigger or the same.", "to": "ひとつの かずが、もうひとつの かずと おなじか、それより おおきい かを たずねるよ。そうなら true。", "kanji": "一つの数が、もう一つの数と同じか、それより大きいかを尋ねるよ。そうなら true。"},
  {"en": "Give back the coins for some of an item: its price times how many. An item the shop does not sell gives 0.", "to": "もちものを いくつか 買う ときの コインを かえそう。ねだん かける かず だよ。おみせで うって いない もちものは 0 だよ。", "kanji": "持ち物をいくつか買うときのコインを返そう。値段かける数だよ。お店で売っていない持ち物は 0 だよ。"},
  {"en": "How many coins you have, a whole number.", "to": "もって いる コインの かず。せいすうで。", "kanji": "持っているコインの数。整数で。"},
  {"en": "How many of the item, a whole number.", "to": "もちものの かず。せいすうで。", "kanji": "持ち物の数。整数で。"},
  {"en": "Look at the two numbers: the coins you have, and the cost. The answer is a question, True or False: are the coins enough?", "to": "ふたつの かずを 見よう。もって いる コインと、ねだんだよ。こたえは True か False。「コインは たりるかな？」への こたえだよ。", "kanji": "二つの数を見よう。持っているコインと、値段だよ。答えは True か False。「コインは足りるかな？」への答えだよ。"},
  {"en": "Looks up the number under a name in a dictionary.", "to": "辞書 の なかから、なまえに ついた かずを さがすよ。", "kanji": "辞書の中から、名前に付いた数を探すよ。"},
  {"en": "Looks up the number under a name in an object.", "to": "オブジェクト の なかから、なまえに ついた かずを さがすよ。", "kanji": "オブジェクトの中から、名前に付いた数を探すよ。"},
  {"en": "Nym's Shop", "to": "ニムの おみせ", "kanji": "ニムのお店"},
  {"en": "Nym's shop prices and sells with your price() and can_buy().", "to": "ニムの おみせは、きみの price() と can_buy() で ねだんを きめて、うるよ。", "kanji": "ニムのお店は、君の price() と can_buy() で値段を決めて、うるよ。"},
  {"en": "Python and JavaScript have a word that asks whether one number is at least another. It is in the list of words in the Hints column.", "to": "Python と JavaScript には、ひとつの かずが もうひとつの かず いじょうかを たずねる ことばが あるよ。それは、ヒントの らんの ことばの リストに あるよ。", "kanji": "Python と JavaScript には、一つの数がもう一つの数以上かを尋ねる言葉があるよ。それは、ヒントのらんの言葉のリストにあるよ。"},
  {"en": "Say whether the coins are enough: True when they are at least the cost, False when they are not.", "to": "コインが ねだん いじょう なら True、そう じゃ なければ False。", "kanji": "コインが値段以上なら True、そうじゃなければ False。"},
  {"en": "The coins for count of the item: its price times count. When the shop does not sell the item, 0.", "to": "count こ 買う ときの もちものの コイン：ねだん かける count。おみせで うって いない ときは 0。", "kanji": "count 個買うときの持ち物のコイン：値段かける count。お店で売っていないときは 0。"},
  {"en": "The name of the item, such as \"apple\".", "to": "もちものの なまえ。たとえば \"apple\"。", "kanji": "持ち物の名前。例えば \"apple\"。"},
  {"en": "The prices are a dictionary, so you can look up one item's price by its name, the way you look up a word in a list.", "to": "ねだんは 辞書 だから、リストの ことばを さがす ように、もちものの なまえで ねだんを さがせるよ。", "kanji": "値段は辞書だから、リストの言葉を探すように、持ち物の名前で値段を探せるよ。"},
  {"en": "Three apples cost three times as much as one apple. What do you need to multiply the price by?", "to": "りんご 3つは、りんご 1つの 3 ばいの ねだんだよ。ねだんに なにを かければ いいかな？", "kanji": "りんご 3つは、りんご 1つの 3 ばいの値段だよ。値段に何をかければいいかな？"},
  {"en": "True when the coins are at least the cost, otherwise False. In JavaScript, true or false.", "to": "コインが ねだん いじょう なら True、そう じゃ なければ False。JavaScript では true か false。", "kanji": "コインが値段以上なら True、そうじゃなければ False。JavaScript では true か false。"},
  {"en": "What the item costs in coins, a whole number.", "to": "もちものの ねだん（コイン）。せいすうで。", "kanji": "持ち物の値段（コイン）。整数で。"},
  {"en": "What the shop sells: a dictionary from each item's name to its price in coins for one. An item the shop does not sell is not in it.", "to": "おみせで うって いる もの：もちものの なまえから、1つぶんの ねだん（コイン）への 辞書。おみせで うって いない もちもの は、はいって いないよ。", "kanji": "お店で売っているもの：持ち物の名前から、1つぶんの値段（コイン）への辞書。お店で売っていない持ち物は、入っていないよ。"},
  {"en": "With {say}, nothing came back. It should be {want}.", "to": "「{say}」の とき、なにも かえって こなかったよ。{want} に なる はずだよ。", "kanji": "「{say}」のとき、何も返ってこなかったよ。{want} になるはずだよ。"},
  {"en": "With {say}, the answer was {got}, but it should be {want}. Check what kind of answer you give back.", "to": "「{say}」の とき、こたえは {got} だったけど、{want} に なる はずだよ。かえす こたえの しゅるいを たしかめて みてね。", "kanji": "「{say}」のとき、答えは {got} だったけど、{want} になるはずだよ。返す答えの種類を確かめてみてね。"},
  {"en": "With {say}, the answer was {got}. It should be {want}.", "to": "「{say}」の とき、こたえは {got} だったよ。{want} に なる はずだよ。", "kanji": "「{say}」のとき、答えは {got} だったよ。{want} になるはずだよ。"},
  {"en": "Write can_buy too", "to": "can_buy も かく", "kanji": "can_buy も書く"},
  {"en": "Your answer is already True or False, so you can give it straight back with return. You do not need an if.", "to": "きみの こたえは もう True か False だから、return で そのまま かえせば いいよ。if は いらないよ。", "kanji": "君の答えはもう True か False だから、return でそのまま返せばいいよ。if はいらないよ。"},
  {"en": "a pebble, which the shop does not sell", "to": "おみせで うって いない、こいし", "kanji": "お店で売っていない、小石"},
  {"en": "exactly enough: 5 coins for something that costs 5", "to": "ちょうど たりる：5 コイン、ねだんが 5 の もの", "kanji": "ちょうど足りる：5 コイン、値段が 5 のもの"},
  {"en": "no apples at all", "to": "りんごが ひとつも ない", "kanji": "りんごが一つもない"},
  {"en": "no coins for something that costs 1", "to": "0 コイン、ねだんが 1 の もの", "kanji": "0 コイン、値段が 1 のもの"},
  {"en": "one honey", "to": "はちみつ 1つ", "kanji": "蜂蜜 1つ"},
  {"en": "three apples", "to": "りんご 3つ", "kanji": "りんご 3つ"},
  {"en": "when not sold", "to": "うって いない とき", "kanji": "売っていないとき"},
  // tasks/shop: the comments of the starter code
  {"en": "An item the shop does not sell gives back 0.", "to": "おみせで うって いない もちもの は 0 を かえすよ。", "kanji": "お店で売っていない持ち物は 0 を返すよ。"},
  {"en": "item is the name of an item, and count is how many of it. Give back the coins for count of item.", "to": "item は もちものの なまえ、count は その もちものの かず。count こ ぶんの コインを かえしてね。", "kanji": "item は持ち物の名前、count はその持ち物の数。count 個ぶんのコインを返してね。"},
  {"en": "prices is what the shop sells: each item's name and its price in coins, such as {\"apple\": 2, \"honey\": 6}.", "to": "prices は おみせで うって いる もの：もちものの なまえと、その ねだん（コイン）。たとえば {\"apple\": 2, \"honey\": 6}。", "kanji": "prices はお店で売っているもの：持ち物の名前と、その値段（コイン）。例えば {\"apple\": 2, \"honey\": 6}。"},
  {"en": "prices is what the shop sells: each item's name and its price in coins, such as {apple: 2, honey: 6}.", "to": "prices は おみせで うって いる もの：もちものの なまえと、その ねだん（コイン）。たとえば {apple: 2, honey: 6}。", "kanji": "prices はお店で売っているもの：持ち物の名前と、その値段（コイン）。例えば {apple: 2, honey: 6}。"},
  // tasks/tidy
  {"en": "A Tidy Bag", "to": "かたづいた かばん", "kanji": "かたづいた鞄"},
  {"en": "A bag is a list of stacks, and each stack has a count. What is it that you need to add up?", "to": "かばんは スタックの リストで、それぞれの スタックに かず が ついて いるよ。たして いく のは なにかな？", "kanji": "鞄はスタックのリストで、それぞれのスタックに数がついているよ。足して行くのは何かな？"},
  {"en": "A tiny function with no name. lambda word: len(word) gives back the length of a word.", "to": "なまえの ない 小さな かんすうだよ。lambda word: len(word) は、ことばの ながさを かえすよ。", "kanji": "名前のない小さな関数だよ。lambda word: len(word) は、言葉の長さを返すよ。"},
  {"en": "Asks whether one thing comes before another. The answer is true or false.", "to": "ひとつの ものが もうひとつより まえに くるかを たずねるよ。こたえは true か false。", "kanji": "一つのものがもう一つより前にくるかを尋ねるよ。答えは true か false。"},
  {"en": "Each stack is a dictionary. Which key holds the name that you sort by?", "to": "スタックは それぞれ 辞書 だよ。ならべる もとの なまえは、どの key に はいって いるかな？", "kanji": "スタックはそれぞれ辞書だよ。並べるもとの名前は、どの key に入っているかな？"},
  {"en": "Each time, add the stack's count to the total. Which word adds a number onto a name's number?", "to": "そのたび、スタックの かずを ごうけいに たすよ。なまえが もって いる かずに、かずを たす ことばは どれかな？", "kanji": "そのたび、スタックの数を合計にたすよ。名前が持っている数に、数を足す言葉はどれかな？"},
  {"en": "For {say}, the answer was {got}, but it should be {want}.", "to": "「{say}」の とき、こたえは {got} だったけど、{want} に なる はずだよ。", "kanji": "「{say}」のとき、答えは {got} だったけど、{want} になるはずだよ。"},
  {"en": "Give back how many things the bag holds: every stack's count added together.", "to": "かばんに はいって いる もの の かずを かえそう：スタック ぜんぶの かずを たした ものだよ。", "kanji": "鞄に入っているものの数を返そう：スタック全部の数を足したものだよ。"},
  {"en": "Give back the same stacks, in A to Z order by item name. Each stack keeps its item and its count.", "to": "おなじ スタックを、もちもの の なまえで A から Z の じゅんに ならべて かえそう。それぞれの スタックは、もちもの と かず を そのまま もって いるよ。", "kanji": "同じスタックを、持ち物の名前で A から Z の順に並べて返そう。それぞれのスタックは、持ち物と数をそのまま持っているよ。"},
  {"en": "Give back the whole bag, as a list of stacks. Yours gave back {got}.", "to": "かばん ぜんぶを、スタックの リストで かえしてね。きみは {got} を かえしたよ。", "kanji": "鞄全部を、スタックのリストで返してね。君は {got} を返したよ。"},
  {"en": "Gives back a new list with its things in order. key says what each thing is compared by.", "to": "もの を じゅんばんに ならべた あたらしい リストを かえすよ。key は、それぞれの もの を なにで くらべるかを いうよ。", "kanji": "ものを順番に並べた新しいリストを返すよ。key は、それぞれのものを何で比べるかをいうよ。"},
  {"en": "How many things the bag holds: every stack's count added together.", "to": "かばんに はいって いる もの の かず：スタック ぜんぶの かずを たした もの。", "kanji": "鞄に入っているものの数：スタック全部の数を足したもの。"},
  {"en": "Looks up the thing under a name in a dictionary.", "to": "辞書 の なかから、なまえに ついた もの を さがすよ。", "kanji": "辞書の中から、名前に付いたものを探すよ。"},
  {"en": "Makes a copy of an array, so the array you started with stays the same.", "to": "array の コピーを つくるよ。だから、さいしょの array は そのまま のこるよ。", "kanji": "array のコピーを作るよ。だから、最初の array はそのまま残るよ。"},
  {"en": "Makes a tiny function with no name. (word) => word.length gives back the length of a word.", "to": "なまえの ない 小さな かんすうを つくるよ。(word) => word.length は、ことばの ながさを かえすよ。", "kanji": "名前のない小さな関数を作るよ。(word) => word.length は、言葉の長さを返すよ。"},
  {"en": "One of the things you gave back is {got}. Every stack needs an \"item\" (a word) and a \"count\" (a whole number).", "to": "きみが かえした もの の なかに、{got} が ひとつ あるよ。どの スタックにも、\"item\"（ことば）と \"count\"（せいすう）が いるよ。", "kanji": "君が返したものの中に、{got} が一つあるよ。どのスタックにも、\"item\"（言葉）と \"count\"（整数）がいるよ。"},
  {"en": "Picks one of two answers: the one after ? when the question is true, else the one after :.", "to": "ふたつの こたえから ひとつを えらぶよ。しつもんが true なら ? の あとの こたえ、そう じゃ なければ : の あとの こたえだよ。", "kanji": "二つの答えから一つを選ぶよ。質問が true なら ? の後の答え、そうじゃなければ : の後の答えだよ。"},
  {"en": "Puts an array's things in order. Its function says which of two things comes first.", "to": "array の もの を じゅんばんに ならべるよ。その かんすうが、ふたつの もの の どちらが さきに くるかを いうよ。", "kanji": "array のものを順番に並べるよ。その関数が、二つのもののどちらがさきにくるかをいうよ。"},
  {"en": "Python has sorted, which gives back a new list in order, and its key says what to sort by. JavaScript has sort, which takes a function that says which of two things comes first.", "to": "Python には sorted が あって、じゅんばんに ならべた あたらしい リストを かえすよ。その key で、なにで ならべるかを きめるよ。JavaScript には sort が あって、ふたつの もの の どちらが さきに くるかを いう かんすうを うけとるよ。", "kanji": "Python には sorted があって、順番に並べた新しいリストを返すよ。その key で、何で並べるかを決めるよ。JavaScript には sort があって、二つのもののどちらがさきにくるかを言う関数を受け取るよ。"},
  {"en": "Start with a total of 0, then look at each stack in turn. Which word goes through a list one thing at a time?", "to": "ごうけいを 0 から はじめて、スタックを ひとつずつ 見ていこう。リストの もの を ひとつずつ とおる ことばは どれかな？", "kanji": "合計を 0 から始めて、スタックを一つずつ見ていこう。リストのものを一つずつ通る言葉はどれかな？"},
  {"en": "The same stacks, sorted A to Z by item name.", "to": "おなじ スタックを、もちもの の なまえで A から Z に ならべた もの。", "kanji": "同じスタックを、持ち物の名前で A から Z に並べたもの。"},
  {"en": "The stacks stay the same. Only their order changes: you want them sorted by the item's name, from A to Z.", "to": "スタック の なかみは おなじままで、じゅんばんだけが かわるよ。もちもの の なまえで、A から Z の じゅんに ならべたいんだよ。", "kanji": "スタックの中身はおなじままで、順番だけが変わるよ。持ち物の名前で、A から Z の順に並べたいんだよ。"},
  {"en": "Tidy keeps every stack. The {name} stack should hold {want}, but it holds {got}.", "to": "tidy は スタックを ひとつも なくさないよ。{name} の スタックは {want} を もつ はずなのに、{got} を もって いるよ。", "kanji": "tidy はスタックを一つも失くさないよ。{name} のスタックは {want} を持つはずなのに、{got} を持っているよ。"},
  {"en": "Tidy must not add a stack. There is an extra {name} stack, holding {got}.", "to": "tidy は スタックを ふやして は いけないよ。よけいな {name} の スタックが あって、{got} を もって いるよ。", "kanji": "tidy はスタックを増やしてはいけないよ。余計な {name} のスタックがあって、{got} を持っているよ。"},
  {"en": "Write tidy too", "to": "tidy も かく", "kanji": "tidy も書く"},
  {"en": "Your bag counts and tidies itself with your total() and tidy().", "to": "きみの かばんは、きみの total() と tidy() で かずを かぞえて、じぶんで かたづくよ。", "kanji": "君の鞄は、君の total() と tidy() で数を数えて、自分でかたづくよ。"},
  {"en": "an empty bag", "to": "からっぽの かばん", "kanji": "空っぽの鞄"},
  {"en": "count", "to": "かず", "kanji": "数"},
  {"en": "item", "to": "もちもの", "kanji": "持ち物"},
  {"en": "one stack", "to": "スタック 1つ", "kanji": "スタック 1つ"},
  {"en": "sort by", "to": "ならべる もと", "kanji": "並べる元"},
  {"en": "three stacks", "to": "スタック 3つ", "kanji": "スタック 3つ"},
  {"en": "three stacks already in order", "to": "もう ならんで いる スタック 3つ", "kanji": "もう並んでいるスタック 3つ"},
  {"en": "three stacks, not in order", "to": "ならんで いない スタック 3つ", "kanji": "並んでいないスタック 3つ"},
  {"en": "{name} is out of order. The stacks go from A to Z by item name.", "to": "{name} が じゅんばんどおりに なって いないよ。スタックは、もちもの の なまえで A から Z の じゅんに ならぶよ。", "kanji": "{name} が順番どおりになっていないよ。スタックは、持ち物の名前で A から Z の順に並ぶよ。"},
  // tasks/tidy: the comments of the starter code
  {"en": "Give back how many things the bag holds, all the stacks' counts added together.", "to": "かばんに はいって いる もの の かずを かえしてね。スタック ぜんぶの かずを たした ものだよ。", "kanji": "鞄に入っているものの数を返してね。スタック全部の数を足したものだよ。"},
  {"en": "bag is your bag: a list of stacks, each {\"item\": ..., \"count\": ...}.", "to": "bag は きみの かばん。スタックの リストで、それぞれ {\"item\": ..., \"count\": ...} だよ。", "kanji": "bag は君の鞄。スタックのリストで、それぞれ {\"item\": ..., \"count\": ...} だよ。"},
  {"en": "bag is your bag: a list of stacks, each {item: ..., count: ...}.", "to": "bag は きみの かばん。スタックの リストで、それぞれ {item: ..., count: ...} だよ。", "kanji": "bag は君の鞄。スタックのリストで、それぞれ {item: ..., count: ...} だよ。"}
]
