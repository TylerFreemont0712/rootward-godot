[
  // Japanese for Lanternroot (ADR-0055): its screens, villagers and letters, keyed by the English (ADR-0047).
  // Code in backticks stays code; names inside tests ("Dear Mabel,") are data and are never translated.
  {"en": "LANTERNROOT", "to": "ともしび村"},
  {"en": "The watch is checking...", "to": "見張り番がしらべているよ…"},
  {"en": "Run the tests", "to": "テストを動かす"},
  {"en": "%d of %d tests passed", "to": "テスト {2} こ中 {1} こ合格"},
  {"en": "‹ Back to town", "to": "‹ 村にもどる"},
  {"en": "+ New file", "to": "+ 新しいファイル"},
  {"en": "A file of your own becomes a workshop in town.", "to": "自分で作ったファイルは、村の工房になるよ。"},
  {"en": "Ctrl+Enter", "to": "Ctrl+Enter"},
  {"en": "A hint", "to": "ヒント"},
  {"en": "Last night's version", "to": "ゆうべの版にもどす"},
  {"en": "Put this file back the way the Night Watch last saw it.", "to": "このファイルを、夜の見張り番が最後に見たときの形にもどすよ。"},
  {"en": "No letter is open. Edit freely, then ring the night bell.", "to": "ひらいている手紙はないよ。自由に書きかえて、夜の鐘を鳴らそう。"},
  {"en": "From %s, %s", "to": "{2}の{1}より"},
  {"en": "WHAT TO BUILD", "to": "作るもの"},
  {"en": "EXAMPLES", "to": "例"},
  {"en": "The Night Watch will also check: %s.", "to": "夜の見張り番はこれもしらべるよ：%s。"},
  {"en": "Hint %d", "to": "ヒント %d"},
  {"en": "A hint (%d left)", "to": "ヒント（のこり %d）"},
  {"en": "No more hints", "to": "ヒントはもうないよ"},
  {"en": "gave back `%s`, as expected", "to": "`%s` を返した。思ったとおり！"},
  {"en": "expected `%s`, but got `%s`", "to": "`{1}` のはずが、`{2}` が返ってきた"},
  {"en": " (%s, line %d)", "to": "（%s の %d 行目）"},
  {"en": "It printed:", "to": "表示したもの："},
  {"en": "Back to town", "to": "村にもどる"},
  {"en": "✦ The lantern is lit!", "to": "✦ ランタンがともった！"},
  {"en": "Day %d: %s", "to": "%d 日目：%s"},
  {"en": "DAY %d OF %d", "to": "{2} 日のうち {1} 日目"},
  {"en": "✦ Every lantern in Lanternroot is lit.", "to": "✦ ともしび村のランタンが、ぜんぶともった。"},
  {"en": "The hamlet runs on your program. Deeper in the roots, more villages are waiting.", "to": "村はきみのプログラムで動いている。根っこのもっと奥で、ほかの村も待っているよ。"},
  {"en": "GREMLINS", "to": "グレムリン"},
  {"en": "Fix the code, then run its tests at the workbench to chase each gremlin out.", "to": "コードを直して、作業台でテストを動かすと、グレムリンを追い出せるよ。"},
  {"en": "A gremlin in %s", "to": "%s にグレムリン"},
  {"en": "“%s” no longer works", "to": "「%s」が動かなくなった"},
  {"en": "LETTERS", "to": "手紙"},
  {"en": "NO LETTERS WAITING", "to": "待っている手紙はないよ"},
  {"en": "From %s · %s", "to": "{1}より · {2}"},
  {"en": "Ring the night bell", "to": "夜の鐘を鳴らす"},
  {"en": "The Night Watch reruns every test in town against the code as it is now.", "to": "夜の見張り番は、いまのコードで村じゅうのテストをもう一度動かすよ。"},
  {"en": "Build a workshop of your own", "to": "自分の工房を建てる"},
  {"en": "Visit the %s town", "to": "%s の村へ行く"},
  {"en": "Each language has its own town, with its own code.", "to": "言語ごとに、それぞれの村とコードがあるよ。"},
  {"en": "Back to the surface", "to": "地上にもどる"},
  {"en": "Lanterns lit: %d of %d · Houses: %d · Bridges: %d · %s", "to": "ランタン {2} こ中 {1} こ · 家 {3} けん · 橋 {4} 本 · {5}"},
  {"en": "NIGHT %d", "to": "%d 晩目"},
  {"en": "Every lantern held.", "to": "ランタンはぜんぶ消えなかった。"},
  {"en": "%d lanterns went dark.", "to": "ランタンが %d こ消えた。"},
  {"en": "The Night Watch ran %d tests: %d held, %d failed.", "to": "夜の見張り番はテストを {1} こ動かした：{2} こ合格、{3} こ失敗。"},
  {"en": "A gremlin got into `%s`: “%s” no longer works (`%s`).", "to": "`{1}` にグレムリンが入った：「{2}」が動かなくなった（`{3}`）。"},
  {"en": "Something changed in town today and broke code that used to work. That is what a test suite is for.", "to": "今日どこかが変わって、前は動いていたコードがこわれた。テストはこれを見つけるためにあるんだ。"},
  {"en": "The gremlin left %s.", "to": "グレムリンは「%s」から出ていった。"},
  {"en": "The Lantern Festival begins!", "to": "ランタン祭りのはじまり！"},
  {"en": "Every house, every bridge and every lantern is code you wrote, tested every night. This is a program.", "to": "家も、橋も、ランタンも、ぜんぶきみが書いて、毎晩テストしたコード。これがプログラムだよ。"},
  {"en": "Day %d dawns: %s", "to": "%d 日目の朝：%s"},
  {"en": "Today's letters are still waiting. The day goes on.", "to": "今日の手紙がまだ待っているよ。一日はつづく。"},
  {"en": "Good morning", "to": "おはよう"},
  {"en": "A HAMLET IN THE ROOTS", "to": "根っこの中の小さな村"},
  {"en": "Welcome to Lanternroot", "to": "ともしび村へようこそ"},
  {"en": "The sandbox is not installed, so no code can run (scripts/fetch-sandbox.sh).", "to": "サンドボックスが入っていないので、コードを動かせないよ（scripts/fetch-sandbox.sh）。"},
  {"en": "Which language will your town speak?", "to": "きみの村は、どの言語を話す？"},
  {"en": "A WORKSHOP OF YOUR OWN", "to": "自分の工房"},
  {"en": "Name your new file", "to": "新しいファイルに名前をつけよう"},
  {"en": "Helpers you write here can be imported by any house. Lowercase letters, digits and _.", "to": "ここに書いたお助け関数は、どの家からでも import できるよ。小文字、数字、_ が使えるよ。"},
  {"en": "Build it", "to": "建てる"},
  {"en": "a letter waits", "to": "手紙が待っている"},
  {"en": "Your workshop", "to": "きみの工房"},
  {"en": "It never finished. Is there a loop whose condition never becomes false?", "to": "終わらなかった。条件がずっと false にならないループはないかな？"},
  {"en": "The Night Watch could not find this function. Check its name and spelling.", "to": "夜の見張り番がこの関数を見つけられなかった。名前とつづりを見てみよう。"},
  {"en": "This test did not run: an earlier one never finished.", "to": "このテストは動かなかった：前のテストが終わらなかったんだ。"},
  {"en": "It printed the answer but gave back nothing. Printing shows a value; return hands it back.", "to": "答えを表示したけど、何も返さなかった。print は見せるだけ、return が値を返すんだ。"},
  {"en": "It gave back nothing. Did the function reach a return?", "to": "何も返さなかった。関数は return までたどりついた？"},
  {"en": "Off by one! Look at the edges: < or <=, where a count starts, rounding.", "to": "1 つずれてる！ はしっこを見てみよう：< か <= か、数えはじめ、切り上げ。"},
  {"en": "It gave back a fraction where a whole number was expected.", "to": "整数のはずのところで、小数を返したよ。"},
  {"en": "It gave back something else. Try this example by hand, step by step.", "to": "ちがうものを返したよ。この例を、手で一歩ずつためしてみよう。"},
  {"en": "A name it uses is not defined here. Check the spelling, or whether it needs an import.", "to": "使っている名前が、ここでは決まっていないよ。つづりを見るか、import がいるか考えよう。"},
  {"en": "Python could not read this line. Check colons, brackets and indentation.", "to": "Python がこの行を読めなかった。コロン、かっこ、字下げを見てみよう。"},
  {"en": "JavaScript could not read this line. Check brackets, braces and quotes.", "to": "JavaScript がこの行を読めなかった。かっこ、波かっこ、クォートを見てみよう。"},
  {"en": "Something here is empty (None or undefined). Did a function you call forget to return?", "to": "どこかが空っぽ（None か undefined）だよ。呼んだ関数が return をわすれていない？"},
  {"en": "Two values of different kinds were mixed, like a number and text.", "to": "数と文字のように、ちがう種類の値がまざったよ。"},
  {"en": "It divided by zero. Which input makes the divisor 0?", "to": "0 でわり算したよ。どの入力で、わる数が 0 になる？"},
  {"en": "A function kept calling itself. Where does it stop?", "to": "関数が自分を呼びつづけた。どこで止まるのかな？"},
  {"en": "It reached past the end of a list. Lists start at 0 and end one before their length.", "to": "リストのおわりの先に手をのばしたよ。リストは 0 からはじまって、長さの 1 つ手前でおわるんだ。"},
  {"en": "It looked up a key that is not in the dictionary yet. What should happen the first time?", "to": "まだ辞書にないキーを探したよ。はじめての時はどうするのがいいかな？"},
  {"en": "An import could not be found. Check the module's name: it is the house's file name.", "to": "import するものが見つからなかった。モジュールの名前は、家のファイル名だよ。"},
  {"en": "That value has no such attribute or method. Check what kind of value it is.", "to": "その値には、そんな属性やメソッドはないよ。どんな種類の値か見てみよう。"},
  {"en": "It raised an error. Read the message and the line it points at.", "to": "エラーが出たよ。メッセージと、指している行を読んでみよう。"},
  {"en": "Use lowercase letters, digits and _ and start with a letter.", "to": "小文字、数字、_ を使って、文字からはじめてね。"},
  {"en": "That name belongs to a standard module; your file would hide it.", "to": "その名前は標準モジュールのものだよ。きみのファイルがそれをかくしてしまう。"},
  {"en": "There is already a house with that name.", "to": "その名前の家はもうあるよ。"},
  {"en": "Below the surface station, a little hamlet hangs in the roots. Its lanterns went out when the old tinker left.", "to": "地上の駅の下、根っこの中に小さな村がぶらさがっている。むかしの修理屋さんがいなくなって、ランタンは消えてしまった。"},
  {"en": "Villagers will send you letters. Each asks for one function. Write it in real code and run its tests: when they pass, a lantern is lit.", "to": "村の人たちから手紙がとどくよ。どの手紙も、関数を 1 つたのんでいる。本物のコードで書いてテストを動かそう。合格すると、ランタンがともるよ。"},
  {"en": "Every file you write becomes a house, and every import a rope bridge between two houses. The whole town is one program: yours.", "to": "書いたファイルはひとつずつ家になり、import は家と家をつなぐつり橋になる。村ぜんたいが 1 つのプログラム、きみのプログラムだよ。"},
  {"en": "Each night the Night Watch reruns every test in town. If a change broke something that used to work, a gremlin moves in.", "to": "毎晩、夜の見張り番が村じゅうのテストをもう一度動かす。前は動いていたものがこわれたら、グレムリンがすみつくよ。"},
  {"en": "Ring the night bell: the Night Watch checks the town, and a new day brings new letters.", "to": "夜の鐘を鳴らそう。夜の見張り番が村をしらべて、新しい日には新しい手紙がとどくよ。"},
  {"en": "Wick", "to": "ウィック"},
  {"en": "the lamplighter", "to": "ランタンつけ"},
  {"en": "Mabel", "to": "メイベル"},
  {"en": "the baker", "to": "パン屋さん"},
  {"en": "Quill", "to": "クイル"},
  {"en": "the postmaster", "to": "郵便局長"},
  {"en": "Bramble", "to": "ブランブル"},
  {"en": "the grocer", "to": "八百屋さん"},
  {"en": "Old Tamsin", "to": "タムシンおばあさん"},
  {"en": "the miller", "to": "粉ひき屋さん"},
  {"en": "Everyone", "to": "みんな"},
  {"en": "the whole hamlet", "to": "村じゅう"},
  {"en": "Lamplighter's Loft", "to": "ランタンつけの屋根裏"},
  {"en": "The Bakery", "to": "パン屋"},
  {"en": "The Post Office", "to": "郵便局"},
  {"en": "The Market", "to": "市場"},
  {"en": "The Mill", "to": "粉ひき小屋"},
  {"en": "The Festival Hall", "to": "お祭りホール"},
  {"en": "First Light", "to": "はじめてのあかり"},
  {"en": "The hamlet is dark. Three letters are pinned to your door.", "to": "村はまっくら。きみのドアに、手紙が 3 通とめてある。"},
  {"en": "Bridges", "to": "橋"},
  {"en": "Word spreads: the new tinker's code works. More letters arrive.", "to": "うわさが広まった。新しい修理屋さんのコードはちゃんと動くって。手紙がもっととどくよ。"},
  {"en": "The Mill Wakes", "to": "粉ひき小屋が目をさます"},
  {"en": "The old mill creaks. And Mabel has a new oven.", "to": "古い粉ひき小屋がきしむ。それに、メイベルには新しいかまどが来た。"},
  {"en": "The Lantern Festival", "to": "ランタン祭り"},
  {"en": "Tonight is the festival. Everything you built must work together.", "to": "今夜はお祭り。きみが作ったものが、ぜんぶいっしょに動かなきゃ。"},
  {"en": "The new oven (a change)", "to": "新しいかまど（へんこう）"},
  {"en": "Oh Tinker, look! My new oven bakes great big loaves, and one of those feeds 6. But I still bake the small ones too. Could `loaves_for` be told how many guests a loaf feeds? And when nobody tells it, it should go on thinking 4, because Bramble's market asks it every day and I'd hate to upset Bramble.", "to": "修理屋さん、見て！ 新しいかまどは大きなパンが焼けるの。大きいのは 1 つで 6 人ぶん。でも小さいのもまだ焼くのよ。`loaves_for` に、パン 1 つで何人ぶんか教えられるようにできる？ だれも教えないときは、今までどおり 4 と思っていてほしいの。ブランブルの市場が毎日聞いてくるから、ブランブルをこまらせたくないのよ。"},
  {"en": "Changing a function other code depends on is where real programs break. A default parameter keeps every old caller working, and the Night Watch (your test suite) is how you know for sure: it reruns the market's tests too. That safety net is called regression testing.", "to": "ほかのコードがたよっている関数を変えるところで、本物のプログラムはこわれる。デフォルト引数があれば、前からの呼び出しはそのまま動く。それをたしかめるのが夜の見張り番（きみのテスト）。市場のテストももう一度動かすからね。このあんぜんネットを「回帰テスト」というんだ。"},
  {"en": "default parameters", "to": "デフォルト引数"},
  {"en": "changing code safely", "to": "あんぜんにコードを変える"},
  {"en": "This is a change to code that already works and that the market relies on. Which callers pass one value, and which will pass two?", "to": "これは、もう動いていて、市場がたよっているコードへのへんこうだよ。値を 1 つわたす呼び出しはどれ？ 2 つわたすのは？"},
  {"en": "A parameter can have a default: `def loaves_for(guests, per_loaf=4):` in Python, `function loavesFor(guests, perLoaf = 4)` in JavaScript. Callers that leave it out get the default.", "to": "引数にはデフォルトをつけられる。Python なら `def loaves_for(guests, per_loaf=4):`、JavaScript なら `function loavesFor(guests, perLoaf = 4)`。わたさなかった呼び出しには、デフォルトが使われるよ。"},
  {"en": "Add the new parameter with its default, then replace every 4 inside the function with it. When you light this lantern, ring the night bell and see whether Bramble's market still works.", "to": "新しい引数をデフォルトつきで足して、関数の中の 4 をぜんぶそれにおきかえよう。このランタンをともしたら、夜の鐘を鳴らして、ブランブルの市場がまだ動くか見てみよう。"},
  {"en": "small loaves when nobody says", "to": "だれも言わなければ小さいパン"},
  {"en": "a loaf for each guest", "to": "お客さん 1 人にパン 1 つ"},
  {"en": "a giant loaf", "to": "ものすごく大きいパン"},
  {"en": "still nobody comes", "to": "やっぱりだれも来ない"},
  {"en": "A week of bread", "to": "1 週間ぶんのパン"},
  {"en": "Tinker, it's Bramble again. I order bread from Mabel for the whole week at once. I'll give you a list: how many guests come to the market each day. Tell me how many loaves to order in total. Now, Mabel's oven already knows how many loaves a day's guests need. Don't make it count twice; ask her bakery. Build a bridge!", "to": "修理屋、またブランブルだ。メイベルのパンは 1 週間ぶんまとめてたのむんだ。毎日、市場に何人お客が来るかのリストをわたすから、ぜんぶでパンをいくつたのめばいいか教えてくれ。それとな、1 日のお客にパンがいくついるかは、メイベルのかまどがもう知ってる。2 回数えさせないで、パン屋に聞いてくれ。橋をかけるんだ！"},
  {"en": "That import is a bridge in your town: the market now depends on the bakery. Reusing code means it is written (and fixed) in one place. It also means a change in the bakery reaches the market, and the Night Watch will check that it still works.", "to": "その import が村の橋。市場はいま、パン屋にたよっている。コードを使い回すと、書くのも直すのも 1 か所ですむ。でもそのぶん、パン屋の変化は市場にもとどく。だから夜の見張り番が、まだ動くかしらべてくれるんだ。"},
  {"en": "imports", "to": "import"},
  {"en": "reusing your code", "to": "コードの使い回し"},
  {"en": "You already wrote the hard part yesterday: `loaves_for` in the bakery. How can the market use it?", "to": "むずかしいところは、きのうもう書いたね。パン屋の `loaves_for` だ。市場からそれを使うには？"},
  {"en": "Code in one file can use another file's functions. In Python: `from bakery import loaves_for`. In JavaScript: `const { loavesFor } = require(\"./bakery\");`. Put it at the top of the market.", "to": "あるファイルのコードは、ほかのファイルの関数を使える。Python なら `from bakery import loaves_for`、JavaScript なら `const { loavesFor } = require(\"./bakery\");`。市場のいちばん上に書こう。"},
  {"en": "Loop over the days, ask the bakery for each day's loaves, and add them up. Note that rounding up each day is not the same as rounding up the week's total.", "to": "日ごとにループして、その日のパンの数をパン屋に聞いて、足していこう。毎日切り上げるのと、1 週間の合計を切り上げるのは、同じじゃないよ。"},
  {"en": "a closed week", "to": "お休みの週"},
  {"en": "rounding up every single day", "to": "毎日切り上げ"},
  {"en": "a quiet day in the middle", "to": "真ん中にしずかな日"},
  {"en": "To our Tinker, from all of us. Tonight is the Lantern Festival! Here is the guest list. We need one plan with three things in it: \"loaves\", how many small loaves for everyone; \"oil\", oil for one lamp per guest; and \"letters\", an invitation opening for each guest, in order. Everything you built for us is already in town. Put it together in a new Festival Hall.", "to": "わたしたちの修理屋さんへ、みんなより。今夜はランタン祭り！ これがお客さんのリスト。3 つのことが入った計画が 1 つほしいの。\"loaves\"：みんなのぶんの小さいパンの数。\"oil\"：お客さん 1 人にランタン 1 つぶんの油。\"letters\"：お客さんごとの招待状の書き出し、順番どおり。きみが作ってくれたものは、もうぜんぶ村にある。新しいお祭りホールで、組み合わせて。"},
  {"en": "This is how programs grow: small pieces, each tested on its own, put together into something bigger. Look at the town: the Festival Hall has bridges to three houses. That picture is your program's dependency graph, and you built every part of it.", "to": "プログラムはこうして大きくなる。1 つずつテストした小さな部品を、組み合わせてもっと大きなものにする。村を見てごらん。お祭りホールから 3 けんの家に橋がかかっている。その絵がきみのプログラムの「依存グラフ」。ぜんぶきみが作ったんだよ。"},
  {"en": "composing modules", "to": "モジュールを組み合わせる"},
  {"en": "dictionaries", "to": "辞書"},
  {"en": "a whole program", "to": "1 つのプログラム"},
  {"en": "Count how many functions you already have that answer part of this. Which modules do you need to import from?", "to": "この一部に答えられる関数が、もういくつあるか数えよう。どのモジュールから import すればいい？"},
  {"en": "Three imports (lamps, bakery, post) and a dictionary (an object in JavaScript) with three keys. How many guests are there? `len(guests)` or `guests.length`.", "to": "import が 3 つ（lamps、bakery、post）と、キーが 3 つの辞書（JavaScript ならオブジェクト）。お客さんは何人？ `len(guests)` か `guests.length`。"},
  {"en": "Import the three functions, count the guests, then return a dictionary: loaves from the bakery, oil from the lamps, and a list with one greeting per guest.", "to": "3 つの関数を import して、お客さんを数えて、辞書を return しよう。パンはパン屋から、油はランタンから、それとお客さんごとのあいさつのリスト。"},
  {"en": "nobody is invited", "to": "だれも招待しない"},
  {"en": "A proper greeting", "to": "きちんとしたあいさつ"},
  {"en": "To the Tinker. Quill, postmaster. Every letter in this hamlet begins the same way: \"Dear\", a space, the name, and a comma. I have written it by hand four thousand times. Build a function that is given a name and returns the opening line, exactly. Exactly, Tinker.", "to": "修理屋どのへ。郵便局長のクイルです。この村の手紙は、みな同じように始まる。\"Dear\"、スペース、名前、そしてコンマ。わたしは手で 4000 回も書いた。名前をわたすと、書き出しの行をそのとおりに返す関数を作ってほしい。そのとおりに、ですぞ。"},
  {"en": "Strings are text, and building them from pieces is half of all programs. Tests compare them character by character, which is why Quill's \"exactly\" matters: a missing space is a different answer.", "to": "文字列はテキスト。かけらから組み立てるのは、プログラムの仕事の半分くらい。テストは 1 文字ずつくらべるから、クイルの「そのとおりに」が大事なんだ。スペースが 1 つ足りないだけで、ちがう答えになるよ。"},
  {"en": "strings", "to": "文字列"},
  {"en": "joining text", "to": "文字をつなぐ"},
  {"en": "The answer is text built from three pieces: the word before, the name, the comma after.", "to": "答えは 3 つのかけらでできた文字列。前のことば、名前、うしろのコンマ。"},
  {"en": "Text joins with `+`. Python also has f-strings (`f\"...{name}...\"`) and JavaScript has template literals (`` `...${name}...` ``).", "to": "文字は `+` でつなげるよ。Python には f 文字列（`f\"...{name}...\"`）、JavaScript にはテンプレートリテラル（`` `...${name}...` ``）もある。"},
  {"en": "Quill said exactly: check the space after \"Dear\" and the comma at the end. A test compares every character.", "to": "クイルは「そのとおりに」と言ったね。\"Dear\" のあとのスペースと、さいごのコンマを見よう。テストは 1 文字ずつくらべるよ。"},
  {"en": "a long name", "to": "長い名前"},
  {"en": "a one-letter name", "to": "1 文字の名前"},
  {"en": "Oil for the lamps", "to": "ランタンの油"},
  {"en": "Dear Tinker, welcome! I am Wick, and I light the lamps. Every lamp burns 3 drops of oil a night. Could you build me a function that is given how many lamps there are and hands back how many drops I need? Then I can ask it every evening instead of counting on my claws.", "to": "修理屋さん、ようこそ！ ぼくはウィック、ランタンをつける係だよ。ランタンは 1 晩に油を 3 てき使うんだ。ランタンの数をわたすと、いる油のしずくの数を返してくれる関数を作ってくれない？ そうすれば毎晩、つめで数えなくてもすむから。"},
  {"en": "A function names a piece of work. Its parameter is what it is given, and `return` is what it gives back. From now on, any part of town can ask lamps how much oil it needs, without knowing how it counts.", "to": "関数は、ひとまとまりの仕事に名前をつけたもの。引数はわたされるもの、`return` は返すもの。これからは村のどこからでも、数え方を知らなくても lamps に油の量を聞けるよ。"},
  {"en": "functions", "to": "関数"},
  {"en": "return", "to": "return（返す）"},
  {"en": "A function is a little machine: something goes in (the parameter), something comes out. What should come out for 2 lamps?", "to": "関数は小さな機械。何かが入って（引数）、何かが出てくる。ランタンが 2 こなら、何が出てくればいい？"},
  {"en": "Printing a number shows it to you; `return` hands it back to whoever asked. Wick's code asks, so the answer must be returned.", "to": "数を print すると、きみに見えるだけ。`return` は、たずねた人に答えを返す。ウィックのコードがたずねるから、答えは return しなきゃ。"},
  {"en": "Multiply the number of lamps by the drops each one burns, and return the result.", "to": "ランタンの数に、1 こが使うしずくの数をかけて、その答えを return しよう。"},
  {"en": "a single lamp", "to": "ランタン 1 こ"},
  {"en": "no lamps at all", "to": "ランタンが 1 こもない"},
  {"en": "How many loaves?", "to": "パンはいくつ？"},
  {"en": "Hello dear! Mabel here, from the bakery. One loaf feeds 4 guests, and I never, ever want anyone left hungry. If 5 guests come, that is 2 loaves, crumbs to spare. Please make me a function: give it the number of guests, and it tells me how many loaves to bake.", "to": "こんにちは！ パン屋のメイベルよ。パン 1 つで、お客さん 4 人がおなかいっぱいになるの。だれ 1 人おなかをすかせてほしくないのよ。お客さんが 5 人なら、パンは 2 つ（少しあまるけど）。お客さんの数をわたすと、焼くパンの数を教えてくれる関数を作ってちょうだい。"},
  {"en": "Rounding up is a classic: whole-number division rounds down, so you add one when the remainder is not zero (or use a ceiling). You will meet it again whenever things come in boxes, pages or loaves.", "to": "切り上げは定番のわざ。整数のわり算は切り捨てになるから、あまりが 0 でなければ 1 たす（か ceil を使う）。箱やページやパンで数えるとき、また出会うよ。"},
  {"en": "arithmetic", "to": "計算"},
  {"en": "rounding up", "to": "切り上げ"},
  {"en": "Try it by hand: 8 guests is 8 / 4 = 2 loaves. What about 9 guests? Why is that 3 and not 2?", "to": "手でためそう。8 人なら 8 / 4 = 2 こ。9 人なら？ どうして 2 じゃなくて 3 なのかな？"},
  {"en": "Plain division gives 2.25 for 9 guests. Whole-number division (`//` in Python, `Math.floor` in JavaScript) rounds down. Mabel needs rounding up when anything is left over.", "to": "ふつうのわり算だと 9 人は 2.25。整数のわり算（Python の `//`、JavaScript の `Math.floor`）は切り捨て。メイベルは、あまりがあれば切り上げてほしいんだ。"},
  {"en": "Divide, then check whether there was a remainder (the `%` operator). If there was, bake one more loaf.", "to": "わり算して、あまりがあるか（`%` 演算子）を見よう。あったら、パンをもう 1 つ焼こう。"},
  {"en": "exactly one loaf's worth", "to": "ちょうどパン 1 つぶん"},
  {"en": "a single guest", "to": "お客さん 1 人"},
  {"en": "nobody comes", "to": "だれも来ない"},
  {"en": "a big wedding", "to": "大きな結婚式"},
  {"en": "Adding up the basket", "to": "かごの合計"},
  {"en": "Oi, Tinker! Bramble, from the market stall. Customers pile things in their baskets and I lose count. I'll give your function a list of prices, one for each thing in the basket, and you give me back the total. Some folk bring an empty basket just to chat, mind.", "to": "よう、修理屋！ 市場のブランブルだ。お客がかごに山ほど入れるもんで、数がわからなくなっちまう。かごの品物 1 つにつき 1 つ、値段のリストを関数にわたすから、合計を返してくれ。おしゃべりしに空のかごで来るやつもいるから、気をつけてな。"},
  {"en": "Start a variable, update it once per item, use it after the loop: this pattern is called an accumulator, and you will write it a thousand times (Python's `sum` is one built in). Starting at 0 is what makes the empty basket work.", "to": "変数を用意して、1 こごとに更新して、ループのあとで使う。この形は「アキュムレータ（ためこみ）」とよばれて、何千回も書くことになるよ（Python の `sum` は組みこみのアキュムレータ）。0 からはじめるから、空のかごでもうまくいくんだ。"},
  {"en": "lists", "to": "リスト"},
  {"en": "loops", "to": "ループ"},
  {"en": "accumulators", "to": "ためこみ（アキュムレータ）"},
  {"en": "Imagine Bramble adding by hand: start at nothing, then add each price in turn. What is the running total before the first price?", "to": "ブランブルが手で足すところを思いうかべて。何もないところから、値段を 1 つずつ足していく。さいしょの値段の前、合計はいくつ？"},
  {"en": "A loop visits every item of a list: `for price in prices:` in Python, `for (const price of prices)` in JavaScript. A variable outside the loop can collect the sum.", "to": "ループはリストの品物を 1 つずつまわるよ。Python なら `for price in prices:`、JavaScript なら `for (const price of prices)`。ループの外の変数に合計をためられる。"},
  {"en": "Start a total at 0 before the loop, add each price to it inside the loop, and return it after the loop ends.", "to": "ループの前に合計を 0 にして、ループの中で値段を足して、ループがおわったら return しよう。"},
  {"en": "an empty basket", "to": "空のかご"},
  {"en": "a heavy shop", "to": "たくさんの買い物"},
  {"en": "a free sample (0 coins)", "to": "ただの試食（コイン 0 まい）"},
  {"en": "Who keeps watch?", "to": "見張りはだれ？"},
  {"en": "Tinker! Wick again. Someone must keep watch over the lamps each night, and we take turns, in order, round and round. Give your function the names, in order, and how many nights to plan. It should hand back a list with one name per night. With Wick and Mabel for three nights, that is Wick, Mabel, Wick.", "to": "修理屋さん！ またウィックだよ。毎晩だれかがランタンを見張らなきゃいけなくて、順番にぐるぐる交代してるんだ。関数に名前を順番どおりと、何晩ぶん決めるかをわたすから、1 晩に 1 人の名前のリストを返してね。ウィックとメイベルで 3 晩なら、Wick、Mabel、Wick だよ。"},
  {"en": "`%` wraps a counter around a fixed size: clocks, turns, rotas, ring buffers. Building a list one item per loop pass is the accumulator again, with a list instead of a number.", "to": "`%` は、数を決まった大きさでぐるっと回す。時計、順番、当番表、リングバッファ。ループ 1 回につき 1 つずつリストを作るのは、数のかわりにリストを使ったアキュムレータだね。"},
  {"en": "remainder (%)", "to": "あまり（%）"},
  {"en": "building a list", "to": "リストを作る"},
  {"en": "Write out night 0, 1, 2, 3, 4 for three names. Which name's position does each night use?", "to": "名前が 3 つのとき、0、1、2、3、4 晩目を書き出してみよう。それぞれの晩は、何番目の名前を使う？"},
  {"en": "The remainder operator `%` wraps a number around: `night % 3` goes 0, 1, 2, 0, 1, 2... Use it to turn a night number into a position in the names list.", "to": "あまりの演算子 `%` は数をぐるっと回す。`night % 3` は 0、1、2、0、1、2…となる。これで晩の番号を、名前リストの位置に変えよう。"},
  {"en": "Start an empty list, loop over the night numbers (`range(nights)` in Python, a counting `for` loop in JavaScript), append the name at position night % len(names), and return the list.", "to": "空のリストからはじめて、晩の番号でループして（Python なら `range(nights)`、JavaScript なら数える `for` ループ）、night % len(names) の位置の名前を足して、リストを return しよう。"},
  {"en": "no nights to plan", "to": "決める晩がない"},
  {"en": "only one volunteer", "to": "やってくれるのは 1 人だけ"},
  {"en": "fewer nights than names", "to": "名前より晩が少ない"},
  {"en": "Stamps by weight", "to": "重さで切手"},
  {"en": "Tinker. Your greeting is acceptable. Next: stamps. A letter of 10 grams or less costs 2 coins. Up to 50 grams costs 5. Anything heavier costs 9. Add a function to the post office that is given the weight and returns the price. Mind the edges; the moles always weigh their letters to exactly 10.", "to": "修理屋どの。あいさつは合格です。つぎは切手。10 グラム以下の手紙はコイン 2 まい。50 グラムまでは 5 まい。それより重いと 9 まい。重さをわたすと値段を返す関数を、郵便局に足してほしい。はしっこに気をつけて。モグラたちはいつも、ちょうど 10 グラムに合わせてくるのです。"},
  {"en": "A chain of conditions is checked top to bottom, and the first one that holds wins. Bugs love the edges: 10 exactly, 50 exactly. Checking values right at a boundary is the cheapest way to catch an off-by-one.", "to": "条件のならびは上から順にしらべられて、さいしょに当てはまったものが勝つ。バグははしっこが大好き。ちょうど 10、ちょうど 50。さかい目の値をためすのが、1 つずれのバグを見つけるいちばんかんたんな方法だよ。"},
  {"en": "if / elif / else", "to": "if / elif / else"},
  {"en": "boundaries", "to": "さかい目"},
  {"en": "There are three prices, so there are three cases. Which question do you ask first?", "to": "値段が 3 つあるから、場合も 3 つ。さいしょにどの質問をする？"},
  {"en": "`if`, then `elif` (`else if` in JavaScript), then `else`: the first true condition wins and the rest are skipped. \"10 grams or less\" is `<=`, not `<`.", "to": "`if`、つぎに `elif`（JavaScript では `else if`）、さいごに `else`。さいしょに true になった条件が勝って、のこりはとばされる。「10 グラム以下」は `<` じゃなくて `<=` だよ。"},
  {"en": "Ask about the lightest band first (10 or less), then the middle band (50 or less), and let everything else fall through to the last price.", "to": "まずいちばん軽いはんい（10 以下）、つぎに真ん中（50 以下）を聞いて、ほかはぜんぶさいごの値段にまかせよう。"},
  {"en": "exactly 10 grams", "to": "ちょうど 10 グラム"},
  {"en": "just over 10 grams", "to": "10 グラムをちょっとこえる"},
  {"en": "exactly 50 grams", "to": "ちょうど 50 グラム"},
  {"en": "a feather (0 grams)", "to": "羽 1 まい（0 グラム）"},
  {"en": "Whose sacks are these?", "to": "このふくろはだれの？"},
  {"en": "Young Tinker. The mill has woken, and so have the sacks. Every sack of grain has its owner's name chalked on it, and they come to me in one long jumble. Give me a function: I hand it the list of names, one per sack, and it tells me how many sacks belong to each name. A table of name and count, if you please.", "to": "若い修理屋さんや。粉ひき小屋が目をさまして、ふくろたちも目をさましたよ。穀物のふくろには、持ち主の名前がチョークで書いてある。それが長い長いごちゃまぜで、わたしのところにとどくのさ。ふくろ 1 つにつき名前 1 つのリストをわたすから、名前ごとにふくろがいくつあるか教えておくれ。名前と数の表でたのむよ。"},
  {"en": "A dictionary finds a value by its key in one step, however big it grows. Counting things by name is one of its most common jobs; Python even has `collections.Counter` for exactly this.", "to": "辞書は、どんなに大きくなっても、キーから値を 1 歩で見つけられる。名前ごとに数えるのは、辞書のいちばんよくある仕事の 1 つ。Python にはそのための `collections.Counter` まであるんだ。"},
  {"en": "counting", "to": "数える"},
  {"en": "You need a table that maps a name to a number. Python calls it a dictionary (`{}`), JavaScript an object (`{}`).", "to": "名前から数を引ける表がいるね。Python では辞書（`{}`）、JavaScript ではオブジェクト（`{}`）とよぶよ。"},
  {"en": "For each sack, look the name up: if it is not in the table yet, its count starts at 0. Then add one. (`counts.get(name, 0)` in Python; `(counts[name] || 0)` in JavaScript.)", "to": "ふくろごとに名前を探そう。まだ表になければ、数は 0 からはじまる。それから 1 たす。（Python なら `counts.get(name, 0)`、JavaScript なら `(counts[name] || 0)`。）"},
  {"en": "Start with an empty table, loop over the sacks, add one to that name's count each time, and return the table.", "to": "空の表からはじめて、ふくろをループして、そのたびにその名前の数を 1 ふやし、表を return しよう。"},
  {"en": "no sacks today", "to": "今日はふくろなし"},
  {"en": "all one owner", "to": "ぜんぶ同じ持ち主"},
  {"en": "a long jumble", "to": "長いごちゃまぜ"},
  {"en": "Chase out the gremlins, then ring the night bell.", "to": "グレムリンを追い出してから、夜の鐘を鳴らそう。"}
]
