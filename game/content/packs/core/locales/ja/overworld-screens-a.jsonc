// Japanese for Lanternroot's coding editors (ADR-0061, Concept/v0.4/06): the boots and lesson editors, the Hints
// column's explanations of code words, Hotaru's feedback on the lessons, the things' messages and the starter
// comments. Keyed by the English exactly (ADR-0047). Code (on_key, onKey, x, y, dictionary, list, return, Esc)
// stays English; the placeholders (%s, %d) stay as they are.
[
  {"en": "Called every time you press a key.", "to": "キーを おす たびに よばれるよ。", "kanji": "キーを押すたびに呼び出されます。"},
  {"en": "key is \"up\", \"down\", \"left\" or \"right\". player.x and player.y are where you stand.", "to": "key は \"up\"、\"down\"、\"left\"、\"right\" の どれかだよ。player.x と player.y は、きみが いる ばしょだよ。", "kanji": "key は \"up\"、\"down\"、\"left\"、\"right\" のいずれかです。player.x と player.y は現在の座標です。"},
  {"en": "Take this rule away", "to": "この ルールを けす", "kanji": "このルールを削除"},
  {"en": "Build with blocks, and see the code they make.", "to": "ブロックで つくって、できる コードを みてみよう。", "kanji": "ブロックを組み合わせ、生成されるコードを確認できます。"},
  {"en": "Builder", "to": "ブロックで つくる", "kanji": "ブロックで作る"},
  {"en": "Scribe", "to": "コードを かく", "kanji": "コードを書く"},
  {"en": "The code your blocks make", "to": "ブロックが つくる コード", "kanji": "ブロックが作るコード"},
  {"en": "Type the code yourself.", "to": "じぶんで コードを かこう。", "kanji": "自分でコードを入力します。"},
  {"en": "Type your code here. Ctrl+Enter tries it.", "to": "ここに コードを かいてね。Ctrl+Enter で ためせるよ。", "kanji": "ここにコードを入力します。Ctrl+Enter で試せます。"},
  {"en": "What each key does", "to": "それぞれの キーの はたらき", "kanji": "各キーの動作"},
  {"en": "A dictionary: names, each with a value, between braces and separated by commas.", "to": "辞書：なまえと あたいの ペアを、{ } で かこんで、コンマで わけた もの。", "kanji": "辞書。キーと値の組を { } で囲み、コンマで区切って並べます。"},
  {"en": "A dot reaches a field inside a thing.", "to": ". は、もの の なかの ぶぶんに とどく しるしだよ。", "kanji": "ドット（.）で、オブジェクト内のフィールドを参照します。"},
  {"en": "A lamp's name, as text, like Moss.", "to": "ランタンの なまえ。もじで かくよ。たとえば Moss。", "kanji": "ランタンの名前を表す文字列です。例：Moss。"},
  {"en": "A list of lamps. It can be empty, or hold many.", "to": "ランタンの リスト。からっぽの ときも、たくさん はいる ときも あるよ。", "kanji": "ランタンのリストです。空の場合も、複数の要素を含む場合もあります。"},
  {"en": "An array of lamps. It can be empty, or hold many.", "to": "ランタンの array。からっぽの ときも、たくさん はいる ときも あるよ。", "kanji": "ランタンの配列です。空の場合も、複数の要素を含む場合もあります。"},
  {"en": "An object: names, each with a value, between braces and separated by commas.", "to": "オブジェクト：なまえと あたいの ペアを、{ } で かこんで、コンマで わけた もの。", "kanji": "オブジェクト。プロパティ名と値の組を { } で囲み、コンマで区切って並べます。"},
  {"en": "Another check, tried only when the ones above it were not true.", "to": "うえの しらべが どれも ちがった ときだけ、ためすよ。", "kanji": "それまでの条件が全て偽だった場合に、次の条件を評価します。"},
  {"en": "Asks: are these two the same? One = stores a value instead.", "to": "ふたつが おなじかを きくよ。= は 1 つだけ だと、あたいを いれる いみに なるよ。", "kanji": "二つの値が等しいか比較します。= 一つの場合は、比較ではなく代入になります。"},
  {"en": "Braces wrap the lines that belong together. A ; ends a line.", "to": "{ } は、いっしょに なる ぎょうを かこむよ。; で ぎょうが おわるよ。", "kanji": "{ } で処理を一つのブロックにまとめます。文の末尾には ; を付けます。"},
  {"en": "Does nothing. It fills a body that has to hold something.", "to": "なにも しないよ。なかみが ひつような ところに おく、からっぽの ことばだよ。", "kanji": "何も実行しない文です。構文上、処理を空にできない場所に置きます。"},
  {"en": "Hands a value back to whoever called the function, and stops.", "to": "かんすうを よんだ ところに あたいを かえして、おわるよ。", "kanji": "呼び出し元に値を返し、関数の実行を終了します。"},
  {"en": "How far across you stand. Moving right makes x bigger, moving left makes it smaller.", "to": "きみが よこに どれだけ いるか。みぎへ いくと x は おおきく、ひだりへ いくと ちいさく なるよ。", "kanji": "横方向の座標です。右へ移動すると x が増え、左へ移動すると減ります。"},
  {"en": "How far across you stand. Right makes it bigger.", "to": "きみが よこに どれだけ いるか。みぎへ いくと、おおきく なるよ。", "kanji": "横方向の座標です。右へ移動すると増えます。"},
  {"en": "How far down you stand. Down makes it bigger.", "to": "きみが たてに どれだけ いるか。したへ いくと、おおきく なるよ。", "kanji": "縦方向の座標です。下へ移動すると増えます。"},
  {"en": "How far down you stand. Moving down makes y bigger, moving up makes it smaller.", "to": "きみが たてに どれだけ いるか。したへ いくと y は おおきく、うえへ いくと ちいさく なるよ。", "kanji": "縦方向の座標です。下へ移動すると y が増え、上へ移動すると減ります。"},
  {"en": "How many lamps there are.", "to": "ランタンが なんこ あるか。", "kanji": "ランタンの個数です。"},
  {"en": "It gives nothing back. It changes player, and the town reads where you stand afterwards.", "to": "なにも かえさないよ。player を かえて、そのあと 村は きみが いる ばしょを よむよ。", "kanji": "戻り値はありません。player を変更し、実行後の座標を町が読み取ります。"},
  {"en": "It gives nothing back. It changes the lamps themselves, and the town looks at them afterwards.", "to": "なにも かえさないよ。ランタンそのものを かえて、そのあと 村が ランタンを みるよ。", "kanji": "戻り値はありません。ランタン自体を変更し、実行後の状態を町が読み取ります。"},
  {"en": "Looks a value up in a dictionary by its name.", "to": "辞書 から、なまえで あたいを さがすよ。", "kanji": "キーを指定し、辞書から対応する値を取得します。"},
  {"en": "Looks a value up in an object by its name.", "to": "オブジェクト から、なまえで あたいを さがすよ。", "kanji": "プロパティ名を指定し、オブジェクトから対応する値を取得します。"},
  {"en": "Make a number bigger, or smaller, by an amount.", "to": "すうじを、きめた ぶんだけ おおきく、または ちいさく するよ。", "kanji": "指定した量だけ、数値を増加または減少させます。"},
  {"en": "Quotes make text.", "to": "\"\" で かこむと、もじに なるよ。", "kanji": "\"\" で囲むと文字列になります。"},
  {"en": "Quotes make text. A name in a dictionary is text too.", "to": "\"\" で かこむと、もじに なるよ。辞書 の なまえも もじだよ。", "kanji": "\"\" で囲むと文字列になります。辞書のキーにも文字列を使います。"},
  {"en": "Return a dictionary: names, each with a value. Whatever you leave out is forgotten.", "to": "return で 辞書 を かえすよ：なまえと あたいの ペア。かかなかった ものは、わすれられるよ。", "kanji": "キーと値の組を辞書にして返します。含めなかった情報は保存されません。"},
  {"en": "Return an object: names, each with a value. Whatever you leave out is forgotten.", "to": "return で オブジェクト を かえすよ：なまえと あたいの ペア。かかなかった ものは、わすれられるよ。", "kanji": "プロパティ名と値の組をオブジェクトにして返します。含めなかった情報は保存されません。"},
  {"en": "Run the indented lines only when the check after if is true.", "to": "if の あとの しらべが ほんとうの ときだけ、インデントした ぎょうを うごかすよ。", "kanji": "if の後の条件が真の場合に限り、インデントしたブロックを実行します。"},
  {"en": "Run the lines inside the braces only when the check in the brackets is true.", "to": "( ) の なかの しらべが ほんとうの ときだけ、{ } の なかの ぎょうを うごかすよ。", "kanji": "( ) 内の条件が真の場合に限り、{ } 内のブロックを実行します。"},
  {"en": "Run the lines inside the braces only when the check is true.", "to": "しらべが ほんとうの ときだけ、{ } の なかの ぎょうを うごかすよ。", "kanji": "条件が真の場合に限り、{ } 内のブロックを実行します。"},
  {"en": "Sets a value inside a dictionary: it changes the dictionary itself.", "to": "辞書 の なかの あたいを きめるよ。辞書 そのものが かわるよ。", "kanji": "辞書の要素に値を代入します。元の辞書自体が変更されます。"},
  {"en": "Sets a value inside an object: it changes the object itself.", "to": "オブジェクト の なかの あたいを きめるよ。オブジェクト そのものが かわるよ。", "kanji": "オブジェクトのプロパティに値を代入します。元のオブジェクト自体が変更されます。"},
  {"en": "The first lamp. Counting starts at 0, and an empty list has no first one.", "to": "さいしょの ランタン。かぞえるのは 0 から はじまるよ。からっぽの リストには、さいしょの ものが ないよ。", "kanji": "最初のランタン。添字は0から始まるよ。空のリストには最初の要素がないことにも気を付けてね。"},
  {"en": "The game calls this function, and hands it what is listed here.", "to": "ゲームが この かんすうを よんで、ここに のって いる ものを わたすよ。", "kanji": "ゲームがこの関数を呼び出し、ここに示された値を引数として渡します。"},
  {"en": "The key that was just pressed: right, left, up or down (as text), or a letter.", "to": "いま おされた キー：right、left、up、down の どれか（もじで）、または アルファベット 1 もじ。", "kanji": "押されたキーを表す文字列です。right、left、up、down、またはアルファベット1文字が渡されます。"},
  {"en": "The spaces at the start of a line say which lines belong inside the for above. Use 4.", "to": "ぎょうの はじめの スペースで、うえの for の なかに はいる ぎょうが わかるよ。スペースは 4 こ つかってね。", "kanji": "行頭の空白で、for の処理に含まれる範囲を示します。インデントには空白を4個使います。"},
  {"en": "The spaces at the start of a line say which lines belong inside the if above. Use 4.", "to": "ぎょうの はじめの スペースで、うえの if の なかに はいる ぎょうが わかるよ。スペースは 4 こ つかってね。", "kanji": "行頭の空白で、if の処理に含まれる範囲を示します。インデントには空白を4個使います。"},
  {"en": "The town calls this every time you press a key, and hands it these two things.", "to": "村は キーを おすたびに、この かんすうを よんで、ふたつの ものを わたすよ。", "kanji": "キーを押すたびに呼び出されます。以下の二つの引数を受け取ります。"},
  {"en": "The town calls this on the lane, and hands it the lamps.", "to": "村は みちの うえで この かんすうを よんで、ランタンを わたすよ。", "kanji": "ランタンの小道で呼び出され、ランタンの一覧を引数として受け取ります。"},
  {"en": "The town calls this when you save, and hands it you, the player.", "to": "村は セーブ するとき この かんすうを よんで、きみ（player）を わたすよ。", "kanji": "保存時に呼び出され、プレイヤーの情報を引数として受け取ります。"},
  {"en": "The two yes-or-no values, in small letters.", "to": "はい か いいえ を あらわす、ふたつの あたい。小文字で かくよ。", "kanji": "真偽を表す二つの値です。全て小文字で書きます。"},
  {"en": "The two yes-or-no values. Write them with a capital letter.", "to": "はい か いいえ を あらわす、ふたつの あたい。さいしょの もじを 大文字で かくよ。", "kanji": "真偽を表す二つの値です。先頭の文字を大文字で書きます。"},
  {"en": "Visit each thing in a list, one after another, running the indented lines for each.", "to": "リストの なかの ものを ひとつずつ たずねて、そのたびに インデントした ぎょうを うごかすよ。", "kanji": "リストの要素を順に取り出し、各要素についてインデントしたブロックを実行します。"},
  {"en": "Visit each thing in an array, one after another, running the lines in the braces for each.", "to": "array の なかの ものを ひとつずつ たずねて、そのたびに { } の なかの ぎょうを うごかすよ。", "kanji": "配列の要素を順に取り出し、各要素について { } 内のブロックを実行します。"},
  {"en": "What it gives back", "to": "かんすうが かえす もの", "kanji": "戻り値"},
  {"en": "What your function gets", "to": "きみの かんすうが もらう もの", "kanji": "引数"},
  {"en": "Whether the lamp shines: True or False.", "to": "ランタンが ひかって いるか：True か False。", "kanji": "ランタンの点灯状態を示す真偽値です。True または False。"},
  {"en": "Whether the lamp shines: true or false.", "to": "ランタンが ひかって いるか：true か false。", "kanji": "ランタンの点灯状態を示す真偽値です。true または false。"},
  {"en": "Which place you are in, as text: home or the town.", "to": "きみが いる ばしょ。もじで、home（いえ）か town（村）。", "kanji": "現在のマップを表す文字列です。home（家）または town（村）。"},
  {"en": "Which way you are facing, as text: up, down, left or right.", "to": "きみが むいて いる 方向。もじで、up、down、left、right の どれか。", "kanji": "向きを表す文字列です。up、down、left、right のいずれかになります。"},
  {"en": "Words you can use", "to": "つかえる ことば", "kanji": "使用できる構文"},
  {"en": "You. It holds where you stand, in the fields x and y.", "to": "きみ。いま たって いる ばしょを、x と y に いれて もって いるよ。", "kanji": "プレイヤーの情報です。x と y のフィールドに現在の座標が入っています。"},
  {"en": "Your name, as text.", "to": "きみの なまえ（もじで）。", "kanji": "プレイヤー名を表す文字列です。"},
  {"en": "a dictionary", "to": "辞書", "kanji": "辞書"},
  {"en": "an object", "to": "オブジェクト", "kanji": "オブジェクト"},
  {"en": "indentation", "to": "インデント", "kanji": "インデント"},
  {"en": "your answer", "to": "きみの こたえ", "kanji": "戻り値"},
  {"en": "Hints", "to": "ヒント", "kanji": "ヒント"},
  {"en": "Open or close the hints: what your function gets, and words you can use.", "to": "ヒントを ひらいたり とじたり するよ。きみの かんすうが もらう もの と、つかえる ことばが わかるよ。", "kanji": "ヒントを開閉します。関数の引数や、使用できる構文を確認できます。"},
  {"en": "keeps:", "to": "おぼえる：", "kanji": "覚える："},
  {"en": "Arrows: move   Enter: tick a block   Esc: close", "to": "やじるし：うごく   Enter：ブロックに チェック   Esc：とじる", "kanji": "矢印：動く   Enter：ブロックにチェック   Esc：閉じる"},
  {"en": "Ctrl+Enter: try it   Esc: close", "to": "Ctrl+Enter：ためす   Esc：とじる", "kanji": "Ctrl+Enter：試す   Esc：閉じる"},
  {"en": "Done", "to": "おわり", "kanji": "完了"},
  {"en": "Hotaru is trying it…", "to": "ほたるが ためして いるよ…", "kanji": "ほたるが試しているよ…"},
  {"en": "Try it  ▶", "to": "ためしてみる  ▶", "kanji": "試す  ▶"},
  {"en": "Type here. The town calls your function.", "to": "ここに かいてね。村が きみの かんすうを よぶよ。", "kanji": "ここにコードを入力してください。町がこの関数を呼び出します。"},
  {"en": "A save needs x, y and map to find us. Vell can help us fix it.", "to": "セーブには、わたしたちを みつける ための x、y、map が ひつようだよ。ヴェルが なおすのを てつだって くれるよ。", "kanji": "セーブには、私たちを見つけるための x、y、map が必要だよ。ヴェルが直すのを手伝ってくれるよ。"},
  {"en": "Look! Every lamp on the lane, awake at once!", "to": "みて！ みちの ランタンが、ぜんぶ いっしょに めを さましたよ！", "kanji": "見て！道のランタンが、全部一緒に目を覚ましたよ！"},
  {"en": "One loop, and the whole lane listened. Let's go and tell Lumen!", "to": "くりかえし ひとつで、みち ぜんぶが ちゃんと いうことを きいたよ。ルーメンに おしえに いこう！", "kanji": "繰り返し一つで、道全部がちゃんということを聞いたよ。ルーメンにおしえに行こう！"},
  {"en": "Press Esc and choose Save, and the town will keep our place.", "to": "Esc を おして「セーブ」を えらぶと、村が わたしたちの いる ばしょを おぼえて くれるよ。", "kanji": "Esc を押して「セーブ」を選ぶと、村が私たちのいる場所を覚えてくれるよ。"},
  {"en": "Press Esc for the menu, then choose Save. Then the town will remember us.", "to": "Esc を おして メニューを ひらき、「セーブ」を えらんでね。そうすれば、村が わたしたちを おぼえて くれるよ。", "kanji": "Esc を押してメニューを開き、「セーブ」を選んでね。そうすれば、村が私たちを覚えてくれるよ。"},
  {"en": "Your save is written! But it only keeps things when you use it.", "to": "セーブが できたよ！ でも、きみが つかった ときだけ、ものを おぼえて くれるよ。", "kanji": "セーブができたよ！でも、君が使ったときだけ、ものを覚えてくれるよ。"},
  {"en": "Your save isn't written yet. Vell at the Archive can help.", "to": "まだ セーブが できて いないよ。きろくこの ヴェルが てつだって くれるよ。", "kanji": "まだセーブができていないよ。記録庫のヴェルが手伝ってくれるよ。"},
  {"en": "Your save tripped: %s", "to": "きみの セーブが つまずいたよ：%s", "kanji": "君のセーブがつまずいたよ：%s"},
  {"en": "Tried on three lanes:", "to": "3 つの みちで ためして みたよ：", "kanji": "3 つの道で試してみたよ："},
  {"en": "Tried on three players:", "to": "3 にんの プレイヤーで ためして みたよ：", "kanji": "3 にんのプレイヤーで試してみたよ："},
  {"en": "Your code", "to": "きみの コード", "kanji": "君のコード"},
  {"en": "%d lamps", "to": "ランタン %d こ", "kanji": "ランタン %d 個"},
  {"en": "%d lamps went in, %d came out.", "to": "ランタン %d こ が はいって、%d こ が でて きたよ。", "kanji": "ランタン %d 個が入って、%d 個が出てきたよ。"},
  {"en": "%d of %d still dark.", "to": "%d こ（ぜんぶで %d こ）が まだ くらいよ。", "kanji": "%d 個（全部で %d 個）がまだ暗いよ。"},
  {"en": "%d of %d worked.", "to": "%d こ（ぜんぶで %d こ）が うまく いったよ。", "kanji": "%d 個（全部で %d 個）がうまく行ったよ。"},
  {"en": "A value got mixed up. Check that each name keeps its own value.", "to": "あたいが まざって しまったよ。なまえごとに、ちゃんと じぶんの あたいを たもって いるか、たしかめてね。", "kanji": "値がまざってしまったよ。名前ごとに、ちゃんと自分の値を保っているか、確かめてね。"},
  {"en": "All %d lit!", "to": "ぜんぶ %d こ ともった！", "kanji": "全部 %d 個灯った！"},
  {"en": "An empty lane has no first lamp to light! A loop just does nothing there.", "to": "からっぽの みちには、ともす さいしょの ランタンが ないよ！ くりかえしは、そこでは なにも しないよ。", "kanji": "空っぽの道には、灯す最初のランタンがないよ！繰り返しは、そこでは何もしないよ。"},
  {"en": "An empty save! Tomorrow the town wouldn't know you at all.", "to": "からっぽの セーブ！ あしたには、村が きみの ことを ぜんぜん しらなく なって しまうよ。", "kanji": "空っぽのセーブ！明日には、村が君のことをぜんぜん知らなくなってしまうよ。"},
  {"en": "At home, x %d y %d", "to": "いえ、x %d y %d", "kanji": "家、x %d y %d"},
  {"en": "Build light_all from the blocks. Every lamp should end up lit, however many there are!", "to": "ブロックで light_all を つくろう。ランタンは いくつ あっても、ぜんぶ ともって いるように しよう！", "kanji": "ブロックで light_all を作ろう。ランタンはいくつあっても、全部灯っているようにしよう！"},
  {"en": "Can't run yet. %s", "to": "まだ うごかせないよ。%s", "kanji": "まだ動かせないよ。%s"},
  {"en": "Every lamp, in every lane! Press Done and watch the real lane wake up.", "to": "どの みちの ランタンも、ぜんぶ！ 「おわり」を おして、ほんとうの みちが めざめるのを みてね。", "kanji": "どの道のランタンも、全部！ 「終わり」を押して、本当の道が目覚めるのをみてね。"},
  {"en": "For each lamp in the lane:", "to": "みちの ランタンを ひとつずつ：", "kanji": "道のランタンを一つずつ："},
  {"en": "Forgot %s.", "to": "%s を わすれて いたよ。", "kanji": "%s を忘れていたよ。"},
  {"en": "Gave back %s, not a dictionary.", "to": "%s を かえしたよ。辞書 では ないよ。", "kanji": "%s を返したよ。辞書ではないよ。"},
  {"en": "Gave back %s, not an object.", "to": "%s を かえしたよ。オブジェクト では ないよ。", "kanji": "%s を返したよ。オブジェクトではないよ。"},
  {"en": "Gave back %s, not the lamps.", "to": "%s を かえしたよ。ランタン では ないよ。", "kanji": "%s を返したよ。ランタンではないよ。"},
  {"en": "Gave back an empty save.", "to": "からっぽの セーブを かえしたよ。", "kanji": "空っぽのセーブを返したよ。"},
  {"en": "Gave back nothing. Is there a return?", "to": "なにも かえさなかったよ。return は ある？", "kanji": "何も返さなかったよ。return はある？"},
  {"en": "Good morning! We never pressed Save, so the town forgot where we were. We woke up at home.", "to": "おはよう！ セーブを おして いなかったから、村は わたしたちが どこに いたか わすれて しまったよ。いえで めを さましたんだ。", "kanji": "おはよう！セーブしていなかったから、村は私たちの居場所を忘れてしまったの。それで家で目を覚ましたんだよ。"},
  {"en": "Good morning! Your save didn't keep the map, so the town couldn't find us. We woke up at home.", "to": "おはよう！ セーブに map が のこって いなかったから、村は わたしたちを みつけられなかったよ。いえで めを さましたんだ。", "kanji": "おはよう！セーブデータに地図が残っていなかったから、村は私たちの居場所を見つけられなかったの。それで家で目を覚ましたんだよ。"},
  {"en": "Good morning! Your save didn't keep x and y, so we woke up at home.", "to": "おはよう！ セーブに x と y が のこって いなかったから、いえで めを さましたよ。", "kanji": "おはよう！セーブデータに x と y が残っていなかったから、家で目を覚ましたんだよ。"},
  {"en": "Good morning! Your save named a place the town doesn't know, so we woke up at home.", "to": "おはよう！ セーブに、村が しらない ばしょの なまえが かいて あったから、いえで めを さましたよ。", "kanji": "おはよう！セーブデータに知らない場所の名前が記録されていたから、家で目を覚ましたんだよ。"},
  {"en": "Good morning! Your save put us inside something solid, so we woke up at home.", "to": "おはよう！ セーブでは、かたい ものの なかに はいって しまって いたから、いえで めを さましたよ。", "kanji": "おはよう！セーブデータの位置が障害物の中だったから、家で目を覚ましたんだよ。"},
  {"en": "Good morning! Your save put us off the edge of the map, so we woke up at home.", "to": "おはよう！ セーブでは、ちずの はしの そとに いた ことに なって いたから、いえで めを さましたよ。", "kanji": "おはよう！セーブデータの位置が地図の範囲外だったから、家で目を覚ましたんだよ。"},
  {"en": "Hmm, the check didn't run. Let's try again.", "to": "うーん、しらべが うごかなかったよ。もう いちど やってみよう。", "kanji": "うーん、調べが動かなかったよ。もう一度やってみよう。"},
  {"en": "In town, x %d y %d", "to": "村、x %d y %d", "kanji": "村、x %d y %d"},
  {"en": "It kept x and y, but not which map! Home has an x 2, y 3, and so does the town.", "to": "x と y は のこったけど、どの map か わからないよ！ いえにも 村にも、x 2、y 3 の ばしょが あるんだ。", "kanji": "x と y は残ったけど、どの map か分からないよ！家にも村にも、x 2、y 3 の場所があるんだ。"},
  {"en": "It took too long. Is there a loop that never ends?", "to": "じかんが かかりすぎたよ。おわらない くりかえしが ないかな？", "kanji": "時間がかかりすぎたよ。終わらない繰り返しがないかな？"},
  {"en": "Keep the first line as it was. The town calls that function by its name.", "to": "さいしょの ぎょうは、そのまま にして おいてね。村は その かんすうを なまえで よぶからね。", "kanji": "先頭行の関数名を変更しないでください。町はその名前で関数を呼び出します。"},
  {"en": "Kept %s as %s, but it was %s.", "to": "%s を %s として のこしたけど、ほんとうは %s だったよ。", "kanji": "%s を %s として残したけど、本当は %s だったよ。"},
  {"en": "Kept %s. The town can find you!", "to": "%s を のこしたよ。村が きみを みつけられるよ！", "kanji": "%s を残したよ。村が君を見つけられるよ！"},
  {"en": "Lamps went missing! Light them, but don't take any away.", "to": "ランタンが なくなって いるよ！ ともして あげてね。でも、ひとつも へらさないでね。", "kanji": "ランタンがなくなっているよ！灯してあげてね。でも、一つも減らさないでね。"},
  {"en": "Light the first lamp", "to": "さいしょの ランタンを ともす", "kanji": "最初のランタンを灯す"},
  {"en": "Light the lane", "to": "みちの ランタンを ともす", "kanji": "道のランタンを灯す"},
  {"en": "Line %d: %s", "to": "%d ぎょうめ：%s", "kanji": "%d 行目：%s"},
  {"en": "Lit!", "to": "ともった！", "kanji": "灯った！"},
  {"en": "No lamps", "to": "ランタンなし", "kanji": "ランタンなし"},
  {"en": "Nothing to light, and nothing broke.", "to": "ともす ものは なくて、なにも こわれなかったよ。", "kanji": "灯すランタンはありません。エラーもありません。"},
  {"en": "One lamp", "to": "ランタン 1 こ", "kanji": "ランタン 1 個"},
  {"en": "Only the first lamp woke up! A loop can visit every lamp, one by one.", "to": "さいしょの ランタンしか めを さまさなかったよ！ くりかえしは、ランタンを ひとつずつ ぜんぶ たずねられるんだよ。", "kanji": "最初のランタンしか目を覚まさなかったよ！ループを使えば、全てのランタンを一つずつ処理できるんだ。"},
  {"en": "Passed! Every case worked.", "to": "できた！ ぜんぶの ばあいで うまく いったよ。", "kanji": "できた！全部の場合でうまく行ったよ。"},
  {"en": "Remember me", "to": "わたしを おぼえて", "kanji": "私を覚えて"},
  {"en": "Saved! Your save kept %s.", "to": "セーブ できたよ！ きみの セーブは %s を のこして いるよ。", "kanji": "セーブできたよ！君のセーブは %s を残しているよ。"},
  {"en": "Set its lit to True", "to": "その lit を True に する", "kanji": "その lit を True にする"},
  {"en": "Set its lit to true", "to": "その lit を true に する", "kanji": "その lit を true にする"},
  {"en": "So close! lit has to be True, exactly.", "to": "おしい！ lit は ちょうど True に しないと いけないよ。", "kanji": "おしい！ lit はちょうど True にしないといけないよ。"},
  {"en": "So close! lit has to be true, exactly.", "to": "おしい！ lit は ちょうど true に しないと いけないよ。", "kanji": "おしい！ lit はちょうど true にしないといけないよ。"},
  {"en": "Some lamps are still dark. Does every lamp get lit?", "to": "まだ くらい ランタンが あるよ。ぜんぶの ランタンが ともる かな？", "kanji": "まだ暗いランタンがあるよ。全部のランタンが灯るかな？"},
  {"en": "Something went wrong.", "to": "なにか まちがって しまったよ。", "kanji": "何か間違ってしまったよ。"},
  {"en": "The check couldn't run: %s", "to": "しらべを うごかせなかったよ：%s", "kanji": "調べを動かせなかったよ：%s"},
  {"en": "The lamps are all still dark. What should happen to each one?", "to": "ランタンは ぜんぶ、まだ くらい ままだよ。ひとつずつ、どう なれば いいかな？", "kanji": "ランタンは全部、まだ暗いままだよ。一つずつ、どうなればいいかな？"},
  {"en": "The lamps changed places.", "to": "ランタンの ならびが かわって しまったよ。", "kanji": "ランタンの並びが変わってしまったよ。"},
  {"en": "The lamps got shuffled. Light each one where it stands.", "to": "ランタンが ばらばらに なって いたよ。ひとつずつ、いた ばしょの まま ともしてね。", "kanji": "ランタンがばらばらになっていたよ。一つずつ、いた場所のまま灯してね。"},
  {"en": "The town looks for %s and can't find it.", "to": "村は %s を さがして いるけど、みつからないよ。", "kanji": "村は %s を探しているけど、見つからないよ。"},
  {"en": "Tick what the town should remember about you. Your save gives those back.", "to": "村が きみの ことで おぼえて おく ものに、チェックを いれてね。セーブは、それを かえして くれるよ。", "kanji": "村が君のことで覚えて奥ものに、チェックを入れてね。セーブは、それを返してくれるよ。"},
  {"en": "Try it on three lanes: no lamps, one lamp, five lamps.", "to": "3 つの みちで ためすよ：ランタンなし、ランタン 1 こ、ランタン 5 こ。", "kanji": "3 つの道で試すよ：ランタンなし、ランタン 1 個、ランタン 5 個。"},
  {"en": "Try it on three players: one at home, two in town.", "to": "3 にんの プレイヤーで ためすよ：いえに 1 にん、村に 2 にん。", "kanji": "3 にんのプレイヤーで試すよ：家に 1 人、村に 2 人。"},
  {"en": "Write light_all. It gets a list of lamps. Light every one, however many there are!", "to": "light_all を かこう。ランタンの リストを もらうよ。いくつ あっても、ぜんぶ ともしてね！", "kanji": "light_all を書こう。ランタンのリストをもらうよ。いくつあっても、全部灯してね！"},
  {"en": "Write save. It gets you, the player. Give back what the town should remember about you.", "to": "save を かこう。きみ（player）を もらうよ。村が きみの ことで おぼえて おく ものを かえしてね。", "kanji": "save を書こう。君（player）をもらうよ。村が君のことで覚えて奥ものを返してね。"},
  {"en": "You did it! Now the town can remember you. Press Done, then save from the menu (Esc).", "to": "やったね！ これで 村が きみの ことを おぼえて くれるよ。「おわり」を おしてから、メニュー（Esc）から セーブ してね。", "kanji": "やったね！これで村が君のことを覚えてくれるよ。「終わり」を押してから、メニュー（Esc）からセーブしてね。"},
  {"en": "Your code can't run yet. The red line shows where to look.", "to": "きみの コードは まだ うごかないよ。あかい ぎょうが、みる ばしょを しめして いるよ。", "kanji": "君のコードはまだ動かないよ。赤い行が、見る場所を示しているよ。"},
  {"en": "Your code is going round and round! Does the loop ever end?", "to": "きみの コードが ぐるぐる まわって いるよ！ くりかえしは、いつか おわるかな？", "kanji": "君のコードがぐるぐる回っているよ！繰り返しは、いつか終わるかな？"},
  {"en": "Your code tripped. The red line shows where.", "to": "きみの コードが つまずいたよ。あかい ぎょうが、どこかを しめして いるよ。", "kanji": "コードでエラーが発生しました。赤い行が発生箇所です。"},
  {"en": "Your save forgot something. The town needs x, y and map to find you.", "to": "きみの セーブは、なにか わすれて いるよ。村が きみを みつけるには、x、y、map が いるよ。", "kanji": "君のセーブは、何か忘れているよ。村が君を見つけるには、x、y、map がいるよ。"},
  {"en": "across", "to": "よこ", "kanji": "横"},
  {"en": "light_all should light the lamps it gets, not make something new.", "to": "light_all は、もらった ランタンを ともす もの だよ。あたらしい ものを つくらないでね。", "kanji": "light_all は、もらったランタンを灯すものだよ。新しいものを作らないでね。"},
  {"en": "lit is %s, not True.", "to": "lit は %s で、True では ないよ。", "kanji": "lit は %s で、True ではないよ。"},
  {"en": "lit is %s, not true.", "to": "lit は %s で、true では ないよ。", "kanji": "lit は %s で、true ではないよ。"},
  {"en": "save has to give something back. That's what return does!", "to": "save は なにか かえさないと だめだよ。それが return の しごとだよ！", "kanji": "save は何か返さないとだめだよ。それが return の仕事だよ！"},
  {"en": "save should give back a dictionary: names, each with a value.", "to": "save は 辞書 を かえすと いいよ：なまえと あたいの ペア。", "kanji": "save は辞書を返すといいよ：名前と値のペア。"},
  {"en": "save should give back an object: names, each with a value.", "to": "save は オブジェクト を かえすと いいよ：なまえと あたいの ペア。", "kanji": "save はオブジェクトを返すといいよ：名前と値のペア。"},
  {"en": "which place", "to": "どの ばしょ", "kanji": "どの場所"},
  {"en": "which way you face", "to": "どっちを むいて いるか", "kanji": "どっちを向いているか"},
  {"en": "your name", "to": "きみの なまえ", "kanji": "君の名前"},
  {"en": "Give back a dictionary of what the town should remember.", "to": "村が おぼえて おく ものを、辞書 で かえしてね。", "kanji": "村が覚えて奥ものを、辞書で返してね。"},
  {"en": "Give back an object of what the town should remember.", "to": "村が おぼえて おく ものを、オブジェクト で かえしてね。", "kanji": "村が覚えて奥ものを、オブジェクトで返してね。"},
  {"en": "Light every lamp on the lane.", "to": "みちの ランタンを ぜんぶ ともしてね。", "kanji": "道のランタンを全部灯してね。"},
  {"en": "lamps is a list. Each lamp is a dictionary like {\"name\": \"Moss\", \"lit\": False}.", "to": "lamps は リストだよ。ランタンは それぞれ、{\"name\": \"Moss\", \"lit\": False} の ような 辞書 だよ。", "kanji": "lamps はリストだよ。ランタンはそれぞれ、{\"name\": \"Moss\", \"lit\": False} のような辞書だよ。"},
  {"en": "lamps is an array. Each lamp is an object like {name: \"Moss\", lit: false}.", "to": "lamps は array だよ。ランタンは それぞれ、{name: \"Moss\", lit: false} の ような オブジェクト だよ。", "kanji": "lamps は array だよ。ランタンはそれぞれ、{name: \"Moss\", lit: false} のようなオブジェクトだよ。"},
  {"en": "player.facing and player.name are there too.", "to": "player.facing と player.name も あるよ。", "kanji": "player.facing と player.name もあるよ。"},
  {"en": "player.x and player.y are where you stand; player.map is which map.", "to": "player.x と player.y は いま いる ばしょ。player.map は どの map か だよ。", "kanji": "player.x と player.y は今いる場所。player.map はどの map かだよ。"},
  {"en": "player[\"facing\"] and player[\"name\"] are there too.", "to": "player[\"facing\"] と player[\"name\"] も あるよ。", "kanji": "player[\"facing\"] と player[\"name\"] もあるよ。"},
  {"en": "player[\"x\"] and player[\"y\"] are where you stand; player[\"map\"] is which map.", "to": "player[\"x\"] と player[\"y\"] は いま いる ばしょ。player[\"map\"] は どの map か だよ。", "kanji": "player[\"x\"] と player[\"y\"] は今いる場所。player[\"map\"] はどの map かだよ。"},
  {"en": "Run  ▶", "to": "うごかす  ▶", "kanji": "実行  ▶"},
  {"en": "Trying it...", "to": "ためして いるよ...", "kanji": "実行中…"},
  {"en": "Type your code here. Ctrl+Enter runs it.", "to": "ここに コードを かいてね。Ctrl+Enter で うごかせるよ。", "kanji": "ここにコードを入力します。Ctrl+Enter で実行できます。"},
  {"en": "%s did not answer: %s. Nothing changed.", "to": "%s が こたえなかったよ：%s。なにも かわらなかったよ。", "kanji": "%s が答えなかったよ：%s。何も変わらなかったよ。"},
  {"en": "%s may not change %s, so that stayed the same.", "to": "%s は %s を かえられないので、そのまま にしたよ。", "kanji": "%s は %s をかえられないので、そのままにしたよ。"},
  {"en": "%s must give back words and settings, as a dictionary. Nothing changed.", "to": "%s は、ことばと せっていを 辞書 で かえさないと だめだよ。なにも かわらなかったよ。", "kanji": "%s は、言葉と設定を辞書で返さないとだめだよ。何も変わらなかったよ。"},
  {"en": "%s stopped: %s. Nothing changed.", "to": "%s が とまったよ：%s。なにも かわらなかったよ。", "kanji": "%s が止まったよ：%s。何も変わらなかったよ。"},
  {"en": "%s took too long. Is there a loop that never ends? Nothing changed.", "to": "%s は じかんが かかりすぎたよ。おわらない くりかえしが ないかな？ なにも かわらなかったよ。", "kanji": "%s は時間がかかりすぎたよ。終わらない繰り返しがないかな？何も変わらなかったよ。"},
  {"en": "%s tripped on line %d: %s. Nothing changed.", "to": "%s は %d ぎょうめで つまずいたよ：%s。なにも かわらなかったよ。", "kanji": "%s は %d 行目でつまずいたよ：%s。何も変わらなかったよ。"},
  {"en": "%s used too much memory. Nothing changed.", "to": "%s は メモリを つかいすぎたよ。なにも かわらなかったよ。", "kanji": "%s はメモリをつかいすぎたよ。何も変わらなかったよ。"},
  {"en": "It may change nothing. It may say words.", "to": "なにも かえないかも。ことばを いうかも。", "kanji": "何も変えないかも。言葉をいうかも。"},
  {"en": "It may change: %s. It may say words.", "to": "かえるかも：%s。ことばを いうかも。", "kanji": "変えるかも：%s。言葉をいうかも。"},
  {"en": "It ran. Nothing was said.", "to": "うごいたよ。なにも いわなかったよ。", "kanji": "動いたよ。何も言わなかったよ。"},
  {"en": "You are standing in %s, so it stays as it was.", "to": "きみは %s の なかに たって いるから、もとの まま だよ。", "kanji": "君は %s の中に立っているから、もとのままだよ。"},
  {"en": "a name you used is not known here", "to": "つかった なまえが、ここでは しられて いない", "kanji": "未定義の名前を参照しています"},
  {"en": "a number was divided by zero", "to": "すうじを 0 で わって しまった", "kanji": "数値をゼロで割ろうとしました"},
  {"en": "a place in a list is past its end, and lists start at 0", "to": "リストの ばしょが さいごを こえて いる（リストは 0 から はじまる）", "kanji": "リストの場所が最後を声ている（リストは 0 から始まる）"},
  {"en": "a value is the wrong kind for what it does", "to": "あたいの しゅるいが、つかい方と あって いない", "kanji": "処理に適さない型の値です"},
  {"en": "that key is not in the dictionary", "to": "その キーは 辞書 の なかに ない", "kanji": "辞書にそのキーがありません"},
  {"en": "the code called itself too many times", "to": "コードが じぶんを よびすぎた", "kanji": "再帰呼び出しの回数が上限を超えました"},
  {"en": "the code is not written the way the language reads it", "to": "コードの かきかたが、ことばの きまりと ちがう", "kanji": "コードの書き方が、言葉の決まりと違う"},
  {"en": "the code stopped with an error", "to": "コードが エラーで とまった", "kanji": "コードがエラーで停止しました"},
  {"en": "there is no function named on_use or onUse to run", "to": "うごかす ための on_use か onUse という かんすうが ない", "kanji": "動かすための on_use か onUse という関数がない"},
  {"en": "Face a thing that takes code, then press X.", "to": "コードを うけとる ものに むいて、X を おしてね。", "kanji": "コードを受け取るものに向いて、X を押してね。"}
]
