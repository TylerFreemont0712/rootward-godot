[
  {"en": "Package Lock", "to": "パッケージロック"},
  {"en": "The Registry's prices are 15% lower.", "to": "レジストリの値段が15%やすくなる。"},
  {"en": "Pinned, so nothing changes under you.", "to": "しっかり固定。足もとの値段は変わらない。"},
  {"en": "Mirror Server", "to": "ミラーサーバー"},
  {"en": "The Registry stocks one more card and one more relic.", "to": "レジストリの棚に、カードと遺物が1つずつ増える。"},
  {"en": "The same shelves, twice.", "to": "同じ棚が、2つ。"},
  {"en": "Bug Bounty Program", "to": "バグバウンティ制度"},
  {"en": "Every foe you kill pays 2 more cycles.", "to": "倒した敵ごとに、サイクルが2多くもらえる。"},
  {"en": "Someone is always paying for bugs.", "to": "バグには、いつもだれかがお金を出している。"},
  {"en": "Venture Capital", "to": "ベンチャーキャピタル"},
  {"en": "Gain 150 cycles now. Every Registry you enter takes 1 maximum Integrity.", "to": "今すぐ150サイクルもらう。レジストリに入るたび、最大Integrityが1へる。"},
  {"en": "Growth at all costs. Mostly yours.", "to": "なにがなんでも成長。その代金は、たいてい自分ばらい。"},
  {"en": "Semantic Versioning", "to": "セマンティックバージョニング"},
  {"en": "Refactoring a card at the Registry is free once each layer.", "to": "レジストリでのリファクタが、階層ごとに1回むりょうになる。"},
  {"en": "Major, minor, patch, and a bow.", "to": "メジャー、マイナー、パッチ、そしておじぎ。"},
  {"en": "Coupon Code", "to": "クーポンコード"},
  {"en": "The Registry's sale card is free.", "to": "レジストリのセールのカードがむりょうになる。"},
  {"en": "SAVE100, valid in no other store.", "to": "SAVE100。ほかのお店では使えない。"},
  {"en": "Lockfile", "to": "ロックファイル"},
  {"en": "The first relic you buy in each layer costs half.", "to": "階層ごとに、はじめて買う遺物が半額になる。"},
  {"en": "Everything pinned, nothing surprising.", "to": "ぜんぶ固定。おどろきはなし。"},
  {"en": "Interest Rate", "to": "金利"},
  {"en": "At every Registry, first gain 10% of your cycles (at most 30).", "to": "レジストリに入るたび、先にもっているサイクルの10%をもらう（30まで）。"},
  {"en": "Your money works while you walk.", "to": "歩いているあいだも、お金がはたらく。"},
  {"en": "Monorepo", "to": "モノレポ"},
  {"en": "You have 1 more mana each turn while your deck holds 25 cards or more.", "to": "デッキが25枚以上のあいだ、毎ターンのマナが1ふえる。"},
  {"en": "Everything in one place, including the problems.", "to": "なんでも1か所に。問題もいっしょに。"},
  {"en": "Microservices", "to": "マイクロサービス"},
  {"en": "You draw 1 more card each turn while your deck holds 12 cards or fewer.", "to": "デッキが12枚以下のあいだ、毎ターン1枚多く引く。"},
  {"en": "Small, sharp, and talking to each other.", "to": "小さくて、するどくて、おたがいに話している。"},
  {"en": "Snapshot", "to": "スナップショット"},
  {"en": "Once a run, a blow that would end it restores you to the start of that turn.", "to": "1回の冒険で1度だけ、やられる一撃を受けても、そのターンのはじめにもどれる。"},
  {"en": "Take a picture before you try it.", "to": "やる前に、写真をとっておこう。"},
  {"en": "Rubber Duck", "to": "ラバーダック"},
  {"en": "A wrong answer in an Issue that reads code costs you nothing.", "to": "コードを読むイシューでまちがえても、なにも失わない。"},
  {"en": "It listens. That is the whole trick.", "to": "聞いてくれる。それがコツのぜんぶ。"},
  {"en": "Polyglot", "to": "ポリグロット"},
  {"en": "Fight rewards offer another paradigm's cards 15 points more often.", "to": "戦いの報酬で、ほかのパラダイムのカードが出る率が15ポイントふえる。"},
  {"en": "Hello, bonjour, 你好, namaste.", "to": "こんにちは、ボンジュール、你好、ナマステ。"},
  {"en": "Specialist", "to": "スペシャリスト"},
  {"en": "Your focus's cards are three times as likely in your rewards.", "to": "報酬で、フォーカスのカードが出る率が3倍になる。"},
  {"en": "Ten thousand hours, give or take.", "to": "1万時間。まあ、そのくらい。"},
  {"en": "Amortised Analysis", "to": "償却解析"},
  {"en": "The Table's rows never go down: a weak turn is written as the best of the turns before it.", "to": "表の行は下がらない。弱いターンは、それまででいちばんよいターンの値で書かれる。"},
  {"en": "On average, everything is fine.", "to": "ならして見れば、ぜんぶだいじょうぶ。"},
  {"en": "Memory Pool", "to": "メモリプール"},
  {"en": "The Index holds 4 more bolts, and the bolt it adds to your seed gains 2.", "to": "インデックスにボルトが4つ多く入る。種にくわわるボルトは+2される。"},
  {"en": "Allocate once, reuse forever.", "to": "1回かくほして、ずっと使いまわす。"},
  {"en": "Heat Sink", "to": "ヒートシンク"},
  {"en": "A timeout gives its mana back, and block for the operations over the budget.", "to": "タイムアウトしたとき、マナが返ってくる。予算をこえた分のオペレーションは、ブロックになる。"},
  {"en": "Where the heat goes, the danger follows.", "to": "熱がにげれば、危険もにげる。"},
  {"en": "Speculative Execution", "to": "投機的実行"},
  {"en": "Your first strike each program does no work.", "to": "プログラムの最初の攻撃カードは、仕事をしない。"},
  {"en": "It already ran, just in case.", "to": "念のため、もう走らせてある。"},
  {"en": "Stack Frame", "to": "スタックフレーム"},
  {"en": "The card after a splitting card does half the work.", "to": "分けるカードのあとのカードは、仕事が半分になる。"},
  {"en": "Each call pushes a little less.", "to": "呼ぶたびに、少しずつ軽くなる。"},
  {"en": "Big Data", "to": "ビッグデータ"},
  {"en": "A volley of 64 bolts or more deals 25% more.", "to": "ボルトが64本以上の一斉射は、25%多くダメージをあたえる。"},
  {"en": "Anything is a pattern if you have enough of it.", "to": "十分な量があれば、なんでもパターンに見える。"},
  {"en": "Tail Latency", "to": "テールレイテンシ"},
  {"en": "Foes wait 12 more operations before they act.", "to": "敵は、動くまでに12オペレーション長く待つ。"},
  {"en": "The slowest one decides everything.", "to": "いちばん遅いものが、ぜんぶを決める。"},
  {"en": "Hash Seed", "to": "ハッシュシード"},
  {"en": "Bolts that hit a weakness deal 1 more.", "to": "弱点にあたったボルトは、ダメージ+1。"},
  {"en": "Collisions are only a matter of time.", "to": "衝突は、時間の問題。"},
  {"en": "Cold Start", "to": "コールドスタート"},
  {"en": "Your first program of each fight costs 1 less mana.", "to": "戦いの最初のプログラムは、マナが1少なくてすむ。"},
  {"en": "The first request is always the slow one.", "to": "最初のリクエストは、いつも遅い。"},
  {"en": "Dead Code Elimination", "to": "デッドコード削除"},
  {"en": "At a rest site you may also remove a card.", "to": "休憩所では、カードを1枚へらすこともできる。"},
  {"en": "What never runs, never hurts.", "to": "走らないものは、傷つけない。"},
  {"en": "Dotfiles", "to": "ドットファイル"},
  {"en": "Your belt holds one more script.", "to": "ベルトに、スクリプトがもう1つ入る。"},
  {"en": "Years of small adjustments, in a hidden folder.", "to": "かくれたフォルダの、何年ぶんものちょっとした調整。"},
  {"en": "Shell History", "to": "シェルの履歴"},
  {"en": "The first script you use in each fight comes back after it.", "to": "戦いで最初に使ったスクリプトは、戦いのあとに戻ってくる。"},
  {"en": "Press up, and it is there again.", "to": "上キーをおせば、また出てくる。"},
  {"en": "Alias", "to": "エイリアス"},
  {"en": "Scripts cost 25% less at the Registry.", "to": "レジストリでのスクリプトが25%やすくなる。"},
  {"en": "Four letters instead of forty.", "to": "40文字のかわりに、4文字。"},
  {"en": "Every third fight, you start with 1 less mana. Repay 150 cycles at a Registry to clear it.", "to": "3回の戦いごとに、マナが1少ない状態で始まる。レジストリで150サイクルを返すと、なくなる。"},
  {"en": "The interest is paid in attention.", "to": "利子は、注意力ではらう。"}
]
