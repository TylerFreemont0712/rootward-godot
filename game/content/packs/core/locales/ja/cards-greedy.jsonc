[
  {"en": "Break", "to": "ブレーク"},
  {"en": "Break+", "to": "ブレーク+"},
  {"en": "Hits the front foe with each bolt until it falls, then breaks out of the loop. The bolts after the kill stay unaimed for the next card, and only the bolts used count as work.", "to": "いちばん前の敵を、ボルトを1本ずつ当てて倒したらループをbreakで抜ける。倒したあとのボルトは使わず、次のカードに残る。仕事量は使ったボルトの分だけ。"},
  {"en": "Hits the front foe with each bolt until it falls, then breaks. The bolts after the kill are aimed at the next foe (aiming them counts as work).", "to": "前の敵を倒したらbreakで抜ける。残ったボルトは次の敵にねらいを定める（ねらう分も仕事量にかぞえる）。"},
  {"en": "Job Sequencing", "to": "ジョブの順番（じゅんばん）"},
  {"en": "Job Sequencing+", "to": "ジョブの順番（じゅんばん）+"},
  {"en": "Each foe is a job: its deadline is its intent's tempo, its profit the damage it intends. Bolts go first to the foe that would hurt you most among those you can still beat to the punch.", "to": "敵を仕事（ジョブ）と考える。しめ切りは敵の行動の速さ、もうけは敵が与えるダメージ。先に倒せる敵のうち、いちばん痛い敵からボルトを送る。"},
  {"en": "Each foe is a job. Foes are ranked by profit per HP, the damage they intend for each point of HP they have, then by profit.", "to": "敵を仕事と考えて、HP1あたりのダメージが大きい順に並べる。同じならダメージの大きい順。"},
  {"en": "Boyer-Moore Vote", "to": "ボイヤー・ムーア多数決（たすうけつ）"},
  {"en": "Boyer-Moore Vote+", "to": "ボイヤー・ムーア多数決（たすうけつ）+"},
  {"en": "One pass and one counter find the volley's majority element. If there is one, every bolt becomes that element, 1 stronger.", "to": "1回のパスと1つのカウンターで、ボルトの属性の過半数を見つける。あれば全ボルトがその属性になり、威力が1上がる。"},
  {"en": "One pass and one counter find the volley's majority element. If there is one, every bolt becomes that element, 2 stronger.", "to": "1回のパスと1つのカウンターで、ボルトの属性の過半数を見つける。あれば全ボルトがその属性になり、威力が2上がる。"},
  {"en": "Stock Trader", "to": "ストックトレーダー"},
  {"en": "Stock Trader+", "to": "ストックトレーダー+"},
  {"en": "Adds up every rise from one bolt to the next into a new bolt at the end. A rising volley pays well.", "to": "前のボルトより強くなった分をすべて足して、最後に新しいボルトを1本作る。威力が上がり続ける列は大もうけ。"},
  {"en": "Adds up every rise from one bolt to the next into a new bolt at the end, with the element of the strongest bolt.", "to": "前のボルトより強くなった分をすべて足して、最後に新しいボルトを1本作る。いちばん強いボルトの属性になる。"},
  {"en": "Brace", "to": "ブレース"},
  {"en": "Brace+", "to": "ブレース+"},
  {"en": "Turns the weakest bolts into block, one by one, until the block covers the biggest incoming intent. The rest still fly.", "to": "弱いボルトから順に防御（ブロック）に変える。いちばん大きい敵の攻撃を防げるまで続ける。残りは飛んでいく。"},
  {"en": "Turns the weakest bolts into block, one by one, until the block covers every incoming intent added together. The rest still fly.", "to": "弱いボルトから順にブロックに変える。すべての敵の攻撃を合わせた分を防げるまで続ける。残りは飛んでいく。"},
  {"en": "Heapify", "to": "ヒープ化（か）"},
  {"en": "Heapify+", "to": "ヒープ化（か）+"},
  {"en": "Builds a heap bottom-up in O(n): the strongest bolt comes first and the rest are in heap order, not sorted.", "to": "下からヒープを作る。O(n)で、並べかえより速い。いちばん強いボルトが先頭になり、残りはヒープの順（ならんではいない）。"},
  {"en": "Builds a heap bottom-up in O(n): the strongest bolt comes first, with 1 more power, and the rest are in heap order.", "to": "下からヒープを作る。O(n)。いちばん強いボルトが威力+1で先頭になり、残りはヒープの順。"},
  {"en": "Increase Key", "to": "キー増加（ぞうか）"},
  {"en": "Increase Key+", "to": "キー増加（ぞうか）+"},
  {"en": "Raises the weakest bolt to one less than the strongest, then sifts it up into place.", "to": "いちばん弱いボルトを、最強のボルトより1だけ弱い威力まで上げ、ヒープの上へ浮かび上がらせる。"},
  {"en": "Raises the weakest bolt to equal the strongest, then sifts it up into place.", "to": "いちばん弱いボルトを、最強のボルトと同じ威力まで上げ、ヒープの上へ浮かび上がらせる。"},
  {"en": "Heap Sort", "to": "ヒープソート"},
  {"en": "Heap Sort+", "to": "ヒープソート+"},
  {"en": "Sorts weakest first, in place, in O(n log n) on every volley: it never meets quick sort's worst case.", "to": "弱い順にその場で並べかえる。どんな並びでも O(n log n)。クイックソートの最悪の場合にならない。"},
  {"en": "Sorts weakest first, in place, in O(n log n) on every volley. Costs 0 mana.", "to": "弱い順にその場で並べかえる。どんな並びでも O(n log n)。マナは0。"},
  {"en": "Fractional Knapsack", "to": "分数（ぶんすう）ナップサック"},
  {"en": "Fractional Knapsack+", "to": "分数（ぶんすう）ナップサック+"},
  {"en": "Cuts the strongest bolt into exactly the front foe's HP plus a remainder, then the next strongest for the next foe.", "to": "最強のボルトを、前の敵のHPちょうどの分と、あまりに切り分ける。次に強いボルトは次の敵へ。"},
  {"en": "Cuts the strongest bolt into exactly the front foe's HP plus a remainder that gains 1, then the next strongest for the next foe.", "to": "最強のボルトを、前の敵のHPちょうどの分と、威力+1のあまりに切り分ける。次に強いボルトは次の敵へ。"},
  {"en": "Minimum Arrows", "to": "ミニマム・アロー"},
  {"en": "Minimum Arrows+", "to": "ミニマム・アロー+"},
  {"en": "Each bolt, strongest first, pierces: what it does not spend on one foe flies on into the next, until it runs out.", "to": "強いボルトから順に、敵をつらぬく。1体に使いきれなかった分は、次の敵へ飛んでいく。なくなるまで続く。"},
  {"en": "Each bolt, strongest first, pierces with 1 more power at each foe: what it does not spend flies on into the next.", "to": "強いボルトから順につらぬく。敵を1体通るたびに威力が1上がり、次の敵へ飛んでいく。"},
  {"en": "Nearest Neighbour", "to": "最近傍（さいきんぼう）"},
  {"en": "Nearest Neighbour+", "to": "最近傍（さいきんぼう）+"},
  {"en": "Each bolt flies at the foe whose HP is closest to its power. Fast, usually good, sometimes silly.", "to": "各ボルトは、HPがボルトの威力にいちばん近い敵へ飛ぶ。速くて、たいてい良いが、ときどきおかしい。"},
  {"en": "Each bolt flies at the foe whose HP is closest to its power, preferring a foe it would kill.", "to": "各ボルトは、HPがボルトの威力にいちばん近い敵へ飛ぶ。倒せる敵を先に選ぶ。"},
  {"en": "Task Scheduler", "to": "タスクスケジューラー"},
  {"en": "Task Scheduler+", "to": "タスクスケジューラー+"},
  {"en": "Reorders the volley so no two bolts of one element are neighbours. Where that is impossible, a 1-power idle bolt goes between them.", "to": "同じ属性のボルトがとなりあわないように並べかえる。むりなときは、威力1のアイドルボルトを間にはさむ。"},
  {"en": "Reorders the volley so no two bolts of one element are neighbours. Where that is impossible, a 2-power idle bolt goes between them.", "to": "同じ属性のボルトがとなりあわないように並べかえる。むりなときは、威力2のアイドルボルトを間にはさむ。"}
]
