  {"en": "Missing destination", "to": "行き先がありません", "kanji": "行き先がありません"},
  {"en": "Destination map is missing", "to": "行き先のマップがありません", "kanji": "行き先のマップがありません"},
  {"en": "Destination cell is off the map", "to": "行き先のセルがマップ外です", "kanji": "行き先のセルがマップ外です"},
  {"en": "Destination triggers another entrance", "to": "行き先で別の入口が発動します", "kanji": "行き先で別の入口が発動します"},
  {"en": "Destination is blocked", "to": "行き先に立てません", "kanji": "行き先に立てません"},
  {"en": "Destination facing is invalid", "to": "行き先の向きが無効です", "kanji": "行き先の向きが無効です"},
  {"en": "This new map still has incoming links from %s. Unlink them before reverting.", "to": "新しいマップにはまだ%sから接続があります。元に戻す前に接続を解除してください。", "kanji": "新しいマップにはまだ%sから接続があります。元に戻す前に接続を解除してください。"},
  {"en": "Reverting will discard the new map '%s' and its draft contents, including furnishings. Continue?", "to": "元に戻すと、新しいマップ「%s」と部屋の案（家具を含む）が破棄されます。続けますか？", "kanji": "元に戻すと、新しいマップ「%s」と部屋の案（家具を含む）が破棄されます。続けますか？"},
  {"en": "keeps arrival facing", "to": "到着時の向きを維持", "kanji": "到着時の向きを維持"},
  {"en": "Locate", "to": "場所を表示", "kanji": "場所を表示"},
  {"en": "Link…", "to": "リンク…", "kanji": "リンク…"},
  {"en": "Change link…", "to": "リンク先を変更…", "kanji": "リンク先を変更…"},
  {"en": "Go to destination", "to": "行き先へ移動", "kanji": "行き先へ移動"},
  {"en": "Furnish room", "to": "部屋を整える", "kanji": "部屋を整える"},
  {"en": "Unlinked room draft", "to": "未接続の部屋案", "kanji": "未接続の部屋案"},
  {"en": "Room draft · %s", "to": "部屋案 · {1}", "kanji": "部屋案 · {1}"},
  {"en": "Locate room", "to": "部屋を表示", "kanji": "部屋を表示"},
  {"en": "Reconnect", "to": "再接続", "kanji": "再接続"},
  {"en": "Reconnect is available when the room exit matches exactly one unlinked building.", "to": "部屋の出口が未接続の建物ひとつに一致すると、再接続できます。", "kanji": "部屋の出口が未接続の建物ひとつに一致すると、再接続できます。"},
  {"en": "This room or its matching building changed; the draft list has been refreshed.", "to": "部屋または対応する建物が変更されたため、案の一覧を更新しました。", "kanji": "部屋または対応する建物が変更されたため、案の一覧を更新しました。"},
  {"en": "Reconnected %s. Furnish the room in Objects.", "to": "%sを再接続しました。「オブジェクト」で部屋を整えてください。", "kanji": "%sを再接続しました。「オブジェクト」で部屋を整えてください。"},
  {"en": "Make interior", "to": "室内を作る", "kanji": "室内を作る"},
  {"en": "Unlink", "to": "リンク解除", "kanji": "リンク解除"},
  {"en": "Delete transition…", "to": "遷移を削除…", "kanji": "遷移を削除…"},
  {"en": "No people match this view", "to": "条件に合う人物はいません", "kanji": "条件に合う人物はいません"},
  {"en": "No entrances on this map", "to": "このマップに入口はありません", "kanji": "このマップに入口はありません"},
  {"en": "unlinked room draft", "to": "未接続の部屋案", "kanji": "未接続の部屋案"},
  {"en": "Map start is shown below", "to": "マップの開始位置を表示しています", "kanji": "マップの開始位置を表示しています"},
  {"en": "Map start", "to": "マップの開始位置", "kanji": "マップの開始位置"},
  {"en": "%d, %d · facing %s", "to": "{1},{2} · 向き：{3}", "kanji": "{1},{2} · 向き：{3}"},
  {"en": "Facing for map start", "to": "開始位置の向き", "kanji": "開始位置の向き"},
  {"en": "Apply facing", "to": "向きを適用", "kanji": "向きを適用"},
  {"en": "This is where a new game begins on this map. It does not change saved character positions.", "to": "このマップで新しいゲームを始める場所です。保存済みキャラクターの位置は変わりません。", "kanji": "このマップで新しいゲームを始める場所です。保存済みキャラクターの位置は変わりません。"},
  {"en": "Set start…", "to": "開始位置を設定…", "kanji": "開始位置を設定…"},
  {"en": "Map start facing: %s", "to": "開始位置の向き：{1}", "kanji": "開始位置の向き：{1}"},
  {"en": "Facing: %s (R to turn)", "to": "向き：%s（Rで回転）", "kanji": "向き：%s（Rで回転）"},
  {"en": "Map %s is no longer available.", "to": "マップ「%s」は利用できなくなりました。", "kanji": "マップ「%s」は利用できなくなりました。"},
  {"en": "That person placement changed; the list has been refreshed.", "to": "人物の配置が変わったため、一覧を更新しました。", "kanji": "人物の配置が変わったため、一覧を更新しました。"},
  {"en": "That entrance changed; the list has been refreshed.", "to": "入口が変わったため、一覧を更新しました。", "kanji": "入口が変わったため、一覧を更新しました。"},
  {"en": "That person no longer has a placement on the remembered map.", "to": "記録したマップにこの人物の配置がありません。", "kanji": "記録したマップにこの人物の配置がありません。"},
  {"en": "The person was not moved.", "to": "人物は移動していません。", "kanji": "人物は移動していません。"},
  {"en": "Back to person", "to": "人物に戻る", "kanji": "人物に戻る"},
  {"en": "%s has an authored work schedule. Moving this person also requires a coordinated schedule update.", "to": "{1}には登録済みの勤務予定があります。人物の移動には予定の同時更新も必要です。", "kanji": "{1}には登録済みの勤務予定があります。人物の移動には予定の同時更新も必要です。"},
  {"en": "Moving them updates their authored Lanternroot work location too.", "to": "移動すると、ランタンルート内の登録済み勤務場所も更新されます。", "kanji": "移動すると、ランタンルート内の登録済み勤務場所も更新されます。"},
  {"en": "%s has Lanternroot-only schedule anchors and cannot move between maps.", "to": "{1}の予定位置はランタンルート内のみのため、マップ間を移動できません。", "kanji": "{1}の予定位置はランタンルート内のみのため、マップ間を移動できません。"},
  {"en": "This scheduled person must stay at their authored Lanternroot work cell.", "to": "予定のある人物は、ランタンルートの登録済み勤務セルに配置してください。", "kanji": "予定のある人物は、ランタンルートの登録済み勤務セルに配置してください。"},
  {"en": "Scheduled people cannot be placed outside Lanternroot.", "to": "予定のある人物はランタンルート以外に配置できません。", "kanji": "予定のある人物はランタンルート以外に配置できません。"},
  {"en": "%s is scheduled and needs one authored placement. Remove only duplicate placements.", "to": "{1}には予定があり、登録済みの配置が一つ必要です。重複した配置だけを削除してください。", "kanji": "{1}には予定があり、登録済みの配置が一つ必要です。重複した配置だけを削除してください。"},
  {"en": "The authored dialogue file is missing. Repair it before editing dialogue.", "to": "登録済みの会話ファイルがありません。修復してから編集してください。", "kanji": "登録済みの会話ファイルがありません。修復してから編集してください。"},
  {"en": "Talk file ID: %s", "to": "会話ファイルID：{1}", "kanji": "会話ファイルID：{1}"},
  {"en": "The new transition could not be removed after cancel. Delete it before publishing.", "to": "取消後に新しい遷移を削除できませんでした。公開前に遷移を削除してください。", "kanji": "取消後に新しい遷移を削除できませんでした。公開前に遷移を削除してください。"},
  {"en": "Place and link transition", "to": "遷移を配置して接続", "kanji": "遷移を配置して接続"},
  {"en": "Place transition", "to": "遷移を配置", "kanji": "遷移を配置"},
  {"en": "This cell is outside the map.", "to": "このセルはマップの外です。", "kanji": "このセルはマップの外です。"},
  {"en": "People and the map start cannot stand on a door or transition.", "to": "人物や開始位置をドアまたは遷移セルに置くことはできません。", "kanji": "人物や開始位置をドアまたは遷移セルに置くことはできません。"},
  {"en": "This cell is not open, walkable ground.", "to": "このセルは通行可能な地面ではありません。", "kanji": "このセルは通行可能な地面ではありません。"},
  {"en": "%s has multiple authored placements. Remove the extra placement before moving them.", "to": "%sには配置が複数あります。移動する前に余分な配置を削除してください。", "kanji": "%sには配置が複数あります。移動する前に余分な配置を削除してください。"},
  {"en": "The move could not be staged for both maps: %s", "to": "両方のマップで移動を準備できませんでした：%s", "kanji": "両方のマップで移動を準備できませんでした：%s"},
  {"en": "Arrive facing down", "to": "下向きで到着", "kanji": "下向きで到着"},
  {"en": "Arrive facing up", "to": "上向きで到着", "kanji": "上向きで到着"},
  {"en": "Arrive facing left", "to": "左向きで到着", "kanji": "左向きで到着"},
  {"en": "Arrive facing right", "to": "右向きで到着", "kanji": "右向きで到着"},
  {"en": "Linking %s: choose a map in the picker, click the cell to arrive on, then the way to face (Esc lets go)", "to": "%sを接続中：マップを選び、到着セルをクリックして向きを選択（Escで取消）", "kanji": "%sを接続中：マップを選び、到着セルをクリックして向きを選択（Escで取消）"},
  {"en": "Let go of linking %s", "to": "%sの接続を取り消しました", "kanji": "%sの接続を取り消しました"},
  {"en": "Could not link %s: its map or the door is not there any more", "to": "%sを接続できません。マップまたはドアが見つかりません。", "kanji": "%sを接続できません。マップまたはドアが見つかりません。"},
  {"en": "Linked: %s leads to %s at %d, %d, facing %s", "to": "{1}は{2}の{3},{4}に接続しました（向き：{5}）", "kanji": "{1}は{2}の{3},{4}に接続しました（向き：{5}）"},
  {"en": "The map's start is now %d, %d", "to": "マップの開始位置を{1},{2}に設定しました", "kanji": "マップの開始位置を{1},{2}に設定しました"},
  {"en": "%s stands in %s at %d, %d. A person stands in one place: move them here?", "to": "%sは「%s」の%d,%dにいます。人物は一か所にだけ配置できます。ここへ移動しますか？", "kanji": "%sは「%s」の%d,%dにいます。人物は一か所にだけ配置できます。ここへ移動しますか？"},
  {"en": "Placed %s (moved from %s)", "to": "%sを「%s」から移動しました", "kanji": "%sを「%s」から移動しました"},
  {"en": "Placed %s", "to": "%sを配置しました", "kanji": "%sを配置しました"},
  {"en": "Create a separate map scene", "to": "別のエリアを作る", "kanji": "別のエリアを作る"},
  {"en": "New area", "to": "新しいエリア", "kanji": "新しいエリア"},
  {"en": "Create area", "to": "エリアを作成", "kanji": "エリアを作成"},
  {"en": "Area name", "to": "エリア名", "kanji": "エリア名"},
  {"en": "Map id", "to": "マップID", "kanji": "マップID"},
  {"en": "Size in tiles", "to": "タイルの大きさ", "kanji": "タイルの大きさ"},
  {"en": "Start cell", "to": "開始位置", "kanji": "開始位置"},
  {"en": "Start facing", "to": "開始方向", "kanji": "開始方向"},
  {"en": "Facing up", "to": "上向き", "kanji": "上向き"},
  {"en": "Facing down", "to": "下向き", "kanji": "下向き"},
  {"en": "Facing left", "to": "左向き", "kanji": "左向き"},
  {"en": "Facing right", "to": "右向き", "kanji": "右向き"},
  {"en": "Starting ground", "to": "最初の地面", "kanji": "最初の地面"},
  {"en": "Creates a walkable outdoor map draft and opens it in Land. Use People & Doors to link it from a door or warp, then Publish.", "to": "歩ける屋外マップの案を作り、地面編集で開きます。人物とドアからドアやワープを接続し、公開してください。", "kanji": "歩ける屋外マップの案を作り、地面編集で開きます。人物とドアからドアやワープを接続し、公開してください。"},
  {"en": "Choose dimensions up to %d tiles on each side.", "to": "各辺を最大{1}タイルまで設定できます。", "kanji": "各辺を最大{1}タイルまで設定できます。"},
  {"en": "%d × %d tiles · %d cells · start at %d, %d · %s · %s", "to": "{1} × {2}タイル · {3}マス · 開始位置 {4},{5} · {6} · {7}", "kanji": "{1} × {2}タイル · {3}マス · 開始位置 {4},{5} · {6} · {7}"},
  {"en": "No walkable outdoor ground is available.", "to": "歩ける屋外の地面がありません。", "kanji": "歩ける屋外の地面がありません。"},
  {"en": "Check the area name and settings.", "to": "エリア名と設定を確認してください。", "kanji": "エリア名と設定を確認してください。"},
  {"en": "That map id is already in use.", "to": "そのマップIDはすでに使われています。", "kanji": "そのマップIDはすでに使われています。"},
  {"en": "The map could not be created. Check that its id is available and the draft folder is writable.", "to": "マップを作成できませんでした。IDと案の保存先を確認してください。", "kanji": "マップを作成できませんでした。IDと案の保存先を確認してください。"},
  {"en": "Created %s. Build it in Land, connect it from a door or warp, then Publish.", "to": "%sを作成しました。地面編集で作り、ドアやワープで接続してから公開してください。", "kanji": "%sを作成しました。地面編集で作り、ドアやワープで接続してから公開してください。"},
  {"en": "Rows and columns to add at each edge; below zero takes them away. Things move with their cells. Maximum size: 128 × 128 tiles.", "to": "各辺に追加する行数と列数です。負の数で削除します。物はマスと一緒に移動します。最大は128 × 128タイルです。", "kanji": "各辺に追加する行数と列数です。負の数で削除します。物はマスと一緒に移動します。最大は128 × 128タイルです。"},
  {"en": "Authored: %s at %d, %d · %s", "to": "登録位置：{1} の {2},{3} · {4}", "kanji": "登録位置：{1} の {2},{3} · {4}"},
  {"en": "Read-only authored definition", "to": "登録情報（読み取り専用）", "kanji": "登録情報（読み取り専用）"},
  {"en": "Gives %s", "to": "依頼：{1}", "kanji": "依頼：{1}"},
  {"en": "That quest is no longer available.", "to": "そのクエストは利用できなくなりました。", "kanji": "そのクエストは利用できなくなりました。"},
  {"en": "Locate the entrance that has this problem", "to": "問題のある入口を表示します", "kanji": "問題のある入口を表示します"},
  {"en": "Repair link…", "to": "接続を修復…", "kanji": "接続を修復…"},
