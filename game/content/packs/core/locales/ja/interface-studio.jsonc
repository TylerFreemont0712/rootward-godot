// Lanternroot Studio's People & Doors workspace and its placement/link messages.
// Numbered slots preserve each argument across both Japanese reading editions.
[
  {"en": "WASD/arrows: pan · Click: arrival · Esc: cancel", "to": "WASD・矢印：移動 · クリック：到着先 · Esc：取消", "kanji": "WASD・矢印：移動 · クリック：到着先 · Esc：取消"},
  {"en": "the door of %s", "to": "{1}の入口", "kanji": "{1}の入口"},
  {"en": "the warp", "to": "通り道", "kanji": "通り道"},
  {"en": "%s · %s at %d, %d", "to": "{1} · {2} の {3},{4}", "kanji": "{1} · {2} の {3},{4}"},
  {"en": "Destination map", "to": "行き先のマップ", "kanji": "行き先のマップ"},
  {"en": "Cancel link (Esc)", "to": "接続をやめる（Esc）", "kanji": "接続をやめる（Esc）"},
  {"en": "Choose a destination map, then click an arrival cell in the world.", "to": "行き先のマップを選んで、到着するマスを押してください。", "kanji": "行き先のマップを選んで、到着するマスを押してください。"},
  {"en": "Click open ground to choose where the player arrives.", "to": "空いているマスを押して、到着する場所を選んでください。", "kanji": "空いているマスを押して、到着する場所を選んでください。"},
  {"en": "Choose the arrival facing. Escape cancels the entire link.", "to": "到着時の向きを選んでください。Escで接続を取り消せます。", "kanji": "到着時の向きを選んでください。Escで接続を取り消せます。"},
  {"en": "One-way link. The destination and its return entrance stay as authored.", "to": "一方通行の接続です。行き先の帰り口はそのままです。", "kanji": "一方通行の接続です。行き先の帰り口はそのままです。"},
  {"en": "Valid arrival cell", "to": "到着できるマス", "kanji": "到着できるマス"},
  {"en": "Arrival: %s at %d, %d", "to": "到着先：{1} の {2},{3}", "kanji": "到着先：{1} の {2},{3}"},
  {"en": "Source", "to": "出発元", "kanji": "出発元"},
  {"en": "Arrival", "to": "到着先", "kanji": "到着先"},
