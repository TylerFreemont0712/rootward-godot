  {"en": "Scheduled", "to": "予定あり", "kanji": "予定あり"},
  {"en": "Scheduled — placement is the authored location", "to": "予定あり — 配置は登録済みの場所です", "kanji": "予定あり — 配置は登録済みの場所です"},
  {"en": "No authored placement", "to": "配置なし", "kanji": "配置なし"},
  {"en": "Unknown person ID in map data", "to": "マップデータに未登録の人物IDがあります", "kanji": "マップデータに未登録の人物IDがあります"},
  {"en": "%s · duplicate placement", "to": "{1} · 配置重複", "kanji": "{1} · 配置重複"},
  {"en": "Select this authored placement", "to": "この配置を選択", "kanji": "この配置を選択"},
  {"en": "Place here", "to": "ここに配置", "kanji": "ここに配置"},
  {"en": "Resolve duplicate placements before moving this person", "to": "重複配置を解消してから移動してください", "kanji": "重複配置を解消してから移動してください"},
  {"en": "Edit dialogue", "to": "会話を編集", "kanji": "会話を編集"},
  {"en": "ID: %s", "to": "ID：{1}", "kanji": "ID：{1}"},
  {"en": "Home", "to": "自宅", "kanji": "自宅"},
