  {"en": "%s (%d)", "to": "{1}（{2}）", "kanji": "{1}（{2}）"},
  {"en": "Search people, places or IDs", "to": "人物、場所、IDを検索", "kanji": "人物、場所、IDを検索"},
  {"en": "Map: %s · %s", "to": "マップ：{1} · {2}", "kanji": "マップ：{1} · {2}"},
