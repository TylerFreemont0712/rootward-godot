// Japanese for the shortcuts, menu, options, volume and music tasks (Concept/v0.4/06): names, goals, hints, advice,
// the glossary's meanings, the cases, the Builder's labels and the starter code's comments, keyed by the English
// exactly (ADR-0047). Code, placeholders and the code words in quotes stay as they are.
[
  // tasks/menu
  {"en": "A list: things in square brackets, in order, with commas between them. [] is an empty list.", "to": "リストは、[ ] の かっこの なかに、ものを じゅんばんに ならべて、あいだを カンマで わけるよ。[] は からの リストだよ。", "kanji": "リストは、[ ] の括弧の中に、ものを順番に並べて、間をカンマで分けるよ。[] は空のリストだよ。"},
  {"en": "A menu is a list, and a list keeps its order. Which thing should the player see first, and which should be last?", "to": "メニューは リストだよ。リストは じゅんばんを まもるよ。プレイヤーが さいしょに みる ものは なに？ さいごに みる ものは なに？", "kanji": "メニューはリストだよ。リストは順番を守るよ。プレイヤーが最初に見るものは何？最後に見るものは何？"},
  {"en": "Add everything the town built", "to": "まちが つくった こうもく ぜんぶを くわえる", "kanji": "町が作った項目全部を加える"},
  {"en": "Adds one thing to the end of a list. Written as the list, a dot, then append.", "to": "リストの おわりに ものを ひとつ くわえるよ。かくときは、リスト、ドット（.）、append の じゅんだよ。", "kanji": "リストの終わりにものを一つ加えるよ。かくときは、リスト、ドット（.）、append の順だよ。"},
  {"en": "Adds one thing to the end of a list. Written as the list, a dot, then push.", "to": "リストの おわりに ものを ひとつ くわえるよ。かくときは、リスト、ドット（.）、push の じゅんだよ。", "kanji": "リストの終わりにものを一つ加えるよ。かくときは、リスト、ドット（.）、push の順だよ。"},
  {"en": "Goes through a list one thing at a time. The lines in its braces run once for each thing.", "to": "リストの ものを ひとつずつ とおるよ。かっこ { } の なかの ぎょうは、ものが ひとつ あるたびに 1かいずつ うごくよ。", "kanji": "リストのものを一つずつ通るよ。括弧 { } の中の行は、ものが一つあるたびに 1回ずつ動くよ。"},
  {"en": "Goes through a list one thing at a time. The lines under it run once for each thing.", "to": "リストの ものを ひとつずつ とおるよ。その した の ぎょうは、ものが ひとつ あるたびに 1かいずつ うごくよ。", "kanji": "リストのものを一つずつ通るよ。そのしたの行は、ものが一つあるたびに 1回ずつ動くよ。"},
  {"en": "Joins a list onto the end of another, and gives back the joined list.", "to": "リストを ほかの リストの おわりに つなげて、つなげた リストを かえすよ。", "kanji": "リストを他のリストの終わりに繋げて、つなげたリストを返すよ。"},
  {"en": "Joins two lists into one: the first list's things, then the second's.", "to": "ふたつの リストを ひとつに つなげるよ。さいしょの リストの もの、そのあとに つぎの リストの もの。", "kanji": "二つのリストを一つに繋げるよ。最初のリストのもの、その後に次のリストのもの。"},
  {"en": "Make the menu list what the town built, with \"continue\" first and \"quit\" last.", "to": "メニューに、まちが つくった ものを ならべよう。さいしょは \"continue\"、さいごは \"quit\" だよ。", "kanji": "メニューに、町が作ったものを並べよう。最初は \"continue\"、最後は \"quit\" だよ。"},
  {"en": "Start your own list with the first item in it, then add each item from built to its end, then add the last item. Adding one thing to the end of a list is append in Python and push in JavaScript.", "to": "じぶんの リストは、さいしょの もの を いれて はじめよう。つぎに built の もの を ひとつずつ おわりに くわえて、さいごの もの を くわえるよ。おわりに ひとつ くわえる のは、Python では append、JavaScript では push だよ。", "kanji": "自分のリストは、最初のものを入れて始めよう。次に built のものを一つずつ終わりに加えて、最後のものを加えるよ。終わりに一つ加えるのは、Python では append、JavaScript では push だよ。"},
  {"en": "The Menu", "to": "メニュー", "kanji": "メニュー"},
  {"en": "The items the menu shows, in order: \"continue\" first, \"quit\" last, and every item of built once in between.", "to": "メニューに でる こうもくの リスト。じゅんばんに、さいしょは \"continue\"、さいごは \"quit\"、そのあいだに built の こうもくが ひとつずつ はいるよ。", "kanji": "メニューに出る項目のリスト。順番に、最初は \"continue\"、最後は \"quit\"、そのあいだに built の項目が一つずつ入るよ。"},
  {"en": "The items the town can show now, in the town's own order. Each is a word such as \"quests\", \"bag\" or \"settings\".", "to": "いま まちが みせられる こうもく。まちが きめた じゅんばんのまま。ひとつひとつは、\"quests\"、\"bag\"、\"settings\" のような ことばだよ。", "kanji": "今町が見せられる項目。町が決めたじゅんばんのまま。ひとつひとつは、\"quests\"、\"bag\"、\"settings\" のような言葉だよ。"},
  {"en": "The menu has to end with \"quit\". Yours ends with {got}.", "to": "メニューは \"quit\" で おわらないと いけないよ。きみの メニューは {got} で おわって いるよ。", "kanji": "メニューは \"quit\" で終わらないといけないよ。君のメニューは {got} で終わっているよ。"},
  {"en": "The menu has to start with \"continue\", so the player can always go back to the town. Yours starts with {got}.", "to": "メニューは \"continue\" で はじまらないと いけないよ。そうすれば、プレイヤーは いつでも まちに もどれるからね。きみの メニューは {got} で はじまって いるよ。", "kanji": "メニューは \"continue\" で始まらないといけないよ。そうすれば、プレイヤーはいつでも町に戻れるからね。君のメニューは {got} で始まっているよ。"},
  {"en": "The town's items are in built. A loop can visit each of them in turn, one at a time, while your own list grows.", "to": "まちの こうもくは built に はいって いるよ。くりかえしなら、ひとつずつ じゅんに まわれるよ。そのあいだ、きみの リストは どんどん のびて いくよ。", "kanji": "町の項目は built に入っているよ。繰り返しなら、一つずつ順に回れるよ。そのあいだ、君のリストはどんどん伸びていくよ。"},
  {"en": "Your menu leaves out {name}, which the town built. Every item the town built goes on the menu.", "to": "きみの メニューには、まちが つくった {name} が ないよ。まちが つくった こうもくは、ぜんぶ メニューに のせるんだよ。", "kanji": "君のメニューには、町が作った {name} がないよ。町が作った項目は、全部メニューに載せるんだよ。"},
  {"en": "Your menu should give back a list of items, in square brackets, but it gave back {got}.", "to": "メニューは、[ ] の かっこで かこんだ こうもくの リストを かえさないと いけないよ。でも、かえして いたのは {got} だったよ。", "kanji": "メニューは、[ ] の括弧で囲んだ項目のリストを返さないといけないよ。でも、返していたのは {got} だったよ。"},
  {"en": "Your menu shows what your menu_items() gives back.", "to": "きみの メニューには、menu_items() が かえした ものが でるよ。", "kanji": "君のメニューには、menu_items() が返したものがでるよ。"},
  {"en": "Your own menu", "to": "じぶんの メニュー", "kanji": "自分のメニュー"},
  {"en": "a fresh tinker's town", "to": "まっさらな しゅうりやさんの まち", "kanji": "まっさらな修理屋さんの町"},
  {"en": "a longer town, with the bag, the map, the music box and the options", "to": "かばん、ちず、オルゴール、オプションが ある ながい まち", "kanji": "鞄、地図、オルゴール、オプションがある長い町"},
  {"en": "a short town with only Settings", "to": "せってい だけの みじかい まち", "kanji": "設定だけの短い町"},
  {"en": "ends with", "to": "さいごは", "kanji": "最後は"},
  {"en": "starts with", "to": "さいしょは", "kanji": "最初は"},
  {"en": "{name} is on the menu twice. Each item goes on the menu once.", "to": "{name} が メニューに ふたつ あるよ。こうもくは、メニューに ひとつずつ のせるんだよ。", "kanji": "{name} がメニューに二つあるよ。項目は、メニューに一つずつ載せるんだよ。"},
  {"en": "{name} isn't something the town built, and it isn't continue or quit. Check the spelling, or take it out.", "to": "{name} は まちが つくった もの じゃ ないし、continue でも quit でも ないよ。つづりを たしかめるか、けして みてね。", "kanji": "{name} は町が作ったものじゃないし、continue でも quit でもないよ。つづりを確かめるか、消してみてね。"},
  // tasks/menu: the comments of the starter code
  {"en": "Give back the list the menu shows: continue first, quit last, and each item of built once.", "to": "メニューに でる リストを かえしてね。さいしょは continue、さいごは quit、そして built の こうもくを ひとつずつ いれてね。", "kanji": "メニューに出るリストを返してね。最初は continue、最後は quit、そして built の項目を一つずつ入れてね。"},
  {"en": "built is the list of items the town can show now, in the town's own order.", "to": "built は、いま まちが みせられる こうもくの リストだよ。まちが きめた じゅんばんのまま。", "kanji": "built は、今町が見せられる項目のリストだよ。町が決めたじゅんばんのまま。"},
  // tasks/music
  {"en": "A list of songs. Each song is a dictionary with \"id\", \"title\" and \"place\" in it.", "to": "きょくの リスト。きょくは、\"id\"、\"title\"、\"place\" を もつ 辞書だよ。", "kanji": "曲のリスト。曲は、\"id\"、\"title\"、\"place\" を持つ辞書だよ。"},
  {"en": "Adds one item to the end of a list.", "to": "リストの おわりに もの を ひとつ くわえるよ。", "kanji": "リストの終わりにものを一つ加えるよ。"},
  {"en": "After the last track there is no next number, so the count has to wrap around to 0. Think about what happens to a number that goes past count minus 1.", "to": "さいごの きょくの あとに、つぎの ばんごうは ないよ。だから かずは 0 に まわって もどらないと いけないよ。count から 1 ひいた 数を こえた かずは、どう なるかな？", "kanji": "最後の曲の後に、次の番号はないよ。だから数は 0 に回って戻らないといけないよ。count から 1 引いた数をこえた数は、どうなるかな？"},
  {"en": "After the last track, {got} is too far. The last track should go round to the first.", "to": "さいごの きょくの あとに {got} は とおすぎるよ。さいごの きょくの つぎは、さいしょの きょくに まわらないと いけないよ。", "kanji": "最後の曲の後に {got} はとおすぎるよ。最後の曲の次は、最初の曲に回らないといけないよ。"},
  {"en": "An empty list, with nothing in it yet.", "to": "まだ なにも はいって いない、からの リストだよ。", "kanji": "まだ何も入っていない、空のリストだよ。"},
  {"en": "Each track is a dictionary with three named parts. Which part holds the name you want to write down?", "to": "きょくは、なまえの ついた 3つの ぶぶんを もつ 辞書だよ。かきとめたい なまえは、どの ぶぶんに はいって いるかな？", "kanji": "曲は、名前の付いた 3つの部分を持つ辞書だよ。書き留めたい名前は、どの部分に入っているかな？"},
  {"en": "For {say}, next_track gave {got}, but the next track is {want}. Track numbers start at 0.", "to": "「{say}」の とき、next_track は {got} を かえしたけど、つぎの きょくは {want} だよ。きょくの ばんごうは 0 から はじまるよ。", "kanji": "「{say}」のとき、next_track は {got} を返したけど、次の曲は {want} だよ。曲の番号は 0 から始まるよ。"},
  {"en": "For {say}, titles() gave nothing back. It should give back a list of titles, one for each track.", "to": "「{say}」の とき、titles() は なにも かえさなかったよ。きょくごとに ひとつずつ、なまえの リストを かえさないと いけないよ。", "kanji": "「{say}」のとき、titles() は何も返さなかったよ。曲ごとに一つずつ、名前のリストを返さないといけないよ。"},
  {"en": "For {say}, titles() gave {got} where {want} belongs. Look at which part of each track you take.", "to": "「{say}」の とき、titles() は {want} が はいる ところに {got} を かえしたよ。きょくの どの ぶぶんを とって いるか、見てみよう。", "kanji": "「{say}」のとき、titles() は {want} が入るところに {got} を返したよ。曲のどの部分を取っているか、見てみよう。"},
  {"en": "For {say}, titles() gave {got}. It should give back a list of titles.", "to": "「{say}」の とき、titles() は {got} を かえしたよ。かえすのは、なまえの リストだよ。", "kanji": "「{say}」のとき、titles() は {got} を返したよ。返すのは、名前のリストだよ。"},
  {"en": "For {say}, your list {got} has the wrong number of titles. Look at how many tracks go into the loop.", "to": "「{say}」の とき、きみの リスト {got} は、なまえの かずが あわないよ。くりかえしに いくつの きょくが はいるか、見てみよう。", "kanji": "「{say}」のとき、君のリスト {got} は、名前の数が合わないよ。繰り返しにいくつの曲が入るか、見てみよう。"},
  {"en": "Go on to the next track", "to": "つぎの きょくへ すすむ", "kanji": "次の曲へ進む"},
  {"en": "Go through every track", "to": "きょくを ぜんぶ とおる", "kanji": "曲を全部通る"},
  {"en": "Goes through a list one item at a time, giving each item a name while the lines in its braces run.", "to": "リストの ものを ひとつずつ とおるよ。かっこ { } の なかの ぎょうが うごく あいだ、それぞれの ものに なまえを つけるんだよ。", "kanji": "リストのものを一つずつ通るよ。括弧 { } の中の行が動く間、それぞれのものに名前を付けるんだよ。"},
  {"en": "Goes through a list one item at a time, giving each item a name while the lines under it run.", "to": "リストの ものを ひとつずつ とおるよ。その した の ぎょうが うごく あいだ、それぞれの ものに なまえを つけるんだよ。", "kanji": "リストのものを一つずつ通るよ。そのしたの行が動く間、それぞれのものに名前を付けるんだよ。"},
  {"en": "How many tracks there are.", "to": "きょくが いくつ あるか。", "kanji": "曲がいくつあるか。"},
  {"en": "Make next_track(index, count) give the number of the track after this one, going back to 0 after the last.", "to": "next_track(index, count) が、いまの きょくの つぎの きょくの ばんごうを かえすように しよう。さいごの きょくの あとは 0 に もどるよ。", "kanji": "next_track(index, count) が、今の曲の次の曲の番号を返すようにしよう。最後の曲の後は 0 に戻るよ。"},
  {"en": "Make titles() give back the title of every track, in order.", "to": "titles() が、きょく ぜんぶの なまえを じゅんばんに かえすように しよう。", "kanji": "titles() が、曲全部の名前を順番に返すようにしよう。"},
  {"en": "Start with an empty list of names. Then visit each track in the list, one after another, the way a loop goes through every item.", "to": "なまえの からの リストから はじめよう。そして、くりかえしが ものを ひとつずつ まわるように、きょくを ひとつずつ まわろう。", "kanji": "名前の空のリストから始めよう。そして、繰り返しがものを一つずつ回るように、曲を一つずつ回ろう。"},
  {"en": "Takes one named part out of a dictionary.", "to": "辞書から、なまえの ぶぶんを ひとつ とりだすよ。", "kanji": "辞書から、名前の部分を一つ取り出すよ。"},
  {"en": "Takes one named part out of an object.", "to": "オブジェクトから、なまえの ぶぶんを ひとつ とりだすよ。", "kanji": "オブジェクトから、名前の部分を一つ取り出すよ。"},
  {"en": "The % sign, in both languages, gives the remainder: what is left over after a division. Which number should the next one be divided by, so the answer stays below count?", "to": "% の しるしは、Python でも JavaScript でも、あまりを かえすよ。わり算のあとに のこった 数のことだよ。つぎの きょくの ばんごうは、なんで われば、こたえが count より 小さい ままに なるかな？", "kanji": "% の印は、Python でも JavaScript でも、余りを返すよ。わり算のあとに残った数のことだよ。次の曲の番号は、なんでわれば、答えが count より小さいままになるかな？"},
  {"en": "The Music Box", "to": "オルゴール", "kanji": "オルゴール"},
  {"en": "The music box plays the titles your titles() lists.", "to": "オルゴールは、きみの titles() が かえす なまえの きょくを ながすよ。", "kanji": "オルゴールは、君の titles() が返す名前の曲をながすよ。"},
  {"en": "The number of the next track: a whole number from 0 up to count minus 1.", "to": "つぎの きょくの ばんごう。0 から、count から 1 ひいた 数 までの せいすう。", "kanji": "次の曲の番号。0 から、count から 1 引いた数までの整数。"},
  {"en": "The number of the track playing: 0 is the first track, and count minus 1 is the last.", "to": "かかって いる きょくの ばんごう。0 が さいしょの きょくで、count から 1 ひいた 数 が さいごの きょくだよ。", "kanji": "かかっている曲の番号。0 が最初の曲で、count から 1 引いた数が最後の曲だよ。"},
  {"en": "The titles, as text, in the same order as the songs.", "to": "なまえ（もじ）を、きょくと おなじ じゅんばんで。", "kanji": "名前（文字）を、曲と同じ順番で。"},
  {"en": "The tool that adds one item to the end of a list is called append. Give the list back after the loop, not inside it.", "to": "リストの おわりに もの を くわえる どうぐは、append と いうよ。リストは くりかえしの なかじゃなく、おわった あとに かえそうね。", "kanji": "リストの終わりにものを加える道具は、append というよ。リストは繰り返しの中じゃなく、終わった後に返そうね。"},
  {"en": "Your function is given the number of the track playing, and how many tracks there are. What number comes after the track you are on?", "to": "きみの かんすうには、かかって いる きょくの ばんごうと、きょくが いくつ あるかが わたされるよ。いま かかって いる きょくの つぎには、どの 数が くるかな？", "kanji": "君の関数には、かかっている曲の番号と、曲がいくつあるかが渡されるよ。今かかっている曲の次には、どの数がくるかな？"},
  {"en": "do what to the number", "to": "数に なにを する", "kanji": "数に何をする"},
  {"en": "next_track should give back a whole number, the number of the next track, such as 2. {got} is not one.", "to": "next_track は、せいすう を かえさないと いけないよ。つぎの きょくの ばんごう、たとえば 2 みたいにね。{got} は せいすうじゃ ないよ。", "kanji": "next_track は、整数を返さないといけないよ。次の曲の番号、例えば 2 みたいにね。{got} は整数じゃないよ。"},
  {"en": "no tracks at all (an empty list)", "to": "からの リスト（きょくが ひとつも ない）", "kanji": "空のリスト（曲が一つもない）"},
  {"en": "one track", "to": "きょくが 1つ", "kanji": "曲が 1つ"},
  {"en": "the only track playing", "to": "かかって いる きょくが ひとつだけ", "kanji": "かかっている曲が一つだけ"},
  {"en": "the part of each track", "to": "きょくごとの ぶぶん", "kanji": "曲ごとの部分"},
  {"en": "three tracks", "to": "きょくが 3つ", "kanji": "曲が 3つ"},
  {"en": "track 0 of 3 playing", "to": "かかって いる 3つの うち 0ばんめの きょく", "kanji": "かかっている 3つのうち 0番目の曲"},
  {"en": "track 1 of 3 playing", "to": "かかって いる 3つの うち 1ばんめの きょく", "kanji": "かかっている 3つのうち 1番目の曲"},
  {"en": "track 2 of 3 playing, the last one", "to": "かかって いる 3つの うち 2ばんめ、さいごの きょく", "kanji": "かかっている 3つのうち 2番目、最後の曲"},
  {"en": "track 4 of 5 playing, the last one", "to": "かかって いる 5つの うち 4ばんめ、さいごの きょく", "kanji": "かかっている 5つのうち 4番目、最後の曲"},
  // tasks/music: the comments of the starter code
  {"en": "Give back a list of the titles, in the same order as the tracks.", "to": "なまえの リストを かえしてね。きょくと おなじ じゅんばんで。", "kanji": "名前のリストを返してね。曲と同じ順番で。"},
  {"en": "tracks is a list of tracks. Each track is a dictionary with \"id\", \"title\" and \"place\" in it.", "to": "tracks は きょくの リストだよ。きょくは、\"id\"、\"title\"、\"place\" を もつ 辞書だよ。", "kanji": "tracks は曲のリストだよ。曲は、\"id\"、\"title\"、\"place\" を持つ辞書だよ。"},
  {"en": "tracks is a list of tracks. Each track is an object with \"id\", \"title\" and \"place\" in it.", "to": "tracks は きょくの リストだよ。きょくは、\"id\"、\"title\"、\"place\" を もつ オブジェクトだよ。", "kanji": "tracks は曲のリストだよ。曲は、\"id\"、\"title\"、\"place\" を持つオブジェクトだよ。"},
  // tasks/options
  {"en": "A dictionary: pairs of a name and a value, in curly braces, with a colon between each name and its value and a comma between the pairs.", "to": "辞書：なまえと あたいの ペアを、{ } の かっこで かこんだ もの。なまえと あたいの あいだは コロン（:）、ペアと ペアの あいだは カンマで わけるよ。", "kanji": "辞書：名前と値のペアを、{ } の括弧で囲んだもの。名前と値の間はコロン（:）、ペアとペアの間はカンマで分けるよ。"},
  {"en": "A list: things in square brackets, in order, with commas between them.", "to": "リスト：[ ] の かっこで かこんだ もの を、じゅんばんに ならべて、あいだを カンマで わけたもの。", "kanji": "リスト：[ ] の括弧で囲んだものを、順番に並べて、間をカンマで分けたもの。"},
  {"en": "A row for full screen", "to": "ぜんがめんの ぎょうを いれる", "kanji": "ぜんがめんの行を入れる"},
  {"en": "A row for the music", "to": "おんがくの ぎょうを いれる", "kanji": "音楽の行を入れる"},
  {"en": "A row for the music box's track", "to": "オルゴールの きょくの ぎょうを いれる", "kanji": "オルゴールの曲の行を入れる"},
  {"en": "A row for the sound", "to": "おとの ぎょうを いれる", "kanji": "音の行を入れる"},
  {"en": "A row for the text speed", "to": "もじの はやさの ぎょうを いれる", "kanji": "文字の速さの行を入れる"},
  {"en": "An object: pairs of a name and a value, in curly braces, with a colon between each name and its value and a comma between the pairs.", "to": "オブジェクト：なまえと あたいの ペアを、{ } の かっこで かこんだ もの。なまえと あたいの あいだは コロン（:）、ペアと ペアの あいだは カンマで わけるよ。", "kanji": "オブジェクト：名前と値のペアを、{ } の括弧で囲んだもの。名前と値の間はコロン（:）、ペアとペアの間はカンマで分けるよ。"},
  {"en": "Each row is a dictionary: pairs of a name and a value, in curly braces. Every row needs a setting and a label.", "to": "ぎょうは 辞書だよ。なまえと あたいの ペアを { } の かっこで かいて、どの ぎょうにも setting と ラベルが いるよ。", "kanji": "行は辞書だよ。名前と値のペアを { } の括弧で書いて、どの行にも setting とラベルがいるよ。"},
  {"en": "Item {index} in your list isn't a row (the first item is 0, as code counts). A row needs a setting and a label, in curly braces.", "to": "きみの リストの、ばんごう {index} の もの は ぎょうじゃ ないよ（コードでは、さいしょの もの を 0 と かぞえるよ）。ぎょうには、{ } の かっこで かこんだ setting と ラベル が いるよ。", "kanji": "君のリストの、番号 {index} のものは行じゃないよ（コードでは、最初のものを 0 と数えるよ）。行には、{ } の括弧で囲んだ setting とラベルがいるよ。"},
  {"en": "Make the Options page list a row for music and a row for sound, and any other rows you like.", "to": "オプションの ページに、おんがくの ぎょうと おとの ぎょうを ならべよう。ほかの ぎょうは、すきに いれて いいよ。", "kanji": "オプションのページに、音楽の行と音の行を並べよう。他の行は、すきに入れていいよ。"},
  {"en": "The Options Page", "to": "オプションの ページ", "kanji": "オプションのページ"},
  {"en": "The Options page has no row for {name}. Music and sound always need a row.", "to": "オプションの ページに {name} の ぎょうが ないよ。おんがくと おとは、いつも ぎょうが いるよ。", "kanji": "オプションのページに {name} の行がないよ。音楽と音は、いつも行がいるよ。"},
  {"en": "The Options page is a list of rows, and each row is one thing the player can turn. What does each row need to say?", "to": "オプションの ページは、ぎょうの リストだよ。ぎょうは、プレイヤーが かえられる もの を ひとつずつ あらわすよ。それぞれの ぎょうは、なにを しめさないと いけないかな？", "kanji": "オプションのページは、行のリストだよ。行は、プレイヤーが変えられるものを一つずつ表すよ。それぞれの行は、何を示さないといけないかな？"},
  {"en": "The Options page shows the rows your options() lists.", "to": "オプションの ページには、options() が かえす ぎょうが でるよ。", "kanji": "オプションのページには、options() が返す行がでるよ。"},
  {"en": "The label {got} is longer than 24 characters. Shorten it so it fits the row.", "to": "ラベルの {got} は、24もじより ながいよ。ぎょうに はいるように、みじかくして ね。", "kanji": "ラベルの {got} は、24文字より長いよ。行に入るように、短くしてね。"},
  {"en": "The row for {name} has no label. Give it some words the player will understand, such as \"Tunes\".", "to": "{name} の ぎょうに ラベルが ないよ。プレイヤーが わかる ことばを いれてね。たとえば \"Tunes\" みたいに。", "kanji": "{name} の行にラベルがないよ。プレイヤーが分かる言葉を入れてね。例えば \"Tunes\" みたいに。"},
  {"en": "The rows of the Options page: a list of dictionaries, each with a \"setting\" (what it turns) and a \"label\" (what the player calls it).", "to": "オプションの ページの ぎょう：辞書の リスト。それぞれに \"setting\"（かえる もの）と \"label\"（プレイヤーが よぶ なまえ）が ある。", "kanji": "オプションのページの行：辞書のリスト。それぞれに \"setting\"（変えるもの）と \"label\"（プレイヤーが呼ぶ名前）がある。"},
  {"en": "Two settings must always be on the page: the music and the sound. Put a row for each of them, then any others you like.", "to": "ページには、ふたつの setting が いつも ひつようだよ。おんがくと おと。それぞれ ぎょうを いれて、そのあとは すきな ぎょうを いれてね。", "kanji": "ページには、二つの setting がいつも必要だよ。音楽と音。それぞれ行を入れて、その後はすきな行を入れてね。"},
  {"en": "Your Options page should be a list of rows, in square brackets, but it gave back {got}.", "to": "きみの オプションの ページは、[ ] の かっこで かこんだ ぎょうの リストで なければ いけないよ。でも、かえして いたのは {got} だったよ。", "kanji": "君のオプションのページは、[ ] の括弧で囲んだ行のリストでなければいけないよ。でも、返していたのは {got} だったよ。"},
  {"en": "full screen row, called", "to": "ぜんがめんの ぎょうの よびかた", "kanji": "ぜんがめんの行の呼び方"},
  {"en": "music row, called", "to": "おんがくの ぎょうの よびかた", "kanji": "音楽の行の呼び方"},
  {"en": "sound row, called", "to": "おとの ぎょうの よびかた", "kanji": "音の行の呼び方"},
  {"en": "text speed row, called", "to": "もじの はやさの ぎょうの よびかた", "kanji": "文字の速さの行の呼び方"},
  {"en": "the Options page, as your rows make it", "to": "きみが つくった オプションの ページ", "kanji": "君が作ったオプションのページ"},
  {"en": "track row, called", "to": "きょくの ぎょうの よびかた", "kanji": "曲の行の呼び方"},
  {"en": "{name} has two rows. Each setting gets one row.", "to": "{name} の ぎょうが ふたつ あるよ。ひとつの setting に、ぎょうは ひとつだけだよ。", "kanji": "{name} の行が二つあるよ。一つの setting に、行は一つだけだよ。"},
  {"en": "{name} isn't a setting the Options page knows. The settings are \"music\", \"sound\", \"text_speed\", \"track\" and \"fullscreen\".", "to": "{name} は、オプションの ページが しって いる setting じゃ ないよ。setting は \"music\"、\"sound\"、\"text_speed\"、\"track\"、\"fullscreen\" の どれかだよ。", "kanji": "{name} は、オプションのページが知っている setting じゃないよ。setting は \"music\"、\"sound\"、\"text_speed\"、\"track\"、\"fullscreen\" のどれかだよ。"},
  // tasks/options: the comments of the starter code
  {"en": "Give back the rows of the Options page: a list of rows, each one a setting and the label the player calls it.", "to": "オプションの ページの ぎょうを かえしてね。ぎょうの リストで、それぞれに setting と、プレイヤーが よぶ ラベル を いれてね。", "kanji": "オプションのページの行を返してね。行のリストで、それぞれに setting と、プレイヤーが呼ぶラベルを入れてね。"},
  {"en": "Takes nothing.", "to": "なにも うけとらないよ。", "kanji": "何も受け取らないよ。"},
  // tasks/shortcuts
  {"en": "Ask about the new key the same way you asked about Esc.", "to": "あたらしい キーも、Esc の ときと おなじように たずねよう。", "kanji": "新しいキーも、Esc のときと同じように尋ねよう。"},
  {"en": "Ask whether key is that key. If it is, give back what it should open.", "to": "key が その キーか どうか たずねよう。そうなら、ひらく ものを かえしてね。", "kanji": "key がそのキーかどうか尋ねよう。そうなら、開くものを返してね。"},
  {"en": "Every other key can give back nothing, so pressing them opens nothing.", "to": "ほかの キーは、なにも かえさなくて いいよ。だから、おしても なにも ひらかないんだ。", "kanji": "他のキーは、何も返さなくていいよ。だから、押しても何も開かないんだ。"},
  {"en": "It's the same kind of question as your other keys.", "to": "ほかの キーと おなじ しゅるいの しつもんだよ。", "kanji": "他のキーと同じ種類の質問だよ。"},
  {"en": "Keep the Esc question where it is. Put the new question beside it, before the line that gives back nothing.", "to": "Esc の しつもんは、そのままに しておこう。あたらしい しつもんは そのよこに、なにも かえさない ぎょうの まえに いれてね。", "kanji": "Esc の質問は、そのままにしておこう。新しい質問はそのよこに、何も返さない行の前に入れてね。"},
  {"en": "Make the Esc key open the menu.", "to": "Esc の キーで メニューが ひらくように しよう。", "kanji": "Esc のキーでメニューが開くようにしよう。"},
  {"en": "Make the I key open your bag (I for inventory), and keep Esc opening the menu.", "to": "I の キーで かばんが ひらくように しよう（I は inventory の I）。Esc で メニューが ひらく のも、そのままに しておいてね。", "kanji": "I のキーで鞄が開くようにしよう（I は inventory の I）。Esc でメニューが開くのも、そのままにしておいてね。"},
  {"en": "Make the M key open the map, and keep the keys you taught before.", "to": "M の キーで ちずが ひらくように しよう。まえに おしえた キーも、そのままに しておいてね。", "kanji": "M のキーでちずが開くようにしよう。前に教えたキーも、そのままにしておいてね。"},
  {"en": "One more key for your collection. M is for map.", "to": "あつめた キーが もうひとつ ふえるよ。M は map（ちず）の M だよ。", "kanji": "集めたキーがもう一つ増えるよ。M は map（地図）の M だよ。"},
  {"en": "Open the bag on a key", "to": "キーで かばんを ひらく", "kanji": "キーで鞄を開く"},
  {"en": "Open the map on a key", "to": "キーで ちずを ひらく", "kanji": "キーでちずを開く"},
  {"en": "Pressing {say} gave back {got}, but it should open {want}.", "to": "「{say}」を おすと {got} を かえしたけど、ひらくのは {want} だよ。", "kanji": "「{say}」をおすと {got} を返したけど、開くのは {want} だよ。"},
  {"en": "Pressing {say} opened nothing. It should open {want}.", "to": "「{say}」を おしても、なにも ひらかなかったよ。ひらくのは {want} だよ。", "kanji": "「{say}」を押しても、何も開かなかったよ。開くのは {want} だよ。"},
  {"en": "The Shortcuts", "to": "ショートカット", "kanji": "ショートカット"},
  {"en": "The name of the key that was pressed: \"escape\", a letter like \"p\", or a digit like \"7\".", "to": "おされた キーの なまえ：\"escape\"、\"p\" のような もじ、\"7\" のような すうじ。", "kanji": "押されたキーの名前：\"escape\"、\"p\" のような文字、\"7\" のような数字。"},
  {"en": "The name of what that key opens: \"menu\", \"bag\", \"map\", \"quests\", \"workbench\", \"options\" or \"music\". Or nothing, when the key opens nothing.", "to": "そのキーで ひらく ものの なまえ：\"menu\"、\"bag\"、\"map\"、\"quests\"、\"workbench\"、\"options\"、\"music\" の どれか。キーで なにも ひらかない ときは、なし。", "kanji": "そのキーで開くものの名前：\"menu\"、\"bag\"、\"map\"、\"quests\"、\"workbench\"、\"options\"、\"music\" のどれか。キーで何も開かないときは、なし。"},
  {"en": "The order of your questions only matters if two of them ask about the same key.", "to": "しつもんの じゅんばんが だいじなのは、ふたつの しつもんが おなじ キーを たずねて いる ときだけだよ。", "kanji": "質問の順番が大事なのは、二つの質問が同じキーを尋ねているときだけだよ。"},
  {"en": "When a key is pressed, open something", "to": "キーが おされたら、なにかを ひらく", "kanji": "キーが押されたら、何かを開く"},
  {"en": "Your function already knows one key. It can know two!", "to": "きみの かんすうは、もう ひとつの キーを しって いるよ。ふたつ しれるように できるよ！", "kanji": "君の関数は、もう一つのキーを知っているよ。二つ知れるようにできるよ！"},
  {"en": "Your function hears every key. Which one should open the menu? Look at the top-left corner of your keyboard.", "to": "きみの かんすうは、どの キーも きこえて いるよ。メニューを ひらく キーは どれかな？ キーボードの ひだりうえの かど を 見てみよう。", "kanji": "君の関数は、どのキーもきこえているよ。メニューを開くキーはどれかな？キーボードの左上のかどを見てみよう。"},
  {"en": "Your keys open your menu now.", "to": "キーで メニューが ひらくように なったよ。", "kanji": "キーでメニューが開くようになったよ。"},
  {"en": "opens", "to": "ひらくもの", "kanji": "開くもの"},
  {"en": "the Esc key", "to": "Esc の キー", "kanji": "Esc のキー"},
  {"en": "the I key", "to": "I の キー", "kanji": "I のキー"},
  {"en": "the M key", "to": "M の キー", "kanji": "M のキー"},
  {"en": "the P key (any answer the town knows is fine)", "to": "P の キー（まちが しって いる こたえなら どれでも）", "kanji": "P のキー（町が知っている答えならどれでも）"},
  {"en": "which key", "to": "どの キー", "kanji": "どのキー"},
  {"en": "{got} isn't something the town can open. It knows \"menu\", \"bag\", \"map\", \"quests\", \"workbench\", \"options\" and \"music\".", "to": "{got} は まちで ひらける もの じゃ ないよ。まちが しって いるのは、\"menu\"、\"bag\"、\"map\"、\"quests\"、\"workbench\"、\"options\"、\"music\" だよ。", "kanji": "{got} は町で開けるものじゃないよ。町が知っているのは、\"menu\"、\"bag\"、\"map\"、\"quests\"、\"workbench\"、\"options\"、\"music\" だよ。"},
  // tasks/shortcuts: the comments of the starter code
  {"en": "Give back the name of what that key should open, or None when it opens nothing.", "to": "そのキーで ひらく ものの なまえを かえしてね。なにも ひらかない ときは、None を かえすよ。", "kanji": "そのキーで開くものの名前を返してね。何も開かないときは、None を返すよ。"},
  {"en": "Give back the name of what that key should open, or null when it opens nothing.", "to": "そのキーで ひらく ものの なまえを かえしてね。なにも ひらかない ときは、null を かえすよ。", "kanji": "そのキーで開くものの名前を返してね。何も開かないときは、null を返すよ。"},
  {"en": "key is the name of the key that was pressed: \"escape\", a letter like \"p\", or a digit like \"7\".", "to": "key は おされた キーの なまえだよ：\"escape\"、\"p\" のような もじ、\"7\" のような すうじ。", "kanji": "key は押されたキーの名前だよ：\"escape\"、\"p\" のような文字、\"7\" のような数字。"},
  // tasks/volume
  {"en": "A notch is a whole number from 0 to 10. A loudness is a number from 0.0 to 1.0. How do you get from one to the other?", "to": "めもりは、0 から 10 までの せいすう。おとの おおきさは、0.0 から 1.0 までの 数だよ。ひとつから もうひとつへ、どう すれば いけるかな？", "kanji": "目盛りは、0 から 10 までの整数。音の大きさは、0.0 から 1.0 までの数だよ。一つからもう一つへ、どうすれば行けるかな？"},
  {"en": "A whole number: 0 is the slider all the way down, 10 all the way up.", "to": "せいすう。0 は いちばん した、10 は いちばん うえだよ。", "kanji": "整数。0 は一番下、10 は一番上だよ。"},
  {"en": "Before the notch is turned into a loudness, it can be kept inside the range from 0 to 10. Which step could do that keeping?", "to": "めもりを おとの おおきさに かえる まえに、0 から 10 の はんいに おさめる ことが できるよ。その おさめる ステップは どれかな？", "kanji": "目盛りを音の大きさに変える前に、0 から 10 の範囲に収めることができるよ。その収めるステップはどれかな？"},
  {"en": "Divides one number by another, and can give a fraction.", "to": "ひとつの 数を ほかの 数で わるよ。こたえが しょうすうに なる ことも あるよ。", "kanji": "一つの数を他の数でわるよ。答えが小数になることもあるよ。"},
  {"en": "Dividing is one way to make a big number small. What should the notch be divided by?", "to": "わり算は、おおきい 数を ちいさく する ひとつの やりかた だよ。めもりは なんで わったら いいかな？", "kanji": "わり算は、大きい数を小さくする一つのやり方だよ。目盛りはなんでわったらいいかな？"},
  {"en": "Gives back the bigger of two numbers.", "to": "ふたつの 数の、おおきい ほうを かえすよ。", "kanji": "二つの数の、大きいほうを返すよ。"},
  {"en": "Gives back the smaller of two numbers.", "to": "ふたつの 数の、ちいさい ほうを かえすよ。", "kanji": "二つの数の、小さいほうを返すよ。"},
  {"en": "How loud, from 0.0 (silent) to 1.0 (full).", "to": "どれくらい おおきいか。0.0（しずか）から 1.0（いっぱい）まで。", "kanji": "どれくらい大きいか。0.0（静か）から 1.0（いっぱい）まで。"},
  {"en": "Keep the knob inside its ends: a nudge below 0 is still silent, and one above 10 is still full.", "to": "つまみを はしに おさめよう。0 より した に ずれても、まだ しずかのまま。10 より うえ に ずれても、まだ いっぱいのまま。", "kanji": "つまみをは死に収めよう。0 より下にずれても、まだしずかのまま。10 より上にずれても、まだいっぱいのまま。"},
  {"en": "Not above 10", "to": "10 より うえには いかない", "kanji": "10 より上には行かない"},
  {"en": "Not below 0", "to": "0 より したには いかない", "kanji": "0 よりしたには行かない"},
  {"en": "Notch {arg0} gave {got}, which is quieter than the notch before it. Should turning a knob up make it quieter?", "to": "めもり {arg0} は {got} を かえしたけど、まえの めもりより しずかに なって いるよ。つまみを あげたのに しずかに なるのは、へんじゃ ないかな？", "kanji": "目盛り {arg0} は {got} を返したけど、前の目盛りより静かになっているよ。つまみをあげたのに静かになるのは、変じゃないかな？"},
  {"en": "Notch {arg0} gave {got}. A loudness can't be below 0.0 or above 1.0.", "to": "めもり {arg0} は {got} を かえしたよ。おとの おおきさは、0.0 より した にも、1.0 より うえにも ならないよ。", "kanji": "目盛り {arg0} は {got} を返したよ。音の大きさは、0.0 より下にも、1.0 より上にもならないよ。"},
  {"en": "Notch {arg0} gave {got}. A loudness is a number, from 0.0 (silent) to 1.0 (full).", "to": "めもり {arg0} は {got} を かえしたよ。おとの おおきさは、0.0（しずか）から 1.0（いっぱい）までの 数だよ。", "kanji": "目盛り {arg0} は {got} を返したよ。音の大きさは、0.0（静か）から 1.0（いっぱい）までの数だよ。"},
  {"en": "Notch {arg0} is above the top, so it should be full: 1.0. It gave {got}.", "to": "めもり {arg0} は いちばん うえを こえて いるから、いっぱいの 1.0 に なるはず。かえしたのは {got} だったよ。", "kanji": "目盛り {arg0} は一番上を声ているから、いっぱいの 1.0 になるはず。返したのは {got} だったよ。"},
  {"en": "Notch {arg0} is below the bottom, so it should be silent: 0.0. It gave {got}.", "to": "めもり {arg0} は いちばん したを こえて いるから、しずかの 0.0 に なるはず。かえしたのは {got} だったよ。", "kanji": "目盛り {arg0} は一番したを声ているから、静かの 0.0 になるはず。返したのは {got} だったよ。"},
  {"en": "Notch {arg0}, {say}, should be full: 1.0. It gave {got}.", "to": "めもり {arg0}（{say}）は、いっぱいの 1.0 に なるはず。かえしたのは {got} だったよ。", "kanji": "目盛り {arg0}（{say}）は、いっぱいの 1.0 になるはず。返したのは {got} だったよ。"},
  {"en": "Notch {arg0}, {say}, should be silent: 0.0. It gave {got}.", "to": "めもり {arg0}（{say}）は、しずかの 0.0 に なるはず。かえしたのは {got} だったよ。", "kanji": "目盛り {arg0}（{say}）は、静かの 0.0 になるはず。返したのは {got} だったよ。"},
  {"en": "Some pad nudges go past the ends. What should a notch of -3 give, and what should a notch of 14 give?", "to": "パッドで ちょっと ずらすと、はしを こえる ことも あるよ。めもり -3 は なにを かえすべきかな？ めもり 14 は なにを かえすべきかな？", "kanji": "パッドでちょっとずらすと、はしを声ることもあるよ。目盛り -3 は何をかえすべきかな？目盛り 14 は何をかえすべきかな？"},
  {"en": "The Options sliders follow your volume() now.", "to": "オプションの スライダーが、きみの volume() に したがうように なったよ。", "kanji": "オプションのスライダーが、君の volume() に従うようになったよ。"},
  {"en": "The Volume Knob", "to": "おとの つまみ", "kanji": "音のつまみ"},
  {"en": "Think about the top notch, 10. What would you do to 10 to get 1.0?", "to": "いちばん うえの めもり、10 を 考えてみよう。10 を どう すれば 1.0 に なるかな？", "kanji": "一番上の目盛り、10 を考えてみよう。10 をどうすれば 1.0 になるかな？"},
  {"en": "Turn each notch into a loudness: notch 0 is silent, notch 10 is full.", "to": "めもりを ひとつずつ おとの おおきさに かえよう。めもり 0 は しずか、めもり 10 は いっぱいだよ。", "kanji": "目盛りを一つずつ音の大きさに変えよう。目盛り 0 は静か、目盛り 10 はいっぱいだよ。"},
  {"en": "all the way down", "to": "いちばん した", "kanji": "一番下"},
  {"en": "all the way up", "to": "いちばん うえ", "kanji": "一番上"},
  {"en": "do what", "to": "なにを する", "kanji": "何をする"},
  {"en": "dragged past the bottom", "to": "したに ひっぱりすぎた スライダー", "kanji": "したにひっぱりすぎたスライダー"},
  {"en": "dragged past the top", "to": "うえに ひっぱりすぎた スライダー", "kanji": "上にひっぱりすぎたスライダー"},
  {"en": "eight notches up", "to": "めもり 8つ うえ", "kanji": "目盛り 8つ上"},
  {"en": "four notches up", "to": "めもり 4つ うえ", "kanji": "目盛り 4つ上"},
  {"en": "halfway", "to": "まんなか", "kanji": "真ん中"},
  {"en": "highest", "to": "いちばん おおきい かず", "kanji": "一番大きい数"},
  {"en": "lowest", "to": "いちばん ちいさい かず", "kanji": "一番小さい数"},
  {"en": "max and min each keep one end of a range: max keeps the bigger of two numbers, min keeps the smaller. Which one keeps a notch from going under 0?", "to": "max と min は、それぞれ はんいの はしを まもるよ。max は ふたつの 数の おおきい ほう、min は ちいさい ほうを かえすよ。めもりが 0 より した に いかない ように まもるのは、どっちかな？", "kanji": "max と min は、それぞれ範囲のはしを守るよ。max は二つの数の大きい方、min は小さいほうを返すよ。目盛りが 0 よりしたに行かないように守るのは、どっちかな？"},
  {"en": "nine notches up", "to": "めもり 9つ うえ", "kanji": "目盛り 9つ上"},
  {"en": "nudged a little past the bottom", "to": "したに すこし はみだした スライダー", "kanji": "したに少しはみだしたスライダー"},
  {"en": "nudged a little past the top", "to": "うえに すこし はみだした スライダー", "kanji": "上に少しはみだしたスライダー"},
  {"en": "one notch up", "to": "めもり 1つ うえ", "kanji": "目盛り 1つ上"},
  {"en": "seven notches up", "to": "めもり 7つ うえ", "kanji": "目盛り 7つ上"},
  {"en": "six notches up", "to": "めもり 6つ うえ", "kanji": "目盛り 6つ上"},
  {"en": "three notches up", "to": "めもり 3つ うえ", "kanji": "目盛り 3つ上"},
  {"en": "two notches up", "to": "めもり 2つ うえ", "kanji": "目盛り 2つ上"},
  // tasks/volume: the comments of the starter code
  {"en": "Give back the loudness, from 0.0 (silent) to 1.0 (full).", "to": "おとの おおきさを かえしてね。0.0（しずか）から 1.0（いっぱい）までの 数で。", "kanji": "音の大きさを返してね。0.0（静か）から 1.0（いっぱい）までの数で。"},
  {"en": "slider is a whole number: 0 is the slider all the way down, 10 all the way up.", "to": "slider は せいすう だよ。0 は いちばん した、10 は いちばん うえだよ。", "kanji": "slider は整数だよ。0 は一番下、10 は一番上だよ。"}
