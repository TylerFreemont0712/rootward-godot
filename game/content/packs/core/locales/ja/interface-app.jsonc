// The shared panels and views (ADR-0047): options, the wardrobe, players, the archives, Pip's coach, cards, the git
// log, the code view, the guardians' intents, rules and chips, and the save and profile problems, keyed by the English
// exactly as the code shows it (%s a name or word, %d a whole number). When the Japanese needs the values in another
// order, number them: {1} is the first %s or %d of the English, {2} the second.
[
  {"en": "Stunned", "to": "スタン中", "kanji": "スタン中"},
  {"en": "Recompiling", "to": "再コンパイル中", "kanji": "再コンパイル中"},
  {"en": "Swapped out", "to": "スワップアウト中", "kanji": "スワップアウト中"},
  {"en": "Strike for %d (enraged)", "to": "%dダメージの攻撃（激怒（げきど））", "kanji": "%dダメージの攻撃（激怒）"},
  {"en": "Strike %d times for %d (enraged)", "to": "{2}ダメージを{1}回（激怒（げきど））", "kanji": "{2}ダメージを{1}回（激怒）"},
  {"en": "Loop %d × %d", "to": "ループ %d × %d", "kanji": "ループ %d × %d"},
  {"en": "Throw %d (catch: %d block)", "to": "%dを投げる（ブロック%dで受け止める）", "kanji": "%dを投げる（ブロック%dで受け止める）"},
  {"en": "Allocate a block", "to": "メモリブロックを確保（かくほ）", "kanji": "メモリブロックを確保"},
  {"en": "Heal %d per block", "to": "メモリブロック1つにつき%d回復", "kanji": "メモリブロック1つにつき%d回復"},
  {"en": "Mend %d (pages out)", "to": "%d回復（ページアウト）", "kanji": "%d回復（ページアウト）"},
  {"en": "Strike for %d", "to": "%dダメージの攻撃", "kanji": "%dダメージの攻撃"},
  {"en": "Overflows: nothing", "to": "オーバーフロー：何もしない", "kanji": "オーバーフロー：何もしない"},
  {"en": "Mutate %d cards", "to": "カードを%d枚書きかえる", "kanji": "カードを%d枚書きかえる"},
  {"en": "Allocated", "to": "確保（かくほ）ずみ", "kanji": "確保ずみ"},
  {"en": "Land a volley that meets its guard and the loop breaks: +50%, it is stunned, the count resets.", "to": "ガード以上の一斉射（いっせいしゃ）を当てると、ループがこわれる。ダメージ+50%で、スタンして、カウントが最初にもどる。", "kanji": "ガード以上の一斉射を当てると、ループが壊れる。ダメージ+50%で、スタンして、カウントが最初にもどる。"},
  {"en": "Block at least a throw's power to catch it: it bounces back at 150%. Uncaught, throws grow.", "to": "投げられた威力（いりょく）以上のブロックで受け止めると、150%ではね返る。受け止めないと、投げはどんどん強くなる。", "kanji": "投げられた威力以上のブロックで受け止めると、150%ではね返る。受け止めないと、投げはどんどん強くなる。"},
  {"en": "Short circuit", "to": "短絡（たんらく）", "kanji": "短絡"},
  {"en": "The first bolt at it must meet its guard. Below it, the rest never land; at or above, it doubles.", "to": "最初に当てるボルトは、ガード以上の威力（いりょく）が必要。足りないと残りは当たらない。ガード以上なら2倍になる。", "kanji": "最初に当てるボルトは、ガード以上の威力が必要。足りないと残りは当たらない。ガード以上なら2倍になる。"},
  {"en": "Dead code", "to": "デッドコード", "kanji": "デッドコード"},
  {"en": "Cards at or after its return slot do not run (and still cost mana).", "to": "returnのスロットと、そのあとのカードは動かない（マナは使う）。", "kanji": "returnのスロットと、そのあとのカードは動かない（マナは使う）。"},
  {"en": "LRU cache", "to": "LRUキャッシュ", "kanji": "LRUキャッシュ"},
  {"en": "A bolt whose power is cached deals nothing. New powers hurt in full.", "to": "キャッシュにある威力（いりょく）のボルトは何もしない。新しい威力なら、全部当たる。", "kanji": "キャッシュにある威力のボルトは何もしない。新しい威力なら、全部当たる。"},
  {"en": "Each block shields her 3 a turn; at 5 blocks, Out of Memory. Breaking a block gives you 3 block.", "to": "メモリブロック1つにつき、毎ターン彼女にシールド3。5つになるとメモリ不足（Out of Memory）。メモリブロックをこわすと、きみにブロック3。", "kanji": "メモリブロック1つにつき、毎ターン彼女にシールド3。5つになるとメモリ不足（Out of Memory）。メモリブロックを壊すと、きみにブロック3。"},
  {"en": "Break it to free it: 3 block for you.", "to": "こわして解放（かいほう）しよう。きみにブロック3。", "kanji": "こわして解放しよう。きみにブロック3。"},
  {"en": "Paged", "to": "ページング", "kanji": "ページング"},
  {"en": "Only the resident page takes hits and strikes. A bolt at another is a page fault and swaps it in.", "to": "メモリにいるページだけが、攻撃を受けて攻撃してくる。ほかのページをねらうとページフォールトになって、そのページと入れかわる。", "kanji": "メモリにいるページだけが、攻撃を受けて攻撃してくる。ほかのページをねらうとページフォールトになって、そのページと入れかわる。"},
  {"en": "Lazy", "to": "遅延（ちえん）", "kanji": "遅延"},
  {"en": "Hits pile up as pending. A bolt of 15 or more forces it all at +25%.", "to": "当てたダメージは保留（ほりゅう）としてたまる。威力（いりょく）15以上のボルトで、全部まとめて+25%で当たる。", "kanji": "当てたダメージは保留としてたまる。威力15以上のボルトで、全部まとめて+25%で当たる。"},
  {"en": "Only the top frame takes damage; the rest of a bolt is lost. Left alone, it pushes a frame.", "to": "ダメージを受けるのは、いちばん上のフレームだけ。ボルトのあまりは消える。ほうっておくと、フレームを1つ積む。", "kanji": "ダメージを受けるのは、いちばん上のフレームだけ。ボルトのあまりは消える。ほうっておくと、フレームを1つ積む。"},
  {"en": "Damage over 127 wraps around: 128 is -128, and negative damage heals it.", "to": "127をこえるダメージは一周する。128は-128になって、マイナスのダメージは回復になる。", "kanji": "127をこえるダメージは一周する。128は-128になって、マイナスのダメージは回復になる。"},
  {"en": "Damage scales with your program's slowest class: fast code, more.", "to": "ダメージは、プログラムのいちばん遅いクラスで決まる。速いコードほど大きい。", "kanji": "ダメージは、プログラムのいちばん遅いクラスで決まる。速いコードほど大きい。"},
  {"en": "Livelock", "to": "ライブロック", "kanji": "ライブロック"},
  {"en": "Every hit swaps the twins. When one falls, the other enrages.", "to": "当てるたびに双子（ふたご）が入れかわる。片方がたおれると、もう片方が激怒（げきど）する。", "kanji": "当てるたびに双子が入れかわる。片方がたおれると、もう片方が激怒する。"},
  {"en": "Mutation", "to": "突然変異（とつぜんへんい）", "kanji": "突然変異"},
  {"en": "It edits your cards. Land 25 in one program to kill the mutants in it.", "to": "きみのカードを書きかえる。ひとつのプログラムで25ダメージ当てると、その中のミュータントをたおせる。", "kanji": "きみのカードを書きかえる。ひとつのプログラムで25ダメージ当てると、その中のミュータントをたおせる。"},
  {"en": "Subset sum", "to": "部分和（ぶぶんわ）", "kanji": "部分和"},
  {"en": "Bolts that add up to exactly its target deal double and stun it. Without one, all are halved.", "to": "合計がちょうど目標の数になるボルトは、2倍のダメージでスタンさせる。ちょうどにならないと、全部半分になる。", "kanji": "合計がちょうど目標の数になるボルトは、2倍のダメージでスタンさせる。ちょうどにならないと、全部半分になる。"},
  {"en": "Oracle", "to": "予言者（よげんしゃ）", "kanji": "予言者"},
  {"en": "If its prediction about your program is right, it takes nothing and half is reflected.", "to": "きみのプログラムについての予言（よげん）が当たると、ダメージを受けずに半分をはね返す。", "kanji": "きみのプログラムについての予言が当たると、ダメージを受けずに半分をはね返す。"},
  {"en": "Compiler", "to": "コンパイラ", "kanji": "コンパイラ"},
  {"en": "Three phases: the guardians you beat, then itself, self-hosting.", "to": "3つのフェーズ：たおした番人（ばんにん）たち、そして自分自身。セルフホスティング。", "kanji": "3つのフェーズ：たおした番人たち、そして自分自身。セルフホスティング。"},
  {"en": "stunned", "to": "スタン", "kanji": "スタン"},
  {"en": "It loses its next turn.", "to": "次のターンは動けない。", "kanji": "次のターンは動けない。"},
  {"en": "phase %d/3", "to": "フェーズ %d/3", "kanji": "フェーズ %d/3"},
  {"en": "Compiled as %s.", "to": "%sとしてコンパイルされた。", "kanji": "%sとしてコンパイルされた。"},
  {"en": "Meet it to break the loop.", "to": "これ以上を当てると、ループがこわれる。", "kanji": "これ以上を当てると、ループが壊れる。"},
  {"en": "loop ×%d", "to": "ループ ×%d", "kanji": "ループ ×%d"},
  {"en": "Hits in its next Loop.", "to": "次のループで攻撃する回数。", "kanji": "次のループで攻撃する回数。"},
  {"en": "trace +%d", "to": "トレース +%d", "kanji": "トレース +%d"},
  {"en": "Added to every throw.", "to": "投げるたびに足される。", "kanji": "投げるたびに足される。"},
  {"en": "first ≥ %d", "to": "最初 ≥ %d", "kanji": "最初 ≥ %d"},
  {"en": "Lead with a bolt of %d or more.", "to": "最初に威力（いりょく）%d以上のボルトを当てよう。", "kanji": "最初に威力%d以上のボルトを当てよう。"},
  {"en": "return @ slot %d", "to": "return @ スロット %d", "kanji": "return @ スロット %d"},
  {"en": "Cards in this slot and after are dead code this turn.", "to": "このターン、このスロットとそのあとのカードはデッドコード。", "kanji": "このターン、このスロットとそのあとのカードはデッドコード。"},
  {"en": "cache: %s", "to": "キャッシュ: %s", "kanji": "キャッシュ: %s"},
  {"en": "Bolts of these powers deal nothing.", "to": "この威力（いりょく）のボルトは何もしない。", "kanji": "この威力のボルトは何もしない。"},
  {"en": "resident", "to": "メモリ内", "kanji": "メモリ内"},
  {"en": "In memory: bolts at this page land.", "to": "メモリにいる。このページへのボルトは当たる。", "kanji": "メモリにいる。このページへのボルトは当たる。"},
  {"en": "swapped out", "to": "スワップアウト", "kanji": "スワップアウト"},
  {"en": "A bolt here is a page fault.", "to": "ここへのボルトはページフォールトになる。", "kanji": "ここへのボルトはページフォールトになる。"},
  {"en": "pending %d", "to": "保留 %d", "kanji": "保留 %d"},
  {"en": "Forced by a bolt of 15+, at +25%. Halves at the end of the turn.", "to": "威力（いりょく）15以上のボルトで、+25%で発動する。ターンの終わりに半分になる。", "kanji": "威力15以上のボルトで、+25%で発動する。ターンの終わりに半分になる。"},
  {"en": "%d frames · top %d", "to": "フレーム%d個 · いちばん上 %d", "kanji": "フレーム%d個 · いちばん上 %d"},
  {"en": "Frames, bottom to top: %s.", "to": "フレーム（下から上へ）: %s。", "kanji": "フレーム（下から上へ）: %s。"},
  {"en": "enraged", "to": "激怒（げきど）", "kanji": "激怒"},
  {"en": "Its strikes hit 50% harder.", "to": "攻撃が50%強くなる。", "kanji": "攻撃が50%強くなる。"},
  {"en": "target %d", "to": "目標 %d", "kanji": "目標 %d"},
  {"en": "Bolts at it that add up to exactly this deal double.", "to": "合計がちょうどこの数になるボルトは、2倍のダメージ。", "kanji": "合計がちょうどこの数になるボルトは、2倍のダメージ。"},
  {"en": "predicts: %s", "to": "予言（よげん）: %s", "kanji": "予言: %s"},
  {"en": "Run a program without this property.", "to": "この性質（せいしつ）をもたないプログラムを実行しよう。", "kanji": "この性質をもたないプログラムを実行しよう。"},
  {"en": "Watching", "to": "様子を見ている", "kanji": "様子を見ている"},
  {"en": "Strike %d times for %d", "to": "{2}ダメージを{1}回", "kanji": "{2}ダメージを{1}回"},
  {"en": "Shield %d", "to": "シールド %d", "kanji": "シールド %d"},
  {"en": "Stoke: its next strike doubles", "to": "力をためる：次の攻撃が2倍", "kanji": "力をためる：次の攻撃が2倍"},
  {"en": "Heal %d", "to": "%d回復", "kanji": "%d回復"},
  {"en": "Reprint: %d per bolt of your last program", "to": "うち返し：前のプログラムのボルト1発につき%d", "kanji": "うち返し：前のプログラムのボルト1発につき%d"},
  {"en": "Nullify", "to": "無効化", "kanji": "無効化"},
  {"en": "The first bolt that hits it each turn does nothing.", "to": "毎ターン、最初に当たったボルトは何もしない。", "kanji": "毎ターン、最初に当たったボルトは何もしない。"},
  {"en": "Thick hide", "to": "分厚い皮（かわ）", "kanji": "分厚い皮"},
  {"en": "Bolts under %d power glance off.", "to": "威力（いりょく）%dより小さいボルトは、かすってしまう。", "kanji": "威力%dより小さいボルトは、かすってしまう。"},
  {"en": ", then ", "to": "、そのあと", "kanji": "、その後"},
  {"en": "Shifting", "to": "うつり変わる弱点", "kanji": "うつり変わる弱点"},
  {"en": "Its weakness moves each turn: %s.", "to": "弱点が毎ターン変わる：%s。", "kanji": "弱点が毎ターン変わる：%s。"},
  {"en": "Pattern ward", "to": "パターン防護", "kanji": "パターン防護"},
  {"en": "Only this turn's element in %s hits at full strength.", "to": "%sのうち、このターンの属性（ぞくせい）だけが全力で当たる。", "kanji": "%sのうち、このターンの属性だけが全力で当たる。"},
  {"en": "Quine", "to": "クワイン", "kanji": "クワイン"},
  {"en": "It reprints the last program that ran: one hit for every bolt it fired, and its wards as shield.", "to": "最後に動いたプログラムをうち返す。うったボルト1発ごとに1回の攻撃、防護はシールドになる。", "kanji": "最後に動いたプログラムをうち返す。打ったボルト1発ごとに1回の攻撃、防護はシールドになる。"},
  {"en": "The same cards in the same order as that program cannot hurt it.", "to": "そのプログラムと同じカードを同じ順番で出しても、ダメージをあたえられない。", "kanji": "そのプログラムと同じカードを同じ順番で出しても、ダメージをあたえられない。"},
  {"en": "Deadlock", "to": "デッドロック", "kanji": "デッドロック"},
  {"en": "It holds a lock its twin needs: damage to it is blocked unless the same program hits both.", "to": "双子（ふたご）の片方が必要なロックをにぎっている。同じプログラムで両方に当てないと、ダメージは止められる。", "kanji": "双子の片方が必要なロックをにぎっている。同じプログラムで両方に当てないと、ダメージは止められる。"},
  {"en": "Once one breaks, the other is free.", "to": "片方がこわれたら、もう片方は自由になる。", "kanji": "片方がこわれたら、もう片方は自由になる。"},
  {"en": "dead code: after the return at slot %d", "to": "デッドコード：スロット%dのreturnのあと", "kanji": "デッドコード：スロット%dのreturnの後"},
  {"en": "Your last move could not be saved (%s). The save before it is kept.", "to": "さっきの手を保存できなかったよ（%s）。その前のセーブはそのまま残っているよ。", "kanji": "さっきの手を保存できなかったよ（%s）。その前のセーブはそのまま残っているよ。"},
  {"en": "This run could not be added to your history (%s).", "to": "この冒険を記録に追加できなかったよ（%s）。", "kanji": "この冒険を記録に追加できなかったよ（%s）。"},
  {"en": "it is not a run", "to": "冒険のデータではない", "kanji": "冒険のデータではない"},
  {"en": "it was saved by version %s of the rules", "to": "ルールのバージョン%sで保存された", "kanji": "ルールのバージョン%sで保存された"},
  {"en": "it has no %s", "to": "%sがない", "kanji": "%sがない"},
  {"en": "its %s is not what a run keeps there", "to": "%sの中身が冒険のデータとちがう", "kanji": "%sの中身が冒険のデータとちがう"},
  {"en": "its status %s is unknown", "to": "状態%sがわからない", "kanji": "状態%sが分からない"},
  {"en": "its map has no rooms", "to": "地図に部屋がない", "kanji": "地図に部屋がない"},
  {"en": "a spell in it has no shards", "to": "シャードのない呪文（じゅもん）がある", "kanji": "シャードのない呪文がある"},
  {"en": "it is in a fight with no foes", "to": "敵のいない戦いのとちゅうになっている", "kanji": "敵のいない戦いのとちゅうになっている"},
  {"en": "There is no shard there.", "to": "そこにはシャードがないよ。", "kanji": "そこにはシャードがないよ。"},
  {"en": "There is no such spell.", "to": "その呪文（じゅもん）はないよ。", "kanji": "その呪文はないよ。"},
  {"en": "%s holds at most %d shards. Drop onto a shard to swap them.", "to": "%sに入るシャードは%d個まで。シャードの上に落とすと、入れかえられるよ。", "kanji": "%sに入るシャードは%d個まで。シャードの上に落とすと、入れかえられるよ。"},
  {"en": "Could not save this profile.", "to": "このプレイヤーを保存できなかったよ。", "kanji": "このプレイヤーを保存できなかったよ。"},
  {"en": "Player not found.", "to": "プレイヤーが見つからないよ。", "kanji": "プレイヤーが見つからないよ。"},
  {"en": "Could not rename this profile.", "to": "名前を変えられなかったよ。", "kanji": "名前を変えられなかったよ。"},
  {"en": "Profiles already exist.", "to": "プレイヤーはもういるよ。", "kanji": "プレイヤーはもういるよ。"},
  {"en": "No legacy saves.", "to": "前のセーブはないよ。", "kanji": "前のセーブはないよ。"},
  {"en": "Could not prepare migration.", "to": "セーブの引っこしの準備ができなかったよ。", "kanji": "セーブの引っこしの準備ができなかったよ。"},
  {"en": "Could not copy migrated saves.", "to": "セーブを引っこしできなかったよ。", "kanji": "セーブを引っこしできなかったよ。"},
  {"en": "Could not verify migrated saves.", "to": "引っこししたセーブをたしかめられなかったよ。", "kanji": "引っこししたセーブをたしかめられなかったよ。"},
  {"en": "Could not save migrated profile.", "to": "引っこししたプレイヤーを保存できなかったよ。", "kanji": "引っこししたプレイヤーを保存できなかったよ。"},
  {"en": "Could not publish migrated profile.", "to": "引っこししたプレイヤーを使えるようにできなかったよ。", "kanji": "引っこししたプレイヤーを使えるようにできなかったよ。"},
  {"en": "New player", "to": "新しいプレイヤー", "kanji": "新しいプレイヤー"},
  {"en": "Your player", "to": "プレイヤーの設定", "kanji": "プレイヤーの設定"},
  {"en": "Your name", "to": "なまえ", "kanji": "名前を入力"},
  {"en": "Could not save this player.", "to": "保存できませんでした。", "kanji": "保存できませんでした。"},
  {"en": "A name, a language and a look. That's all.", "to": "なまえとことば、すがただけで始められるよ。", "kanji": "なまえとことば、すがただけで始められるよ。"},
  {"en": "Language", "to": "ことば", "kanji": "言葉"},
  {"en": "Avatar", "to": "すがた", "kanji": "姿"},
  {"en": "Save player", "to": "保存する", "kanji": "保存する"},
  {"en": "Cancel", "to": "やめる", "kanji": "やめる"},
  {"en": "Delete %s? Their saved runs, git log, settings and Trial progress will be lost.", "to": "%sを消しますか？ セーブ、遊んだ記録、設定、トライアルの進みぐあいが消えます。", "kanji": "%sを消しますか？セーブ、遊んだ記録、設定、トライアルの進みぐあいが消えます。"},
  {"en": "Delete player?", "to": "プレイヤーを消す？", "kanji": "プレイヤーを消す？"},
  {"en": "Keep player", "to": "消さない", "kanji": "消さない"},
  {"en": "Delete %s", "to": "%sを消す", "kanji": "%sを消す"},
  {"en": "OPTIONS", "to": "設定", "kanji": "設定"},
  {"en": "Close  ×", "to": "閉じる  ×", "kanji": "閉じる  ×"},
  {"en": "Make the Machine feel like home. Changes save automatically.", "to": "マシンを自分の家みたいにしよう。変えたことは自動で保存されるよ。", "kanji": "マシンを自分の家みたいにしよう。変えたことは自動で保存されるよ。"},
  {"en": "Battle", "to": "戦い", "kanji": "戦い"},
  {"en": "Audio", "to": "音", "kanji": "音"},
  {"en": "Display", "to": "画面", "kanji": "画面"},
  {"en": "Music volume", "to": "音楽の音量", "kanji": "音楽の音量"},
  {"en": "Sound effects", "to": "効果音", "kanji": "効果音"},
  {"en": "Test sound", "to": "音をためす", "kanji": "音をためす"},
  {"en": "Fullscreen", "to": "全画面", "kanji": "全画面"},
  {"en": "Reduce motion", "to": "動きをへらす", "kanji": "動きをへらす"},
  {"en": "Calmer transitions and no shard flourishes. Background motion updates when you reopen the title.", "to": "画面の切りかえがおだやかになって、シャードの演出もなくなるよ。背景の動きは、タイトルを開きなおすと変わるよ。", "kanji": "画面の切りかえがおだやかになって、シャードの演出もなくなるよ。背景の動きは、タイトルを開きなおすと変わるよ。"},
  {"en": "The arena and its creatures resize with the window.", "to": "戦いの場とモンスターは、ウィンドウに合わせて大きさが変わるよ。", "kanji": "戦いの場とモンスターは、ウィンドウに合わせて大きさが変わるよ。"},
  {"en": "Code playback speed", "to": "コードの再生の速さ", "kanji": "コードの再生の速さ"},
  {"en": "The code plays on the work surface below the arena before the spell fires.", "to": "呪文（じゅもん）が飛ぶ前に、戦いの場の下でコードが動くよ。", "kanji": "呪文が飛ぶ前に、戦いの場の下でコードが動くよ。"},
  {"en": "Show what a spell will do before you cast it", "to": "唱える前に、呪文（じゅもん）の予想を見せる", "kanji": "唱える前に、呪文の予想を見せる"},
  {"en": "Its bolts, damage and block against the foes in front of you.", "to": "目の前の敵へのボルト、ダメージ、ブロックだよ。", "kanji": "目の前の敵へのボルト、ダメージ、ブロックだよ。"},
  {"en": "The Programmer difficulty hides them anyway.", "to": "難しさ「プログラマー」では、どちらにしてもかくれるよ。", "kanji": "難しさ「プログラマー」では、どちらにしてもかくれるよ。"},
  {"en": "Shake the stage on heavy hits", "to": "大きな攻撃で画面をゆらす", "kanji": "大きな攻撃で画面をゆらす"},
  {"en": "Off", "to": "オフ", "kanji": "オフ"},
