  {"en": "Motion Dummy", "to": "モーション人形", "kanji": "モーション人形"},
  {"en": "A crescent hat, a plum capelet, and a palm strike that writes in starlight. Drawn, not modelled.", "to": "三日月のぼうし、すもも色のケープ、そして星の光で文字を書く手のひらの一撃。3Dではなく、手でかいた絵。", "kanji": "三日月のぼうし、すもも色のケープ、そして星の光で文字を書く手のひらの一撃。3Dではなく、手でかいた絵。"},
  {"en": "Amber eyes, a teal field coat, and one bright ember tail.", "to": "こはく色の目、青緑のコート、そして明るく光るほのおのしっぽ。", "kanji": "こはく色の目、青緑のコート、そして明るく光るほのおのしっぽ。"},
  {"en": "Hovering Caster · 3D trial", "to": "宙にうかぶ術師（じゅつし） · 3Dのためし", "kanji": "宙にうかぶ術師 · 3Dの試し"},
  {"en": "A VRoid model on the new move set: she drives her palms through the circle at the foes.", "to": "新しい動きのVRoidモデル。手のひらで魔法陣（まほうじん）をおしだして、敵に打ちこむ。", "kanji": "新しい動きのVRoidモデル。手のひらで魔法陣をおしだして、敵に打ちこむ。"},
  {"en": "Animation lab · plain mannequin", "to": "アニメーション実験室 · ただのマネキン", "kanji": "アニメーション実験室 · ただのマネキン"},
  {"en": "A jointed mannequin on the same skeleton as every 3D skin, for judging the moves with nothing to hide behind.", "to": "どの3Dスキンとも同じ骨組みの、関節のあるマネキン。何にもかくれずに、動きをたしかめるためのもの。", "kanji": "どの3Dスキンとも同じ骨組みの、関節のあるマネキン。何にもかくれずに、動きをたしかめるためのもの。"},
  {"en": "Local reference · not shipped", "to": "このパソコンだけの参考 · 配布しない", "kanji": "このパソコンだけの参考 · 配布しない"},
  {"en": "A model kept on this machine to study its look; it plays the same moves.", "to": "見た目を研究するために、このパソコンにおいてあるモデル。動きは同じだよ。", "kanji": "見た目を研究するために、このパソコンにおいてあるモデル。動きは同じだよ。"},
  {"en": "THE ARCHIVES", "to": "書庫（しょこ）", "kanji": "書庫"},
  {"en": "Every function. Every artifact. A place to plan your next combination.", "to": "すべての関数、すべての遺物（いぶつ）。次の組み合わせを考える場所だよ。", "kanji": "すべての関数、すべての遺物。次の組み合わせを考える場所だよ。"},
  {"en": "Search names, effects, elements or keywords…", "to": "名前、効果、属性（ぞくせい）、キーワードでさがす…", "kanji": "名前、効果、属性、キーワードで探す…"},
  {"en": "Weakness", "to": "弱点", "kanji": "弱点"},
  {"en": "This foe takes extra damage from bolts of the listed element. Relics can increase the bonus.", "to": "この敵は、書かれた属性（ぞくせい）のボルトで大きなダメージを受ける。遺物（いぶつ）でもっと大きくできるよ。", "kanji": "この敵は、書かれた属性のボルトで大きなダメージを受ける。遺物でもっと大きくできるよ。"},
  {"en": "Resistance", "to": "耐性", "kanji": "耐性"},
  {"en": "This foe takes less damage from bolts of the listed element.", "to": "この敵は、書かれた属性（ぞくせい）のボルトのダメージが少なくなる。", "kanji": "この敵は、書かれた属性のボルトのダメージが少なくなる。"},
  {"en": "Change the element to avoid its resistance.", "to": "属性（ぞくせい）を変えて、耐性をさけよう。", "kanji": "属性を変えて、耐性をさけよう。"},
  {"en": "%d %s · select an entry to inspect it", "to": "{2} {1}件 · えらぶと、くわしく見られるよ", "kanji": "{2} {1}件 · 選ぶと、くわしく見られるよ"},
  {"en": "No matches. Try another name or clear your filters.", "to": "見つからないよ。ほかの名前にするか、しぼりこみを消してみよう。", "kanji": "見つからないよ。ほかの名前にするか、しぼりこみを消してみよう。"},
