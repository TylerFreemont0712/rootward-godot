// Japanese for Lanternroot's bag (items), the creator's parts and colours, the music box (tracks and where they are
// heard), the map and its places, the map texts that Space reads, and the things' names and hints (Concept/v0.4/06).
// Code (thing.keys, open, say, player) stays as it is. Names of the Shardrun's places match the game's own
// (shardrun.jsonc: ヒープ工房, 遺構（いこう）, ルート聖域, カーネル).
[
  {"en": "A brass gear, a little oily. Mira says every lantern in town has one inside.", "to": "しんちゅうの ギア。すこし あぶらっぽい。ミラが いうには、むらの ランタンは ぜんぶ、なかに ギアを ひとつずつ もって いるんだって。", "kanji": "少し油の付いた真鍮の歯車。ミラによると、村のランタンには必ず一つ入っているらしい。"},
  {"en": "A fresh loaf, still warm. Marta bakes it every morning.", "to": "できたての パン。まだ あたたかいよ。マルタが まいあさ やいて いるの。", "kanji": "焼きたてで、まだ温かいパン。マルタが毎朝焼いている。"},
  {"en": "A handful of little red ones. Save some for Marta's tarts.", "to": "ちいさくて あかい ベリーが ひとにぎり。マルタの タルトに、すこし とっておこうね。", "kanji": "小さな赤いベリーが一握り。マルタのタルト用にも少し残しておこう。"},
  {"en": "A little bottle that smells of warm wax. Lumen keeps the lanterns lit with it.", "to": "あたたかい ロウの においが する、ちいさな びん。ルーメンは これで ランタンを ともして いるの。", "kanji": "温かい蝋の匂いがする小瓶。ルーメンはこの油でランタンを灯している。"},
  {"en": "Apple", "to": "りんご", "kanji": "りんご"},
  {"en": "Berries", "to": "ベリー", "kanji": "ベリー"},
  {"en": "Big and orange, and it sits very still. Pip wants to count its seeds.", "to": "おおきくて だいだいいろ。とても じっと して いるよ。ピップが たねを かぞえたいって！", "kanji": "大きな橙色のかぼちゃが、どっしりと鎮座している。ピップは種を数えたいらしい。"},
  {"en": "Bread", "to": "パン", "kanji": "パン"},
  {"en": "Brown-capped and damp, from the shady side of the grove. Ask Fern first.", "to": "かさが ちゃいろで、しめって いる。もりの かげの ほうから とれたよ。まずは ファーンに きいてね。", "kanji": "茶色い傘の、湿ったきのこ。木立の日陰で採れたものだ。まずはファーンに聞いてみよう。"},
  {"en": "Cabbage", "to": "キャベツ", "kanji": "キャベツ"},
  {"en": "Carrot", "to": "にんじん", "kanji": "にんじん"},
  {"en": "Crisp and red. Marta says they're best in pie.", "to": "パリッと あかい。マルタいわく、パイに するのが いちばん おいしいんだって。", "kanji": "赤くて歯応えのよいりんご。マルタに言わせれば、パイにするのが一番らしい。"},
  {"en": "Folded twice and sealed with green wax. Nym says the post is always late.", "to": "にど おって、みどりの ロウで ふうを して ある。ニムいわく、ゆうびんは いつも おそいんだって。", "kanji": "二度折り畳み、緑の蝋で封をした手紙。ニムによると、郵便はいつも遅れるらしい。"},
  {"en": "Gear", "to": "ギア", "kanji": "歯車"},
  {"en": "Golden and sticky, from the hive by the square. Marta spreads it on her bread.", "to": "きんいろで ねばねば。ひろばの ハチの すから とって きたの。マルタは パンに ぬるんだよ。", "kanji": "広場の蜂の巣で採れた、黄金色の粘り気のある蜂蜜。マルタはパンに塗って食べる。"},
  {"en": "Honey", "to": "はちみつ", "kanji": "蜂蜜"},
  {"en": "Iron and cold, and cut for a door somewhere. Nym thinks it is worth keeping.", "to": "てつで できた、つめたい かぎ。どこかの とびらに あうように きざまれて いる。ニムは とっておく かちが あると いって いるよ。", "kanji": "冷たい鉄の鍵。どこかの扉に合うように刻まれている。ニムは取っておく価値があると言っている。"},
  {"en": "Key", "to": "キー", "kanji": "鍵"},
  {"en": "Lantern oil", "to": "ランタンの あぶら", "kanji": "ランタン用の油"},
  {"en": "Letter", "to": "てがみ", "kanji": "手紙"},
  {"en": "Mushroom", "to": "きのこ", "kanji": "きのこ"},
  {"en": "One pressed flower, still a little sweet. Mira says it would make a good bookmark.", "to": "おしばなに した はな。まだ すこし あまい かおりが する。ミラいわく、しおりに いいんだって。", "kanji": "ほのかに甘い香りの残る押し花。ミラは栞にするとよさそうだと言っている。"},
  {"en": "Orange and crunchy, from the rows behind the grove. Fern says it likes the rain.", "to": "だいだいいろで、サクサク。もりの うしろの はたけから とって きたよ。ファーンいわく、あめが すきなんだって。", "kanji": "木立の裏の畑で採れた、歯応えのよい橙色のにんじん。ファーンによると、雨が好きらしい。"},
  {"en": "Pale and round, with a purple hat. Good in a stew, Marta says.", "to": "しろっぽくて まるい。むらさきの ぼうしを かぶって いるよ。マルタいわく、シチューに いいんだって。", "kanji": "白くて丸いかぶ。紫の帽子を被っている。マルタによると、シチューに向いているらしい。"},
  {"en": "Pebble", "to": "こいし", "kanji": "小石"},
  {"en": "Pinecone", "to": "まつぼっくり", "kanji": "松ぼっくり"},
  {"en": "Pumpkin", "to": "かぼちゃ", "kanji": "かぼちゃ"},
  {"en": "Round, green and a little proud of itself. Marta needs one for soup.", "to": "まるくて みどり。ちょっと じまんげな かお。マルタは スープに ひとつ ひつようなの。", "kanji": "丸くて緑色の、少し得意げなキャベツ。マルタがスープ用に一つ欲しがっている。"},
  {"en": "Scaly and brown, and it still smells of the forest.", "to": "うろこみたいに ちゃいろい。まだ もりの においが するよ。", "kanji": "鱗のような形の茶色い松ぼっくり。まだ森の匂いがする。"},
  {"en": "Smooth and grey, and warm from the sun. Pell likes it as a paperweight.", "to": "つるつると はいいろ。おひさまで あたたかい。ペルは おもしに するのが すきなんだ。", "kanji": "滑らかな灰色の石。日差しを浴びて温かい。ペルは文鎮として使うのが気に入っている。"},
  {"en": "Turnip", "to": "かぶ", "kanji": "かぶ"},
  {"en": "Flower", "to": "はな", "kanji": "花"},
  {"en": "A pendulum clock. It ticks, and it is never late.", "to": "ふりこの とけい。カチコチ いって、ぜったいに おくれないよ。", "kanji": "振り子時計。規則正しく時を刻み、決して遅れることはない。"},
  {"en": "Your workbench. Every part you build is here.", "to": "きみの さぎょうだい。つくった パーツは、ぜんぶ ここに あるよ。", "kanji": "君の作業台。作ったパーツは全てここに並ぶ。"},
  {"en": "A music box. No tunes in it yet...", "to": "オルゴール。まだ きょくは はいって いないよ…", "kanji": "オルゴール。まだ曲は入っていない……。"},
  {"en": "Hollis's house. The door is locked. Twice.", "to": "ホリスの いえ。とびらには かぎが かかって いる。しかも にかいもね。", "kanji": "ホリスの家。扉には鍵が掛かっている。しかも二重に。"},
  {"en": "Pell's house. There is a map pinned in every window.", "to": "ペルの いえ。どの まどにも ちずが はって あるよ。", "kanji": "ペルの家。どの窓にも地図が貼ってある。"},
  {"en": "Pell's map table, covered in blank maps.", "to": "ペルの ちずの つくえ。まっさらな ちずで いっぱいだよ。", "kanji": "ペルの地図机。白紙の地図で埋め尽くされている。"},
  {"en": "Seren's cottage. Something small and glowing is asleep on the windowsill.", "to": "セレンの ちいさな いえ。まどぎわで、ひかる ちいさな なにかが ねむって いるよ。", "kanji": "セレンの小さな家。窓辺では、光を放つ小さな何かが眠っている。"},
  {"en": "The Archive. The square. Home. Pick a road.", "to": "きろくこ。ひろば。いえ。みちを えらんでね。", "kanji": "記録庫、広場、それとも家。進む道を選ぼう。"},
  {"en": "The lamp lane. Lumen's shrine is at the end.", "to": "ランプの こみち。おくに ルーメンの ほこらが あるよ。", "kanji": "ランタンの並ぶ小道。その奥にルーメンの祠がある。"},
  {"en": "The old stones. Please walk softly.", "to": "ふるい いしの ところ。しずかに あるいてね。", "kanji": "古い石碑。どうか静かに歩いてください。"},
  {"en": "Archive Quarter", "to": "きろくこの あたり", "kanji": "記録庫地区"},
  {"en": "Lantern Square", "to": "ランタンの ひろば", "kanji": "ランタン広場"},
  {"en": "North Green", "to": "きたの しばふ", "kanji": "北の緑地"},
  {"en": "Root Gate Road", "to": "ねっこの もんへの みち", "kanji": "根の門通り"},
  {"en": "Warm Hearth Row", "to": "あったかだんろ どおり", "kanji": "温かな暖炉通り"},
  {"en": "Waterside", "to": "みずべ", "kanji": "水辺"},
  {"en": "A gate can count something. What could it count?", "to": "もんは なにかを かぞえられるよ。なにを かぞえたら いいかな？", "kanji": "門にも何かを数えさせられる。何を数えればよいだろう？"},
  {"en": "Ask whether that list holds four keys, then set open.", "to": "そのリストに キーが 4つ あるか きいてから、open を きめよう。", "kanji": "リストに四つのキーがあるかを調べ、その結果で open を設定しよう。"},
  {"en": "The cabbage-plot gate", "to": "キャベツばたけの もん", "kanji": "キャベツ畑の門"},
  {"en": "thing.keys is the list of keys your boots know.", "to": "thing.keys は、くつが しって いる キーの リストだよ。", "kanji": "thing.keys は、靴が知っているキーのリストだよ。"},
  {"en": "A sign can say what it is told.", "to": "かんばんは、いわれた ことを いえるんだよ。", "kanji": "看板には、指定した言葉を表示させられる。"},
  {"en": "Return the words you want said under say.", "to": "say の なかに、いわせたい ことばを いれて かえそう。", "kanji": "表示したい言葉を say の値に入れて返そう。"},
  {"en": "The crossroads signpost", "to": "こうさてんの みちしるべ", "kanji": "交差点の道標"},
  {"en": "Your code can read where you stand from the player.", "to": "きみの コードは、player から いまの ばしょを よめるよ。", "kanji": "player から、今立っている場所を読み取れる。"},
  {"en": "A Quiet Alcove", "to": "しずかな すみっこ", "kanji": "静かな一角"},
  {"en": "Between the Rings", "to": "リングの あいだ", "kanji": "リングの狭間"},
  {"en": "Heapworks Hum", "to": "ヒープ工房の うなり", "kanji": "ヒープ工房の響き"},
  {"en": "Hold the Middle", "to": "まんなかを まもれ", "kanji": "中央を守れ"},
  {"en": "Home Hollow", "to": "いえの くぼち", "kanji": "家のある窪地"},
  {"en": "Kernel Panic", "to": "カーネルパニック", "kanji": "カーネルパニック"},
  {"en": "Lanternroot's Front Door", "to": "ともしび村の げんかん", "kanji": "ともしび村の玄関"},
  {"en": "Leak Hunt", "to": "もれ さがし", "kanji": "漏れの追跡"},
  {"en": "Root Sanctum", "to": "ルート聖域（せいいき）", "kanji": "ルート聖域"},
  {"en": "Rootward", "to": "Rootward", "kanji": "Rootward"},
  {"en": "Rust and Roots", "to": "さびと ねっこ", "kanji": "錆と根"},
  {"en": "Salvage Skirmish", "to": "遺構（いこう）の ちいさな たたかい", "kanji": "遺構の小競り合い"},
  {"en": "Sanctum Strike", "to": "聖域（せいいき）の いちげき", "kanji": "聖域の一撃"},
  {"en": "The Guardian", "to": "番人（ばんにん）", "kanji": "番人"},
  {"en": "The Kernel", "to": "カーネル", "kanji": "カーネル"},
  {"en": "Things Live in the Leaks", "to": "もれの なかに すむ もの", "kanji": "漏れに棲むもの"},
  {"en": "Use After Free", "to": "ユース・アフター・フリー", "kanji": "解放後の使用"},
  {"en": "fights in the Heap", "to": "ヒープの たたかい", "kanji": "ヒープでの戦闘"},
  {"en": "fights in the Heapworks", "to": "ヒープ工房の たたかい", "kanji": "ヒープ工房での戦闘"},
  {"en": "fights in the Kernel", "to": "カーネルの たたかい", "kanji": "カーネルでの戦闘"},
  {"en": "fights in the Root Sanctum", "to": "ルート聖域の たたかい", "kanji": "ルート聖域での戦闘"},
  {"en": "fights in the Salvage", "to": "遺構（いこう）の たたかい", "kanji": "遺構での戦闘"},
  {"en": "fights in the middle ring", "to": "まんなかの リングの たたかい", "kanji": "中央リングでの戦闘"},
  {"en": "home and the rooms indoors", "to": "いえと へやの なか", "kanji": "家と屋内の部屋"},
  {"en": "the Shardrun's Heap", "to": "シャードランの ヒープ", "kanji": "シャードランのヒープ"},
  {"en": "the Shardrun's Heapworks", "to": "シャードランの ヒープ工房", "kanji": "シャードランのヒープ工房"},
  {"en": "the Shardrun's Kernel", "to": "シャードランの カーネル", "kanji": "シャードランのカーネル"},
  {"en": "the Shardrun's Root Sanctum", "to": "シャードランの ルート聖域", "kanji": "シャードランのルート聖域"},
  {"en": "the Shardrun's Salvage", "to": "シャードランの 遺構（いこう）", "kanji": "シャードランの遺構"},
  {"en": "the Shardrun's middle ring", "to": "シャードランの まんなかの リング", "kanji": "シャードランの中央リング"},
  {"en": "the character select", "to": "キャラクターを えらぶ ところ", "kanji": "キャラクター選択画面"},
  {"en": "the code editors", "to": "コードを かく ところ", "kanji": "コードエディター"},
  {"en": "the guardians of the first layers", "to": "はじめの かいそうの ばんにん", "kanji": "序盤の階層の番人"},
  {"en": "the last guardian of a Shardrun", "to": "シャードランの さいごの ばんにん", "kanji": "シャードランの最後の番人"},
  {"en": "the rest rooms of a Shardrun", "to": "シャードランの 休けいの へや", "kanji": "シャードランの休憩室"},
  {"en": "the title", "to": "タイトル", "kanji": "タイトル画面"},
  {"en": "the town", "to": "むら", "kanji": "村"}
]
