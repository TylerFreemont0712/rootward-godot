// Japanese for Lanternroot's talk, townspeople and map texts (ADR-0061), keyed by the English exactly (ADR-0047).
// Names are katakana, ほたる is Hotaru, and the town is ともしび村 as the letters screen has it. Code, ids and
// symbols stay as they are, and Latin tokens (Python, y, B, Space) sit with a space beside Japanese.
[
  // talk/archivist.jsonc
  {"en": "Ah. The new tinker. I'm Vell. I keep the town's records in the Archive.", "to": "ああ、あたらしい しゅうりやさんですね。わたしは ヴェルです。ともしび村の きろくは、きろくこで わたしが まもっています。", "kanji": "ああ、新しい修理屋さんですね。私はヴェル。記録庫でこの町の記録を管理しています。"},
  {"en": "Every change anyone makes in Lanternroot, I write down. When something breaks, we can always see what changed.", "to": "ともしび村で だれかが かえた ことは、ぜんぶ わたしが かきとめて います。なにかが こわれても、なにが かわったのか、すぐ わかるんですよ。", "kanji": "ともしび村で誰かが何かを変えるたびに、私は記録を残します。何かが壊れても、どこが変わったのか、いつでも確認できるんですよ。"},
  {"en": "That sounds useful.", "to": "それは べんりそう！", "kanji": "便利そうですね。"},
  {"en": "That sounds like a lot of writing.", "to": "それは、かくことが たくさん そう。", "kanji": "ずいぶん書くことが多そうですね。"},
  {"en": "Nothing new in the records today. Yet.", "to": "きょうは、きろくに あたらしい ことは まだ ありません。まだ、ですけどね。", "kanji": "今日は、記録に新しいことはまだありません。まだ、ですけどね。"},
  {"en": "Very. You'll see.", "to": "とても。そのうち わかりますよ。", "kanji": "とても。そのうち分かりますよ。"},
  {"en": "Oh, enormous amounts. I love it.", "to": "ええ、それは もう たくさん！ でも わたしは、そこが だいすきなんです。", "kanji": "ええ、それはもう膨大な量です！でも、私はそれが大好きなんですよ。"},

  // talk/artificer.jsonc
  {"en": "You're the tinker with the empty boots? Not empty any more, I see!", "to": "からっぽの くつを はいた しゅうりやさんって、あなたのこと？ あら、もう からっぽじゃ ないのね！", "kanji": "空っぽの靴を履いた修理屋さんって、あなたのこと？あら、もう空っぽじゃないのね！"},
  {"en": "I'm Mira. I build little machines in the workshop. They do exactly what they're told.", "to": "わたしは ミラ。こうぼうで ちいさな きかいを つくって いるの。きかいは、いわれた ことを そのまま するのよ。", "kanji": "私はミラ。工房で小さな機械を作っているの。機械は、言われたことをそのままするのよ。"},
  {"en": "Exactly what they're told. Not what you meant. That's the tricky part!", "to": "いわれた ことを、そのまま。きみの いいたかった ことには ならないの。そこが いちばん むずかしくて、おもしろいのよ！", "kanji": "言われたことを、そのまま。君の言いたかったことにはならないの。そこが一番難しくて、面白いのよ！"},
  {"en": "Built anything yet? Come and show me when you do.", "to": "もう なにか つくった？ できたら、ぜひ みせに きてね。", "kanji": "もう何か作った？できたら、ぜひ見せに来てね。"},

  // talk/compiler.jsonc
  {"en": "Hm. So you're the tinker.", "to": "ふむ。おまえさんが しゅうりやさんか。", "kanji": "ふむ。おまえさんが修理屋さんか。"},
  {"en": "I'm Brannoc. I turn rough iron into good tools. A tool from my forge works the same way, every single time.", "to": "ブラノックだ。あらい てつを、いい どうぐに かえるのが しごとだ。おれの かじばの どうぐは、なんど つかっても おなじに はたらく。", "kanji": "ブラノックだ。粗い鉄を、いい道具に変えるのが仕事だ。俺の鍛冶場の道具は、何度使っても同じに働く。"},
  {"en": "Bring me careful work one day, and I'll make something of it.", "to": "いつか、ていねいな しごとを もって こい。そしたら、おれも なにか つくって やる。", "kanji": "いつか、丁寧な仕事を持ってこい。そしたら、俺も何か作ってやる。"},
  {"en": "Still here? The forge doesn't wait.", "to": "まだ いたのか？ かじばは まって くれないぞ。", "kanji": "まだいたのか？鍛冶場は待ってくれないぞ。"},

  // talk/guard.jsonc
  {"en": "Halt! ...Oh, you're the new tinker. Sorry. Habit.", "to": "とまれ！ …あ、あたらしい しゅうりやさんか。すまん、くせなんだ。", "kanji": "止まれ！ …あ、新しい修理屋さんか。すまん、くせなんだ。"},
  {"en": "I keep watch over the road and the Root Gate. Nothing gets past me.", "to": "わたしは みちと ねっこの もんを みはって いる。なにも、わたしの よこを とおりぬけられないぞ。", "kanji": "私は道と根の門を見張っている。誰も私の横を通り抜けられないぞ。"},
  {"en": "I get past you every night.", "to": "わたしは まいばん、あなたの よこを すいっと とおってるけどね。", "kanji": "私は毎晩、あなたの横をすいっと通ってるけどね。"},
  {"en": "You glow, firefly. Glowing things are allowed.", "to": "ひかって いるな、ほたる。ひかる ものは とおって いいんだ。", "kanji": "光っているな、ほたる。光るものは通っていいんだ。"},
  {"en": "All quiet. The way I like it.", "to": "きょうも しずかだ。わたしは、これが いちばん すきなんだ。", "kanji": "今日も静かだ。私は、これが一番すきなんだ。"},

  // talk/guildmaster.jsonc
  {"en": "I'm Orin, young tinker. I've watched this town grow for years.", "to": "わしは オリンじゃ。わかい しゅうりやさん。この村が そだつのを、なんねんも みまもって きたんじゃよ。", "kanji": "わしはオリンじゃ。若い修理屋さん。この村が育つのを、何年も見守ってきたんじゃよ。"},
  {"en": "We've needed a tinker since the old one left. Things here are... a little broken.", "to": "まえの しゅうりやさんが いなくなって から、ずっと しゅうりやさんが ひつようじゃった。ここの ものは…すこし こわれて おってのう。", "kanji": "前の修理屋さんがいなくなってから、ずっと修理屋さんが必要じゃった。ここのものは…少し壊れておってのう。"},
  {"en": "Take your time. Meet everyone. When you're ready, there will be work.", "to": "あわてなくて いいぞ。みんなに あって おいで。じゅんびが できたら、しごとも あるからの。", "kanji": "慌てなくていいぞ。みんなに会っておいで。準備ができたら、仕事もあるからの。"},
  {"en": "The town is glad you came.", "to": "村は きみが きてくれて、よろこんで おるぞ。", "kanji": "村は君が来てくれて、喜んでおるぞ。"},

  // talk/hotaru-all-ways.jsonc
  {"en": "Up, down, left and right! Your boots can take you anywhere now.", "to": "うえ、した、ひだり、みぎ！ もう、くつで どこへでも いけるよ！", "kanji": "上、下、左、右！もう、靴でどこへでも行けるよ！"},
  {"en": "Did you notice? Going up made y smaller.", "to": "きづいた？ うえへ いくと、y が ちいさく なったでしょ。", "kanji": "気づいた？上へいくと、y が小さくなったでしょ。"},
  {"en": "The door's at the bottom of the room. Let's go meet everyone!", "to": "とびらは へやの いちばん したよ。みんなに あいに いこう！", "kanji": "扉は部屋の一番したよ。みんなにあいに行こう！"},

  // talk/hotaru-first-step.jsonc
  {"en": "You walked! Your own code moved you!", "to": "あるけた！ きみの かいた コードで、きみが うごいたんだよ！", "kanji": "歩けた！君の書いたコードで、君が動いたんだよ！"},

  // talk/hotaru-town.jsonc
  {"en": "Welcome to Lanternroot!", "to": "ようこそ、ともしび村へ！", "kanji": "ようこそ、ともしび村へ！"},
  {"en": "See the big tree in the square? That's the Lantern Root. The whole town grew up around it.", "to": "ひろばの おおきな木が みえる？ あれが ランタンの木。村ぜんぶ、あの木の まわりで そだったのよ。", "kanji": "広場の大きな木が見える？あれがランタンの木。この町は、あの木を中心に発展してきたのよ。"},
  {"en": "Walk up to someone and press Space to talk. Everyone wants to meet the new tinker!", "to": "だれかの まえまで いって、スペースキーを おすと はなせるよ。みんな、あたらしい しゅうりやさんに あいたがってるんだ！", "kanji": "誰かの前まで行って Space を押すと話せるよ。みんな、新しい修理屋さんに会いたがってるんだ！"},

  // talk/hotaru-wake.jsonc
  {"en": "Psst! Over here, by the lantern!", "to": "しーっ！ こっちだよ、ランタンの よこ！", "kanji": "しーっ！こっちだよ、ランタンの横！"},
  {"en": "I'm Hotaru. I live in the lantern on your desk. Every lantern in Lanternroot has a firefly like me.", "to": "わたしは ほたる。きみの つくえの ランタンに すんで いるの。ともしび村の ランタンには、わたしみたいな ほたるが いつも いるんだよ。", "kanji": "私はほたる。君の机のランタンに住んでいるの。ともしび村のランタンには、私みたいなほたるがいつもいるんだよ。"},
  {"en": "And you're the new tinker! The whole town has been waiting for you.", "to": "それと、きみが あたらしい しゅうりやさんね！ 村の みんなが、きみを まって いたんだよ。", "kanji": "それと、君が新しい修理屋さんね！村のみんなが、君を待っていたんだよ。"},
  {"en": "Come over and say hello! ...Oh. You can't, can you?", "to": "こっちに きて、あいさつしてね！ …あ。そっか、いけないんだっけ？", "kanji": "こっちに来て、挨拶してね！ …あ。そっか、いけないんだっけ？"},
  {"en": "Everything in Lanternroot runs on code. Even your boots. And yours are still empty!", "to": "ともしび村では、なにもかも コードで うごいて いるの。くつも そう。でも きみの くつは、まだ からっぽなんだよ！", "kanji": "ともしび村では、何もかもコードで動いているの。靴もそう。でも君の靴は、まだ空っぽなんだよ！"},
  {"en": "Let's teach them to walk first. Then we'll teach them to do something.", "to": "まずは くつに あるく やりかたを おしえよう。そのあと、なにかを する やりかたも おしえるね。", "kanji": "まずは靴に歩き方を教えよう。その後で、何かに働きかける方法も教えるね。"},

  // talk/innkeeper.jsonc
  {"en": "Oh! You must be the new tinker! Pull up a stool.", "to": "まあ！ あなたが あたらしい しゅうりやさんね！ さあ、こしかけて ちょうだいね。", "kanji": "まあ！あなたが新しい修理屋さんね！さあ、腰掛けてちょうだいね。"},
  {"en": "I'm Marta. I run the Warm Hearth, just here. There's always a pot of soup on, day or night.", "to": "わたしは マルタ。すぐそこの あったかだんろを やってるのよ。おなべには、ひるも よるも いつも スープが にえて いるの。", "kanji": "私はマルタ。すぐそこの温かな暖炉をやってるのよ。お鍋には、昼も夜もいつもスープが煮えているの。"},
  {"en": "Always? How?", "to": "いつも？ どうやって？", "kanji": "いつも？どうやって？"},
  {"en": "Nice to meet you!", "to": "はじめまして！", "kanji": "はじめまして！"},
  {"en": "Back again? The soup's still warm!", "to": "また きたの？ スープは まだ あったかいわよ！", "kanji": "またきたの？スープはまだ温かいわよ！"},
  {"en": "I cook one big pot in the morning. Then when someone's hungry, a bowl is ready in a moment.", "to": "あさに、おおきな なべで いっかい にるの。おなかの すいた ひとが くると、ひとわんは すぐ できるのよ。", "kanji": "朝に、大きななべで一回にるの。お腹のすいた人がくると、一椀はすぐできるのよ。"},
  {"en": "Cooking it fresh every single time would be far too slow! Remember that trick. It's a good one.", "to": "いちいち ぜんぶ つくって いたら、とても まに あわないでしょ！ この くふうは おぼえて おいてね。いい ほうほうなのよ。", "kanji": "注文のたびに最初から作っていたら、間に合わないでしょ！この工夫は覚えておいてね。役に立つ方法なのよ。"},
  {"en": "Come by when your boots get tired.", "to": "くつが つかれたら、いつでも よって いってね。", "kanji": "歩き疲れたら、いつでも寄っていってね。"},

  // talk/keeper.jsonc
  {"en": "Shh. The tree is listening.", "to": "しーっ。木が きいて いるのよ。", "kanji": "しーっ。木が聞いているのよ。"},
  {"en": "I'm Fern. I tend the Lantern Root. Its roots go down further than anyone has ever followed them.", "to": "わたしは ファーン。ランタンの木の せわを して いるの。その ねっこは、だれも おって いけないほど、ふかくまで のびて いるのよ。", "kanji": "私はファーン。ランタンの木のせわをしているの。その根は、誰も追っていけないほど、深くまで伸びているのよ。"},
  {"en": "I was born on one of its branches!", "to": "わたしは、その えだの ひとつで うまれたのよ！", "kanji": "私は、その枝の一つで生まれたのよ！"},
  {"en": "The roots are humming today. Can you hear them?", "to": "きょうは ねっこが ブーンと ひびいて いるの。きこえる？", "kanji": "今日は根がブーンと響いているの。聞こえる？"},

  // talk/necromancer.jsonc
  {"en": "Oh. A visitor. Most people avoid my corner.", "to": "あら…おきゃくさま。ここには、みんな あまり きたがらないの。", "kanji": "あら…お客様。ここには、みんなあまりきたがらないの。"},
  {"en": "I'm Morrow. I keep the old stones. Each one marks something someone made long ago and stopped using.", "to": "わたしは モロウ。ふるい いしを まもって いるの。いしは ひとつずつ、むかし だれかが つくって、もう つかわなくなった ものを しるして いるのよ。", "kanji": "私はモロウ。古い石を守っているの。石は一つずつ、昔誰かが作って、もう使わなくなったものを記しているのよ。"},
  {"en": "Nothing here is dead, you know. It's only... retired.", "to": "ここの もの、しんで いるわけじゃ ないのよ。ただ…いまは おやすみ して いるだけ。", "kanji": "ここのもの、死んでいるわけじゃないのよ。ただ…今はおやすみしているだけ。"},
  {"en": "The stones are quiet today. They usually are.", "to": "きょうは いしが しずかね。いつも そう だけど。", "kanji": "今日は石が静かね。いつもそうだけど。"},

  // talk/noticeboard.jsonc
  {"en": "LANTERNROOT NOTICES.", "to": "ともしび村の おしらせ。", "kanji": "ともしび村のお知らせ。"},
  {"en": "Lost: one spare lantern. Found: it was on the bench all along.", "to": "まいご：よびの ランタンが ひとつ。みつかった：ずっと ベンチの うえに あったよ。", "kanji": "迷子：予備のランタンが一つ。見つかった：ずっとベンチの上にあったよ。"},
  {"en": "Not yet", "to": "まだ いい", "kanji": "まだいい"},

  // talk/oracle.jsonc
  {"en": "Every lantern in town has a firefly inside. I look after them all.", "to": "村の ランタンには、ひとつずつ ほたるが すんで いるの。わたしは、その ほたるたちを ぜんぶ みて いるのよ。", "kanji": "村のランタンには、一つずつほたるが住んでいるの。私は、そのほたるたちを全部見ているのよ。"},
  {"en": "Hotaru is one of mine, you know. She's very proud to be yours now.", "to": "ほたるも、わたしの ほたるの ひとりなのよ。いまは あなたの ほたるに なれて、とても ほこらしそう。", "kanji": "ほたるも、私のほたるの一人なのよ。今はあなたのほたるになれて、とても誇らしそう。"},
  {"en": "Lumen! Don't tell them that!", "to": "ルーメン！ そんなこと、みんなに いわないでよ！", "kanji": "ルーメン！そんなこと、みんなに言わないでよ！"},
  {"en": "May your lantern never go out, tinker.", "to": "あなたの ランタンが、いつまでも きえませんように。しゅうりやさん。", "kanji": "修理屋さん、あなたのランタンが、いつまでも消えませんように。"},

  // talk/pell.jsonc
  {"en": "Hi! You're new! I'm Pell. I make maps.", "to": "やあ！ きみ、あたらしいね！ わたしは ペル。ちずを かいて いるんだ。", "kanji": "やあ！君、新しいね！私はペル。ちずを書いているんだ。"},
  {"en": "I've drawn every street in Lanternroot. Twice! But the roots under the town... nobody has mapped those.", "to": "ともしび村の みちは、ぜんぶ かいたよ。にかいもね！ でも、村の した の ねっこは…だれも ちずに して いないんだ。", "kanji": "ともしび村の道は全部描いたよ。二回もね！でも、町の地下に伸びる根は…まだ誰も地図にしていないんだ。"},
  {"en": "One day I'll get past the Root Gate. You'll come too, right?", "to": "いつか、ねっこの もんを とおりぬけて みせるよ。きみも いっしょに いくよね？", "kanji": "いつか、根の門を通り抜けてみせるよ。君も一緒にいくよね？"},
  {"en": "Lost? Everything starts at the big tree.", "to": "まいご？ なにもかも、おおきな木から はじまるんだよ。", "kanji": "迷った？何事も、あの大きな木から始まるんだよ。"},

  // talk/pip.jsonc
  {"en": "Shh! I'm counting the lanterns on the big tree.", "to": "しーっ！ ぼく、おおきな木の ランタンを かぞえて いるんだ。", "kanji": "しーっ！僕、大きな木のランタンを数えているんだ。"},
  {"en": "One, two, three... nine, ten. Ten lanterns!", "to": "いち、に、さん…きゅう、じゅう！ ランタンは じゅっこ！", "kanji": "一、二、三…九、十。ランタンは十個！"},
  {"en": "It's eleven.", "to": "じゅういっこだよ。", "kanji": "十一個だよ。"},
  {"en": "Ten! You can't even count, you're a bug.", "to": "じゅうだよ！ ほたるって、かぞえるのも へたっぴだね。むしだもんね！", "kanji": "十だよ！ほたるって、数えるのもへたっぴだね。むしだもんね！"},
  {"en": "Did you start counting at zero?", "to": "0から かぞえはじめたの？", "kanji": "0から数え始めたの？"},
  {"en": "Want some help?", "to": "てつだおうか？", "kanji": "手伝おうか？"},
  {"en": "Ten lanterns. Or eleven. I'm counting again tomorrow.", "to": "じゅっこ。それとも じゅういっこ。あしたも また かぞえるんだ。", "kanji": "十個。それとも十一個。明日もまた数えるんだ。"},
  {"en": "Zero? Why would anybody start counting at zero?", "to": "0？ どうして だれかが 0から かぞえるの？", "kanji": "0？どうして誰かが 0から数えるの？"},
  {"en": "...Wait. Is that a tinker thing?", "to": "…まって。それって、しゅうりやさんの ひみつ？", "kanji": "…待って。それって、修理屋さんの秘密？"},
  {"en": "No thank you! I'm almost sure it's ten.", "to": "けっこうだよ！ じゅうで まちがいないと おもうもん。", "kanji": "結構だよ！十で間違いないと思うもん。"},

  // talk/quartermaster.jsonc
  {"en": "Nym's! Everything a tinker needs. A few things nobody needs, too.", "to": "ニムの おみせ！ しゅうりやさんに ひつような もの、なんでも そろってるよ。それと、だれも ひつようと おもわない もの、すこしね！", "kanji": "ニムのお店！修理屋さんに必要なもの、なんでも揃ってるよ。それと、誰も必要と思わないもの、少しね！"},
  {"en": "The shop isn't quite open yet. Come back when you've got work and coins.", "to": "おみせは、まだ ちょっとだけ あいて いないの。しごとと コインが できたら、また きてね。", "kanji": "お店はまだ準備中なの。仕事を見つけてコインを手に入れたら、また来てね。"},
  {"en": "Nearly open! Very, very nearly.", "to": "もうすぐ あくよ！ ほんとに、もうすぐなんだから！", "kanji": "もうすぐあくよ！本当に、もうすぐなんだから！"},

  // talk/sergeant.jsonc
  {"en": "Tinker! Good. Stand up straight!", "to": "しゅうりやさん！ よし。せすじを のばせ！", "kanji": "修理屋さん！よし。背筋を伸ばせ！"},
  {"en": "I train the town guard. Practise every day, and nothing will surprise you.", "to": "わたしは 村の けいびたいを きたえて いる！ まいにち れんしゅうすれば、なにに おどろかされることも ない！", "kanji": "私は町の警備隊を鍛えている！毎日練習を積めば、何が起きても動じなくなるぞ！"},
  {"en": "Those boots look new. Walk a few laps of the drill yard. Good practice!", "to": "その くつ、あたらしいな！ くんれんじょうを なんかい か まわって みろ。いい れんしゅうだ！", "kanji": "その靴は新品だな！訓練場を何周か歩いてみろ。いい練習になるぞ！"},
  {"en": "Keep those boots moving!", "to": "その くつ、うごかし つづけろ！", "kanji": "その靴、動かし続けろ！"},

  // talk/shade.jsonc
  {"en": "Didn't see me there, did you?", "to": "あれ、いたのに きづかなかった？ ふふ、わたし かくれるのは とくいなの。", "kanji": "あれ、いたのに気づかなかった？ふふ、私隠れるのは得意なの。"},
  {"en": "I'm Nix. I test the town's locks. If I can open one, so could a thief. So I tell people how to fix them.", "to": "ニックスよ。村の かぎを ためして いるの。わたしに あけられるなら、どろぼうにも あけられるでしょ。だから、なおしかたを みんなに おしえて いるの。", "kanji": "ニックスよ。村の鍵を試しているの。私に開けられるなら、泥棒にも開けられるでしょ。だから、直し方をみんなに教えているの。"},
  {"en": "Your lock is loose, by the way. Fine. For now.", "to": "それと、きみの いえの かぎが ゆるんで いるよ。まあ、いいんじゃない。いまの ところはね。", "kanji": "それと、君の家の鍵が緩んでいるよ。まあ、いいんじゃない。今のところはね。"},
  {"en": "Locks are holding. For now.", "to": "かぎは、まだ もってるよ。いまの ところはね。", "kanji": "鍵は、まだ持ってるよ。今のところはね。"},

  // talk/summoner.jsonc
  {"en": "Hello, tinker. I'm Seren. I call little helper spirits when they're needed.", "to": "こんにちは、しゅうりやさん。わたしは セレン。こまった とき、ちいさな おてつだいの せいれいを よぶの。", "kanji": "こんにちは、修理屋さん。私はセレン。困ったとき、小さなお手伝いの精霊をよぶの。"},
  {"en": "Tell them clearly what to do and when. They'll never let you down.", "to": "せいれいには、なにを するのか、いつ するのかを はっきり つたえて あげて。そうすれば、けっして がっかり させないわ。", "kanji": "精霊には、何をいつするのか、はっきり伝えてあげて。そうすれば、決して期待を裏切らないわ。"},
  {"en": "My helpers are resting. Even spirits need sleep.", "to": "いま おやすみ ちゅうなの。せいれいにも ねむりは いるのよ。", "kanji": "今はお休み中なの。精霊にも眠りは必要なのよ。"},

  // talk/warden.jsonc
  {"en": "...STAND BACK. THE ROOT GATE IS SEALED.", "to": "…さがれ！ ねっこの もんは とじられて いる！", "kanji": "…下がれ！根の門は封鎖されている！"},
  {"en": "...Apologies. My voice gets loud. I guard the way down into the roots.", "to": "…しつれいした。わたしの こえは、どうも おおきく なりがちでな。わたしは、ねっこへ おりる みちを まもって いる。", "kanji": "…失礼した。私の声は、どうも大きくなりがちでな。私は、根へ降りる道を守っている。"},
  {"en": "It opens for tinkers who are ready. You are not ready. Yet.", "to": "もんは、じゅんびの できた しゅうりやさんの ために ひらく。きみは、まだ じゅんびが できて いない。いまは まだ、な。", "kanji": "門は、準備のできた修理屋のために開く。君には、まだ準備が足りない。今のところは、な。"},
  {"en": "THE GATE IS SEALED. ...Have a pleasant day.", "to": "もんは とじられて いる！ …よい いちにちを。", "kanji": "門は封鎖されている！…では、よい一日を。"},

  // townsfolk.jsonc: names and titles
  {"en": "Marta", "to": "マルタ", "kanji": "マルタ"},
  {"en": "Keeper of the Warm Hearth", "to": "あったかだんろの まもりびと", "kanji": "温かな暖炉の守り人"},
  {"en": "Pip", "to": "ピップ", "kanji": "ピップ"},
  {"en": "Lantern counter", "to": "ランタンかぞえやさん", "kanji": "ランタンの数え係"},
  {"en": "Hollis", "to": "ホリス", "kanji": "ホリス"},
  {"en": "Gate guard", "to": "もんの みはり", "kanji": "門の見張り"},
  {"en": "Lumen", "to": "ルーメン", "kanji": "ルーメン"},
  {"en": "Keeper of the Lanterns", "to": "ランタンの まもりびと", "kanji": "ランタンの守り人"},
  {"en": "Vell", "to": "ヴェル", "kanji": "ヴェル"},
  {"en": "The Archivist", "to": "きろくがかり", "kanji": "記録係"},
