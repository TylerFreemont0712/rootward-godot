  {"en": "Artificer", "to": "アーティフィサー", "kanji": "アーティフィサー"},
  {"en": "Brannoc", "to": "ブラノック", "kanji": "ブラノック"},
  {"en": "The Smith", "to": "かじやさん", "kanji": "鍛冶屋さん"},
  {"en": "Orin", "to": "オリン", "kanji": "オリン"},
  {"en": "Elder of Lanternroot", "to": "ともしび村の ちょうろう", "kanji": "ともしび村の長老"},
  {"en": "Fern", "to": "ファーン", "kanji": "ファーン"},
  {"en": "Keeper of the Grove", "to": "もりの まもりびと", "kanji": "森の守り人"},
  {"en": "Morrow", "to": "モロウ", "kanji": "モロウ"},
  {"en": "Keeper of the Old Stones", "to": "ふるい いしの まもりびと", "kanji": "古い石の守り人"},
  {"en": "Pell", "to": "ペル", "kanji": "ペル"},
  {"en": "Mapmaker", "to": "ちずかき", "kanji": "地図職人"},
  {"en": "Nym", "to": "ニム", "kanji": "ニム"},
  {"en": "Shopkeeper", "to": "おみせやさん", "kanji": "店主"},
  {"en": "Sergeant Brisk", "to": "ブリスク ぐんそう", "kanji": "ブリスク軍曹"},
  {"en": "Drillmaster", "to": "くんれんかん", "kanji": "訓練官"},
  {"en": "Nix", "to": "ニックス", "kanji": "ニックス"},
  {"en": "Lockpicker", "to": "かぎあけや", "kanji": "鍵開け屋"},
  {"en": "Seren", "to": "セレン", "kanji": "セレン"},
  {"en": "Summoner", "to": "しょうかんし", "kanji": "召喚士"},
  {"en": "The Warden", "to": "ばんにん", "kanji": "番人"},
  {"en": "Keeper of the Root Gate", "to": "ねっこの もんの まもりびと", "kanji": "根の門の守り人"},

  // the speaker's name in dialogue_box.gd (HOTARU), which is not in townsfolk.jsonc
  {"en": "Hotaru", "to": "ほたる", "kanji": "ほたる"},

  // maps/home.jsonc
  {"en": "Your house", "to": "きみの いえ", "kanji": "君の家"},
  {"en": "Your bed. Still warm.", "to": "きみの ベッド。まだ あたたかい。", "kanji": "君のベッド。まだ暖かい。"},
  {"en": "Books about gears, lanterns, and something called Python.", "to": "ギアや ランタンの ほん。それと、Python っていう ふしぎな ものの ほん。", "kanji": "ギアやランタンの本。それと、Python っていう不思議なものの本。"},

  // maps/lanternroot.jsonc
  {"en": "Lanternroot", "to": "ともしび村", "kanji": "ともしび村"},
  {"en": "The Archive. Every change anyone has made in Lanternroot is written down inside.", "to": "きろくこ。ともしび村で だれかが かえた ことは、ぜんぶ なかに かいて あるよ。", "kanji": "記録庫。ともしび村で誰かが変えたことは、全部中に書いてあるよ。"},
  {"en": "The Village Hall. Its doors are closed for now.", "to": "むらの かいぎしょ。いまは とびらが しまって いるよ。", "kanji": "村の会議所。今は扉が閉まっているよ。"},
  {"en": "The Lantern Shrine. A warm light glows behind the door.", "to": "ランタンの ほこら。とびらの むこうで、あたたかい ひかりが ゆれて いる。", "kanji": "ランタンの祠。扉の向こうで温かな光が揺れている。"},
  {"en": "Mira's workshop. Something inside is ticking.", "to": "ミラの こうぼう。なかで なにかが カチカチ いって いる。", "kanji": "ミラの工房。中で何かがカチカチと音を立てている。"},
  {"en": "The Warm Hearth. It smells like soup.", "to": "あったかだんろ。スープの いい においが するよ。", "kanji": "温かな暖炉。スープのいい匂いがするよ。"},
  {"en": "Brannoc's forge. The air shimmers with heat.", "to": "ブラノックの かじば。あついから、くうきが ゆらゆら して いる。", "kanji": "ブラノックの鍛冶場。熱いから、空気がゆらゆらしている。"},
  {"en": "Nym's. A sign in the window says: OPENING SOON!", "to": "ニムの おみせ。まどの かんばん：「もうすぐ オープン！」", "kanji": "ニムのお店。まどの看板：「もうすぐオープン！」"},
  {"en": "The Root Gate. It is sealed, and the roots around it are humming.", "to": "ねっこの もん。とじられて いて、まわりの ねっこが ブーンと ひびいて いる。", "kanji": "根の門。封鎖された門の周囲で、根が低く響いている。"},
  {"en": "The Lantern Root. Little lanterns sway in its branches.", "to": "ランタンの木。えだに ちいさな ランタンが ゆれて いる。", "kanji": "ランタンの木。枝に小さなランタンが揺れている。"},
  {"en": "A deep old well. Your voice comes back up a moment later.", "to": "ふるくて ふかい いど。こえが、すこし おくれて かえって くるよ。", "kanji": "古くて深い井戸。声をかけると、少し遅れてこだまが返ってくる。"},
  {"en": "Each key press runs your rule. Your x or y changed, so you took a step.", "to": "キーを おすたびに ルールが うごくよ。xか yが かわったから、いっぽ あるけたんだ。", "kanji": "キーをおすたびにルールが動くよ。xか yが変わったから、一歩歩けたんだ。"},
  {"en": "Press B to add another arrow rule. Try it, then teach your boots all four directions.", "to": "Bで べつの やじるしの ルールを たそう。「はいてみる」で ためして、よっつの むきを ブーツに おしえよう。", "kanji": "B を押して別の矢印キーのルールを追加し、「試す」で確認しよう。靴が上下左右に歩けるようにしてね。"},
]
