{
  "id": "fuse",
  "name": "Fuse",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "fuse",
  "summary": "Fuses all attacks into one bolt that deals the sum of their power × multiplier. It keeps the first attack's power, aim and element; wards stay separate.",
  "art_note": "Gold filaments converge into one white-hot needle beside an untouched teal shield.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 2 },
        { "power": 8, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 3, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 4 },
        { "power": 3, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ]
    }
  ]
}
