{
  "id": "pair-fold",
  "name": "Pair Fold",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "pair_fold",
  "summary": "Merges bolts in pairs from the front when both are attacks or both are wards. The first keeps its element, target and power, and its multiplier is raised so the pair's total (power × multiplier) is kept. Anything else stays.",
  "art_note": "Two folded parchment bolts become a dense paired rune.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 3 },
        { "power": 2, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 4 },
        { "power": 2, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ]
    }
  ]
}
