{
  "id": "entrench",
  "name": "Entrench",
  "rarity": "common",
  "cost": 1,
  "complexity": "linear",
  "function": "entrench",
  "summary": "Multiplies ward multipliers by the turn number, up to ×5. Later defenses can support a bigger counterattack.",
  "art_note": "Five concentric defensive earthworks around a glowing hourglass.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ]
    },
    {
      "name": "Fourth turn strengthens only wards",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "battle": {
        "turn": 4,
        "me": { "hp": 30, "max": 30, "block": 0, "mana": 6 },
        "foes": [{ "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] }]
      },
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 4 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ]
    },
    {
      "name": "The fifth turn is the ceiling",
      "bolts": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }],
      "battle": {
        "turn": 8,
        "me": { "hp": 30, "max": 30, "block": 0, "mana": 6 },
        "foes": [{ "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] }]
      },
      "expect": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 5 }]
    }
  ]
}
