{
  "id": "reserve-tap",
  "name": "Reserve Tap",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "reserve_tap",
  "summary": "Attacks gain +1 multiplier per 4 block you already have. Reads your protection without spending it; wards are unchanged.",
  "art_note": "A tap drawing golden light from a full teal shield reservoir.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 6, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 6, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ]
    },
    {
      "name": "Twelve block adds three multiplier without spending block",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ],
      "battle": {
        "turn": 1,
        "me": { "hp": 30, "max": 30, "block": 12, "mana": 6 },
        "foes": [{ "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] }]
      },
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 4 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ]
    }
  ]
}
