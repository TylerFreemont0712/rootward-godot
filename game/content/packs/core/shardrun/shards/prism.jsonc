{
  "id": "prism",
  "name": "Prism",
  "rarity": "uncommon",
  "cost": 1,
  "function": "prism",
  "summary": "Splits every bolt into three: one fire, one frost, one spark, each at 40% power.",
  "tags": ["nested-loops", "lists"],
  "examples": [
    {
      "name": "one bolt becomes three elements",
      "bolts": [
        { "power": 10, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 4, "element": "fire", "target": "front", "pierce": false, "ward": false },
        { "power": 4, "element": "frost", "target": "front", "pierce": false, "ward": false },
        { "power": 4, "element": "spark", "target": "front", "pierce": false, "ward": false }
      ]
    }
  ]
}
