{
  "id": "alternating-current",
  "name": "Alternating Current",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "alternating_current",
  "summary": "Triples a bolt's multiplier when its element differs from the previous bolt. The first bolt is unchanged.",
  "art_note": "A zigzag arc hopping between red and blue crystals.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "fire", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "frost", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "frost", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "spark", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "fire", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "frost", "target": "front", "pierce": false, "ward": false, "mult": 3 },
        { "power": 4, "element": "frost", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "spark", "target": "front", "pierce": false, "ward": false, "mult": 3 }
      ]
    }
  ]
}
