{
  "id": "ward",
  "name": "Ward",
  "rarity": "common",
  "cost": 1,
  "function": "ward",
  "summary": "Turns the first bolt into a ward with 2 more power. Other bolts are unchanged.",
  "tags": ["lists", "slicing"],
  "forge": { "into": "ward-plus", "verb": "upgrade" },
  "examples": [
    {
      "name": "a lone bolt becomes block",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 6, "element": "none", "target": "front", "pierce": false, "ward": true }
      ]
    },
    {
      "name": "only the first bolt turns",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 5, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 6, "element": "none", "target": "front", "pierce": false, "ward": true },
        { "power": 5, "element": "none", "target": "front", "pierce": false, "ward": false }
      ]
    },
    {
      "name": "no bolts, no ward",
      "bolts": [],
      "expect": []
    }
  ]
}
