{
  "id": "singularity",
  "name": "Singularity",
  "rarity": "rare",
  "cost": 2,
  "complexity": "constant",
  "function": "singularity",
  "summary": "Replaces the volley with one piercing attack aimed at the foe with most HP: power is 4 × the bolt count, and its multiplier equals that count. It costs almost no work.",
  "tags": ["len", "lists"],
  "examples": [
    {
      "name": "nothing collapses into nothing",
      "bolts": [],
      "expect": []
    },
    {
      "name": "four bolts become one that pierces",
      "bolts": [
        { "power": 2, "element": "fire", "target": "front", "pierce": false, "ward": false },
        { "power": 9, "element": "frost", "target": "back", "pierce": false, "ward": false },
        { "power": 1, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 1, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 16, "element": "none", "target": "strongest", "pierce": true, "ward": false, "mult": 4 }
      ]
    }
  ]
}
