        { "power": 4, "element": "frost", "target": "front", "pierce": false, "ward": false, "mult": 2 },
        { "power": 4, "element": "spark", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "fire", "target": "front", "pierce": false, "ward": false, "mult": 8 },
