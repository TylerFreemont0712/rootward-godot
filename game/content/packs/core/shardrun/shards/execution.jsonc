{
  "id": "execution",
  "name": "Execution",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "execution",
  "summary": "If any living foe is at half HP or below, triples attack multipliers and aims them at the weakest foe. Wards stay unchanged.",
  "art_note": "A narrow silver blade falling toward a half-empty violet health rune.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }],
      "expect": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }]
    },
    {
      "name": "A wounded foe triggers attacks but not wards",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ],
      "battle": {
        "turn": 1,
        "me": { "hp": 30, "max": 30, "block": 0, "mana": 6 },
        "foes": [
          { "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] },
          { "name": "Training Dummy", "hp": 10, "max": 20, "shield": 0, "weak": [], "resist": [] }
        ]
      },
      "expect": [
        { "power": 4, "element": "none", "target": "weakest", "pierce": false, "ward": false, "mult": 3 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ]
    }
  ]
}
