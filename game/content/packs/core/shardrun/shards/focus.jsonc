{
  "id": "focus",
  "name": "Focus Lens",
  "rarity": "uncommon",
  "cost": 1,
  "function": "focus",
  "summary": "Combines all bolt power into one bolt. It keeps the first bolt's multiplier, element, aim, pierce, and attack or ward role.",
  "tags": ["accumulator", "lists"],
  "examples": [
    {
      "name": "two bolts become one",
      "bolts": [
        { "power": 3, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 5, "element": "fire", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 8, "element": "none", "target": "front", "pierce": false, "ward": false }
      ]
    },
    {
      "name": "nothing to focus",
      "bolts": [],
      "expect": []
    }
  ]
}
