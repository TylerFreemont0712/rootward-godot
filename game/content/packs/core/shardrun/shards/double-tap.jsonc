{
  "id": "double-tap",
  "name": "Double Tap",
  "rarity": "common",
  "cost": 1,
  "function": "double_tap",
  "summary": "Fires the first bolt twice: a full-power copy goes in front of it.",
  "tags": ["lists", "copying"],
  "examples": [
    {
      "name": "the first bolt is copied",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 2, "element": "fire", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 2, "element": "fire", "target": "front", "pierce": false, "ward": false }
      ]
    },
    {
      "name": "nothing to copy",
      "bolts": [],
      "expect": []
    }
  ]
}
