{
  "id": "prefix-charge",
  "name": "Prefix Charge",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "prefix_charge",
  "summary": "Each bolt receives the sum of all multipliers up to its position. Ordering decides who inherits the charge.",
  "art_note": "A row of amber capacitors linked by an increasingly bright thread.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 2 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 3 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 2 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 5 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 6 }
      ]
    }
  ]
}
