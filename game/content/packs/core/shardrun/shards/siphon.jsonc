{
  "id": "siphon",
  "name": "Siphon",
  "rarity": "rare",
  "cost": 2,
  "function": "siphon",
  "summary": "Turns the weakest bolt into a ward at double power. The rest still fly.",
  "tags": ["enumerate", "min-max"],
  "examples": [
    {
      "name": "the weakest becomes a ward",
      "bolts": [
        { "power": 9, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 4, "element": "fire", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 9, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 8, "element": "fire", "target": "front", "pierce": false, "ward": true }
      ]
    }
  ]
}
