{
  "id": "last-stand",
  "name": "Last Stand",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "last_stand",
  "summary": "Quadruples multipliers at half Integrity or lower. Above half, changes nothing.",
  "art_note": "A battered amber banner still glowing above a cracked red heart.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }],
      "expect": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }]
    },
    {
      "name": "Half integrity includes the boundary",
      "bolts": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 2 }],
      "battle": {
        "turn": 1,
        "me": { "hp": 15, "max": 30, "block": 0, "mana": 6 },
        "foes": [{ "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] }]
      },
      "expect": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 8 }]
    },
    {
      "name": "Above half integrity stays unchanged",
      "bolts": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }],
      "battle": {
        "turn": 1,
        "me": { "hp": 16, "max": 30, "block": 0, "mana": 6 },
        "foes": [{ "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] }]
      },
      "expect": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }]
    }
  ]
}
