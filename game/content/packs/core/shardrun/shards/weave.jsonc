{
  "id": "weave",
  "name": "Weave",
  "rarity": "common",
  "cost": 0,
  "complexity": "linear",
  "function": "weave",
  "summary": "Turns the 1st, 3rd, and later odd-numbered bolts into wards with doubled multipliers. Even-numbered bolts become attacks with their original multipliers.",
  "art_note": "Teal shield threads and amber arrow threads woven into one ribbon.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 2 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 2 }
      ]
    }
  ]
}
