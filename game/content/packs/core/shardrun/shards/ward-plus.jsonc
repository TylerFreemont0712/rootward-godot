{
  "id": "ward-plus",
  "name": "Ward+",
  "rarity": "common",
  "cost": 1,
  "function": "ward_plus",
  "summary": "Turns the first bolt into block, 5 stronger. Other bolts still fly.",
  "tags": ["lists", "slicing"],
  "draftable": false,
  "examples": [
    {
      "name": "a lone bolt becomes block",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 9, "element": "none", "target": "front", "pierce": false, "ward": true }
      ]
    },
    {
      "name": "only the first bolt turns",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 5, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 9, "element": "none", "target": "front", "pierce": false, "ward": true },
        { "power": 5, "element": "none", "target": "front", "pierce": false, "ward": false }
      ]
    },
    {
      "name": "no bolts, no ward",
      "bolts": [],
      "expect": []
    }
  ]
}
