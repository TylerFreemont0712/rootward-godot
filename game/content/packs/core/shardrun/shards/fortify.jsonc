  "cost": 1,
  "complexity": "linear",
  "function": "fortify",
  "summary": "Multiplies ward multipliers by 1 plus the number of attacks in this volley. Attacks are kept unchanged.",
  "art_note": "Two amber arrows powering a thick hexagonal teal barrier.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 2, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 2, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 3 }
      ]
    }
  ]
}
