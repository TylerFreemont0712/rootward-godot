{
  "id": "census",
  "name": "Census",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linearithmic",
  "function": "census",
  "summary": "Sorts bolts by power, weakest first, then adds rank as power: +0 to the weakest, +1 to the next, and so on. Sorting costs more than a linear pass.",
  "tags": ["sorting", "enumerate"],
  "examples": [
    {
      "name": "the only bolt is first in line, and first gains nothing",
      "bolts": [
        { "power": 6, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 6, "element": "none", "target": "front", "pierce": false, "ward": false }
      ]
    },
    {
      "name": "weakest first, and the line pays by place",
      "bolts": [
        { "power": 5, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 1, "element": "frost", "target": "back", "pierce": false, "ward": false },
        { "power": 3, "element": "none", "target": "front", "pierce": false, "ward": false }
      ],
      "expect": [
        { "power": 1, "element": "frost", "target": "back", "pierce": false, "ward": false },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false },
        { "power": 7, "element": "none", "target": "front", "pierce": false, "ward": false }
      ]
    }
  ]
}
