{
  "id": "resonant-run",
  "name": "Resonant Run",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "resonant_run",
  "summary": "Consecutive bolts of the same element multiply their multipliers by ×1, ×2, ×3… A changed element restarts the streak.",
  "art_note": "Matching runes forming an increasingly bright chain, broken by a contrasting rune.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "fire", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ],
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 2 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 3 },
        { "power": 4, "element": "fire", "target": "front", "pierce": false, "ward": false, "mult": 1 }
      ]
    }
  ]
}
