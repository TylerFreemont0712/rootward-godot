{
  "id": "crowd-surge",
  "name": "Crowd Surge",
  "rarity": "uncommon",
  "cost": 1,
  "complexity": "linear",
  "function": "crowd_surge",
  "summary": "Multiplies attack multipliers by the number of living foes (at least ×1). Combines with scatter; wards are unchanged.",
  "art_note": "Several enemy silhouettes feeding sparks into one branching bolt.",
  "tags": ["lists", "dictionaries"],
  "examples": [
    {
      "name": "An empty volley stays empty",
      "bolts": [],
      "expect": []
    },
    {
      "name": "The transformation is visible in the output",
      "bolts": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }],
      "expect": [{ "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 }]
    },
    {
      "name": "Three foes triple attacks, never wards",
      "bolts": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 1 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ],
      "battle": {
        "turn": 1,
        "me": { "hp": 30, "max": 30, "block": 0, "mana": 6 },
        "foes": [
          { "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] },
          { "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] },
          { "name": "Training Dummy", "hp": 20, "max": 20, "shield": 0, "weak": [], "resist": [] }
        ]
      },
      "expect": [
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": false, "mult": 3 },
        { "power": 4, "element": "none", "target": "front", "pierce": false, "ward": true, "mult": 1 }
      ]
    }
  ]
}
