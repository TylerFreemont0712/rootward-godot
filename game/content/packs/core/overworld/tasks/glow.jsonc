// Hotaru's glow (Concept/v0.4/05, 2.2): Hotaru's light follows your glow(t), one brightness a second. One stage.
// The giver is Lumen (oracle), the keeper of the lanterns, since a giver must be a townsperson. Hotaru does the asking.
{
  "id": "glow",                         // the file's name, and the part's id (Parts.IDS)
  "name": "Hotaru's Glow",              // the part's name: Workbench card, banner
  "title": "Hotaru's glow",             // the editor's heading
  "giver": "oracle",                    // a townsfolk id: their portrait in the editor and on the Workbench card
  "built_line": "Hotaru shines in the pattern your glow() makes.",
  "entry": {"python": "glow", "javascript": "glow"},
  "params": [
    {"name": "t", "meaning": "The second of the minute, from 0 to 59. It goes up by one each second.", "example": "7"}
  ],
  "gives": {"meaning": "Hotaru's brightness: 0.0 is dark and 1.0 is bright.", "example": "0.5"},
  "words": {
    "python": [
      {"term": "%", "meaning": "Gives what is left over after sharing a number out. 11 % 5 is 1: 5 fits into 11 twice, and 1 is left.", "example": "cookies = 11 % 5"},
      {"term": "*", "meaning": "Multiplies two numbers.", "example": "pencils = 3 * 4"},
      {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\""}
    ],
    "javascript": [
      {"term": "%", "meaning": "Gives what is left over after sharing a number out. 11 % 5 is 1: 5 fits into 11 twice, and 1 is left.", "example": "const cookies = 11 % 5;"},
      {"term": "*", "meaning": "Multiplies two numbers.", "example": "const pencils = 3 * 4;"},
      {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\";"}
    ]
  },
  "starter": {"python": "glow.starter.py", "javascript": "glow.starter.js"},
  "blocks": {
    "lines": {
      "python": [
        "def glow(t):",
        "    return t {op} {amount}"
      ],
      "javascript": [
        "function glow(t) {",
        "  return t {op} {amount};",
        "}"
      ]
    },
    "slots": {
      "op": {"label": "do what", "choices": ["*", "+", "%"]},
      "amount": {"label": "by", "choices": ["10", "4", "2"]}
