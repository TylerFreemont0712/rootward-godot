        {"args": [[{"item": "apple", "count": 2}], "cabbage"], "want": [{"item": "apple", "count": 2}, {"item": "cabbage", "count": 1}], "say": "two apples in the bag, and a cabbage"},
        {"args": [[{"item": "apple", "count": 1}, {"item": "cabbage", "count": 2}, {"item": "carrot", "count": 1}], "cabbage"], "want": [{"item": "apple", "count": 1}, {"item": "cabbage", "count": 3}, {"item": "carrot", "count": 1}], "say": "three stacks, and the cabbage in the middle"}
      ],
      "hints": [
