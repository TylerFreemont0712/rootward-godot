// The bag (Concept/v0.4/01, 5.6): Nym's bag holds stacks, {"item", "count"}. Stage 1 is add(bag, item), which puts one more
// of an item in the bag: in its stack when it has one, else in a new stack. Stage 2 is remove(bag, item), which takes one
// away, and a stack that reaches 0 goes. The game runs add when you pick something up and remove when you give it.
{
  "id": "bag",
  "name": "The Bag",
  "title": "A bag of your own",
  "giver": "quartermaster",
  "built_line": "Things you pick up go in your bag with your add().",
  "entry": {"python": "add", "javascript": "add"},
  "params": [
    {"name": "bag", "meaning": "Your bag: a list of stacks. Each stack is a dictionary with \"item\" (what it holds) and \"count\" (how many), such as {\"item\": \"pear\", \"count\": 1}.", "example": "[{\"item\": \"pear\", \"count\": 2}]"},
    {"name": "item", "meaning": "The name of what was picked up, such as \"apple\".", "example": "\"pear\""}
  ],
  "gives": {"meaning": "The bag, with one more of the item in it. A stack of that item grows by one; if there is none, a new stack of one is added.", "example": "[{\"item\": \"pear\", \"count\": 3}]"},
  "words": {
    "python": [
      {"term": "for", "meaning": "Does its indented lines once for each thing in a list, in order.", "example": "for score in scores:\n    total += score"},
      {"term": "if", "meaning": "Runs the lines under it only when its question is True.", "example": "if weather == \"rain\":\n    return \"umbrella\""},
      {"term": "==", "meaning": "Asks whether two things are the same. The answer is True or False.", "example": "pet == \"cat\""},
      {"term": "+=", "meaning": "Adds to the number a name holds, and keeps the new number there.", "example": "score += 10"},
      {"term": "-=", "meaning": "Takes from the number a name holds, and keeps the new number there.", "example": "lives -= 1"},
      {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\""},
      {"term": ".append", "meaning": "Adds one thing to the end of a list.", "example": "basket.append(\"pear\")"},
      {"term": ".remove", "meaning": "Takes the first thing that matches out of a list.", "example": "basket.remove(\"pear\")"}
    ],
    "javascript": [
      {"term": "for", "meaning": "Does its indented lines once for each thing in an array, in order.", "example": "for (const score of scores) {\n  total += score;\n}"},
      {"term": "if", "meaning": "Runs the lines in its braces only when its question is true.", "example": "if (weather === \"rain\") {\n  return \"umbrella\";\n}"},
      {"term": "===", "meaning": "Asks whether two things are the same. The answer is true or false.", "example": "pet === \"cat\""},
      {"term": "+=", "meaning": "Adds to the number a name holds, and keeps the new number there.", "example": "score += 10;"},
      {"term": "-=", "meaning": "Takes from the number a name holds, and keeps the new number there.", "example": "lives -= 1;"},
      {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\";"},
      {"term": ".push", "meaning": "Adds one thing to the end of an array.", "example": "basket.push(\"pear\");"},
      {"term": ".indexOf", "meaning": "Gives the place of a thing in an array, or -1 when it is not there.", "example": "basket.indexOf(\"pear\")"},
      {"term": ".splice", "meaning": "Takes things out of an array, starting at a place: splice(place, how many).", "example": "basket.splice(2, 1);"}
    ]
  },
  "starter": {"python": "bag.starter.py", "javascript": "bag.starter.js"},
  "blocks": {
    "lines": {
      "python": [
        "def add(bag, item):",
        "[look]    for stack in bag:",
        "[look]        if stack[\"item\"] == item:",
        "[look]            stack[\"count\"] {add_op} 1",
        "[look]            {add_stop}",
        "[new]    bag.append({\"item\": item, \"count\": 1})",
        "    return bag",
        "",
        "[take]def remove(bag, item):",
        "[take]    for stack in bag:",
        "[take]        if stack[\"item\"] == item:",
        "[take]            stack[\"count\"] {take_op} 1",
        "[empty]            if stack[\"count\"] == 0:",
        "[empty]                bag.remove(stack)",
        "[take]            return bag",
        "[take]    return bag"
      ],
      "javascript": [
        "function add(bag, item) {",
        "[look]  for (const stack of bag) {",
        "[look]    if (stack.item === item) {",
        "[look]      stack.count {add_op} 1;",
        "[look]      {add_stop}",
        "[look]    }",
        "[look]  }",
        "[new]  bag.push({ item: item, count: 1 });",
        "  return bag;",
        "}",
        "",
        "[take]function remove(bag, item) {",
        "[take]  for (const stack of bag) {",
        "[take]    if (stack.item === item) {",
        "[take]      stack.count {take_op} 1;",
        "[empty]      if (stack.count === 0) {",
        "[empty]        bag.splice(bag.indexOf(stack), 1);",
        "[empty]      }",
        "[take]      return bag;",
        "[take]    }",
        "[take]  }",
        "[take]  return bag;",
        "[take]}"
      ]
    },
    "slots": {
