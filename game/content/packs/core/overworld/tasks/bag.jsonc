      "new": {"label": "Otherwise, a new stack"},
      "take": {"label": "Find the item and take one away", "stage": 1},
      "empty": {"label": "Take an empty stack out", "stage": 1}
    },
    "start": {"slots": {"add_op": 0, "add_stop": 0, "take_op": 0}, "toggles": []}
