      "add_stop": {
        "label": "then",
        "choices": [
          {"label": "keep looking", "python": "pass", "javascript": "// keep looking"},
          {"label": "stop here", "python": "return bag", "javascript": "return bag;"}
        ]
      },
      "take_op": {"label": "the count", "choices": ["+=", "-="], "stage": 1}
    },
    "toggles": {
