        ],
        "javascript": [
          {"term": "The old stone", "meaning": "An old piece of code. Read it from the top, one line at a time, and keep track of what each name holds.", "example": "let total = 0;\nfor (const n of [1, 2, 3]) {\n  total += n;\n}"}
