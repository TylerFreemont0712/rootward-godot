        "python": [
          {"term": "The old stone", "meaning": "An old piece of code. Read it from the top, one line at a time, and keep track of what each name holds.", "example": "word = \"lantern\"\nanswer = \"short\"\nif len(word) > 4:\n    answer = \"long\""}
        ],
        "javascript": [
          {"term": "The old stone", "meaning": "An old piece of code. Read it from the top, one line at a time, and keep track of what each name holds.", "example": "let word = \"lantern\";\nlet answer = \"short\";\nif (word.length > 4) {\n  answer = \"long\";\n}"}
