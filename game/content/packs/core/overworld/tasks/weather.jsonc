// Fern's weather (Concept/v0.4/05, 2.7): the player's weather(day) says what each day of the town's year is like. One
// stage: every day gives sun, rain or cloud, and every 7 days in a row hold a rain day and a sun day. The game asks it
// for days 0 to 27 and repeats them (a table); a rain day makes rain fall over the town.
{
  "id": "weather",
  "name": "The Weather",
  "title": "Fern's weather",
  "giver": "keeper",
  "built_line": "Rain falls in town on the days your weather() says.",
  "entry": {"python": "weather", "javascript": "weather"},
  "params": [
    {"name": "day", "meaning": "The town's day number, from 0. The days go on and on.", "example": "3"}
  ],
  "gives": {"meaning": "The weather that day: \"sun\", \"rain\" or \"cloud\".", "example": "\"cloud\""},
  "words": {
    "python": [
      {"term": "%", "meaning": "Gives the rest left over after dividing one whole number by another.", "example": "9 % 4"},
      {"term": "==", "meaning": "Asks whether two things are the same. The answer is True or False.", "example": "fruit == \"pear\""},
      {"term": "if", "meaning": "Runs the lines under it only when its question is True.", "example": "if score == 10:\n    return \"ten\""},
      {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\""}
    ],
    "javascript": [
      {"term": "%", "meaning": "Gives the rest left over after dividing one whole number by another.", "example": "9 % 4"},
      {"term": "===", "meaning": "Asks whether two things are the same. The answer is true or false.", "example": "fruit === \"pear\""},
      {"term": "if", "meaning": "Runs the lines in its braces only when its question is true.", "example": "if (score === 10) {\n  return \"ten\";\n}"},
      {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\";"}
    ]
  },
  "starter": {"python": "weather.starter.py", "javascript": "weather.starter.js"},
  "blocks": {
    "lines": {
      "python": [
        "def weather(day):",
        "    if day % {every} == 0:",
        "        return \"rain\"",
        "[cloud]    if day % {every} == {cloud_day}:",
        "[cloud]        return \"cloud\"",
        "    return \"sun\""
      ],
      "javascript": [
        "function weather(day) {",
        "  if (day % {every} === 0) {",
        "    return \"rain\";",
        "  }",
        "[cloud]  if (day % {every} === {cloud_day}) {",
        "[cloud]    return \"cloud\";",
        "[cloud]  }",
        "  return \"sun\";",
        "}"
      ]
    },
    "slots": {
      "every": {"label": "rain every", "choices": ["10", "4", "7"]},
      "cloud_day": {"label": "cloud on", "choices": ["3", "2", "1"]}
    },
    "toggles": {
      "cloud": {"label": "Some days are cloud too"}
    },
    "start": {"slots": {"every": 0, "cloud_day": 0}, "toggles": []}
