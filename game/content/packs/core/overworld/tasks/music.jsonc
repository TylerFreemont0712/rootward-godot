// The music box (Concept/v0.4/01, 5.5): Marta's titles(tracks) lists the songs by their names, and next_track(index, count)
// goes on to the next song, round to the first after the last. Stage 1 is the list (flag music-listed); stage 2 the next
// song (music-next), which opens once the list is written. The game asks titles() when the box opens, so the list
// follows tracks.jsonc.
{
  "id": "music",
  "name": "The Music Box",
  "title": "The music box",
  "giver": "innkeeper",
  "built_line": "The music box plays the titles your titles() lists.",
  "entry": {"python": "titles", "javascript": "titles"},
  "params": [
    {"name": "tracks", "meaning": "A list of songs. Each song is a dictionary with \"id\", \"title\" and \"place\" in it.", "example": "[{\"id\": \"owls\", \"title\": \"Owl Lullaby\", \"place\": \"the library\"}]"}
  ],
  "gives": {"meaning": "The titles, as text, in the same order as the songs.", "example": "[\"Owl Lullaby\"]"},
  "words": {
    "python": [
      {"term": "for", "meaning": "Goes through a list one item at a time, giving each item a name while the lines under it run.", "example": "for fruit in basket:\n    print(fruit)"},
      {"term": "[]", "meaning": "An empty list, with nothing in it yet.", "example": "baskets = []"},
      {"term": ".append", "meaning": "Adds one item to the end of a list.", "example": "pets.append(\"cat\")"},
      {"term": "[\"key\"]", "meaning": "Takes one named part out of a dictionary.", "example": "pet[\"name\"]"}
    ],
    "javascript": [
      {"term": "for", "meaning": "Goes through a list one item at a time, giving each item a name while the lines in its braces run.", "example": "for (const fruit of basket) {\n  eat(fruit);\n}"},
      {"term": "[]", "meaning": "An empty list, with nothing in it yet.", "example": "const baskets = [];"},
      {"term": ".push", "meaning": "Adds one item to the end of a list.", "example": "pets.push(\"cat\");"},
      {"term": "[\"key\"]", "meaning": "Takes one named part out of an object.", "example": "pet[\"name\"]"}
    ]
  },
  "starter": {"python": "music.starter.py", "javascript": "music.starter.js"},
  "blocks": {
    "lines": {
      "python": [
        "def titles(tracks):",
        "    names = []",
        "[list]    for track in tracks:",
        "[list]        names.append(track[{field}])",
        "    return names",
        "",
        "[next]def next_track(index, count):",
        "[next]    return (index {op} 1) {wrap}"
      ],
      "javascript": [
        "function titles(tracks) {",
        "  const names = [];",
        "[list]  for (const track of tracks) {",
        "[list]    names.push(track[{field}]);",
        "[list]  }",
        "  return names;",
        "}",
        "",
        "[next]function nextTrack(index, count) {",
        "[next]  return (index {op} 1) {wrap};",
        "[next]}"
      ]
    },
    "slots": {
      "field": {"label": "the part of each track", "choices": ["\"id\"", "\"title\"", "\"place\""]},
      "op": {"label": "do what to the number", "choices": ["-", "+", "*"], "stage": 1},
      "wrap": {"label": "then", "choices": [{"label": "nothing", "python": "", "javascript": ""}, "% count", "- count"], "stage": 1}
    },
    "toggles": {
      "list": {"label": "Go through every track", "stage": 0},
      "next": {"label": "Go on to the next track", "stage": 1}
    },
    "start": {"slots": {}, "toggles": []}
  },
  "stages": [
    {
      "flag": "music-listed",
      "goal": "Make titles() give back the title of every track, in order.",
      "judge": "equals",
      "cases": [
        {
          "args": [[{"id": "bell", "title": "Morning Bell", "place": "the town"}, {"id": "waltz", "title": "Lantern Waltz", "place": "home"}, {"id": "dew", "title": "Dew on the Roof", "place": "the code editors"}]],
          "want": ["Morning Bell", "Lantern Waltz", "Dew on the Roof"],
          "say": "three tracks"
        },
        {
          "args": [[{"id": "bell", "title": "Morning Bell", "place": "the town"}]],
          "want": ["Morning Bell"],
          "say": "one track"
        },
        {
          "args": [[]],
          "want": [],
          "say": "no tracks at all (an empty list)",
          "edge": true
        }
      ],
      "hints": [
        "Each track is a dictionary with three named parts. Which part holds the name you want to write down?",
        "Start with an empty list of names. Then visit each track in the list, one after another, the way a loop goes through every item.",
        "The tool that adds one item to the end of a list is called append. Give the list back after the loop, not inside it."
      ]
    },
    {
      "flag": "music-next",
      "goal": "Make next_track(index, count) give the number of the track after this one, going back to 0 after the last.",
      "unlocked_by": {"flag": "music-listed"},
      "entry": {"python": "next_track", "javascript": "nextTrack"},
      "params": [
        {"name": "index", "meaning": "The number of the track playing: 0 is the first track, and count minus 1 is the last.", "example": "2"},
        {"name": "count", "meaning": "How many tracks there are.", "example": "5"}
      ],
      "gives": {"meaning": "The number of the next track: a whole number from 0 up to count minus 1.", "example": "3"},
      "words": {
        "python": [
          {"term": "+", "meaning": "Adds two numbers together.", "example": "scores = 3 + 1"},
          {"term": "%", "meaning": "Gives what is left over after dividing one number by another.", "example": "left = 7 % 3  # 1 is left over"},
          {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\""}
        ],
        "javascript": [
          {"term": "+", "meaning": "Adds two numbers together.", "example": "const scores = 3 + 1;"},
          {"term": "%", "meaning": "Gives what is left over after dividing one number by another.", "example": "const left = 7 % 3; // 1 is left over"},
          {"term": "return", "meaning": "Gives an answer back and stops the function there.", "example": "return \"hello\";"}
        ]
      },
      "judge": "next_track",
      "cases": [
        {"args": [0, 3], "want": 1, "say": "track 0 of 3 playing"},
        {"args": [1, 3], "want": 2, "say": "track 1 of 3 playing"},
        {"args": [2, 3], "want": 0, "say": "track 2 of 3 playing, the last one", "edge": true},
        {"args": [0, 1], "want": 0, "say": "the only track playing", "edge": true},
        {"args": [4, 5], "want": 0, "say": "track 4 of 5 playing, the last one", "edge": true}
      ],
      "hints": [
        "Your function is given the number of the track playing, and how many tracks there are. What number comes after the track you are on?",
        "After the last track there is no next number, so the count has to wrap around to 0. Think about what happens to a number that goes past count minus 1.",
        "The % sign, in both languages, gives the remainder: what is left over after a division. Which number should the next one be divided by, so the answer stays below count?"
      ]
    }
  ],
  "advice": {
    "nothing": "For {say}, titles() gave nothing back. It should give back a list of titles, one for each track.",
    "wrong-type": "For {say}, titles() gave {got}. It should give back a list of titles.",
    "wrong-length": "For {say}, your list {got} has the wrong number of titles. Look at how many tracks go into the loop.",
    "wrong-item": "For {say}, titles() gave {got} where {want} belongs. Look at which part of each track you take.",
    "wrong": "For {say}, next_track gave {got}, but the next track is {want}. Track numbers start at 0.",
    "not-whole": "next_track should give back a whole number, the number of the next track, such as 2. {got} is not one.",
    "no-wrap": "After the last track, {got} is too far. The last track should go round to the first."
  }
}
