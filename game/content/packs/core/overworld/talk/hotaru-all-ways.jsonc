  "nodes": {
    "free": {
      "lines": [
        {
          "text": "Up, down, left and right! Your boots can take you anywhere now.",
          "speaker": "hotaru",
          "mood": "happy"
        },
        {
          "text": "Did you notice? Going up made y smaller.",
          "speaker": "hotaru"
        },
        {
          "text": "y counts down the page, like lines in a book.",
          "speaker": "hotaru"
        },
        {
          "text": "The door's at the bottom of the room. Let's go meet everyone!",
          "speaker": "hotaru"
        }
      ]
    }
  }
}
