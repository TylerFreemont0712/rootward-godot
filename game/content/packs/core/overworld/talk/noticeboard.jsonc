// The noticeboard in the square (ADR-0061): a four-line sign with no choices. Reading it sets read-notices, which the
// archivist's offer and the hello quest's last step need.
{
  "id": "noticeboard",
  "start": [{"goto": "notices"}],
  "nodes": {
    "notices": {
      "lines": [
        {"text": "LANTERNROOT NOTICES."},
        {"text": "Lost: one spare lantern. Found: it was on the bench all along."},
        {"text": "Lost: one firefly. Found: the same firefly. (Lumen)"},
        {"text": "The Lantern Festival is coming. Bring something that glows."}
      ],
      "set": ["read-notices"]
    }
  }
}
