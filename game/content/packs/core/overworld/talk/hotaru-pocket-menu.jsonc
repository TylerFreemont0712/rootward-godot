      "lines": [
        {
          "text": "This is my pocket menu! I keep it for emergencies.",
          "speaker": "hotaru",
          "mood": "happy"
        },
        {
          "text": "It only holds the basics: your boots, Save, Settings and the ways out. My pocket is small!",
          "speaker": "hotaru"
        },
        {
          "text": "Mira at the workshop could build you a real one. She loves a neat machine.",
          "speaker": "hotaru"
        }
