class_name EffectSchemas
extends RefCounted
## What a relic does for a run, or an import for a fight: the effect kinds ProgramRelics understands.


## What a relic does for a run, or an import for a fight (ProgramRelics).
static func effect() -> Dictionary:
	var positive := ShardrunSchemas.POSITIVE
	var factor := {"type": "number", "positive": true, "max": 10.0}
	return (
		Schema
		. union(
			{
				"kill-initiative-mana": {"amount": positive, "max": positive},
				"small-program-work": {"max_cards": positive, "factor": factor},
				"fight-import": {"module": Schema.TEXT},
				"full-spread-power": {"add": positive},
				"work-power": {"every": positive, "add": positive},
				"source-power": {"paradigm": Schema.ID, "add": positive},
				"max-bolts": {"count": positive},
				"prune-not-timeout": {},
				"timeout-integrity": {"amount": positive},
				"table": {"from": Schema.with_default(positive, 3), "divisor": Schema.with_default(positive, 4)},
				"table-from": {"turn": positive},
				"table-divisor": {"divisor": positive},
				"exact-kill-table": {"factor": factor, "block": positive},
				"index": {"size": Schema.with_default(positive, 8), "seed": Schema.with_default(positive, 1)},
				"index-size": {"size": positive},
				"index-seed": {"count": positive},
				"shop-discount": {"fraction": Schema.RATIO},
				"shop-stock": {"cards": Schema.int_min(0), "relics": Schema.int_min(0)},
				"kill-cycles": {"amount": positive},
				"pickup-cycles": {"amount": positive},
				"registry-toll": {"amount": positive},
				"free-refactor": {},
				"sale-free": {},
				"lockfile": {},
				"interest": {"fraction": Schema.RATIO, "max": positive},
				"deck-mana": {"min_cards": positive, "amount": positive},
				"deck-draw": {"max_cards": positive, "amount": positive},
				"snapshot": {},
				"waive-stakes": {},
				"reward-share-shift": {"to_other": Schema.RATIO},
				"reward-focus": {"weight": {"type": "number", "min": 1.0}},
				"table-monotone": {},
				"index-seed-power": {"add": positive},
				"timeout-refund": {},
				"first-role-free": {"role": Schema.one_of(ProgramSchemas.ROLES)},
				"split-next-work": {"factor": {"type": "number", "positive": true, "max": 1.0}},
				"volley-bonus": {"min_bolts": positive, "factor": {"type": "number", "positive": true, "max": 10.0}},
				"first-program-discount": {"amount": positive},
				"rest-purge": {},
				"belt-extra": {"amount": positive},
				"script-refund": {},
				"script-discount": {"fraction": Schema.RATIO},
				"debt-mana": {"every": positive, "amount": positive},
				"weak-flat-bonus": {"add": positive},
				"sorted-strike-power": {"add": positive},
				"recurse-depth": {"depth": Schema.int_range(1, 4)},
				"rejoin-power": {"add": positive},
				"pivot-mark": {"factor": factor},
				"table-best-seed": {"divisor": positive},
				"index-open": {},
				"index-size-add": {"size": positive},
				"index-keep": {"count": positive},
				"turn-block": {"amount": positive},
				"heal-after-fight": {"amount": positive},
				"max-integrity": {"add": positive},
				"cast-block": {"amount": positive},
				"weak-bonus": {"add": factor},
				"retain-block": {"fraction": Schema.RATIO},
				"spell-capacity": {"add": positive},
				"mana-per-turn": {"add": Schema.INT},
				"damage-multiplier": {"factor": factor},
				"cast-burn": {"amount": positive},
				"turn-burn": {"amount": positive},
				"hold": {"add": positive},
				"opening-draw": {"add": positive},
				"hand-size": {"add": positive},
				"bolt-power": {"add": Schema.NUMBER},
				"seed-bolts": {"count": positive, "power": positive},
				"seed-power": {"add": positive},
				"first-turn-mana": {"add": positive},
				"element-power": {"add": positive},
				"free-first-work": {},
				"work-factor": {"factor": factor},
				"role-complexity":
				{"role": Schema.one_of(ProgramSchemas.ROLES), "complexity": Schema.one_of(ProgramSchemas.COMPLEXITIES)},
				"role-cost": {"role": Schema.one_of(ProgramSchemas.ROLES), "cost": Schema.int_range(0, 9)},
				"duplicate-free": {},
				"cron": {"every": Schema.int_range(2, 9)},
				"tempo": {"add": Schema.INT},
				"budget": {"add": Schema.INT},
				"budget-factor": {"factor": factor},
				"sorted-landing": {"add": positive},
				"mono-element": {"factor": factor},
				"wasted-to-block": {"fraction": Schema.RATIO},
				"overkill-flows": {},
				"small-program": {"max_cards": positive, "factor": factor},
				"full-program": {"factor": factor},
				"fast-program": {"complexity": Schema.one_of(ProgramSchemas.COMPLEXITIES), "factor": factor},
				"jit": {},
				"initiative": {"factor": factor},
				"kill-mana": {"amount": positive, "max": positive},
				"kill-heal": {"amount": positive},
				"block-per-card": {"amount": positive},
				"strongest-mult": {"factor": factor},
				"echo": {},
				"all-elements": {},
				# ADR-0018: these cards cost `add` more (less, when negative); an import's function run before or after
				# every card of a role; a fight global that keeps the damage every program landed.
				"card-cost": {"cards": Schema.list_of(Schema.ID, null, 1), "add": Schema.INT},
				"hook-before": {"role": Schema.one_of(ProgramSchemas.ROLES)},
				"hook-after": {"role": Schema.one_of(ProgramSchemas.ROLES)},
				"global": {"name": Schema.TEXT},
			}
		)
	)
