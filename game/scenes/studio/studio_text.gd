static func t(key: String) -> String:
	return Text.t(String(STRINGS.get(key, key)))


## A localized Studio format, translated before values are inserted (Japanese may number slots to change their order).
static func f(key: String, args: Array) -> String:
	return Text.f(String(STRINGS.get(key, key)), args)
