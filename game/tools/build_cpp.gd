extends SceneTree
## Writes the C++ sources scripts/build-cpp.sh compiles (ADR-0046): for each module (program cards, Spellforge's
## shards), one translation unit a card and one a mutant the Mutator can make of it, and the registry that finds them
## by id. Also each module's stamp, a hash of everything it is built from, so the game can tell a stale build.
##
##   godot --headless --path game -s res://tools/build_cpp.gd -- <out dir>

const MODULES := {"program": "program.hpp", "spellforge": "spellforge.hpp"}
const RUNTIME := "res://sandbox/cpp"


func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty():
		push_error("usage: build_cpp.gd -- <out dir>")
		quit(1)
		return
	var out := args[0]
	var loaded := ContentLoader.load_shardrun()
	if not loaded.ok:
		push_error("content does not load")
		quit(1)
		return
	var catalog: Dictionary = loaded.catalog
	var programs: Dictionary = (catalog.get("programs", {}) as Dictionary).get("cards", {})
	var sets := {
		"program": ShardrunCatalog.sorted_values(programs),
		"spellforge": ShardrunCatalog.sorted_values(catalog.shards),
	}
	# ROOTWARD_CPP_ONLY (ids, comma separated) builds only those cards (scripts/try-cpp.sh); "program:fork" or
	# "spellforge:fork" names one mode's card where an id is in both.
	var only := OS.get_environment("ROOTWARD_CPP_ONLY").split(",", false)
	for module: String in MODULES:
		var cards: Array = sets[module]
		if not only.is_empty():
			cards = cards.filter(
				func(card: Dictionary) -> bool: return card.id in only or "%s:%s" % [module, card.id] in only
			)
		var count := _write_module(out.path_join(module), module, cards, module == "program")
		print("%s: %d units" % [module, count])
	quit(0)


func _write_module(dir: String, module: String, cards: Array, mutants: bool) -> int:
	DirAccess.make_dir_recursive_absolute(dir)
	for old in DirAccess.get_files_at(dir):
		DirAccess.remove_absolute(dir.path_join(old))
	var header: String = MODULES[module]
	var entries: Array[Dictionary] = []
	for card: Dictionary in cards:
		var code := String((card.get("code", {}) as Dictionary).get("cpp", ""))
		if code == "":
			continue
		var name := SpellHarness.function_name(card, SandboxJob.CPP)
		entries.append({"id": card.id, "name": name, "code": code})
		if not mutants:
			continue
		for op in ProgramMutants.OPERATORS.size():
			var mutant := ProgramMutants.mutate(code, SandboxJob.CPP, op)
			if not mutant.is_empty() and int(mutant.op) == op:
				entries.append({"id": "%s~%d" % [card.id, op], "name": name, "code": String(mutant.code)})
	var units: PackedStringArray = []
	for entry in entries:
		var file := "%s.cpp" % CppSource.namespace_of(entry.id)
		_write(dir.path_join(file), CppSource.unit(entry.id, entry.code, header))
		units.append("%s %s" % [file, entry.id])
	_write(dir.path_join("registry.cpp"), _registry(entries, header))
	_write(dir.path_join("units.txt"), "\n".join(units) + "\n")
	_write(dir.path_join("STAMP"), stamp(module, cards) + "\n")
	return entries.size()


func _registry(entries: Array[Dictionary], header: String) -> String:
	var text := '// Generated by tools/build_cpp.gd: every card of this module, by id.\n#include "%s"\n' % header
	text += '#include "registry.hpp"\n\n'
	for entry in entries:
		text += "namespace %s { Bolts %s(Bolts, const Battle&); }\n" % [CppSource.namespace_of(entry.id), entry.name]
	text += "\nconst rootward::Entry rootward::CARDS[] = {\n"
	for entry in entries:
		text += '\t{"%s", %s::%s},\n' % [entry.id, CppSource.namespace_of(entry.id), entry.name]
	if entries.is_empty():
		text += '\t{"", nullptr},\n'
	text += "};\nconst int rootward::CARD_COUNT = %d;\n" % entries.size()
	return text


## What a module is built from, hashed: the runtime's sources and every card's C++ code. Sandbox.cpp_stale compares
## it with the installed build's.
static func stamp(module: String, cards: Array) -> String:
	var hashing := HashingContext.new()
	hashing.start(HashingContext.HASH_SHA256)
	hashing.update(module.to_utf8_buffer())
	for file: String in ["common.hpp", "program.hpp", "spellforge.hpp", "registry.hpp", "json.hpp", "harness.cpp"]:
		hashing.update(FileAccess.get_file_as_string(RUNTIME.path_join(file)).to_utf8_buffer())
	for card: Dictionary in cards:
		var code := String((card.get("code", {}) as Dictionary).get("cpp", ""))
		hashing.update(("%s\n%s\n" % [card.id, code]).to_utf8_buffer())
	return hashing.finish().hex_encode()


func _write(path: String, text: String) -> void:
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(text)
	file.close()
