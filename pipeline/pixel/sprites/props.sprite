// Small props drawn by hand (pipeline/pixel/README.md): at 16 pixels a generated picture turns to mush, so these are
// placed pixel by pixel. Lit from the upper left; outlines in ink; the bottom row of each is where it meets the ground.
// A prop with two frames (a lamp lit and unlit) is saved as a strip, frames side by side.

legend W wood.0
legend X wood.1
legend Y wood.2
legend Z wood.3
legend S stone.0
legend T stone.1
legend U stone.2
legend V stone.3
legend G glow.0
legend H glow.1
legend I glow.2
legend J glow.3
legend K steel.1
legend L steel.2
legend M steel.3
legend F leaf.1
legend E leaf.2
legend D leaf.3
legend A leaf.0
legend R cloth_red.1
legend Q cloth_red.2
legend C cloth_cream.0
legend B cloth_cream.1
legend N cloth_blue.1
legend P cloth_pink.0
legend O cloth_yellow.0
legend 1 dirt.0
legend 2 dirt.1
legend 3 dirt.2
legend 4 dirt.3
legend 5 grass.0
legend 6 grass.1
legend 7 grass.2
legend 8 grass.3
legend * cloth_white.0
legend + cloth_yellow.1
legend ^ cloth_pink.1
legend $ gold.1
legend ! gold.0
legend d cloth_red.0
legend 9 cloth_blue.0

